        "files": {
          "/usr/lib/udev/rules.d/60-atlas-usbboot.rules": "bundle/linux/60-atlas-usbboot.rules"
        },
        "postInstallScript": "bundle/linux/postinst.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "polkit"
        ],
        "files": {
          "/usr/lib/udev/rules.d/60-atlas-usbboot.rules": "bundle/linux/60-atlas-usbboot.rules"
        },
        "postInstallScript": "bundle/linux/postinst.sh"
      }
    }
  }
}
