      "../../../devices/raze/compat.json": "devices/raze/compat.json",
      "../../../devices/raze/eeprom/": "devices/raze/eeprom/",
      "../../../devices/roborio/manifest.json": "devices/roborio/manifest.json",
      "../../../devices/systemcore/manifest.json": "devices/systemcore/manifest.json",
      "../../../devices/radxa-rock-5c/manifest.json": "devices/radxa-rock-5c/manifest.json",
      "../../../devices/radxa-rock-4d/manifest.json": "devices/radxa-rock-4d/manifest.json",
      "../../../devices/radxa-zero-3e/manifest.json": "devices/radxa-zero-3e/manifest.json",
      "../../../devices/radxa-cubie-a7a/manifest.json": "devices/radxa-cubie-a7a/manifest.json",
      "../../../devices/radxa-cubie-a7s/manifest.json": "devices/radxa-cubie-a7s/manifest.json",
      "../../../devices/radxa-cubie-a7z/manifest.json": "devices/radxa-cubie-a7z/manifest.json",
