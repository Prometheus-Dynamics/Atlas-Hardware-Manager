        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "pkexec | policykit-1"
        ],
        "files": {
          "/usr/bin/atlas": "bundle/linux/atlas",
          "/usr/lib/udev/rules.d/60-atlas-usbboot.rules": "bundle/linux/60-atlas-usbboot.rules"
        },
        "postInstallScript": "bundle/linux/postinst.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "polkit"
        ],
        "files": {
          "/usr/bin/atlas": "bundle/linux/atlas",
          "/usr/lib/udev/rules.d/60-atlas-usbboot.rules": "bundle/linux/60-atlas-usbboot.rules"
        },
        "postInstallScript": "bundle/linux/postinst.sh"
      }
    }
  }
}
