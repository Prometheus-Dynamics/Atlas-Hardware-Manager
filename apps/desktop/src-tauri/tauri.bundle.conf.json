      "../../../devices/raze/manifest.json": "devices/raze/manifest.json",
      "../../../devices/raze/compat.json": "devices/raze/compat.json",
      "../../../devices/raze/eeprom/pieeprom-2025-12-08.upd": "devices/raze/eeprom/pieeprom-2025-12-08.upd",
      "../../../devices/raze/eeprom/pieeprom-2025-12-08.sig": "devices/raze/eeprom/pieeprom-2025-12-08.sig",
