{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "externalBin": [
      "binaries/atlas-helper"
    ],
    "resources": {
      "../../../tools/usbboot/mass-storage-gadget64/": "usbboot/mass-storage-gadget64/",
      "../../../devices/": "devices/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "pkexec | policykit-1"
