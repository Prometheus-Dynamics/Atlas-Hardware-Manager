# Installed by Atlas Hardware Manager: lets the logged-in user USB-boot
# Raspberry Pi boards (BCM2835/2837/2711/2712 boot ROMs) without root.
SUBSYSTEM=="usb", ATTR{idVendor}=="0a5c", ATTR{idProduct}=="2711|2712|2763|2764", MODE="0660", TAG+="uaccess"
# The mass-storage gadget's serial console, so Atlas can restart a board
# into its new image after a flash.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0a5c", ATTRS{idProduct}=="0104", TAG+="uaccess"
# Atlas's raze-flasher (a USB-booted Raze): its console and its bulk
# interface, by product name, since 1d6b:0104 alone is any Linux gadget
# (a running Raze's own console among them).
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d6b", ATTRS{idProduct}=="0104", ATTRS{product}=="Raze flasher", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1d6b", ATTR{idProduct}=="0104", ATTR{product}=="Raze flasher", MODE="0660", TAG+="uaccess"
# A running board's own console (device package 1.0.7+), by its
# manufacturer: Atlas manages a board plugged in here through it, with no
# SSH key (holding the cable is the access).
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d6b", ATTRS{idProduct}=="0104", ATTRS{manufacturer}=="Prometheus Dynamics", TAG+="uaccess"
