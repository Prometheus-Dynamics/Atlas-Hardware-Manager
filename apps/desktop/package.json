{
  "name": "atlas-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "app": "cargo build -p atlas-helper && ATLAS_HELPER=$PWD/../../target/debug/atlas-helper ATLAS_USBBOOT_DIR=$PWD/../../tools/usbboot/mass-storage-gadget64 tauri dev",
    "app:sim": "ATLAS_SIM=demo tauri dev",
    "bundle": "bash ../../scripts/bundle.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tabler/icons-svelte-runes": "^3.48.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.16",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
