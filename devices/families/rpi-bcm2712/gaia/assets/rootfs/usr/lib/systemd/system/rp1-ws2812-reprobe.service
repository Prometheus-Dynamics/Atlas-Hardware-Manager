[Unit]
Description=Raze LED ring: re-probe the WS2812 PIO driver if /dev/leds0 is missing
After=systemd-modules-load.service
ConditionPathExists=!/dev/leds0
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/board/rp1-ws2812-reprobe
Restart=on-failure
RestartSec=10

[Install]
# The old name, for an OS whose units still order after it.
Alias=raze-leds-reprobe.service
WantedBy=multi-user.target
