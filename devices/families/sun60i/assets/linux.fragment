# Every A733 board (candidate, UNVERIFIED, never booted on board). Each line says why it is here.
# Standing rule: built in (=y) where a bring-up with no modules and no console needs it early.
# The base kernel is Linux 7.3.4 with DockSeed's A733 series applied (family.toml). Mainline 7.3.4
# alone has no A733 clock, pinctrl, dts, MUSB or USB PHY match, no gmac210 driver match: see the
# B19 PR text. The symbols below that exist only in the series are marked (series).
# The DEV-ONLY bring-up gadget (legacy g_ether, built in) is NOT here: it is in the bring-up
# board's own fragment, because a gadget bound at boot would hold the one USB device controller
# that the managed image's Lemnos gadget needs.

# -- Storage: the bring-up root is ext4 on the card (sd-image makes it); slot roots are EROFS.
CONFIG_MMC_SUNXI=y
CONFIG_EXT4_FS=y

# -- Ethernet: the gigabit GMAC (gmac210, MAE0621A-Q3C PHY). DWMAC_SUN55I is the glue (series).
#    STMMAC_PLATFORM and STMMAC_ETH are the generic driver it sits on; built in so eth0 exists
#    before any module could load.
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_SUN55I=y

# -- USB device and host: the OTG controller (MUSB, sunxi glue) and its USB 2 PHY. The PHY's A733
#    entry is in the series (phy-sun4i-usb). PHY_SUN4I_USB is what the USB-C 1 port's PHY uses.
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_PHY_SUN4I_USB=y

# -- Pins: the A733 PIO (series). The status LED (PJ26) and the MMC pins are pins of this bank.
CONFIG_PINCTRL_SUN60I_A733=y

# -- LED class and the heartbeat trigger: the bring-up's first sign of life (the board's status LED
#    takes "heartbeat" as its default trigger in the bring-up board's dts). Built in.
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# -- Lemnos's managed gadget (FunctionFS for Orion, NCM, ACM) is configfs: its kernel side here.
#    Defconfig has these as m; they stay built in for the same reason as the gadget framework.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y

# -- Slot file and verity: Lemnos's initramfs needs a loop device, EROFS and dm-verity in every
#    family's kernel (INPUTS: Lemnos docs/slots.md). Each is a real need for a slot boot.
CONFIG_BLK_DEV_LOOP=y
CONFIG_EROFS_FS=y
# Device mapper must be built in for verity: a module would not exist when the slot initramfs runs
#   (DM_VERITY is m in the defconfig, and it depends on BLK_DEV_DM, which is m there too).
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
# The rest of the slot root chain, written out because the repository's check requires every slot
# family to name it (scripts/check-devices.sh, SLOT_CHAIN; the Cubie bring-up product is an sd-image,
# which carries a slot): DM_BUFIO (DM_VERITY selects it; named so a fragment cannot turn it to m),
# the hash dm-verity uses, and the block layer over MMC. Unresolved against the A733 kernel (mainline
# 7.3.4 plus the pinned series): no config was resolved for this family in B16; untested on board.
CONFIG_DM_BUFIO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_MMC_BLOCK=y
# -- The bring-up signs (components/bringup-alive, B31). CONFIG_SUNXI_WATCHDOG=y: the defconfig has it =m (defconfig:816),
#    and a module is loaded from the root, which systemd's own watchdog open does not wait for. The A733 watchdog node is
#    the DockSeed series' r_wdt (sun60i-a733.dtsi, enabled; the WDT0 node is disabled there and not used). Built in so the
#    device exists when PID 1 opens it. The driver's 16 s hardware maximum and the sunxi-wdt-heartbeat patch: see
#    components/bringup-alive/files/10-watchdog.conf.
CONFIG_SUNXI_WATCHDOG=y
# CONFIG_LEDS_TRIGGER_TIMER: the 1 s blink the bring-up LEDs switch to (board-alive-led). The heartbeat is already above.
CONFIG_LEDS_TRIGGER_TIMER=y
