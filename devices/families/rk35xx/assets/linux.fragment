# Every RK35xx board. Each line says why it is here (standing rule: "dev had
# it" is not a reason).
# CONFIG_EROFS_FS: the slot file on the data partition is EROFS (the slot recipe
#   builds it; Gaia's slot is EROFS with dm-verity).
# CONFIG_EROFS_FS_ZIP, CONFIG_EROFS_FS_ZIP_ZSTD: Gaia's slot recipes write the root as EROFS compressed
#   with zstd (4 KiB clusters, the recipe's default). Without the zstd decompressor built in, the kernel
#   cannot mount a slot's root at all. Found by Gaia reading a built ZERO 3E kernel (PR B34): it had
#   EROFS_FS_ZIP_ZSTD off. The bring-up images boot an ext4 root, so it would have shown at the first slot.
# CONFIG_STMMAC_ETH, CONFIG_STMMAC_PLATFORM, CONFIG_DWMAC_ROCKCHIP: the Gigabit
#   GMAC (dwmac-rockchip, RTL8211F PHY built in) that eth0 needs for DHCP; built
#   in so eth0 exists before any module could load.
# CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY: the combo PHY behind the USB 3.0 host
#   port (and PCIe); the ZERO 3E's USB 3.0 Type-C host port is dead without it.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
# The LZMA decompressor too (L2d): the slot-making recipes now default to lzma (the build's own mkfs.erofs writes no zstd;
# the board measurement on the first image decides the final value). Lines beside the zstd line, each its own option.
CONFIG_EROFS_FS_ZIP_LZMA=y
# Each LZMA stream holds memory for the life of the mount: the same 4 as the Raze kernel (raze.config).
CONFIG_EROFS_FS_ZIP_LZMA_DEFAULT_MAX_STREAMS=4
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
# -- USB gadget for the flasher (no modules there): lemnosd's configfs gadget and Orion's FunctionFS link --
# CONFIG_USB_CONFIGFS: configfs gadget (m in arm64 defconfig). Depends on USB_GADGET (=y in the defconfig;
#   the ZERO 3E board fragment sets it too) and selects USB_LIBCOMPOSITE=y; CONFIGFS_FS=y is in the defconfig.
CONFIG_USB_CONFIGFS=y
# CONFIG_USB_CONFIGFS_F_FS: FunctionFS (Orion's link). Defconfig has it y, but it stayed m behind USB_CONFIGFS;
#   this line makes it real. Selects USB_F_FS=y (no prompt, so not settable on its own).
CONFIG_USB_CONFIGFS_F_FS=y
# -- NCM, the bring-up's USB network function (PR B24): the Gaia usb-gadget-network component makes the NCM
#    function through configfs and sets its addresses before binding. =y, not m: a module would not be
#    loaded before the gadget starts (the bring-up has no module loader step for it). Built on the rk35xx
#    families' trim (trim.fragment keeps NCM).
CONFIG_USB_CONFIGFS_NCM=y
# -- Built in for the flasher (no modules in its image; Lemnos docs/kernel-config.md @4c6678f3, "Built in" column) --
# CONFIG_SPI_SPIDEV: /dev/spidevB.C, the stock SPI route Lemnos uses without lemnos.ko (m in the arm64 defconfig).
#   Mark: VERIFIED, the generic "Built in" table of Lemnos docs/kernel-config.md at 818473f6 (not per-SoC).
CONFIG_SPI_SPIDEV=y
# CONFIG_DMABUF_HEAPS_CMA: /dev/dma_heap/linux,cma, the CMA heap of Lemnos's stream buffers (needs DMA_CMA and CMA).
#   Mark: VERIFIED, the generic dma-heaps table of Lemnos docs/kernel-config.md at 818473f6.
CONFIG_DMABUF_HEAPS_CMA=y
# -- The slot's root chain, built in (PR B16). lemnos-slot-init opens the root slot before any root filesystem
#    with modules exists, and loads dm modules only from /lib/modules in its initramfs (Lemnos docs/slots.md @4a2d3b7d,
#    service/slot-init/src/sys.rs), and Gaia's initramfs carries no modules. So each of these is =y on every
#    RK35xx slot board. The trim (trim.fragment) sets the dm lines; these are the rest of the chain:
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_BUFIO=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y
CONFIG_EXT4_FS=y
# The storage host the root and data partitions sit on: the RK35xx boards' SD and eMMC controllers (DW MMC).
CONFIG_MMC_DW_ROCKCHIP=y
# The second storage host and the block layer (PR B16). A slot board may boot from its SD slot or its eMMC:
#   CONFIG_MMC_BLOCK: the block layer over MMC (both hosts below are MMC; no block device without it).
#   CONFIG_MMC_SDHCI, CONFIG_MMC_SDHCI_PLTFM: the SDHCI core and its platform layer that the DWCMSHC driver sits on
#     (MMC_SDHCI_OF_DWCMSHC depends on MMC_SDHCI_PLTFM, and that on MMC_SDHCI).
#   CONFIG_MMC_SDHCI_OF_DWCMSHC: the eMMC socket on the ROCK 5C (rockchip,rk3588-dwcmshc) and the ROCK 4D's eMMC
#     (rockchip,rk3576-dwcmshc, which falls back to rk3588-dwcmshc). The ROCK 4D's eMMC node is disabled in the
#     pinned dts, so it binds only once a board dts enables it.
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
# -- The bring-up signs (components/bringup-alive, B31). Each is already =y in the arm64 defconfig this family starts
#    from (DW_WATCHDOG at defconfig:814, LEDS_TRIGGER_TIMER at :1331, LEDS_TRIGGER_HEARTBEAT at :1333); written here so
#    the family states what its boards need and a defconfig change cannot drop one.
# CONFIG_DW_WATCHDOG: the Synopsys watchdog every RK35xx SoC has (compatible snps,dw-wdt; the rk3566/rk3588/rk3576 nodes
#   in rk356x-base.dtsi:1377, rk3588-base.dtsi:2724, rk3576.dtsi:2438 have no status, so they are enabled). systemd opens it
#   (RuntimeWatchdogSec in components/bringup-alive). Built in: it is open before any module could load.
CONFIG_DW_WATCHDOG=y
# CONFIG_LEDS_TRIGGER_HEARTBEAT: the heartbeat pattern the bring-up LEDs beat with from boot (board-alive-led).
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
# CONFIG_LEDS_TRIGGER_TIMER: the 1 s blink, the second state once the named link has an address (board-alive-led).
CONFIG_LEDS_TRIGGER_TIMER=y
