# Every RK35xx board (RK3566 ZERO 3E, RK3588S ROCK 5C, RK3576 ROCK 4D): the kernel trim (PR B16).
# Applied after the arm64 defconfig, before linux.fragment and any board fragment. Every line is
# "not set" or a symbol the boards or the root path need, and each group says why it is here.
# Standing rule: a symbol is turned off only when no board's dts, no Lemnos need, no slot or gadget
# need and no product uses it. Where unsure, the symbol stays on and is listed as a candidate in
# docs/prs/B16.md. Checked with merge_config and olddefconfig against the pinned Linux 7.3.3 Kconfig.

# -- Other SoC vendors' platforms: their clocks, pinctrl, PHYs and drivers go with the platform. --
# PR B25: a platform symbol that depends on an off parent (ARCH_EXYNOS, ARCH_BCM, ARCH_TEGRA ...) is absent from
# the resolved config once that parent is off, so its own "not set" line would be inert and is not listed; the parent's
# line takes. Likewise KVM (VIRTUALIZATION is off) and DEBUG_INFO_BTF (DEBUG_INFO_NONE).
# A platform symbol is off unless its own family is the board's. ARCH_ROCKCHIP stays (the boards).
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BITMAIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_LAN969X is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MMP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_PENSANDO is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set

# -- Virtualization and server hardware: no guest and no server board runs this kernel. --
# CONFIG_VIRTUALIZATION is not set
# Server NICs: none is on any RK35xx board. The Gigabit GMAC (STMMAC) and the PHYs stay.
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_MELLANOX is not set
# CONFIG_NET_VENDOR_BROADCOM is not set
# CONFIG_NET_VENDOR_CAVIUM is not set

# -- Wireless and Bluetooth: none is on the three boards (an M.2 module is added by hand, not built in). --
# CONFIG_WLAN is not set
# CONFIG_BT is not set

# -- USB audio: no board has a USB sound device. --
# CONFIG_SND_USB_AUDIO is not set

# -- Filesystems no product mounts. ext4, vfat, EROFS, tmpfs, configfs and squashfs stay.
#    OVERLAY_FS is off: Lemnos refuses layered manifests, so nothing mounts an overlay (as the Raze's trim).
# CONFIG_OVERLAY_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set

# -- DRM bridges the RK35xx boards do not use: the NXP TDA998x HDMI bridge (the boards' HDMI is the
#    Synopsys DW-HDMI through DRM_ROCKCHIP). ROCKCHIP's own DRM stays.
# CONFIG_DRM_I2C_NXP_TDA998X is not set

# -- Debug information and kallsyms: the image is the shipped kernel, and oopses still name functions
#    (KALLSYMS stays, as the Raze's trim). No DWARF or BTF is built into the Image or the modules.
# The "Debug information" choice is None: DEBUG_INFO itself is derived from it (not settable).
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set

# -- The slot root's dm-verity. Off in the arm64 defconfig, and Lemnos's slot initramfs needs
#    dm-mod, dm-bufio and dm-verity (docs/slots.md, "The kernel needs ... loop and dm-verity").
#    Built in, so no module has to be packed into the initramfs (a built-in module needs no load).
CONFIG_BLK_DEV_DM=y
CONFIG_DM_BUFIO=y
CONFIG_DM_VERITY=y

# -- USB gadget functions (PR B14 made USB_CONFIGFS=y, so every configfs function the defconfig asks for
#    now builds). Kept: FunctionFS (Orion's link), NCM (the board's network function, the Raze's) and ACM
#    (the one serial console). Every other configfs function is off: no RK35xx product uses it.
#    The legacy g_* gadget modules are off too (PR B24: USB_ETH included; the bring-up's network is the
#    configfs NCM function, and a built-in legacy gadget would bind the controller first).
# CONFIG_USB_CONFIGFS_SERIAL is not set
# CONFIG_USB_CONFIGFS_OBEX is not set
# CONFIG_USB_CONFIGFS_ECM is not set
# CONFIG_USB_CONFIGFS_ECM_SUBSET is not set
# CONFIG_USB_CONFIGFS_RNDIS is not set
# CONFIG_USB_CONFIGFS_EEM is not set
# CONFIG_USB_CONFIGFS_MASS_STORAGE is not set
# CONFIG_USB_CONFIGFS_F_LB_SS is not set
# CONFIG_USB_CONFIGFS_F_UAC1 is not set
# CONFIG_USB_CONFIGFS_F_UAC1_LEGACY is not set
# CONFIG_USB_CONFIGFS_F_UAC2 is not set
# CONFIG_USB_CONFIGFS_F_MIDI is not set
# CONFIG_USB_CONFIGFS_F_MIDI2 is not set
# CONFIG_USB_CONFIGFS_F_HID is not set
# CONFIG_USB_CONFIGFS_F_UVC is not set
# CONFIG_USB_CONFIGFS_F_PRINTER is not set
# CONFIG_USB_G_SERIAL is not set
# CONFIG_USB_G_NCM is not set
# CONFIG_USB_G_MULTI is not set
# CONFIG_USB_G_HID is not set
# CONFIG_USB_G_PRINTER is not set
# -- Legacy gadget modules (drivers/usb/gadget/legacy). All are off (PR B24 removed the ZERO 3E's USB_ETH:
#    the network is the configfs NCM function). USB_ETH's RNDIS and EEM sub-options go with USB_ETH: a line
#    for a symbol whose parent is off is dropped by Kconfig, which the build's line check refuses.
#    USB_MASS_STORAGE is the legacy module that also selects the mass-storage function; off with the configfs one.
# CONFIG_USB_ETH is not set
# CONFIG_USB_MASS_STORAGE is not set
# CONFIG_USB_ZERO is not set
# CONFIG_USB_AUDIO is not set
# CONFIG_USB_GADGETFS is not set
# CONFIG_USB_FUNCTIONFS is not set
# CONFIG_USB_RAW_GADGET is not set
# CONFIG_USB_CDC_COMPOSITE is not set
# CONFIG_USB_G_WEBCAM is not set
# CONFIG_USB_MIDI_GADGET is not set
# CONFIG_USB_G_ACM_MS is not set
# CONFIG_USB_G_MULTI is not set

# -- Per-SoC drivers this trim does NOT turn off (comments only; the symbols stay as the defconfig has them).
#    Source: Lemnos docs/kernel-config.md at 818473f6, "The SoC drivers" table. Marks, with the doc's rev:
#    CONFIG_I2C_RK3X (rk3566 and rk3588 I2C): FALLBACK only, rockchip,rk3399-i2c is the driver's string.
#    CONFIG_SPI_ROCKCHIP (rk3566 and rk3588 SPI): FALLBACK only, rockchip,rk3066-spi.
#    CONFIG_PWM_ROCKCHIP (rk3566 and rk3588 PWM): FALLBACK only, rockchip,rk3328-pwm.
#    CONFIG_GPIO_ROCKCHIP (rk3566 and rk3588 GPIO): NOT VERIFIED (the doc did not read the driver).
#    CONFIG_SERIAL_8250_DW (rk3566 and rk3588 UART): NOT VERIFIED (the doc did not read the driver).
#    CONFIG_I2C_DESIGNWARE_PLATFORM, CONFIG_PWM_RP1 and CONFIG_PINCTRL_RP1 are the RP1 rows, VERIFIED,
#    and sit in the bcm2712 fragment, not here. The ROCK 4D (rk3576) has no row in the doc: NOT VERIFIED.
#    Every one of these is on in the resolved ZERO 3E, ROCK 5C and ROCK 4D configs (merge check, PR B16).
