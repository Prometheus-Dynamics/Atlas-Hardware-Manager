diff --git a/arch/arm/mach-rockchip/rv1126b/rv1126b.c b/arch/arm/mach-rockchip/rv1126b/rv1126b.c
index 2372dce9..a210ebad 100644
--- a/arch/arm/mach-rockchip/rv1126b/rv1126b.c
+++ b/arch/arm/mach-rockchip/rv1126b/rv1126b.c
@@ -19,9 +19,9 @@
 #include <spl.h>
 #include <linux/bitops.h>
 #include <asm/io.h>
-#include <asm/arch/cru_rv1126b.h>
-#include <asm/arch/grf_rv1126b.h>
-#include <asm/arch/ioc_rv1126b.h>
+#include <asm/arch-rockchip/cru_rv1126b.h>
+#include <asm/arch-rockchip/grf_rv1126b.h>
+#include <asm/arch-rockchip/ioc_rv1126b.h>
 #include <asm/armv8/mmu.h>
 #include <linux/delay.h>
 
@@ -130,7 +130,37 @@ void spl_board_storages_finish(struct spl_image_loader *loader)
 }
 #endif
 
+/* Seed 1c535d65 rv1126b.c: SGRF base and firewall offsets (lines 112-121). */
+#define SGRF_SYS_BASE			0x20220000
+#define SGRF_SYS_AHB_SECURE_SGRF_CON	0x14
+#define FIREWALL_SLV_CON0		0x20
+#define FIREWALL_SLV_CON1		0x24
+#define FIREWALL_SLV_CON2		0x28
+#define FIREWALL_SLV_CON3		0x2c
+#define FIREWALL_SLV_CON4		0x30
+#define FIREWALL_SLV_CON5		0x34
+
+/*
+ * arch_cpu_init: only the two writes SD boot needs (seed 426-437, in the SPL block of the seed's
+ * arch_cpu_init). The sdmmc0 DMA master is made secure so the card's transfers are not blocked,
+ * and the peripheral slaves are made non-secure so U-Boot can reach UART2, the MMC and the GRFs.
+ * Not ported, and not needed for SD boot to a prompt (reasons in docs/prs/AU1-aura.md):
+ * the eMMC, FSPI and SDMMC1 masters, the AXI secure GRF, OTP non-secure (needed for OTP reads only),
+ * the NPU power domain, TSADC trim (thermal only), the USB3 and PERI pipe-PHY and USB2 host-port
+ * setup (not the USB2 gadget path), SARADC IBP, FEPHY pads (the Aura uses an external PHY), the DS
+ * levels for FSPI, and the PVTPLL clock enables (ISP, ENC, AIISP not used). TRM not read.
+ */
 int arch_cpu_init(void)
 {
+#ifdef CONFIG_SPL_BUILD
+	writel(0x40000, SGRF_SYS_BASE + SGRF_SYS_AHB_SECURE_SGRF_CON);
+
+	writel(0xffff0000, SGRF_SYS_BASE + FIREWALL_SLV_CON0);
+	writel(0xffff0000, SGRF_SYS_BASE + FIREWALL_SLV_CON1);
+	writel(0xffff0000, SGRF_SYS_BASE + FIREWALL_SLV_CON2);
+	writel(0xffff0000, SGRF_SYS_BASE + FIREWALL_SLV_CON3);
+	writel(0xffff0000, SGRF_SYS_BASE + FIREWALL_SLV_CON4);
+	writel(0xffff0000, SGRF_SYS_BASE + FIREWALL_SLV_CON5);
+#endif
 	return 0;
 }
