diff --git a/arch/arm/dts/rv1126b-luckfox-aura.dts b/arch/arm/dts/rv1126b-luckfox-aura.dts
new file mode 100644
index 00000000..52ca4bd6
--- /dev/null
+++ b/arch/arm/dts/rv1126b-luckfox-aura.dts
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Luckfox Aura (RV1126B) for U-Boot. The kernel series' board dts is
+ * arch/arm64/boot/dts/rockchip/rv1126b-luckfox-aura.dts (Atlas AU1, patch 0011 of the kernel series);
+ * this one carries the U-Boot needs: the console, the microSD (SPL and env), the watchdog and the
+ * boot-order. Pins, PHY and rails are the kernel dts's; see docs/prs/AU1-aura.md for what is unverified.
+ */
+
+/dts-v1/;
+
+#include "rv1126b.dtsi"
+#include "rv1126b-pinctrl.dtsi"
+#include "rv1126b-u-boot.dtsi"
+
+/ {
+	model = "Waveshare Luckfox Aura";
+	compatible = "waveshare,luckfox-aura", "rockchip,rv1126b";
+
+	aliases {
+		mmc0 = &sdmmc0;
+		serial2 = &uart2;
+	};
+
+	chosen {
+		stdout-path = "serial2:1500000n8";
+	};
+};
+
+/* Console: UART2 on M0 (the Aura schematic's DEBUG block: NLUART20TX0M0 / RX0M0 / CTSN0M0 /
+ * RTSN0M0, the uart2m0 groups). Baud 1500000 as the vendor EVB debug UART (UNVERIFIED on the bench). */
+&uart2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart2m0_xfer_pins>;
+	status = "okay";
+};
+
+/* microSD: sdmmc0 (the kernel dts's groups). Card-detect and vmmc are as the kernel dts (UNVERIFIED). */
+&sdmmc0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc0_bus4_pins &sdmmc0_cmd_pins &sdmmc0_clk_pins &sdmmc0_detn_pins>;
+	no-sdio;
+	no-mmc;
+	disable-wp;
+	bootph-all;
+	status = "okay";
+};
+
+&wdt {
+	bootph-all;
+	status = "okay";
+};
+
+/* USB gadget for fastboot: the USB 3 OTG Type-C as a USB 2 gadget (the kernel dts's choice; no
+ * SuperSpeed, so the usb3-phy is not used). Generic DWC3 (CONFIG_USB_DWC3_GENERIC). */
+&usb2phy {
+	status = "okay";
+};
+
+&usb2phy_otg {
+	status = "okay";
+};
+
+&usb_drd_dwc3 {
+	dr_mode = "peripheral";
+	phys = <&usb2phy_otg>;
+	phy-names = "usb2-phy";
+	status = "okay";
+};
