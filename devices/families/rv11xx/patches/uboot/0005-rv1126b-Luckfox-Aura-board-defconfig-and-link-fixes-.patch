--- /dev/null
+++ b/board/luckfox/aura-rv1126b/aura-rv1126b.c
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Luckfox Aura (RV1126B, sold by Waveshare). Board hooks.
+ *
+ * The USB gadget (fastboot) is the generic DWC3 driver on the device tree's usb_drd_dwc3 node
+ * (CONFIG_USB_DWC3_GENERIC, arch/arm/dts/rv1126b-luckfox-aura.dts). The seed's EVB file (Rockchip
+ * 1c535d65 board/rockchip/evb_rv1126b/evb_rv1126b.c, lines 1-33) hand-wrote that glue; mainline
+ * v2026.10 drives it from the device tree, so the glue is not carried.
+ */
+
+#include <init.h>
+
+int board_init(void)
+{
+	return 0;
+}
+#include <asm/arch-rockchip/rv1126b.h>
+
+#ifdef CONFIG_SPL_BUILD
+void spl_board_init(void)
+{
+	/* microSD (sdmmc0) pinmux and card power cycle before SPL loads from it */
+	rv1126b_sdmmc0_iomux_init();
+}
+#endif
