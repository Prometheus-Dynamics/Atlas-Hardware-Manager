+config SOC_SPECIFIC_OPTIONS # dummy
+	def_bool y
+	select HAS_CUSTOM_SYS_INIT_SP_ADDR
+
 config SYS_SOC
-	default "rockchip"
+	default "rv1126b"
+
+# The idbloader packing uses this name: mkimage -n $(CONFIG_SYS_SOC) -T rksd finds the rkcommon row "rv1126b".
 
 # Seed 1c535d65 arch/arm/mach-rockchip/Kconfig:838 (ROCKCHIP_STIMER_BASE for RV1126B)
 config ROCKCHIP_STIMER_BASE
@@ -52,8 +59,23 @@ config SPL_LOAD_FIT_ADDRESS
 	hex
 	default 0x42000000	# seed common line 25
 
+config CUSTOM_SYS_INIT_SP_ADDR
+	hex
+	default 0x40600000	# seed common line 34 (SYS_INIT_SP_ADDR)
+
+config SPL_MAX_SIZE
+	hex
+	default 0x80000	# seed common line 16
+
 config SPL_STACK
 	hex
 	default 0x4fe00000	# seed common line 19
 
+config TARGET_LUCKFOX_AURA_RV1126B
+	bool "Luckfox Aura (RV1126B, sold by Waveshare)"
+	help
+	  Luckfox Aura: RV1126B with microSD boot and an external RGMII Ethernet PHY.
+
+source "board/luckfox/aura-rv1126b/Kconfig"
+
 endif
