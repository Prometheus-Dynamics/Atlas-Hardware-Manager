diff --git a/include/configs/rv1126b_common.h b/include/configs/rv1126b_common.h
new file mode 100644
index 00000000..532f39fd
--- /dev/null
+++ b/include/configs/rv1126b_common.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Rockchip RV1126B common configuration.
+ *
+ * Ported from Rockchip u-boot-next-dev 1c535d65, include/configs/rv1126b_common.h. The memory layout
+ * values moved to arch/arm/mach-rockchip/rv1126b/Kconfig (with their seed line numbers). Kept here:
+ * the SDRAM window, the boot environment layout, and the malloc and bounce sizes (seed lines 1-14,
+ * 36-40, 82-87, 109-146). NOT ported in this patch: the secure OTP block (seed 38-93: rollback,
+ * secure-boot enable, firmware and OEM keys), the thunderboot and USB-plug settings (seed 88-108),
+ * the 32-bit kernel entries. TRM not read.
+ */
+
+#ifndef __CONFIG_RV1126B_COMMON_H
+#define __CONFIG_RV1126B_COMMON_H
+
+#define CFG_CPUID_OFFSET		0x22
+
+#include "rockchip-common.h"
