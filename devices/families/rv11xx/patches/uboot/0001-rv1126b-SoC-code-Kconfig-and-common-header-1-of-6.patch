diff --git a/arch/arm/mach-rockchip/rv1126b/rv1126b.c b/arch/arm/mach-rockchip/rv1126b/rv1126b.c
new file mode 100644
index 00000000..2372dce9
--- /dev/null
+++ b/arch/arm/mach-rockchip/rv1126b/rv1126b.c
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Rockchip RV1126B SoC support (quad Cortex-A53, AArch64).
+ *
+ * Ported from Rockchip u-boot-next-dev 1c535d65, arch/arm/mach-rockchip/rv1126b/rv1126b.c:
+ *   memory map            seed 137-170 (CONFIG_ARM64 block)
+ *   debug UART            seed 183-185
+ *   SD iomux (devnum 1)   seed 188-215 (the VCCIO2 and PMUIO0 writes; the SPL power-cycle is seed 201-214)
+ *   STIMER                seed 291-305
+ *   storages finish       seed 307-315
+ *   arch_cpu_init         seed 417-... : ONLY the boot-minimum is here (see the list below)
+ * Not ported in this patch, each listed in docs/prs/AU1-aura.md: bidram and ATAGS, the rk_meta and FIT
+ * helpers (seed 409-416, 523-772), the TSADC trim (seed 317-385), the SGRF secure and firewall setup,
+ * the USB and PERI GRF setup, the SARADC IBP and the FEPHY pads from arch_cpu_init. TRM not read.
+ */
+
+#include <init.h>
+#include <dm.h>
+#include <spl.h>
+#include <linux/bitops.h>
+#include <asm/io.h>
+#include <asm/arch/cru_rv1126b.h>
+#include <asm/arch/grf_rv1126b.h>
+#include <asm/arch/ioc_rv1126b.h>
+#include <asm/armv8/mmu.h>
+#include <linux/delay.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define SDMMC_PWR_DOWN_MS		50
+
+/* Register bases and offsets used by board_set_iomux and the SPL power cycle: seed 1c535d65
+ * rv1126b.c lines 71-73 (GPIO0), 75-77 (PMUIO0 IOC), 92-96 (VCCIO2 IOC and the pull register). */
+#define GPIO0_BASE			0x20600000
+#define GPIO_SWPORT_DR_L		0x00
+#define GPIO_SWPORT_DDR_L		0x08
+#define PMUIO0_IOC_BASE		0x201a0000
+#define GPIO0A_IOMUX_SEL_H		0x4
+#define VCCIO2_IOC_BASE		0x201b8000
+#define GPIO2A_IOMUX_SEL_L		0x40
+#define GPIO2A_IOMUX_SEL_H		0x44
+#define GPIO2A_PULL			0x320
+
+static struct mm_region rv1126b_mem_map[] = {
+#ifndef CONFIG_SPL_BUILD
+	{
+		.virt = 0x00010000UL,
+		.phys = 0x00010000UL,
+		.size = 0x0fff0000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) |
+			 PTE_BLOCK_INNER_SHARE
+	},
+#endif
+	{
+		.virt = 0x20000000UL,
+		.phys = 0x20000000UL,
+		.size = 0x02800000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
+			 PTE_BLOCK_NON_SHARE |
+			 PTE_BLOCK_PXN | PTE_BLOCK_UXN
+	}, {
+		.virt = 0x3ff1e000UL,
+		.phys = 0x3ff1e000UL,
+		.size = 0x000e2000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
+			 PTE_BLOCK_NON_SHARE |
+			 PTE_BLOCK_PXN | PTE_BLOCK_UXN
+	}, {
+		.virt = 0x40000000UL,
+		.phys = 0x40000000UL,
+		.size = 0x100000000UL - 0x40000000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) |
+			 PTE_BLOCK_INNER_SHARE
+	}, {
+		/* List terminator */
+		0,
+	}
+};
+
+struct mm_region *mem_map = rv1126b_mem_map;
+
+void board_debug_uart_init(void)
+{
+	/* No need to change uart in most time. */
+}
+
+/*
+ * sdmmc0 (microSD) pinmux, seed lines 188-215 (devnum 1 branch). Mainline v2026.10 has no
+ * board_set_iomux(enum if_type, ...) hook, so the board calls this from its own init.
+ * In SPL it also power-cycles the card (seed 201-214). The kernel's sdmmc0 pinctrl takes over later.
+ */
+void rv1126b_sdmmc0_iomux_init(void)
+{
+#ifdef CONFIG_SPL_BUILD
+	/* SDMMC D0-3/CMD/CLK to gpio, pull down; power-cycle the card */
+	writel(0xffff0000, VCCIO2_IOC_BASE + GPIO2A_IOMUX_SEL_L);
+	writel(0x00ff0000, VCCIO2_IOC_BASE + GPIO2A_IOMUX_SEL_H);
+	writel(0x00f00000, PMUIO0_IOC_BASE + GPIO0A_IOMUX_SEL_H);
+	writel(0x0fff0aaa, VCCIO2_IOC_BASE + GPIO2A_PULL);
+
+	writel(0x01000100, GPIO0_BASE + GPIO_SWPORT_DR_L);
+	writel(0x01000100, GPIO0_BASE + GPIO_SWPORT_DDR_L);
+	mdelay(SDMMC_PWR_DOWN_MS);
+	writel(0x01000000, GPIO0_BASE + GPIO_SWPORT_DR_L);
+#endif
+	/* SDMMC D0-3/CMD/CLK, pulled up */
+	writel(0xffff1111, VCCIO2_IOC_BASE + GPIO2A_IOMUX_SEL_L);
+	writel(0x00ff0011, VCCIO2_IOC_BASE + GPIO2A_IOMUX_SEL_H);
+	writel(0x00f00010, PMUIO0_IOC_BASE + GPIO0A_IOMUX_SEL_H);
+	writel(0x0fff0555, VCCIO2_IOC_BASE + GPIO2A_PULL);
+}
+
+#ifdef CONFIG_SPL_BUILD
+void rockchip_stimer_init(void)
+{
+	u32 reg;
+
+	/* If Timer already enabled, don't re-init it */
+	reg = readl(CONFIG_ROCKCHIP_STIMER_BASE + 0x4);
+	if (reg & 0x1)
+		return;
+	writel(0xffffffff, CONFIG_ROCKCHIP_STIMER_BASE + 0x14);
+	writel(0xffffffff, CONFIG_ROCKCHIP_STIMER_BASE + 0x18);
+	writel(0x00010001, CONFIG_ROCKCHIP_STIMER_BASE + 0x04);
+}
+
+void spl_board_storages_finish(struct spl_image_loader *loader)
+{
+	/* Seed 307-315 unset the sdmmc0 iomux here; the kernel's own pinctrl owns the pins, so nothing. */
+}
+#endif
+
+int arch_cpu_init(void)
+{
+	return 0;
+}
