diff --git a/arch/arm/dts/rv1126b-pinctrl.dtsi b/arch/arm/dts/rv1126b-pinctrl.dtsi
new file mode 100644
index 00000000..dac97746
--- /dev/null
+++ b/arch/arm/dts/rv1126b-pinctrl.dtsi
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * RV1126B pin configurations and the pin groups the Luckfox Aura's boot set uses (UART2, SD on
+ * sdmmc0, and I2C0). Copied from Rockchip's RV1126B pinctrl and pinconf dtsi (kernel-develop-6.12),
+ * as the mainline form: the pcfg nodes the groups reference, then the groups. Only the groups used by
+ * the boot set are here; the rest of the table is left for later.
+ * Mux values are as the vendor writes them. The RV1126B pinctrl driver (patch 0001) decodes them.
+ */
+
+#include <dt-bindings/pinctrl/rockchip.h>
+
+&pinctrl {
+	pcfg_pull_up: pcfg-pull-up {
+		bias-pull-up;
+	};
+
+	pcfg_pull_down: pcfg-pull-down {
+		bias-pull-down;
+	};
+
+	pcfg_pull_none: pcfg-pull-none {
+		bias-disable;
+	};
+
+	pcfg_pull_up_drv_level_2_75: pcfg-pull-up-drv-level-2-75 {
+		bias-pull-up;
+		drive-strength = <0x0f>;
+	};
+
+	pcfg_pull_none_smt: pcfg-pull-none-smt {
+		bias-disable;
+		input-schmitt-enable;
+	};
+
+	i2c0 {
+		/omit-if-no-ref/
+		i2c0m0_pins: i2c0m0-pins {
+			rockchip,pins =
+				/* i2c0_scl_m0 */
+				<0 RK_PC2 4 &pcfg_pull_none_smt>,
+				/* i2c0_sda_m0 */
+				<0 RK_PC3 4 &pcfg_pull_none_smt>;
+		};
+
+		/omit-if-no-ref/
+		i2c0m1_pins: i2c0m1-pins {
+			rockchip,pins =
+				/* i2c0_scl_m1 */
+				<2 RK_PA1 3 &pcfg_pull_none_smt>,
+				/* i2c0_sda_m1 */
+				<2 RK_PA0 3 &pcfg_pull_none_smt>;
+		};
+	};
+
+	sdmmc0 {
+		/omit-if-no-ref/
+		sdmmc0_bus4_pins: sdmmc0-bus4-pins {
+			rockchip,pins =
+				/* sdmmc0_d0 */
+				<2 RK_PA0 1 &pcfg_pull_up_drv_level_2_75>,
+				/* sdmmc0_d1 */
+				<2 RK_PA1 1 &pcfg_pull_up_drv_level_2_75>,
+				/* sdmmc0_d2 */
+				<2 RK_PA2 1 &pcfg_pull_up_drv_level_2_75>,
+				/* sdmmc0_d3 */
+				<2 RK_PA3 1 &pcfg_pull_up_drv_level_2_75>;
+		};
+
+		/omit-if-no-ref/
+		sdmmc0_cmd_pins: sdmmc0-cmd-pins {
+			rockchip,pins =
+				/* sdmmc0_cmd */
+				<2 RK_PA5 1 &pcfg_pull_up_drv_level_2_75>;
+		};
+
+		/omit-if-no-ref/
+		sdmmc0_clk_pins: sdmmc0-clk-pins {
+			rockchip,pins =
+				/* sdmmc0_clk */
+				<2 RK_PA4 1 &pcfg_pull_up_drv_level_2_75>;
+		};
+
+		/omit-if-no-ref/
+		sdmmc0_detn_pins: sdmmc0-detn-pins {
+			rockchip,pins =
+				/* sdmmc0_detn */
+				<0 RK_PA5 1 &pcfg_pull_up>;
+		};
+	};
+
+	sdmmc0 {
+		/omit-if-no-ref/
+		sdmmc0_idle_pins: sdmmc0-idle-pins {
+			rockchip,pins =
+				<2 RK_PA0 RK_FUNC_GPIO &pcfg_pull_down>,
+				<2 RK_PA1 RK_FUNC_GPIO &pcfg_pull_down>,
+				<2 RK_PA2 RK_FUNC_GPIO &pcfg_pull_down>,
+				<2 RK_PA3 RK_FUNC_GPIO &pcfg_pull_down>,
+				<2 RK_PA4 RK_FUNC_GPIO &pcfg_pull_down>,
+				<2 RK_PA5 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+	};
+
+	uart2 {
+		/omit-if-no-ref/
+		uart2m0_xfer_pins: uart2m0-xfer-pins {
+			rockchip,pins =
+				/* uart2_rx_m0 */
+				<3 RK_PB0 4 &pcfg_pull_up>,
+				/* uart2_tx_m0 */
+				<3 RK_PB1 4 &pcfg_pull_up>;
+		};
+
+		/omit-if-no-ref/
+		uart2m0_ctsn_pins: uart2m0-ctsn-pins {
+			rockchip,pins =
+				/* uart2m0_ctsn */
+				<3 RK_PA7 4 &pcfg_pull_none>;
+		};
+		/omit-if-no-ref/
+		uart2m0_rtsn_pins: uart2m0-rtsn-pins {
+			rockchip,pins =
+				/* uart2m0_rtsn */
+				<3 RK_PA6 4 &pcfg_pull_none>;
+		};
+
+		/omit-if-no-ref/
+		uart2m1_xfer_pins: uart2m1-xfer-pins {
+			rockchip,pins =
+				/* uart2_rx_m1 */
+				<7 RK_PB0 6 &pcfg_pull_up>,
+				/* uart2_tx_m1 */
+				<7 RK_PB1 6 &pcfg_pull_up>;
+		};
+
+		/omit-if-no-ref/
+		uart2m1_ctsn_pins: uart2m1-ctsn-pins {
+			rockchip,pins =
+				/* uart2m1_ctsn */
+				<7 RK_PA4 6 &pcfg_pull_none>;
+		};
+		/omit-if-no-ref/
+		uart2m1_rtsn_pins: uart2m1-rtsn-pins {
+			rockchip,pins =
+				/* uart2m1_rtsn */
+				<7 RK_PA7 6 &pcfg_pull_none>;
+		};
+	};
+};
+
+/*
+ * GMAC1 (eth) on the M0 route, for an external RGMII PHY (the Luckfox Aura, U25).
+ * Source: Rockchip's RV1126B pinctrl dtsi, the eth node (ref/rv1126b-pinctrl.dtsi 247-302: MDIO
+ * 249-255, mclk 258-262, rx 265-273, tx 276-285, rgmii clk 287-293, rgmii bus 296-307) and the
+ * eth_clk_25m node (397-403); all on function 2. Pull-config nodes: BSP pinconf 107-110 and 137-140.
+ * UNTESTED ON BOARD. TRM not read. Routing per the Aura schematic's GMAC1_*_M0 nets (see the AU1 doc).
+ */
+&pinctrl {
+	pcfg_pull_none_drv_level_3_75: pcfg-pull-none-drv-level-3-75 {
+		bias-disable;
+		drive-strength = <0x1f>;
+	};
+
+	pcfg_pull_none_drv_level_5_00: pcfg-pull-none-drv-level-5-00 {
+		bias-disable;
+		drive-strength = <0x3c>;
+	};
+
+	eth {
+		ethm0_miim_pins: ethm0-miim-pins {
+			rockchip,pins =
+				<6 RK_PC0 2 &pcfg_pull_none_drv_level_3_75>,
+				<6 RK_PB7 2 &pcfg_pull_none_drv_level_3_75>;
+		};
+
+		ethm0_rx_bus2_pins: ethm0-rx-bus2-pins {
+			rockchip,pins =
+				<6 RK_PB5 2 &pcfg_pull_none>,
+				<6 RK_PB2 2 &pcfg_pull_none>,
+				<6 RK_PB3 2 &pcfg_pull_none>;
+		};
+
+		ethm0_tx_bus2_pins: ethm0-tx-bus2-pins {
+			rockchip,pins =
+				<6 RK_PB1 2 &pcfg_pull_none>,
+				<6 RK_PA7 2 &pcfg_pull_none_drv_level_3_75>,
+				<6 RK_PB0 2 &pcfg_pull_none_drv_level_3_75>;
+		};
+
+		ethm0_rgmii_clk_pins: ethm0-rgmii-clk-pins {
+			rockchip,pins =
+				<6 RK_PC3 2 &pcfg_pull_none>,
+				<6 RK_PC2 2 &pcfg_pull_none_drv_level_3_75>;
+		};
+
+		ethm0_rgmii_bus_pins: ethm0-rgmii-bus-pins {
+			rockchip,pins =
+				<6 RK_PA3 2 &pcfg_pull_none>,
+				<6 RK_PA4 2 &pcfg_pull_none>,
+				<6 RK_PA5 2 &pcfg_pull_none_drv_level_3_75>,
+				<6 RK_PA6 2 &pcfg_pull_none_drv_level_3_75>;
+		};
+	};
+};
diff --git a/arch/arm/dts/rv1126b-u-boot.dtsi b/arch/arm/dts/rv1126b-u-boot.dtsi
new file mode 100644
index 00000000..2df7657b
--- /dev/null
+++ b/arch/arm/dts/rv1126b-u-boot.dtsi
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * RV1126B U-Boot additions: the nodes SPL (and TPL) needs are tagged for it.
+ * Node set: the kernel series' rv1126b.dtsi (Atlas, patch 0006 of the kernel series), whose
+ * register bases and interrupts are Rockchip's (vendor rv1126b.dtsi, GPL-2.0+ OR MIT).
+ * The tags follow arch/arm/dts/rk3576-u-boot.dtsi (bootph-all, bootph-pre-ram).
+ */
+
+#include "rockchip-u-boot.dtsi"
+
+/ {
+	chosen {
+		u-boot,spl-boot-order = "same-as-spl", &sdmmc0;
+	};
+};
+
+&cru {
+	bootph-all;
+};
+
+&grf {
+	bootph-all;
+};
+
+&ioc_grf {
+	bootph-all;
+};
+
+&pinctrl {
+	bootph-all;
+};
+
+&gpio0 {
+	bootph-all;
+};
+
+&gpio2 {
+	bootph-all;
+};
+
+&uart2 {
+	bootph-all;
+};
+
+&sdmmc0 {
+	bootph-all;
+};
+
+/* The pin groups and pull configs the SPL pinmux uses: the sdmmc0 and uart2 groups (see
+ * rv1126b-pinctrl.dtsi) and the pcfgs they reference. */
+&sdmmc0_bus4_pins {
+	bootph-all;
+};
+
+&sdmmc0_cmd_pins {
+	bootph-all;
+};
+
+&sdmmc0_clk_pins {
+	bootph-all;
+};
+
+&sdmmc0_detn_pins {
+	bootph-all;
+};
+
+&uart2m0_xfer_pins {
+	bootph-all;
+};
+
+&pcfg_pull_none {
+	bootph-all;
+};
+
+&pcfg_pull_up {
+	bootph-all;
+};
+
+&pcfg_pull_none_smt {
+	bootph-all;
+};
+
+&pcfg_pull_up_drv_level_2_75 {
+	bootph-all;
+};
diff --git a/arch/arm/dts/rv1126b.dtsi b/arch/arm/dts/rv1126b.dtsi
new file mode 100644
index 00000000..81d72b46
--- /dev/null
+++ b/arch/arm/dts/rv1126b.dtsi
@@ -0,0 +1,473 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * RV1126B SoC: the boot set (CPU, GIC, timer, PSCI, CRU, GRF, pinctrl banks,
+ * UART, watchdog, SD and eMMC hosts, USB 2 PHY and DRD controller, combo PHY,
+ * GMAC, OTP, I2C0). Register bases and interrupt numbers are Rockchip's, from
+ * the vendor RV1126B SoC dtsi (Rockchip develop-6.1, GPL-2.0+ OR MIT). Nodes
+ * outside the boot set (ISP, VPSS, NPU, codecs, SARADC, thermal, PWM, SPI,
+ * the other UARTs and I2Cs, the power domains and OPP tables) are not here yet:
+ * see docs/prs/AU1-aura.md. The pin groups are in rv1126b-pinctrl.dtsi, which a
+ * board includes; this file does not reference them.
+ */
+
+#include <dt-bindings/clock/rockchip,rv1126b-cru.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/phy/phy.h>
+#include <dt-bindings/reset/rockchip,rv1126b-cru.h>
+
+/ {
+	compatible = "rockchip,rv1126b";
+	interrupt-parent = <&gic>;
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	clocks {
+		xin32k: xin32k {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <32768>;
+			clock-output-names = "xin32k";
+		};
+
+		xin24m: xin24m {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <24000000>;
+			clock-output-names = "xin24m";
+		};
+
+		clk_rcosc: clk_rcosc {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <96000000>;
+			clock-output-names = "clk_rcosc";
+		};
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x0>;
+			enable-method = "psci";
+			clocks = <&cru ARMCLK>;
+		};
+
+		cpu1: cpu@1 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x1>;
+			enable-method = "psci";
+			clocks = <&cru ARMCLK>;
+		};
+
+		cpu2: cpu@2 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x2>;
+			enable-method = "psci";
+			clocks = <&cru ARMCLK>;
+		};
+
+		cpu3: cpu@3 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x3>;
+			enable-method = "psci";
+			clocks = <&cru ARMCLK>;
+		};
+	};
+
+	psci {
+		compatible = "arm,psci-1.0";
+		method = "smc";
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>;
+	};
+
+	gic: interrupt-controller@21201000 {
+		compatible = "arm,gic-400";
+		#interrupt-cells = <3>;
+		#address-cells = <0>;
+		interrupt-controller;
+		reg = <0x21201000 0x1000>,
+		      <0x21202000 0x2000>,
+		      <0x21204000 0x2000>,
+		      <0x21206000 0x2000>;
+		interrupts = <GIC_PPI 9 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>;
+	};
+
+	cru: clock-controller@20000000 {
+		compatible = "rockchip,rv1126b-cru", "syscon";
+		reg = <0x20000000 0xc0000>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+	};
+
+	grf: syscon@20100000 {
+		compatible = "rockchip,rv1126b-grf", "syscon", "simple-mfd";
+		reg = <0x20100000 0x91000>;
+	};
+
+	ioc_grf: syscon@201a0000 {
+		compatible = "rockchip,rv1126b-ioc-grf", "syscon", "simple-mfd";
+		reg = <0x201a0000 0x50000>;
+	};
+
+	pmu: power-management@20838000 {
+		compatible = "rockchip,rv1126b-pmu", "syscon", "simple-mfd";
+		reg = <0x20838000 0x400>;
+	};
+
+	pinctrl: pinctrl {
+		compatible = "rockchip,rv1126b-pinctrl";
+		rockchip,grf = <&ioc_grf>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		gpio0: gpio@20600000 {
+			compatible = "rockchip,gpio-bank";
+			reg = <0x20600000 0x200>;
+			interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 1 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru PCLK_PMU_GPIO0>, <&cru DBCLK_PMU_GPIO0>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl 0 0 32>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		gpio1: gpio@21300000 {
+			compatible = "rockchip,gpio-bank";
+			reg = <0x21300000 0x200>;
+			interrupts = <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 5 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 6 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru PCLK_GPIO1>, <&cru DBCLK_GPIO1>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl 0 32 32>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		gpio2: gpio@21700000 {
+			compatible = "rockchip,gpio-bank";
+			reg = <0x21700000 0x200>;
+			interrupts = <GIC_SPI 8 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 9 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru PCLK_GPIO2>, <&cru DBCLK_GPIO2>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl 0 64 32>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		gpio3: gpio@21e00000 {
+			compatible = "rockchip,gpio-bank";
+			reg = <0x21e00000 0x200>;
+			interrupts = <GIC_SPI 12 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 14 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 15 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru PCLK_GPIO3>, <&cru DBCLK_GPIO3>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl 0 96 32>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		gpio4: gpio@21800000 {
+			compatible = "rockchip,gpio-bank";
+			reg = <0x21800000 0x200>;
+			interrupts = <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 17 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 19 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru PCLK_GPIO4>, <&cru DBCLK_GPIO4>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl 0 128 32>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		gpio5: gpio@21900000 {
+			compatible = "rockchip,gpio-bank";
+			reg = <0x21900000 0x200>;
+			interrupts = <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru PCLK_GPIO5>, <&cru DBCLK_GPIO5>;
+			gpio-controller;
+			#gpio-cells = <2>;
