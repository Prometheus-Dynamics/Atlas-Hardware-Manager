diff --git a/drivers/phy/rockchip/phy-rockchip-inno-usb2.c b/drivers/phy/rockchip/phy-rockchip-inno-usb2.c
--- a/drivers/phy/rockchip/phy-rockchip-inno-usb2.c
+++ b/drivers/phy/rockchip/phy-rockchip-inno-usb2.c
@@ -2366,6 +2366,90 @@
 	{ /* sentinel */ }
 };
 
+#define FILTER_COUNTER		0xF4240
+
+static int rv1126b_usb2phy_tuning(struct rockchip_usb2phy *rphy)
+{
+	int ret = 0;
+
+	/* Turn off differential receiver by default to save power */
+	regmap_clear_bits(rphy->phy_base, 0x0030, BIT(2));
+	regmap_clear_bits(rphy->phy_base, 0x0430, BIT(2));
+
+	/* Enable pre-emphasis during non-chirp phase */
+	regmap_update_bits(rphy->phy_base, 0x0000, GENMASK(2, 0), 0x04);
+	regmap_update_bits(rphy->phy_base, 0x0400, GENMASK(2, 0), 0x04);
+
+	/* Set HS eye height to 425mv (default is 400mv) */
+	regmap_update_bits(rphy->phy_base, 0x0030, GENMASK(6, 4), 0x05 << 4);
+	regmap_update_bits(rphy->phy_base, 0x0430, GENMASK(6, 4), 0x05 << 4);
+
+	/* Set Rx squelch trigger point configure to 112.5mv */
+	regmap_update_bits(rphy->phy_base, 0x0004, GENMASK(7, 5), 0x00 << 5);
+	regmap_update_bits(rphy->phy_base, 0x0008, GENMASK(0, 0), 0x00);
+	regmap_update_bits(rphy->phy_base, 0x0404, GENMASK(7, 5), 0x00 << 5);
+	regmap_update_bits(rphy->phy_base, 0x0408, GENMASK(0, 0), 0x00);
+
+	/* bvalid and id filter time: 10 ms on the u2phy grf pclk (100 MHz) */
+	ret |= regmap_write(rphy->grf, 0x10088, FILTER_COUNTER);
+	ret |= regmap_write(rphy->grf, 0x1008c, FILTER_COUNTER);
+
+	/* Enable host port wakeup irq */
+	ret |= regmap_write(rphy->grf, 0x000c, 0x80008000);
+
+	return ret;
+}
+
