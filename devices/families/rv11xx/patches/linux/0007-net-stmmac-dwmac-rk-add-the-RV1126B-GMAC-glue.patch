diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c
@@ -1100,6 +1100,81 @@
 	.gmac_phy_intf_sel_mask = GENMASK_U16(6, 4),
 
 	.supports_rmii = true,
+};
+
+/* RV1126B GMAC glue (RGMII). Register offsets and bit values from the BSP's
+ * rv1126b_* block, kernel-develop-6.12 drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c lines 2872-2926 and
+ * 2928-2968 (set_to_rgmii, set_rgmii_speed). TRM not read. RMII and the integrated MAC-PHY are not ported. */
+#define RV1126B_VI_GRF_GMAC_CON0		0x50050
+#define RV1126B_GMAC_PHY_INTF_SEL_RGMII		GRF_CLR_BIT(3)
+#define RV1126B_GMAC_CLK_RGMII_DIV1		(GRF_CLR_BIT(6) | GRF_CLR_BIT(5))
+#define RV1126B_GMAC_CLK_RGMII_DIV5		(GRF_BIT(6) | GRF_BIT(5))
+#define RV1126B_GMAC_CLK_RGMII_DIV50		(GRF_BIT(6) | GRF_CLR_BIT(5))
+
+#define RV1126B_IOC_GRF_GMACIO_M0_CON0		0x38BA0
+#define RV1126B_IOC_GRF_GMACIO_M0_CON1		0x38BA4
+#define RV1126B_IOC_GRF_GMACIO_M1_CON0		0x30BA8
+#define RV1126B_IOC_GRF_GMACIO_M1_CON1		0x30BAC
+
+#define RV1126B_GMAC_RXCLK_DLY_ENABLE		GRF_BIT(1)
+#define RV1126B_GMAC_RXCLK_DLY_DISABLE		GRF_CLR_BIT(1)
+#define RV1126B_GMAC_TXCLK_DLY_ENABLE		GRF_BIT(0)
+#define RV1126B_GMAC_TXCLK_DLY_DISABLE		GRF_CLR_BIT(0)
+
+/* BSP HIWORD_UPDATE(val, 0x7F, 8) and (val, 0x7F, 0): the same as GRF_FIELD(14, 8) and GRF_FIELD(6, 0) */
+#define RV1126B_GMAC_CLK_RX_DL_CFG(val)		GRF_FIELD(14, 8, val)
+#define RV1126B_GMAC_CLK_TX_DL_CFG(val)		GRF_FIELD(6, 0, val)
+
+static void rv1126b_set_to_rgmii(struct rk_priv_data *bsp_priv,
+				 int tx_delay, int rx_delay)
+{
+	regmap_write(bsp_priv->grf, RV1126B_VI_GRF_GMAC_CON0,
+		     RV1126B_GMAC_PHY_INTF_SEL_RGMII);
+
+	regmap_write(bsp_priv->php_grf, RV1126B_IOC_GRF_GMACIO_M0_CON1,
+		     DELAY_ENABLE(RV1126B, tx_delay, rx_delay));
+	regmap_write(bsp_priv->php_grf, RV1126B_IOC_GRF_GMACIO_M1_CON1,
+		     DELAY_ENABLE(RV1126B, tx_delay, rx_delay));
+
+	regmap_write(bsp_priv->php_grf, RV1126B_IOC_GRF_GMACIO_M0_CON0,
+		     RV1126B_GMAC_CLK_TX_DL_CFG(tx_delay) |
+		     RV1126B_GMAC_CLK_RX_DL_CFG(rx_delay));
+	regmap_write(bsp_priv->php_grf, RV1126B_IOC_GRF_GMACIO_M1_CON0,
+		     RV1126B_GMAC_CLK_TX_DL_CFG(tx_delay) |
+		     RV1126B_GMAC_CLK_RX_DL_CFG(rx_delay));
+}
+
+static int rv1126b_set_speed(struct rk_priv_data *bsp_priv,
+			     phy_interface_t interface, int speed)
+{
+	u32 val;
+
+	if (!phy_interface_mode_is_rgmii(interface))
+		return -EINVAL;
+
+	switch (speed) {
+	case 10:
+		val = RV1126B_GMAC_CLK_RGMII_DIV50;
+		break;
+	case 100:
+		val = RV1126B_GMAC_CLK_RGMII_DIV5;
+		break;
+	case 1000:
+		val = RV1126B_GMAC_CLK_RGMII_DIV1;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return regmap_write(bsp_priv->grf, RV1126B_VI_GRF_GMAC_CON0, val);
+}
+
+static const struct rk_gmac_ops rv1126b_ops = {
+	.set_to_rgmii = rv1126b_set_to_rgmii,
+	.set_speed = rv1126b_set_speed,
+	/* The interface select is one bit (RGMII = 0), not the mask-and-encode the generic path writes,
+	 * so gmac_phy_intf_sel_mask stays 0 and rv1126b_set_to_rgmii writes it. */
+	.php_grf_required = true,
 };
 
 static int rk_gmac_clk_init(struct plat_stmmacenet_data *plat)
@@ -1633,6 +1708,7 @@
 	{ .compatible = "rockchip,rk3588-gmac", .data = &rk3588_ops },
 	{ .compatible = "rockchip,rv1108-gmac", .data = &rv1108_ops },
 	{ .compatible = "rockchip,rv1126-gmac", .data = &rv1126_ops },
+	{ .compatible = "rockchip,rv1126b-gmac", .data = &rv1126b_ops },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, rk_gmac_dwmac_match);
