--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rv1126b-luckfox-aura.dts
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Waveshare (Luckfox) Aura: RV1126B, microSD boot, USB 3 OTG Type-C as a
+ * USB 2 gadget, Gigabit Ethernet (RGMII), DW watchdog, ramoops.
+ *
+ * BENCH PROTOTYPE, UNTESTED ON BOARD. Every fact below marked UNVERIFIED is
+ * not yet read from the schematic, the board, or a register comparison:
+ *  - the PMIC is not identified: the two regulators here are fixed stand-ins;
+ *  - the console UART, the microSD pins and the I2C0 pins are the BSP groups
+ *    (the EVB's choice), not the Aura's; GMAC has no pin group in the BSP, so
+ *    it has no pinctrl-0 (docs/prs/AU1-aura.md);
+ *  - the Ethernet PHY address and RGMII delays come from the strap names only;
+ *  - the ramoops address is a placeholder not checked against TF-A's, U-Boot's
+ *    or the kernel's memory use.
+ */
+
+/dts-v1/;
+
+#include "rv1126b.dtsi"
+#include "rv1126b-pinctrl.dtsi"
+
+/ {
+	model = "Waveshare Luckfox Aura";
+	compatible = "waveshare,luckfox-aura", "rockchip,rv1126b";
+
+	aliases {
+		serial2 = &uart2;
+		ethernet0 = &gmac;
+		mmc0 = &sdmmc0;
+	};
+
+	chosen {
+		/* UNVERIFIED: the Aura's debug UART is taken as the EVB's uart2. */
+		stdout-path = "serial2:1500000n8";
+	};
+
+	/* UNVERIFIED stand-in: a fixed 3.3 V rail for the microSD card and the
+	 * PHY, until the PMIC is identified on the bench. */
+	vcc3v3_sys: regulator-vcc3v3-sys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v3_sys";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* Crash log across a reset. UNVERIFIED placement: check against the
+		 * TF-A, U-Boot and kernel memory map on the bench (cat /proc/iomem). */
+		ramoops: ramoops@110000 {
+			compatible = "ramoops";
+			reg = <0x110000 0xf0000>;
+			console-size = <0x20000>;
+			record-size = <0x10000>;
+			ftrace-size = <0>;
+			pmsg-size = <0>;
+			ecc-size = <0>;
+		};
+	};
+};
+
+/* Console UART pins: the EVB's uart2m0 RX/TX (UNVERIFIED for the Aura: read the schematic). */
+&uart2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart2m0_xfer_pins>;
+	status = "okay";
+};
+
+&wdt {
+	status = "okay";
+};
+
+/* microSD slot: the vendor SD host. Card-detect and pins: UNVERIFIED (see above). */
+&sdmmc0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc0_bus4_pins &sdmmc0_cmd_pins &sdmmc0_clk_pins &sdmmc0_detn_pins>;
+	vmmc-supply = <&vcc3v3_sys>;
+	no-sdio;
+	no-mmc;
+	disable-wp;
+	status = "okay";
+};
+
+&usb2phy {
+	status = "okay";
+};
+
+&usb2phy_otg {
+	status = "okay";
+};
+
+/* USB 3 OTG Type-C as a USB 2 gadget. The combo PHY is left out of the first
+ * image (no SuperSpeed); the controller runs at high speed on the USB 2 PHY. */
+&usb_drd_dwc3 {
+	dr_mode = "peripheral";
+	phys = <&usb2phy_otg>;
+	phy-names = "usb2-phy";
+	status = "okay";
+};
+
+/*
+ * Gigabit Ethernet: an EXTERNAL RGMII PHY (U25 on the Aura schematic, part not read; RTL8211F-class
+ * per the pin names, UNVERIFIED). Routing: GMAC1 M0 (ethm0 groups in rv1126b-pinctrl.dtsi).
+ * Delays from the schematic straps (ETHER sheet, "Pull-up for additional 2ns delay" rows, R232-R235):
+ * RXDLY high (R233 4.7K to VCCIO_PHY1) so the PHY adds the RX delay; TXDLY low (R234 4.7K on the
+ * pull-down side, R235 not fitted) so the MAC adds the TX delay: phy-mode "rgmii-rxid". The sheet's
+ * heading calls R234 a pull-up, but its placement is the pull-down side; UNVERIFIED, read on the board.
+ * PHY address 1: PHYAD[2:0] = 3'b001 (sheet table; R237 4.7K pulls PHYAD0 up, R238/R239 pull PHYAD1/2 down).
+ * No PHY reset GPIO is wired in this description (the reset net source is not traced: UNVERIFIED).
+ * The 25 MHz output (ETH_CLK1_25M_OUT_M0) is not used: the PHY has its own crystal (XTAL pins; R214
+ * 0R/NC is the link, UNVERIFIED). TRM not read. UNTESTED ON BOARD.
+ */
+&gmac {
+	phy-mode = "rgmii-rxid";
+	phy-handle = <&phy>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&ethm0_miim_pins &ethm0_rx_bus2_pins &ethm0_tx_bus2_pins
+		     &ethm0_rgmii_clk_pins &ethm0_rgmii_bus_pins>;
+	status = "okay";
+
+	mdio {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		phy: ethernet-phy@1 {
+			reg = <1>;
+		};
+	};
+};
+
+/* I2C0: the BSP's i2c0m0 pins, left disabled: the Aura has no I2C device in the boot set (UNVERIFIED). */
+&i2c0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c0m0_pins>;
+};
