diff --git a/arch/arm64/boot/dts/rockchip/rv1126b-luckfox-aura.dts b/arch/arm64/boot/dts/rockchip/rv1126b-luckfox-aura.dts
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rv1126b-luckfox-aura.dts
@@ -0,0 +1,284 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Waveshare (Luckfox) Aura: RV1126B, microSD boot, an RK801 PMIC, an external RGMII Gigabit PHY,
+ * USB 3 OTG Type-C as a USB 2 gadget, DW watchdog, ramoops.
+ *
+ * Values come from the vendor Aura dts and dtsi in the Rockchip SDK 202611 (Luckfox_Aura_SDK_202611.tar.gz,
+ * sha256 b9a95edbd9b17efef477509926874b498549e9df2712a2bcd6bb60d6b3283b2c; kernel rev c67d457cf327 (6.1)):
+ *   rv1126b-luckfox-aura.dts  (board: sdmmc0, emmc, uart, gmac, PHY, i2c0 and the PMIC node)
+ *   rv1126b-luckfox-aura.dtsi (the regulators and the rails, the pmic and usb pin groups)
+ * Citations are in the commit and docs/prs/AU1-aura.md. Not verified on a board.
+ */
+
+/dts-v1/;
+
+#include "rv1126b.dtsi"
+#include "rv1126b-pinctrl.dtsi"
+
+/ {
+	model = "Waveshare Luckfox Aura";
+	compatible = "waveshare,luckfox-aura", "rockchip,rv1126b";
+
+	aliases {
+		mmc0 = &sdmmc0;
+		serial0 = &uart0;
+		ethernet0 = &gmac;
+	};
+
+	chosen {
+		/* Vendor kernel console: ttyFIQ0 (fiq-debugger on uart0) with earlycon at 0x20810000; vendor U-Boot
+		 * stdout is uart0 at 1500000 (rv1126b-u-boot.dtsi 19-20; defconfig CONFIG_BAUDRATE). */
+		stdout-path = "serial0:1500000n8";
+	};
+
+	/* Fixed rails that are not on the RK801 (vendor rv1126b-luckfox-aura.dtsi 47-98). */
+	vcc5v_dcin: vcc5v-dcin {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v_dcin";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+	};
+
+	vcc5v0_sys: vcc5v0-sys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v0_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&vcc5v_dcin>;
+	};
+
+	vcc5v0_host: vcc5v0-host {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v0_host";
+		regulator-boot-on;
+		regulator-always-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		enable-active-high;
+		gpio = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>;
+		vin-supply = <&vcc5v0_sys>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vcc5v0_host_en>;
+	};
+
+	/* SD card supplies: vendor vcc_sd (vmmc) and vccio_sd (vqmmc), both fixed 3.3 V from vcc3v3_sys
+	 * (rv1126b-luckfox-aura.dtsi 100-120). */
+	vcc_sd: vcc-sd {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_sd";
+		regulator-boot-on;
+		regulator-always-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&vcc3v3_sys>;
+	};
+
+	vccio_sd: vccio-sd {
+		compatible = "regulator-fixed";
+		regulator-name = "vccio_sd";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&vcc3v3_sys>;
+	};
+
+	/* Vendor vdd_cpu (dtsi 122-131): a fixed 0.95 V regulator in the vendor tree, not a PMIC output. Kept
+	 * as the vendor has it; the CPU's cpu-supply and opp are not wired here (see docs/prs/AU1-aura.md). */
+	vdd_cpu: vdd-cpu {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_cpu";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <950000>;
+		regulator-max-microvolt = <950000>;
+		vin-supply = <&vcc5v0_sys>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* Crash log across a reset. UNVERIFIED placement: check against the TF-A, U-Boot and kernel
+		 * memory map on the bench (cat /proc/iomem). */
+		ramoops: ramoops@110000 {
+			compatible = "ramoops";
+			reg = <0x110000 0xf0000>;
+			console-size = <0x20000>;
+			record-size = <0x10000>;
+			ftrace-size = <0>;
+			pmsg-size = <0>;
+			ecc-size = <0>;
+		};
+	};
+};
+
+/* Console: UART0 on M0, the vendor's choice (uart0m0_xfer_pins, rv1126b-pinctrl.dtsi). */
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0m0_xfer_pins>;
+	status = "okay";
+};
+
+&wdt {
+	status = "okay";
+};
+
+/* microSD (vendor sdmmc0, rv1126b-luckfox-aura.dts 79-94): 4-bit, 52 MHz, vmmc and vqmmc as above.
+ * The card-detect is sdmmc0_detn (gpio0 PA5); the card power enable is sdmmc0_pwren (gpio0 PB2, pull
+ * down). The vendor U-Boot toggles GPIO0 B0 for the card power instead (see docs/prs/AU1-aura.md). */
+&sdmmc0 {
+	bus-width = <4>;
+	max-frequency = <52000000>;
+	no-sdio;
+	no-mmc;
+	cap-sd-highspeed;
+	disable-wp;
+	vmmc-supply = <&vcc_sd>;
+	vqmmc-supply = <&vccio_sd>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc0_clk_pins &sdmmc0_cmd_pins &sdmmc0_detn_pins &sdmmc0_bus4_pins &sdmmc0_pwren>;
+	status = "okay";
+};
+
+/* Gigabit Ethernet (vendor rv1126b-luckfox-aura.dts 304-330): external RGMII PHY on GMAC1 M0, the PHY's
+ * 25 MHz clock from the SoC (CLK_MAC_OUT2IO on eth_clk_25m_out_m0), reset on gpio6 PB6 (active low,
+ * 20 ms, then 100 ms for the RTL8211F-class part, the vendor's comment). The vendor sets the TX delay to
+ * 0x20 in the MAC and leaves the RX delay to the PHY strap (the RXDLY line is high, see the AU1 doc). */
+&gmac {
+	phy-mode = "rgmii";
+	clock_in_out = "output";
+	snps,reset-gpio = <&gpio6 RK_PB6 GPIO_ACTIVE_LOW>;
+	snps,reset-active-low;
+	snps,reset-delays-us = <0 20000 100000>;
+	assigned-clocks = <&cru CLK_MAC_OUT2IO>;
+	assigned-clock-rates = <25000000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&ethm0_miim_pins &ethm0_tx_bus2_pins &ethm0_rx_bus2_pins
+		     &ethm0_rgmii_clk_pins &ethm0_rgmii_bus_pins &eth_clk_25mm0_out_pins>;
+	tx_delay = <0x20>;
+	phy-handle = <&rgmii_phy>;
+	status = "okay";
+};
+
+&mdio {
+	rgmii_phy: phy@1 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0x1>;
+		clocks = <&cru CLK_MAC_OUT2IO>;
+	};
+};
+
+/* PMIC: RK801 at I2C0 address 0x27 (vendor rv1126b-luckfox-aura.dtsi 340-454). Mainline's rk801 MFD
+ * (drivers/mfd/rk8xx-i2c.c) and regulator driver (drivers/regulator/rk808-regulator.c, rk801_reg[]) match it.
+ * The vendor's pwrctrl-gpios (gpio0 PC1) and the pmic-reset pinctrl state are not in mainline's binding and
+ * are not carried: soc_pwrctrl_reset stays unused. Regulator names are the mainline ones (dcdc1..4, ldo1..2,
+ * switch); the vendor names are in the comments. */
+&i2c0 {
+	status = "okay";
+
+	rk801: pmic@27 {
+		compatible = "rockchip,rk801";
+		reg = <0x27>;
+		interrupt-parent = <&gpio0>;
+		interrupts = <RK_PC0 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pmic_int>;
+		rockchip,system-power-controller;
+		wakeup-source;
+
+		vcc1-supply = <&vcc5v_dcin>;
+		vcc2-supply = <&vcc5v_dcin>;
+		vcc3-supply = <&vcc5v0_sys>;
+		vcc4-supply = <&vcc5v0_sys>;
+		vcc5-supply = <&vcc3v3_sys>;
+		vcc6-supply = <&vcc3v3_sys>;
+		vcc7-supply = <&vcc3v3_sys>;
+
+		regulators {
+			/* vendor DCDC_REG1, vdd_npu: 0.5-1.5 V, always on */
+			vdd_npu: dcdc1 {
+				regulator-name = "vdd_npu";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1500000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/* vendor DCDC_REG2, vcc3v3_sys: 3.3 V, always on (the schematic's VCC3V3_SYS net) */
+			vcc3v3_sys: dcdc2 {
+				regulator-name = "vcc3v3_sys";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/* vendor DCDC_REG3, vcc_ddr: no voltage range in the vendor tree */
+			vcc_ddr: dcdc3 {
+				regulator-name = "vcc_ddr";
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/* vendor DCDC_REG4, vdd_logic: 0.5-1.5 V, always on */
+			vdd_logic: dcdc4 {
+				regulator-name = "vdd_logic";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1500000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/* vendor LDO_REG1, named vdd0v9_sys but with min = max = 3.3 V. UNVERIFIED: the name says 0.9 V,
+			 * the value says 3.3 V, the schematic has no 0V9 net, and nothing in this dts consumes it.
+			 * The vendor value is kept so the regulator matches the vendor tree until the bench settles it. */
+			vdd0v9_sys: ldo1 {
+				regulator-name = "vdd0v9_sys";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/* vendor LDO_REG2, vcc_1v8: 1.8-3.3 V, always on. The schematic's VCC_1V8 net; the vendor saradc
+			 * vref is this rail (dtsi 458). */
+			vcc_1v8: ldo2 {
+				regulator-name = "vcc_1v8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/* vendor SWITCH_REG, vcc_3v3: a switch, no voltage */
+			vcc_3v3: switch {
+				regulator-name = "vcc_3v3";
+				regulator-boot-on;
+				regulator-always-on;
+			};
+		};
+	};
+};
+
+/* USB 3 OTG Type-C as a USB 2 gadget (the vendor's USB-C power is vbus5v0_typec, gpio0 PC6; not
+ * described here). The combo PHY is not used in this description. */
+&usb2phy {
+	status = "okay";
+};
+
+&usb2phy_otg {
+	status = "okay";
+};
+
+&usb_drd_dwc3 {
+	dr_mode = "peripheral";
+	phys = <&usb2phy_otg>;
+	phy-names = "usb2-phy";
+	status = "okay";
+};
