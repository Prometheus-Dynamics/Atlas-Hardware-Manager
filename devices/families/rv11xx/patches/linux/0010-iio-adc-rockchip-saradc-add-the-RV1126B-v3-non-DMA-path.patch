@@ -20,6 +20,7 @@
           - rockchip,rk3562-saradc
           - rockchip,rk3588-saradc
           - rockchip,rv1106-saradc
+          - rockchip,rv1126b-saradc
       - items:
           - const: rockchip,rk3506-saradc
           - const: rockchip,rk3528-saradc
