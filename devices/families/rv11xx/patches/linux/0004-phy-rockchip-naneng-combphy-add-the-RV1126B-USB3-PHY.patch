 allOf:
+  # RV1126B: two clocks (refclk, apbclk) and two resets (combphy-apb, combphy), from the vendor
+  # dtsi's usb3-phy node. Every other compatible keeps the three clocks and two resets below.
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: rockchip,rv1126b-usb3-phy
+    then:
+      properties:
+        clocks:
