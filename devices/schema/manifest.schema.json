{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:board:manifest:1",
  "title": "Device package manifest (contract 1)",
  "description": "devices/<model>/manifest.json: what Atlas needs to recognise, recover and flash a device, and what an OS build gets from the package. Checksums are informational: tools may verify them and warn, but must let the user proceed.",
  "type": "object",
  "required": [
    "schema",
    "contract",
    "model",
    "package_version",
    "display_name",
    "revisions",
    "rev_source",
    "identity",
    "recovery",
    "eeprom",
    "capabilities",
    "identity_service"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "urn:board:manifest:1" },
    "contract": { "const": 1 },
    "model": { "$ref": "#/$defs/id" },
    "package_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "vendor": { "type": "string" },
    "platform": {
      "type": "object",
      "properties": {
        "soc": { "type": "string" },
        "module": { "type": "string" },
        "arch": { "type": "string" }
      }
    },
    "kernel": {
      "type": "object",
      "description": "The kernel the package builds. OS kernel fragments are merged first and the package's fragment last, so the package's decisions win (fragment_merge).",
      "properties": {
        "source": { "type": "string" },
        "branch": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "version": { "type": "string" },
        "defconfig": { "type": "string" },
        "page_size_kib": { "enum": [4, 16, 64] },
        "builtin": { "type": "array", "items": { "type": "string" }, "description": "Features built into the kernel, not modules (erofs, ...)." },
        "fragment": { "type": "string", "description": "The package's kernel config fragment, relative to the package directory." },
        "fragment_merge": { "enum": ["os-first-package-last"] },
        "verified": { "$ref": "#/$defs/verified" }
      }
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "match"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "match": {
            "description": "How a value read from rev_source selects this revision. {\"default\": true} matches when nothing else does.",
            "type": "object",
            "minProperties": 1,
            "properties": {
              "default": { "type": "boolean" },
              "value": { "type": ["string", "integer"] },
              "values": { "type": "array", "items": { "type": ["string", "integer"] } }
            }
          },
          "display_name": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "rev_source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["none", "otp-customer", "eeprom-config", "gpio-strap", "devicetree"]
        },
        "key": { "type": "string", "description": "OTP row, EEPROM config key, GPIO list or DT path, depending on kind." },
        "mapping": { "type": "object", "additionalProperties": { "$ref": "#/$defs/id" } },
        "override_file": { "type": "string" },
        "hook": { "type": "string" },
        "todo": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "required": ["serial_source", "hostname_pattern", "mac_rule", "usb_gadget"],
      "properties": {
        "serial_source": {
          "type": "object",
          "required": ["kind", "path", "format"],
          "properties": {
            "kind": { "enum": ["devicetree", "file", "otp"] },
            "path": { "type": "string" },
            "format": { "const": "lowercase-hex" },
            "serial8": { "type": "string" }
          }
        },
        "hostname_pattern": { "type": "string", "pattern": "\\{serial8?\\}" },
        "hostname_policy": { "type": "string" },
        "mac_rule": {
          "type": "object",
          "required": ["seed", "fallback_seed", "algorithm", "first_octet", "interfaces"],
          "properties": {
            "seed": { "type": "string" },
            "fallback_seed": { "type": "string" },
            "algorithm": { "type": "string" },
            "first_octet": { "const": "02" },
            "interfaces": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["device_xor", "host_xor"],
                "properties": {
                  "device_xor": { "$ref": "#/$defs/hexbyte" },
                  "host_xor": { "$ref": "#/$defs/hexbyte" }
                }
              }
            }
          }
        },
        "usb_gadget": {
          "type": "object",
          "required": ["vid", "pid", "manufacturer", "product", "serial"],
          "properties": {
            "vid": { "$ref": "#/$defs/usbid" },
            "pid": { "$ref": "#/$defs/usbid" },
            "manufacturer": { "type": "string" },
            "product": { "type": "string" },
            "serial": { "type": "string" },
            "functions": { "type": "array", "items": { "type": "string" } },
            "optional_functions": { "type": "array", "items": { "type": "string" } },
            "network": { "type": "object" }
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "required": ["usb_boot", "method", "storage_target", "instructions"],
      "properties": {
        "usb_boot": {
          "type": "object",
          "required": ["vid", "pid"],
          "properties": {
            "vid": { "$ref": "#/$defs/usbid" },
            "pid": { "$ref": "#/$defs/usbid" }
          }
        },
        "method": { "enum": ["mass-storage-gadget"] },
        "storage_target": { "enum": ["emmc", "sd", "nvme", "usb"] },
        "storage_target_evidence": { "type": "array", "items": { "type": "string" } },
        "instructions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "todo": { "type": "array", "items": { "type": "string" } }
      }
    },
    "eeprom": {
      "type": "object",
      "required": ["min_version", "files", "update_method"],
      "properties": {
        "min_version": {
          "type": "object",
          "required": ["date", "timestamp"],
          "properties": {
            "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "timestamp": { "type": "integer", "minimum": 0 },
            "hash": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "role"],
            "properties": {
              "path": { "type": "string" },
              "role": { "enum": ["pieeprom", "pieeprom-sig", "recovery", "bootconf"] },
              "sha256": { "$ref": "#/$defs/sha256" },
              "fetch": { "type": "string", "description": "Name of a fetch.lock entry, for files not kept in git." },
              "notes": { "type": "string" }
            }
          }
        },
        "update_method": { "enum": ["rpiboot-recovery"] },
        "bootconf": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "capabilities": {
      "description": "Hardware facts, precise enough to generate the package's config from (devices/tools/gen-raze.py). Each hardware section carries `verified`: per fact (a dotted path inside the section), who confirmed it, when and how, or \"unverified\".",
      "type": "object",
      "required": ["camera", "fan", "leds", "usb-power", "gadget-net"],
      "additionalProperties": { "type": "object" },
      "properties": {
        "leds": {
          "type": "object",
          "properties": {
            "kind": { "type": "string" },
            "driver": { "type": "string" },
            "part": { "type": "string", "description": "LED part number, e.g. SK6812-EC20." },
            "gpio": { "type": "integer", "minimum": 0 },
            "count": { "type": "integer", "minimum": 1 },
            "device": { "type": "string" },
            "brightness": { "type": "integer", "minimum": 0, "maximum": 255 },
            "rgbw": { "type": "boolean", "description": "Whether the overlay passes rgbw (32 bits per LED on the wire). Must match wire_format." },
            "overlay": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "dev_name": { "type": "string" }
              }
            },
            "wire_format": { "enum": ["grb24", "rgb24", "grbw32", "rgbw32"], "description": "Bits on the LED data line." },
            "userspace": {
              "type": "object",
              "description": "What the driver's character device takes per LED.",
              "properties": {
                "layout": { "type": "string", "pattern": "^[rgbw]{4}$" },
                "bytes_per_led": { "const": 4 },
                "ignored_channels": { "type": "array", "items": { "enum": ["r", "g", "b", "w"] } }
              }
            },
            "index": {
              "type": "object",
              "description": "Logical LED i is driver slot (offset + direction * i) mod count.",
              "properties": {
                "offset": { "type": "integer", "minimum": 0 },
                "direction": { "enum": [1, -1] }
              }
            },
            "verified": { "$ref": "#/$defs/verified" }
          }
        },
        "fan": {
          "type": "object",
          "properties": {
            "overlay": { "type": "string" },
            "pwm": {
              "type": "object",
              "properties": {
                "controller": { "type": "string", "description": "Device tree label of the PWM controller." },
                "channel": { "type": "integer", "minimum": 0 },
                "period_ns": { "type": "integer", "minimum": 1 },
                "polarity": { "enum": ["normal", "inversed"] }
              }
            },
            "cooling_levels": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "description": "Duty (0..level_max) per cooling state: below the first trip, then one per trip." },
            "min_level": { "type": "integer", "minimum": 0, "description": "The duty floor: the lowest cooling level." },
            "level_max": { "type": "integer", "minimum": 1 },
            "trips_c": { "type": "array", "items": { "type": "number" } },
            "trips_source": { "enum": ["base-dt", "overlay"] },
            "thermal_zone": { "type": "string" },
            "cooling_device_type": { "type": "string" },
            "hwmon_name": { "type": "string" },
            "verified": { "$ref": "#/$defs/verified" }
          }
        },
        "camera": {
          "type": "object",
          "properties": {
            "sensor": { "type": "string" },
            "part": { "type": "string" },
            "port": { "type": "string" },
            "csi": {
              "type": "object",
              "properties": {
                "port": { "type": "string" },
                "dt_target": { "type": "string" },
                "receiver_driver": { "type": "string" },
                "data_lanes": { "type": "integer", "minimum": 1 },
                "clock_continuous": { "type": "boolean" }
              }
            },
            "i2c_address": { "$ref": "#/$defs/i2caddr" },
            "i2c": {
              "type": "object",
              "properties": {
                "bus": { "type": ["integer", "null"], "description": "Linux bus number (/dev/i2c-N); null when unknown." },
                "bus_dt_label": { "type": "string" },
                "address": { "$ref": "#/$defs/i2caddr" }
              }
            },
            "chip_id": {
              "type": "object",
              "properties": {
                "register": { "type": "integer" },
                "accepted": { "type": "array", "items": { "type": "integer" } }
              }
            },
            "overlay": { "type": "string" },
            "kernel_driver": { "type": "string" },
            "kernel_compatible": { "type": "string" },
            "tuning": { "type": "array", "items": { "type": "string" } },
            "verified": { "$ref": "#/$defs/verified" }
          }
        },
        "i2c": {
          "type": "object",
          "properties": {
            "buses": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["bus", "kind"],
                "properties": {
                  "bus": { "type": "integer", "minimum": 0, "description": "Linux bus number (/dev/i2c-N); for a pio bus, which has no kernel adapter, the manifest's own number for it." },
                  "kind": { "enum": ["hardware", "i2c-gpio", "pio"], "description": "pio: lemnosd runs the bus on the RP1 PIO block (Lemnos pio-i2c), with no overlay." },
                  "controller": { "type": "string" },
                  "sda_gpio": { "type": "integer", "minimum": 0 },
                  "scl_gpio": { "type": "integer", "minimum": 0 },
                  "pins": { "type": "string" },
                  "overlay": { "type": "string" },
                  "hz": { "type": "integer", "minimum": 1, "description": "A pio bus's clock (Lemnos's default: 400000)." },
                  "notes": { "type": "string" }
                }
              }
            },
            "devices": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["part", "bus", "address"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "part": { "type": "string" },
                  "part_number": { "type": "string" },
                  "function": { "type": "string" },
                  "bus": { "type": "integer", "minimum": 0 },
                  "address": { "$ref": "#/$defs/i2caddr" },
                  "shunt_ohm": { "type": "number" },
                  "current_scale": { "type": "number" }
                }
              }
            },
            "description_file": { "type": "string" },
            "verified": { "$ref": "#/$defs/verified" }
          }
        },
        "watchdog": {
          "type": "object",
          "properties": {
            "device": { "type": "string" },
            "driver": { "type": "string" },
            "runtime_sec": { "type": "integer", "minimum": 0 },
            "reboot_sec": { "type": "integer", "minimum": 0 },
            "manager": { "enum": ["systemd"] },
            "config": { "type": "string" },
            "verified": { "$ref": "#/$defs/verified" }
          }
        },
        "selftest": {
          "type": "object",
          "properties": {
            "path": { "type": "string" },
            "result": { "type": "string" },
            "format_version": { "type": "integer", "minimum": 1 },
            "checks": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "identity_service": {
      "type": "object",
      "required": ["port", "path", "mdns_service"],
      "properties": {
        "port": { "const": 5899 },
        "path": { "const": "/.well-known/pd-device" },
        "mdns_service": { "const": "_pd-device._tcp" },
        "protocol": { "const": "http" },
        "schema": { "type": "string" },
        "txt": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gaia": {
      "type": "object",
      "properties": {
        "layer": { "type": "string" },
        "optional_layers": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "usbid": { "type": "string", "pattern": "^[0-9a-f]{4}$" },
    "hexbyte": { "type": "string", "pattern": "^0x[0-9a-f]{2}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "i2caddr": {
      "description": "A 7-bit I2C address. A number; older manifests wrote it as a \"0x..\" string, which readers still accept.",
      "oneOf": [
        { "type": "integer", "minimum": 3, "maximum": 119 },
        { "type": "string", "pattern": "^0x[0-7][0-9a-fA-F]$" }
      ]
    },
    "verified": {
      "type": "object",
      "description": "Per fact (a dotted path inside the section): who confirmed it, when and how, or \"unverified\".",
      "additionalProperties": {
        "oneOf": [
          { "const": "unverified" },
          {
            "type": "object",
            "required": ["by", "date", "method"],
            "additionalProperties": false,
            "properties": {
              "by": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "method": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    }
  }
}
