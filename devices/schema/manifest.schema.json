{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:board:manifest:1",
  "title": "Device package manifest (contract 1)",
  "description": "devices/<model>/manifest.json: what Atlas needs to recognise, recover and flash a device, and what an OS build gets from the package. Checksums are informational: tools may verify them and warn, but must let the user proceed.",
  "type": "object",
  "required": ["schema", "contract", "model", "package_version", "display_name"],
  "if": { "required": ["fingerprints"] },
  "then": {
    "description": "A device without the identity contract (the roboRIO): recognised and read from this data.",
    "required": ["key", "info"]
  },
  "else": {
    "if": {
      "required": ["record_only"],
      "properties": { "record_only": { "const": true } }
    },
    "then": {
      "description": "A board record: a board Atlas flashes from its SoC's download mode before it has a full device package: what it is and how to flash it. With identity.identity_port it also serves the identity contract, so Atlas sees it running.",
      "required": ["platform", "recovery"]
    },
    "else": {
      "description": "A board package: it serves the identity contract.",
      "required": [
        "revisions",
        "rev_source",
        "identity",
        "recovery",
        "eeprom",
        "capabilities"
      ],
      "properties": {
        "identity": {
          "required": ["serial_source", "hostname_pattern"]
        }
      },
      "if": { "not": { "required": ["ecosystem"] } },
      "then": {
        "description": "A package that names no ecosystem gives its own identity endpoint, MAC rule and USB gadget ids; one that names an ecosystem inherits them (devices/ecosystem.json).",
        "required": ["identity_service"],
        "properties": {
          "identity": {
            "required": ["mac_rule", "usb_gadget"],
            "properties": {
              "usb_gadget": { "required": ["vid", "pid", "manufacturer", "serial"] }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "A board named by no family gives its own recovery method and entry steps; a family-named one inherits them (devices/families/).",
      "if": { "not": { "required": ["family"] } },
      "then": { "properties": { "recovery": { "required": ["method", "instructions"] } } }
    }
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "urn:board:manifest:1" },
    "contract": { "const": 1 },
    "model": { "$ref": "#/$defs/id" },
    "package_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "display_name": { "type": "string", "minLength": 1 },
    "record_only": {
      "type": "boolean",
      "description": "True for a board record (no device package yet): see the top-level if/then."
    },
    "description": { "type": "string" },
    "vendor": { "type": "string" },
    "family": {
      "$ref": "#/$defs/id",
      "description": "The device family (devices/families/<id>.json, family.schema.json) this board belongs to: its recovery.method and recovery.instructions default to the family's when omitted."
    },
    "ecosystem": {
      "$ref": "#/$defs/id",
      "description": "The OS ecosystem (devices/ecosystem.json) this package belongs to: its identity.mac_rule, identity.usb_gadget, identity_service and capabilities.gadget-net default to the ecosystem's when omitted. Records name none."
    },
    "variants": {
      "type": "array",
      "description": "Variants of this board that differ in data only (the AI-CAM's lens variants). Atlas exposes each one's data as written.",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "display_name": { "type": "string" },
          "data": { "type": "object" }
        }
      }
    },
    "platform": {
      "type": "object",
      "properties": {
        "soc": { "type": "string" },
        "module": { "type": "string" },
        "arch": { "type": "string" }
      }
    },
    "kernel": {
      "type": "object",
      "description": "The kernel the package builds. OS kernel fragments are merged first and the package's fragment last, so the package's decisions win (fragment_merge).",
      "properties": {
        "source": { "type": "string" },
        "branch": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "version": { "type": "string" },
        "defconfig": { "type": "string" },
        "page_size_kib": { "enum": [4, 16, 64] },
        "builtin": { "type": "array", "items": { "type": "string" }, "description": "Features built into the kernel, not modules (erofs, ...)." },
        "fragment": { "type": "string", "description": "The package's kernel config fragment, relative to the package directory." },
        "fragment_merge": { "enum": ["os-first-package-last"] },
        "verified": { "$ref": "#/$defs/verified" }
      }
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "match"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "match": {
            "description": "How a value read from rev_source selects this revision. {\"default\": true} matches when nothing else does.",
            "type": "object",
            "minProperties": 1,
            "properties": {
              "default": { "type": "boolean" },
              "value": { "type": ["string", "integer"] },
              "values": { "type": "array", "items": { "type": ["string", "integer"] } }
            }
          },
          "display_name": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "rev_source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["none", "otp-customer", "eeprom-config", "gpio-strap", "devicetree"]
        },
        "key": { "type": "string", "description": "OTP row, EEPROM config key, GPIO list or DT path, depending on kind." },
        "mapping": { "type": "object", "additionalProperties": { "$ref": "#/$defs/id" } },
        "override_file": { "type": "string" },
        "hook": { "type": "string" },
        "todo": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "description": "A board package requires serial_source and hostname_pattern; mac_rule and usb_gadget come from its ecosystem or are required (see the top-level else). A board record gives only what it serves (identity_port).",
      "properties": {
        "serial_source": {
          "type": "object",
          "required": ["kind", "path", "format"],
          "properties": {
            "kind": { "enum": ["devicetree", "file", "otp"] },
            "path": { "type": "string" },
            "format": { "const": "lowercase-hex" },
            "serial8": { "type": "string" }
          }
        },
        "hostname_pattern": { "type": "string", "pattern": "\\{serial8?\\}" },
        "hostname_policy": { "type": "string" },
        "mac_rule": {
          "type": "object",
          "required": ["seed", "fallback_seed", "algorithm", "first_octet", "interfaces"],
          "properties": {
            "seed": { "type": "string" },
            "fallback_seed": { "type": "string" },
            "algorithm": { "type": "string" },
            "first_octet": { "const": "02" },
            "interfaces": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["device_xor", "host_xor"],
                "properties": {
                  "device_xor": { "$ref": "#/$defs/hexbyte" },
                  "host_xor": { "$ref": "#/$defs/hexbyte" }
                }
              }
            }
          }
        },
        "usb_gadget": {
          "type": "object",
          "description": "The USB gadget's descriptor strings. A package naming an ecosystem may give only product (its vid, pid, manufacturer and serial come from the ecosystem).",
          "required": ["product"],
          "properties": {
            "vid": { "$ref": "#/$defs/usbid" },
            "pid": { "$ref": "#/$defs/usbid" },
            "manufacturer": { "type": "string" },
            "product": { "type": "string" },
            "serial": { "type": "string" },
            "functions": { "type": "array", "items": { "type": "string" } },
            "optional_functions": { "type": "array", "items": { "type": "string" } },
            "network": { "type": "object" }
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "required": ["usb_boot", "storage_target"],
      "properties": {
        "usb_boot": {
          "type": "object",
          "required": ["vid", "pid"],
          "properties": {
            "vid": { "$ref": "#/$defs/usbid" },
            "pid": { "$ref": "#/$defs/usbid" },
            "pid_unconfirmed": {
              "type": "boolean",
              "description": "The PID is a guess: a device of this vendor whose PID no record names may be this board, until the board says otherwise (the chip its loader reports)."
            }
          }
        },
        "method": {
          "description": "mass-storage-gadget: a Raspberry Pi boot ROM serves the eMMC as a USB disk. rockusb: a Rockchip boot ROM (maskrom) runs a loader file's DDR init and usbplug, which writes the storage. k230-usb: the K230 boot ROM runs Canaan's burner U-Boot, which writes the storage. fel: the Allwinner boot ROM takes an eGON SPL in SRAM over FEL, then U-Boot. Required unless the board names a family, which gives it.",
          "enum": ["mass-storage-gadget", "rockusb", "k230-usb", "fel"]
        },
        "storage_target": { "enum": ["emmc", "sd", "nvme", "usb", "spi-nand", "spi-nor"] },
        "flasher": {
          "type": "object",
          "description": "This board's USB-boot flasher bundle (docs/flasher.md): Atlas uses it instead of the mass-storage path when the bundle is at hand.",
          "required": ["bundle"],
          "additionalProperties": false,
          "properties": { "bundle": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } }
        },
        "storage_target_evidence": { "type": "array", "items": { "type": "string" } },
        "instructions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "status": {
          "description": "untested: Atlas's flashing for this board is written from the vendor's protocol and tools and unit-tested, but has not run on a board. Atlas says so before it flashes.",
          "enum": ["verified", "untested"]
        },
        "flash": {
          "type": "object",
          "description": "How the download mode writes this board (rockusb, k230-usb).",
          "additionalProperties": false,
          "properties": {
            "loader": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "minItems": 1, "items": { "type": "string" } }
              ],
              "description": "The vendor loader file's name: a glob or a list of them (rkbin's rk3588_loader_v*.bin and Radxa's rk3588_spl_loader_v*.bin; the K230 burner U-Boot). Atlas looks next to the image, then in the package directory; it never downloads one."
            },
            "storage": {
              "enum": ["emmc", "sd", "spi-nor", "spi-nand"],
              "description": "The storage the loader writes, when it must be chosen (rockusb CHANGE_STORAGE; the K230 burner's medium)."
            },
            "image_offset": {
              "type": "integer",
              "minimum": 0,
              "description": "Byte offset on the storage where the image's first byte goes (0: the image is the whole disk, idblock and all)."
            },
            "fel_image": {
              "type": "string",
              "description": "allwinner-fel: the image form this board's FEL package takes (the family says what Atlas can load)."
            },
            "load_address": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{8}$",
              "description": "k230-usb: where the boot ROM loads and starts the burner."
            },
            "nand": {
              "type": "object",
              "description": "spi-nand: the flash's geometry. The image's UBI region (found by its headers) is written as ubiformat does; what comes before it is written as is.",
              "required": ["peb_size", "page_size"],
              "additionalProperties": false,
              "properties": {
                "peb_size": { "type": "integer", "minimum": 4096 },
                "page_size": { "type": "integer", "minimum": 512 },
                "size": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "todo": { "type": "array", "items": { "type": "string" } }
      }
    },
    "eeprom": {
      "type": "object",
      "required": ["min_version", "files", "update_method"],
      "properties": {
        "min_version": {
          "type": "object",
          "required": ["date", "timestamp"],
          "properties": {
            "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "timestamp": { "type": "integer", "minimum": 0 },
            "hash": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "role"],
            "properties": {
              "path": { "type": "string" },
              "role": { "enum": ["pieeprom", "pieeprom-sig", "recovery", "bootconf"] },
              "sha256": { "$ref": "#/$defs/sha256" },
              "fetch": { "type": "string", "description": "Name of a fetch.lock entry, for files not kept in git." },
              "notes": { "type": "string" }
            }
          }
        },
        "update_method": { "enum": ["rpiboot-recovery"] },
        "bootconf": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "capabilities": {
      "description": "Hardware facts, precise enough to generate the package's config from (devices/tools/gen-raze.py). Each hardware section carries `verified`: per fact (a dotted path inside the section), who confirmed it, when and how, or \"unverified\".",
      "type": "object",
      "required": ["camera", "fan", "leds", "usb-power", "gadget-net"],
      "additionalProperties": { "type": "object" },
      "properties": {
        "leds": {
          "type": "object",
          "properties": {
            "kind": { "type": "string" },
            "driver": { "type": "string" },
            "part": { "type": "string", "description": "LED part number, e.g. SK6812-EC20." },
            "gpio": { "type": "integer", "minimum": 0 },
            "count": { "type": "integer", "minimum": 1 },
            "device": { "type": "string" },
            "brightness": { "type": "integer", "minimum": 0, "maximum": 255 },
            "rgbw": { "type": "boolean", "description": "Whether the overlay passes rgbw (32 bits per LED on the wire). Must match wire_format." },
            "overlay": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "dev_name": { "type": "string" }
              }
            },
            "wire_format": { "enum": ["grb24", "rgb24", "grbw32", "rgbw32"], "description": "Bits on the LED data line." },
            "userspace": {
              "type": "object",
              "description": "What the driver's character device takes per LED.",
              "properties": {
                "layout": { "type": "string", "pattern": "^[rgbw]{4}$" },
                "bytes_per_led": { "const": 4 },
                "ignored_channels": { "type": "array", "items": { "enum": ["r", "g", "b", "w"] } }
              }
            },
            "index": {
              "type": "object",
              "description": "Logical LED i is driver slot (offset + direction * i) mod count.",
              "properties": {
                "offset": { "type": "integer", "minimum": 0 },
                "direction": { "enum": [1, -1] }
              }
            },
            "verified": { "$ref": "#/$defs/verified" }
          }
        },
        "fan": {
          "type": "object",
          "properties": {
            "overlay": { "type": "string" },
            "pwm": {
              "type": "object",
              "properties": {
                "controller": { "type": "string", "description": "Device tree label of the PWM controller." },
                "channel": { "type": "integer", "minimum": 0 },
                "period_ns": { "type": "integer", "minimum": 1 },
                "polarity": { "enum": ["normal", "inversed"] }
              }
            },
            "cooling_levels": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "description": "Duty (0..level_max) per cooling state: below the first trip, then one per trip." },
            "min_level": { "type": "integer", "minimum": 0, "description": "The duty floor: the lowest cooling level." },
            "level_max": { "type": "integer", "minimum": 1 },
            "trips_c": { "type": "array", "items": { "type": "number" } },
            "trips_source": { "enum": ["base-dt", "overlay"] },
            "thermal_zone": { "type": "string" },
            "cooling_device_type": { "type": "string" },
            "hwmon_name": { "type": "string" },
            "verified": { "$ref": "#/$defs/verified" }
          }
        },
        "camera": {
          "type": "object",
          "properties": {
            "sensor": { "type": "string" },
            "part": { "type": "string" },
            "port": { "type": "string" },
            "csi": {
              "type": "object",
              "properties": {
                "port": { "type": "string" },
                "dt_target": { "type": "string" },
                "receiver_driver": { "type": "string" },
                "data_lanes": { "type": "integer", "minimum": 1 },
                "clock_continuous": { "type": "boolean" }
              }
            },
            "i2c_address": { "$ref": "#/$defs/i2caddr" },
            "i2c": {
              "type": "object",
              "properties": {
                "bus": { "type": ["integer", "null"], "description": "Linux bus number (/dev/i2c-N); null when unknown." },
                "bus_dt_label": { "type": "string" },
                "address": { "$ref": "#/$defs/i2caddr" }
              }
            },
            "chip_id": {
              "type": "object",
              "properties": {
                "register": { "type": "integer" },
                "accepted": { "type": "array", "items": { "type": "integer" } }
              }
            },
            "overlay": { "type": "string" },
            "kernel_driver": { "type": "string" },
            "kernel_compatible": { "type": "string" },
            "tuning": { "type": "array", "items": { "type": "string" } },
            "lens": {
              "type": "object",
              "description": "The camera module's lens: the model a self-calibration should fit, and one module's fit as a starting point.",
              "required": ["model"],
              "properties": {
                "model": { "enum": ["pinhole", "fisheye"] },
                "projection": { "type": "string", "description": "For fisheye: equidistant, equisolid, stereographic or orthographic." },
                "notes": { "type": "string" },
                "hint": {
                  "type": "object",
                  "required": ["width", "height", "fx_px"],
                  "properties": {
                    "width": { "type": "integer", "minimum": 1 },
                    "height": { "type": "integer", "minimum": 1 },
                    "fx_px": { "type": "number", "exclusiveMinimum": 0 },
                    "fy_px": { "type": "number", "exclusiveMinimum": 0 },
                    "cx_px": { "type": "number" },
                    "cy_px": { "type": "number" },
                    "distortion": {
                      "type": "object",
                      "description": "For fisheye (equidistant): OpenCV cv::fisheye k1..k4.",
                      "properties": { "k1": { "type": "number" }, "k2": { "type": "number" }, "k3": { "type": "number" }, "k4": { "type": "number" } }
                    },
                    "rms_px": { "type": "number", "minimum": 0 },
                    "sigma": { "type": "number", "exclusiveMinimum": 0, "description": "The focal length's relative spread across modules: how far a fit may move from the prior." }
                  }
                },
                "source": { "type": "object", "properties": { "by": { "type": "string" }, "date": { "type": "string" } } }
              }
            },
            "verified": { "$ref": "#/$defs/verified" }
          }
        },
        "i2c": {
          "type": "object",
          "properties": {
            "buses": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["bus", "kind"],
                "properties": {
                  "bus": { "type": "integer", "minimum": 0, "description": "Linux bus number (/dev/i2c-N); for a pio bus, which has no kernel adapter, the manifest's own number for it." },
                  "kind": { "enum": ["hardware", "i2c-gpio", "pio"], "description": "pio: lemnosd runs the bus on the RP1 PIO block (Lemnos pio-i2c), with no overlay." },
                  "controller": { "type": "string" },
                  "sda_gpio": { "type": "integer", "minimum": 0 },
                  "scl_gpio": { "type": "integer", "minimum": 0 },
                  "pins": { "type": "string" },
                  "overlay": { "type": "string" },
                  "hz": { "type": "integer", "minimum": 1, "description": "A pio bus's clock (Lemnos's default: 400000)." },
                  "notes": { "type": "string" }
                }
              }
            },
            "devices": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["part", "bus", "address"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "part": { "type": "string" },
                  "part_number": { "type": "string" },
                  "function": { "type": "string" },
                  "bus": { "type": "integer", "minimum": 0 },
                  "address": { "$ref": "#/$defs/i2caddr" },
                  "shunt_ohm": { "type": "number" },
                  "current_scale": { "type": "number" }
                }
              }
            },
            "description_file": { "type": "string" },
            "verified": { "$ref": "#/$defs/verified" }
          }
        },
        "watchdog": {
          "type": "object",
          "properties": {
            "device": { "type": "string" },
            "driver": { "type": "string" },
            "runtime_sec": { "type": "integer", "minimum": 0 },
            "reboot_sec": { "type": "integer", "minimum": 0 },
            "manager": { "enum": ["systemd"] },
            "config": { "type": "string" },
            "verified": { "$ref": "#/$defs/verified" }
          }
        },
        "selftest": {
          "type": "object",
          "properties": {
            "path": { "type": "string" },
            "result": { "type": "string" },
            "format_version": { "type": "integer", "minimum": 1 },
            "checks": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "identity_service": {
      "type": "object",
      "required": ["port", "path", "mdns_service"],
      "properties": {
        "port": { "const": 5899 },
        "path": { "const": "/.well-known/pd-device" },
        "mdns_service": { "const": "_pd-device._tcp" },
        "protocol": { "const": "http" },
        "schema": { "type": "string" },
        "txt": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gaia": {
      "type": "object",
      "properties": {
        "layer": { "type": "string" },
        "optional_layers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "description": "The info value that keys the device (team, serial, mac)."
    },
    "fingerprints": {
      "type": "array",
      "minItems": 1,
      "description": "How to tell that what answers at an address is this model: the first whose checks all hold wins. GETs only, to that address.",
      "items": {
        "type": "object",
        "required": ["id", "get"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "get": { "$ref": "#/$defs/httpget" },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": { "type": "integer", "minimum": 100, "maximum": 599 },
              "header": { "type": "object", "additionalProperties": { "$ref": "#/$defs/textmatch" } },
              "body_contains": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "info": {
      "type": "object",
      "description": "What to read once recognised, by name: model and name name the device, versions.<x> is a version, anything else an attribute. A value that can't be read is left out or takes its default.",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 4,
        "properties": {
          "http_json": {
            "type": "object",
            "required": ["port", "path", "pick"],
            "additionalProperties": false,
            "properties": {
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "path": { "type": "string", "pattern": "^/" },
              "pick": { "type": "string", "pattern": "^\\$(\\.[^.]+)*$" }
            }
          },
          "address": { "type": "string", "minLength": 1, "description": "A fact of the address it was found at (team)." },
          "tcp_open": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "port"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            }
          },
          "template": { "type": "string", "description": "{address} and other values by name." },
          "word": { "type": "integer", "minimum": 0 },
          "strip_prefix": { "type": "string" },
          "default": { "type": "string" }
        },
        "additionalProperties": false,
        "oneOf": [
          { "required": ["http_json"] },
          { "required": ["address"] },
          { "required": ["tcp_open"] },
          { "required": ["template"] }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "usbid": { "type": "string", "pattern": "^[0-9a-f]{4}$" },
    "hexbyte": { "type": "string", "pattern": "^0x[0-9a-f]{2}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "httpget": {
      "type": "object",
      "required": ["port", "path"],
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "type": "string", "pattern": "^/" }
      }
    },
    "textmatch": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "equals": { "type": "string" },
        "starts_with": { "type": "string" },
        "contains": { "type": "string" }
      }
    },
    "i2caddr": {
      "description": "A 7-bit I2C address. A number; older manifests wrote it as a \"0x..\" string, which readers still accept.",
      "oneOf": [
        { "type": "integer", "minimum": 3, "maximum": 119 },
        { "type": "string", "pattern": "^0x[0-7][0-9a-fA-F]$" }
      ]
    },
    "verified": {
      "type": "object",
      "description": "Per fact (a dotted path inside the section): who confirmed it, when and how, or \"unverified\".",
      "additionalProperties": {
        "oneOf": [
          { "const": "unverified" },
          {
            "type": "object",
            "required": ["by", "date", "method"],
            "additionalProperties": false,
            "properties": {
              "by": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "method": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    }
  }
}
