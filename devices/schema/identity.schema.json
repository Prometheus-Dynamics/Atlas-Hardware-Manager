{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pd-device:identity:1",
  "title": "Device identity document (contract 1)",
  "description": "Served at GET http://<device>:5899/.well-known/pd-device and written to /run/pd-device/identity.json. Readers must ignore properties they do not know; later contract versions only add properties.",
  "type": "object",
  "required": [
    "contract",
    "model",
    "rev",
    "serial",
    "hostname",
    "os",
    "device_package",
    "update_methods",
    "manage_url",
    "macs"
  ],
  "properties": {
    "contract": {
      "const": 1
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "rev": {
      "type": [
        "string",
        "null"
      ]
    },
    "serial": {
      "description": "Board serial, lowercase hex; null when the device tree has none.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]+$"
    },
    "hostname": {
      "type": [
        "string",
        "null"
      ]
    },
    "os": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "os-release ID"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "description": "os-release VERSION_ID, else VERSION"
        }
      }
    },
    "device_package": {
      "type": "object",
      "required": [
        "version",
        "commit"
      ],
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "bootloader": {
      "description": "Omitted when the bootloader version cannot be read.",
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "update_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "image-write"
      },
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "manage_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "macs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
      }
    },
    "endpoints": {
      "type": "object",
      "description": "Optional live endpoints, paths relative to this document's origin. Atlas uses each one it finds: metrics, logs, actions.",
      "properties": {
        "metrics": {
          "type": "string"
        },
        "logs": {
          "type": "string"
        },
        "actions": {
          "type": "string",
          "description": "POST <actions>/<id> runs action <id>; any 2xx means accepted."
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "description": "Actions the actions endpoint accepts.",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string"
          },
          "destructive": {
            "type": "boolean"
          }
        }
      }
    },
    "camera_stream": {
      "type": "string",
      "description": "Optional camera view: an MJPEG stream or still image, path or URL."
    },
    "diagnostics": {
      "type": "array",
      "description": "Root-only diagnostics the board has, run over SSH (never through this endpoint). \"selftest\": /usr/lib/pd-device/selftest --json prints a self-test report (format 1) and writes it to /run/pd-device/selftest.json.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    }
  }
}
