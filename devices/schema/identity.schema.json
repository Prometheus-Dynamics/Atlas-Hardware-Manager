{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:board:identity:1",
  "title": "Device identity document (contract 1)",
  "description": "Served at GET http://<device>:5899/.well-known/pd-device and written to /run/board/identity.json. Readers must ignore properties they do not know; later contract versions only add properties.",
  "type": "object",
  "required": [
    "contract",
    "model",
    "rev",
    "serial",
    "hostname",
    "os",
    "device_package",
    "update_methods",
    "manage_url",
    "macs"
  ],
  "properties": {
    "contract": {
      "const": 1
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "rev": {
      "type": [
        "string",
        "null"
      ]
    },
    "serial": {
      "description": "Board serial, lowercase hex; null when the device tree has none.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]+$"
    },
    "hostname": {
      "type": [
        "string",
        "null"
      ]
    },
    "os": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "os-release ID"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "description": "os-release VERSION_ID, else VERSION"
        }
      }
    },
    "device_package": {
      "type": "object",
      "required": [
        "version",
        "commit"
      ],
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "bootloader": {
      "description": "Omitted when the bootloader version cannot be read.",
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "update_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "image-write"
      },
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "manage_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "macs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
      }
    },
    "endpoints": {
      "type": "object",
      "description": "Optional live endpoints, paths relative to this document's origin (\":<port>/path\" for another port on the same host). Atlas uses each one it finds: metrics, logs, actions, status, events, stream.",
      "properties": {
        "metrics": {
          "type": "string"
        },
        "logs": {
          "type": "string"
        },
        "actions": {
          "type": "string",
          "description": "POST <actions>/<id> runs action <id>; any 2xx means accepted."
        },
        "status": {
          "type": "string",
          "description": "GET: the board's status JSON (boot, failed units, temperatures, fan, update, clock)."
        },
        "events": {
          "type": "string",
          "description": "GET: the event log, one JSON object per line; ?after_seq=<n> returns only later events."
        },
        "stream": {
          "type": "string",
          "description": "Live event and readings stream. May name another port on the same host (\":5898/stream\")."
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "description": "Actions the actions endpoint accepts.",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string"
          },
          "destructive": {
            "type": "boolean"
          }
        }
      }
    },
    "camera_stream": {
      "type": "string",
      "description": "Optional camera view: an MJPEG stream or still image, path or URL."
    },
    "gadget": {
      "type": "object",
      "description": "Optional: the device's address on its USB gadget network, when the package runs it. addressing says where it came from: serial-hash-v1 (derived from the USB serial, see the manifest's capabilities.gadget-net.addressing), pinned (USB_GADGET_ADDRESS) or fallback (the fixed address, the serial gave none).",
      "required": [
        "address",
        "prefix"
      ],
      "properties": {
        "address": {
          "type": "string",
          "format": "ipv4"
        },
        "prefix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "addressing": {
          "type": "string"
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "description": "Root-only diagnostics the board has, run over SSH (never through this endpoint). \"selftest\": /usr/lib/board/selftest --json prints a self-test report (format 1) and writes it to /run/board/selftest.json.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "camera_streams": {
      "type": "array",
      "description": "Optional camera views, as the image lists them (PhotonVision): each an MJPEG stream, path or URL (\":<port>/path\" for another port on the same host). Supersedes camera_stream.",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "security": {
      "type": "string",
      "enum": [
        "on",
        "off"
      ],
      "description": "The device's security switch. Off: actions are accepted from the USB link without a key."
    },
    "time": {
      "type": "integer",
      "description": "The device's clock (Unix seconds) when it served this document, so a host can tell the clock is wrong (no RTC battery, often no NTP)."
    },
    "usb_route": {
      "type": "object",
      "description": "Optional: the USB link's route onto the device's other networks (usb-route).",
      "required": [
        "enabled",
        "active"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "subnets": {
          "type": "array",
          "description": "The networks routed to the USB link (a.b.c.d/n).",
          "items": {
            "type": "string"
          }
        },
        "addresses": {
          "type": "array",
          "description": "The device's own addresses on them (a.b.c.d/n).",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "update": {
      "type": "object",
      "description": "Optional: the updater's state as it last wrote it (update.json). layout \"slots\" adds the slot fields and the installed slots; the A/B layout has none of them.",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "idle",
            "staging",
            "staged",
            "rebooting",
            "trying",
            "confirmed",
            "rolled-back",
            "cancelled",
            "error"
          ]
        },
        "layout": {
          "type": "string",
          "description": "\"slots\"; absent for the A/B layout."
        },
        "slot_active": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot_staged": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot_default": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot_previous": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot_trial": {
          "type": [
            "string",
            "null"
          ]
        },
        "version_active": {
          "type": [
            "string",
            "null"
          ]
        },
        "version_staged": {
          "type": [
            "string",
            "null"
          ]
        },
        "version_previous": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000,
          "description": "Per mille."
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "Who started it: atlas, orion or local."
        },
        "phase": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "checking",
            "failed",
            null
          ],
          "description": "While trying: null before confirm starts, checking, failed."
        },
        "free_bytes": {
          "type": "integer"
        },
        "reserve_bytes": {
          "type": "integer"
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "family": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "variant": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kernel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "size": {
                "type": "integer"
              },
              "verity": {
                "type": "boolean"
              },
              "intact": {
                "type": "boolean"
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "running",
                    "default",
                    "previous",
                    "trial",
                    "staged"
                  ]
                }
              },
              "pinned": {
                "type": "boolean"
              },
              "good": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "installed": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "RFC 3339, null when unknown."
              },
              "last_boot": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "RFC 3339, null when never booted."
              },
              "display_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "layers": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "failures": {
                "type": "integer",
                "minimum": 0,
                "description": "How many times the slot has failed. A history: it stays after a confirm."
              },
              "failed": {
                "type": "boolean",
                "description": "Failed since its last confirm. boot-once, set-default and rollback refuse such a slot unless forced; a power cut is never a failure."
              },
              "last_failure": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The last failure: its reason, the boot it happened in and when (RFC 3339). Null when it never failed.",
                "required": [
                  "reason",
                  "boot",
                  "time"
                ],
                "properties": {
                  "reason": {
                    "type": "string"
                  },
                  "boot": {
                    "type": "string"
                  },
                  "time": {
                    "type": "string"
                  }
                }
              },
              "last_confirm": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The last confirm: the boot and when (RFC 3339). Null when it never confirmed.",
                "required": [
                  "boot",
                  "time"
                ],
                "properties": {
                  "boot": {
                    "type": "string"
                  },
                  "time": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "keep": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Slots boards: how many slots housekeeping keeps when an update is confirmed (pinned ones don't count; 0: never removes any)."
        }
      }
    }
  }
}
