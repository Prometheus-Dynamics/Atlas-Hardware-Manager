# PENDING (K1): board draft for the CanMV K230D AI-CAM bench slot image. Not a description: it moves to
# devices/boards/canmv-k230d-ai-cam/board.toml when Gaia's riscv64 design lands. app/app.json stays where it is.
# devices/boards/bpi-canmv-k230d-zero is NOT touched (a separate board).
#
# SOURCE NOTE: the SDK on disk has NO AI-CAM (junroc) dts or defconfig (grep for junroc, ai_cam, ai-cam, aicam: no hits,
# /mnt/ssd-samsung/gaia/bsp/k230_linux_sdk). The OTG controller below is the SDK's K230D BPI board dts, the closest
# K230D board on disk. Every value is "from the SDK, unconfirmed until first boot".
version = 1
extends = "../../families/k230/family.toml"
name = "canmv-k230d-ai-cam"
description = "CanMV K230D AI-CAM (K230D, 128 MB, microSD, GC2093 camera)"

[target]
cpu = "xuantie-c908"

# Kernel: mainline v7.3.4 (family). Its device tree is ours: mainline k230.dtsi has CPU, irq, clock, reset, pinctrl and
# UARTs only (Gaia REPORT-mainline.md, 7.3.3; v7.3.4 UNVERIFIED). No K230D board dts is in mainline.
[kernel]
device_tree_dir = "dts"
fragments = ["kernel/bench.fragment"]

# Network: the USB gadget only. The K230 SoC has NO Ethernet MAC (Gaia REPORT-mainline.md; coordinator ruling
# 2026-11-14). Wi-Fi is dropped for now (coordinator ruling 2026-11-14). The gadget is the only network on this board.
#
# Gadget port: the SDK's K230D BPI dts enables usbotg0 (k230d_canmv_bpi.dts:56-58, &usbotg0 status okay), which is
# snps,dwc2 at 0x91500000 with dr_mode "otg" (k230.dtsi:209-216). The controller is usbotg0. The Type-C connector
# that wires it is NOT named by the SDK (no connector in the dts; docs/linux_sdk快速入门指南.md names only the
# debug serial ports). From the SDK, unconfirmed until first boot.
# Lemnos's K230-MAP (pr/K230-MAP 6cf411d5, on pr/BB1b e8472620; NOT pinned) names the port usb-otg0 at
# /soc/usb-otg@91500000, UDC 91500000.usb-otg. Pre-filled in lemnos-board.toml.pending, pending the coordinator's pin.
# UDC name: CONFIRM ON BOARD (Lemnos: not checked on a board).
#
# VBUS (coordinator ruling (a), 2026-11-14): vbus_undriven = true, with a reason. The SDK names no VBUS supply,
# regulator, GPIO or phy-supply for usbotg0 (k230.dtsi:209-216; k230d_canmv_bpi.dts:56-58 sets only status). dr_mode is
# pinned to "peripheral" (assets/usbotg0-peripheral.dtsi), so the controller never drives VBUS. Bench only, unconfirmed.
#
# Power: the supply is not named by the SDK. The Zero's USB-C 5 V 2 A rating is Atlas's B7 record, not this board's.
# From the SDK, unconfirmed until first boot.
#
# DRAM: the SDK's LPDDR4 table, used as it is. CONFIG_DDR_SIZE=0x8000000 = 128 MiB (k230d_canmv_bpi_defconfig:20;
# k230d_canmv_defconfig:20) and CONFIG_SIPLP4_2667 (board/canaan/k230d_canmv/Kconfig:20) selects the 2667 table
# (sip_lpddr4_init_32_swap_2667.c, generated by ddr.sh). The SDK does not name the DRAM part (vendor, part number,
# LPDDR type of the package): the table's name is the only source. From the SDK, unconfirmed until first boot.
#
# Slots: the uboot record, env in the device form (assets/uboot-bench.fragment; values in lemnos-board.toml.pending).

# PAD TABLE (K1, 2026-11-16): PRECONDITION. The SDK's BPI boot chain (arch/riscv/dts/k230d_canmv_bpi.dts:61-171, applied
# pre-relocation, so in SPL) writes ONE iomux table to nearly every pad, including the bank-voltage mode: IO2-63 at 3V3,
# IO0-1 at 1V8 (the defines at dts:27-32). The file warns: "Please pay attention to the bank voltage! will damage the
# chip" (dts:65). That table is the BPI Zero's. Nothing on disk says what the AI-CAM supplies or wires. So the AI-CAM's
# pad table and bank voltages must come from the AI-CAM's own data (its schematic, or the vendor AI-CAM firmware or dts if
# published). They must never be the Zero's table carried over. Until that data exists, no AI-CAM image may be built.
# Unknown pads stay inputs with no output enable (the drop_pins form, k230d.dtsi:51-69), not copied from the Zero.
#
# This [pads] block is read by scripts/check-devices.sh (pads_rule). It is marked as derived from the Zero, so the rule
# refuses any product on this board today. Clear it only with the AI-CAM's own source and bank voltages.
[pads]
source = "SDK BPI Zero table, arch/riscv/dts/k230d_canmv_bpi.dts:61-171 (copied, NOT the AI-CAM's own)"
derived_from_board = "bpi-canmv-k230d-zero"
bank_voltages = {}
