# PENDING (K1): board draft for the CanMV K230D AI-CAM bench slot image. Not a description: it moves to
# devices/boards/canmv-k230d-ai-cam/board.toml when Gaia's riscv64 design lands. The existing app/app.json stays
# where it is. devices/boards/bpi-canmv-k230d-zero is NOT touched (a separate board; its Linux 6.6 ruyisdk
# kernel is a vendor tree, which the mainline rule rejects, so the Zero's own board work is not K1's).
version = 1
extends = "../../families/k230/family.toml"
name = "canmv-k230d-ai-cam"
description = "CanMV K230D AI-CAM (K230D, 128 MB, microSD, GC2093 camera, Wi-Fi)"

[target]
cpu = "xuantie-c908"

# Kernel: mainline v7.3.4 (family). Its device tree is ours: mainline k230.dtsi has CPU, irq, clock, reset, pinctrl and
# UARTs only (Gaia REPORT-mainline.md, 7.3.3; v7.3.4 UNVERIFIED). Our dts adds the nodes below. No K230D board dts is in mainline.
[kernel]
device_tree_dir = "dts"
fragments = ["kernel/bench.fragment"]

# The bench image's network (the user's ruling, 2026-11-14: Ethernet stays in every image, plus the USB gadget on the
# OTG port). The K230 SoC has NO Ethernet MAC (Gaia REPORT-mainline.md: "the SoC has no MAC"; Lemnos survey). So a
# bench K230D has the USB gadget and Wi-Fi only. Gap, not a choice of K1: see docs/prs/K1-k230d.md.
#
# Gadget: the K230D USB2 OTG Type-C (the user's answer, 2026-11-14), ID-driven and OFF by default. Which connector
# and how it is powered are STILL OPEN (see the report). The dwc2 OTG node is not in Lemnos's socs/k230.toml yet;
# Lemnos is adding it in a small PR. Keep the gadget entry pending until that rev.
#
# Slots: the uboot record, env in the fixed device form (assets/uboot-bench.fragment).
#
# Power: the supply is not sourced. The Zero's USB-C 5 V 2 A rating is B7's record, not this board's.
# UNVERIFIED for AI-CAM. Needed before any power-on test.
