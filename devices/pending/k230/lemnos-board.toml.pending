# PENDING (K1): Lemnos board file draft for canmv-k230d-ai-cam (slot form). NOT named in [descriptions] and not
# installed by any product. The dwc2 gadget row and the SD host row are pending Lemnos's K230-MAP rev (Lemnos
# worker on pr/BB1b; coordinator 2026-11-14). Keys follow docs/boards.md "U-Boot environment" on pr/BB1b and the
# model testing/boards/rk3566-slots.toml (Lemnos pr/BB1b).
format = "lemnos.board"
schema_version = 1

[board]
id = "canmv-k230d-ai-cam"        # = Gaia board name = devices/boards/<dir>
soc = "k230"                     # Lemnos socs/k230.toml (K230D shares the map)
form = "fragment"

# Watchdog: socs/k230.toml watchdog0 at /soc/wdt0@91106000, snps,dw-wdt. lemnosd keeps it fed.
[[hardware]]
controller = "watchdog0"

[[devices]]
id = "watchdog"
driver = "hw-watchdog"
uses = { watchdog = "watchdog:/soc/wdt0@91106000" }

# Slots, the uboot record (BB1b). Values from the SDK on disk, all cited in docs/prs/K1-k230d.md:
#   uboot_env_size          0x10000  U-Boot CONFIG_ENV_SIZE (k230d_canmv_bpi_defconfig:5); mkenvimage -s 0x10000 (post-image.sh:234)
#   uboot_env_offset        0x1E0000 CONFIG_ENV_OFFSET (k230d_canmv_bpi_defconfig:6); genimage.cfg:30 (uboot_env, 0x20000 region)
#   uboot_env_offset_redund 0x380000 genimage.cfg:43 (partition env, copy 1)
#   uboot_env_mmc_index     1        the SD card is U-Boot's mmc1 = SYSCTL_BOOT_SDIO1 (k230_spl.c:65, 167), mmc1@91581000
#                                    (k230.dtsi:161); no mmc aliases in k230.dtsi, so the index is the probe order
#   uboot_env_device        /dev/mmcblk0  Linux name of the SD disk. UNVERIFIED: from Atlas's B7 AI-CAM dts draft
#                                    (alias mmc0 = SD, bootargs root=/dev/mmcblk0p2); no Linux dts for this board is on disk.
#   uboot_watchdog_ms       10000    see the reason in docs/prs/K1-k230d.md (the SDK's dw-wdt clock is not on disk)
# The uboot_usb_vendor/product pair is the pid.codes test pair, a placeholder Lemnos says to replace before release.
[[devices]]
id = "slots"
driver = "system-slots"
record = "uboot"
config = { data = "/data", boot = "/boot", record = "uboot", boot_args = "os", boot_sources = ["/soc/mmc1@91581000=/soc/mmc1@91581000"], uboot_env_size = 0x10000, uboot_env_device = "/dev/mmcblk0", uboot_env_offset = 0x1E0000, uboot_env_offset_redund = 0x380000, uboot_env_mmc_index = 1, uboot_usb_vendor = 0x1209, uboot_usb_product = 0x0001, uboot_watchdog_ms = 10000 }

# Not written here, open in docs/prs/K1-k230d.md:
#   - the dwc2 OTG device row (usbotg0, snps,dwc2 at 0x91500000, k230.dtsi:209): pending Lemnos's map rev;
#   - the SD host row (mmc1, k230.dtsi:161): pending the same rev;
#   - boot_sources: the node form is a guess from the model's placeholder "<mmc node>=<mmc node>", UNVERIFIED;
#   - the crash log / pstore reserved region: a board kernel item (kernel/bench.fragment and the dts), address not chosen;
#   - Ethernet: none, the SoC has no MAC (coordinator ruling 2026-11-14); the gadget is the only network.
