# PENDING (K1): Lemnos board file draft for canmv-k230d-ai-cam (slot form). NOT named in [descriptions], not installed
# by any product, and NOT pinned: the rows below cite Lemnos's K230-MAP, pr/K230-MAP 6cf411d5 (one commit on pr/BB1b
# e8472620), which the coordinator has not pinned. Keys follow docs/boards.md "U-Boot environment" on pr/BB1b and the
# model testing/boards/rk3566-slots.toml. The generator refuses this file until the VBUS statement below is decided.
format = "lemnos.board"
schema_version = 1

[board]
id = "canmv-k230d-ai-cam"        # = Gaia board name = devices/boards/<dir>
soc = "k230"                     # Lemnos socs/k230.toml (K230D shares the map)
form = "fragment"

# Watchdog: socs/k230.toml watchdog0 at /soc/wdt0@91106000, snps,dw-wdt. lemnosd keeps it fed.
[[hardware]]
controller = "watchdog0"

[[devices]]
id = "watchdog"
driver = "hw-watchdog"
uses = { watchdog = "watchdog:/soc/wdt0@91106000" }

# The OTG device port (controller usb-otg0 in socs/k230.toml at 6cf411d5: usb-peripheral, /soc/usb-otg@91500000,
# UDC 91500000.usb-otg). The UDC name is the SDK's platform device name, UNCONFIRMED on a board (Lemnos: "not checked on a board").
[[hardware]]
name = "udc:91500000.usb-otg"
controller = "usb-otg0"
role = "peripheral"
vbus_undriven = true
vbus_reason = "bench only, unconfirmed on the board. The SDK names no VBUS supply for usbotg0: k230.dtsi:209-216 has no vbus-supply, phy-supply or gpio, and the BPI dts (k230d_canmv_bpi.dts:56-58) only sets status. dr_mode is pinned to peripheral (assets/usbotg0-peripheral.dtsi), so the controller never enters host mode or drives VBUS. CONFIRM ON BOARD: the host side supplies VBUS, and the port detects it without a vbus gpio."

[[devices]]
id = "gadget"
driver = "usb-gadget"
uses = { function = "udc:91500000.usb-otg" }

# Slots, the uboot record (BB1b). Values from the SDK on disk, all cited in docs/prs/K1-k230d.md:
#   uboot_env_size          0x2000   CONFIG_ENV_SIZE, vendor AI-CAM (k230d_canmv_junroc_ai_cam_defconfig:4); mkenvimage -s 0x2000 (vendor post-image.sh:17). The BPI's 0x10000 is superseded.
#   uboot_env_offset        0x300000 = CONFIG_ENV_OFFSET, vendor AI-CAM (junroc defconfig:6); vendor genimage env_a at 3M (the primary copy). BPI 0x1E0000 superseded.
#   uboot_env_offset_redund 0x320000 vendor genimage env_b (the second copy). The vendor defconfig has NO ENV_REDUNDANT: a decision for Lemnos's record.
#   uboot_env_mmc_index     1        SD = mmc1 (SYSCTL_BOOT_SDIO1, k230_spl.c:65, 167). Pinned by the alias mmc1 in the
#                                    U-Boot dts and the kernel dts (assets/mmc-aliases.dtsi). CONFIRM ON BOARD.
#   uboot_env_device        /dev/mmcblk0  (the kernel alias mmc0 = the SD host; Gaia pins it): the vendor U-Boot bootargs say root=/dev/mmcblk1p2 (board.c, fdt_chosen_bootargs) but the vendor Linux dts aliases mmc0 = the SD (mmc_sd1), so Linux names it mmcblk0 (patch 0024). CONFIRM ON BOARD before the first Lemnos write:
#                                    a wrong device makes Lemnos refuse ("no valid environment"), it never writes blindly.
#   uboot_watchdog_ms       10000    see docs/prs/K1-k230d.md (the SDK's dw-wdt clock is not on disk)
# The uboot_usb_vendor/product pair is the pid.codes test pair, a placeholder Lemnos says to replace before release.
# boot_sources is "<U-Boot DT path>=<kernel DT path>" (Lemnos docs/slots.md, "The boot source"). The left side is the
# SD host's path in the SDK U-Boot dt: /soc/mmc1@91581000 (k230.dtsi:60 soc {, :161 mmc1@91581000, closed :277).
# The right side is the kernel path, sdhci1@91581000, which the kernel dts names (Lemnos's map, 6cf411d5). The MMC
# hosts are not map rows (by design).
[[devices]]
id = "slots"
driver = "system-slots"
record = "uboot"
config = { data = "/data", boot = "/boot", record = "uboot", boot_args = "os", boot_sources = ["/soc/mmc1@91581000=/soc/sdhci1@91581000"], uboot_env_size = 0x2000, uboot_env_device = "/dev/mmcblk0", uboot_env_offset = 0x300000, uboot_env_offset_redund = 0x320000, uboot_env_mmc_index = 1, uboot_usb_vendor = 0x1209, uboot_usb_product = 0x0001, uboot_watchdog_ms = 10000 }

# Not written here: Ethernet (none, the SoC has no MAC; coordinator ruling 2026-11-14); the crash log / pstore reserved
# region (a board kernel item, address not chosen).
