# DEV ONLY (bring-up). The ZERO 3E's gadget network: one ECM function (usb0).
# Why each line:
# - Address 10.55.0.1/24: dev's host-side address, kept because the bench host's
#   notes use it. It is data for the bring-up, not a design (decision 5: Lemnos
#   builds the gadget from the board file later).
# - DHCPServer: hands the host 10.55.0.2, which dev's udhcpd did; networkd does it
#   now, so BusyBox's udhcpd is not carried.
[Match]
Name=usb0

[Network]
Address=10.55.0.1/24
DHCPServer=yes

[DHCPServer]
# UNVERIFIED on the board: PoolOffset counted from the network address, so 2 is
# 10.55.0.2. Check when the board runs.
PoolOffset=2
PoolSize=1
