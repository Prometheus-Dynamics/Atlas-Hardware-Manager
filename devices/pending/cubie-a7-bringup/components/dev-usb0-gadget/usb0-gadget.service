# DEV ONLY (bring-up). systemd-networkd configures usb0 when the gadget binds.
# This unit reconfigures usb0 once the kernel has created it, so 10-usb0.network
# applies even when the gadget appears after networkd started.
[Unit]
Description=DEV ONLY: reconfigure usb0 when the gadget appears
BindsTo=sys-subsystem-net-devices-usb0.device
After=sys-subsystem-net-devices-usb0.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/networkctl reconfigure usb0

[Install]
WantedBy=multi-user.target
