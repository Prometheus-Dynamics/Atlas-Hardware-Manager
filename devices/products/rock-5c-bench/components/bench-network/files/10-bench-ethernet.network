# The bench's Ethernet (a second path to the board, beside the USB gadget): matched by type, as the bring-up's network is.
# Buildroot's own eth0.network (BR2_SYSTEM_DHCP="eth0", base os.fragment) matches Name=eth0, and with predictable names the GMAC
# is normally end0, so that file does not match; this one does. Name=!usb0 !lemnos0 keeps it off the gadget interfaces: usb0 (the
# gadget's, if present) and lemnos0 (the Lemnos gadget's NCM, addressed by lemnos0-address) are both type ether.
# MulticastDNS=yes: the board answers for its hostname here too.
[Match]
Type=ether
Name=!usb0 !lemnos0

[Network]
DHCP=yes
MulticastDNS=yes
