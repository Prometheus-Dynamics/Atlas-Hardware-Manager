# Cubie A7S bring-up OS: DEV ONLY (this directory is the one place a dev-only unit is allowed).
# Candidate, unverified, never booted. Each line says why it is here (standing rule).
# Toolchain: Buildroot's bootlin aarch64 glibc (the one known-good toolchain Gaia has built with).
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y

# Init: systemd, the RK35xx and A733 standard (decision 3). Systemd 254 or newer is required by
# Lemnos and Orion units; Buildroot 2026.02.3 ships systemd 258.7 (checked in the ZERO 3E base).
# No RuntimeWatchdogSec or ShutdownWatchdogSec: lemnosd (not on this bring-up) feeds the watchdog.
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD=y
# systemd-networkd: configures eth0 (DHCP) and the bring-up usb0 link.
BR2_PACKAGE_SYSTEMD_NETWORKD=y
# Ethernet: eth0 by DHCP through networkd. Reason: the Gigabit port is how the board is reached.
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_HOSTNAME="cubie-a7s"
# BusyBox: /bin/sh and the core utilities; systemd is the init.
BR2_PACKAGE_BUSYBOX=y

# SSH server for the bench key: the only way in until Orion serves SSH on the board.
BR2_PACKAGE_DROPBEAR=y

# Host build tools for the kernel and U-Boot (not on the board). Kept because Gaia's sunxi U-Boot
# and kernel builds need them; the list is the ZERO 3E base's, minus the Rockchip-only lines.
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_PYTHON3=y
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_NEEDS_UTIL_LINUX=y
BR2_PACKAGE_HOST_DTC=y
# No BR2_TARGET_UBOOT_FORMAT_CUSTOM and no ATF BL31 ELF lines: the A733 chain is the SPL that
# carries the DRAM blob and its own BL31 (TF-A, built from source), in one u-boot-sunxi-with-spl.bin.

# Serial console (B19, decided): kept configured although no adapter is attached. Its login policy is the
# base's default (security OFF: root logs in on the console with no password, the bench rule; the zero-3e
# bring-up does the same). The getty is on ttyS0, the kernel's console (extlinux.conf). Without these lines
# systemd's generator still starts serial-getty@ttyS0, but with root login off nobody could log in on it.
BR2_TARGET_ENABLE_ROOT_LOGIN=y
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP=y
# SSH host key (B13): on the data partition, through components/dev-bringup-hostkey (product.toml).
# SSH login: dropbear runs with -s from components/dev-bench-ssh-key/dropbear.default (B19 closes the B13 open
# point: key only, no password logins over SSH; the console is the separate login above).

# Kernel image and device trees under /boot in the root partition (B22, Gaia F11): the kernel is its own build
# now, and Gaia puts its image and device trees under /boot only when this fragment line is set (as Gaia's
# zero-3e-demo does). Without it the bootable root has modules and no /boot/Image for extlinux to load.
BR2_LINUX_KERNEL_INSTALL_TARGET=y
