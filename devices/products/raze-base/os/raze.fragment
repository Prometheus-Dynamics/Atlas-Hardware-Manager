# The Raze OS's Buildroot options (the `os` of raze-base). Buildroot options only. Each line says why.
# Kernel decisions are in boards/raze/kernel/; the firmware pin is in families/bcm2712/family.toml.
# F8? the Buildroot source and its fragment form are the OS's spelling; untested.

# 4 KiB pages (also in the kernel fragment; Buildroot forces it after fragments).
BR2_ARM64_PAGE_SIZE_4K=y

# systemd 258.7 in Buildroot 2026.08: Lemnos's lemnosd unit needs 254+, and the Raze runs systemd
# (the board's one init; the RK35xx and A733 boards too).
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD=y

# The Pi firmware (1.20260915 at 6f0881cb…, the family's pin): the boot ROM's files, start4.elf and
# the rest, so the Pi boots. Its overlay set is what config.txt's dtoverlay= loads from:
#   bcm2712d0  the firmware applies it itself on D0 silicon (without it the kernel faults in pinctrl)
#   vc4-kms-v3d-pi5  the GPU (the product's choice; HeliOS wants it)
#   ramoops-pi5      crash logs (the product's choice; raze-device.txt)
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
BR2_PACKAGE_RPI_FIRMWARE_DTB_OVERLAYS="bcm2712d0 vc4-kms-v3d-pi5 ramoops-pi5"
