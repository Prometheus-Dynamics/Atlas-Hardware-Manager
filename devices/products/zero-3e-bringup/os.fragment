# Radxa ZERO 3E bring-up only, on top of zero-3e-base's os.fragment (the base is
# listed first in the product). DEV ONLY: the one place a dev-only unit is
# allowed; the base stays clean. Every line says why it is here.

# SSH server for the bench key: the way in until Orion serves SSH on the board.
# dropbear.service is enabled by dev-bench-ssh-key's [[services]] entry.
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_SMALL=y
# The board serves only; it needs no ssh client.
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
# The base has no DNS (resolved is off), and dropbear's reverse-DNS lookup on
# connect stalls until the lookup times out (Buildroot's help for this option).
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y

# Serial console: a login on the debug UART, bring-up only. The ZERO 3E's
# extlinux.conf names console=ttyS2,1500000.
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS2"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP=y
# Kernel console (B13): the same tty as the getty above (extlinux's console=ttyS2; the base's decision applies).
# Nothing masked.

# Root's SSH way in is the key alone: dev-bench-ssh-key sets dropbear's -s (no
# password logins). The base's console login is its own policy (see the base).
# Root is read-only, as in the base, so the bring-up proves the same root.
# SSH host key (B13): on the data partition, not in /run. components/dev-bringup-hostkey mounts /data and
# gives dropbear -r /data/dropbear/dropbear_ed25519_host_key, so the key survives a reflash and a slot change.
# usb0 (PR B24): the usb-gadget-network component serves DHCP on usb0 with BusyBox's udhcpd, its
# one DHCP server. systemd-networkd's DHCPServer on usb0 (B11) is gone with dev-usb0-gadget. The
# lease file is in /tmp (the root is read-only; B11's first boot had no udhcpd applet, see busybox.fragment).
# BusyBox applets for the usb-gadget-network component (PR B24): the script's udhcpd (the one DHCP server
# on usb0), ifconfig, killall, sha256sum and mountpoint. The fragment is beside this file.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="@here@/busybox.fragment"


# B31: Buildroot's name-based eth0.network is off (it matches Name=eth0; the GMAC is normally end0). The bring-up network is components/bringup-network (Type=ether, usb0 excluded). This line comes after the base fragment, so it wins.
BR2_SYSTEM_DHCP=""
