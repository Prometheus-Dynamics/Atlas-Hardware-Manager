# The fixture's kernel fragment (good-sd-image only). A slot's root is opened before any module can load, so the
# chain is built in, and the zstd erofs root (the sd-image recipe's default) needs its decompressor. Same lines
# as the real families' fragments (scripts/check-devices.sh SLOT_CHAIN and erofs_rule). Not a device.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_BUFIO=y
CONFIG_DM_VERITY=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_LZMA_DEFAULT_MAX_STREAMS=4
CONFIG_EXT4_FS=y
CONFIG_CRYPTO_SHA256=y
CONFIG_MMC_BLOCK=y
