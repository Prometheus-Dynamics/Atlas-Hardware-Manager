#!/bin/sh
# reboot-locked <command> [args...]: a restart that waits for the board's
# lock first and holds it until the shutdown ends this process.
# reboot-locked --holder: who holds the lock ("pid <n> (<command>)"), or
# nothing when it is free.
#
# The lock (BOARD_REBOOT_LOCK, /run/lock/raze-gpu.lock) is what the bench's
# measurements hold while they run, so a restart asked for during one (an
# update's trial, a slot booted once, a reboot over Orion or the USB link)
# waits for it to finish instead of cutting it, and says whose lock it
# waits for. Holding the lock until the end keeps the next measurement from
# starting on a board that is going down.
# BOARD_REBOOT_LOCK_WAIT: seconds to wait (0, the default: as long as it
# takes). Past it the restart is refused (exit 3), or, with
# BOARD_REBOOT_LOCK_OVERRIDE=1 (the restarts that recover the board), goes
# anyway, logged with the holder. BOARD_REBOOT_LOCK_HOLD: seconds to keep
# the lock after the command (600). A holder that asks for the restart
# itself (an install under the lock) creates <lock>.reboot-ok first: the
# restart then goes ahead under the holder's lock instead of waiting for
# itself. With no flock, or BOARD_REBOOT_LOCK empty, the command just runs.
# While it waits, its line is also in BOARD_REBOOT_WAIT_FILE
# (/run/board/reboot-wait, next to the writer's update.json), which HeliOS
# reports as its update status's `reboot_waiting`; the file goes once the
# wait ends, whichever way.
set -u

LOCK=${BOARD_REBOOT_LOCK-/run/lock/raze-gpu.lock}
WAIT=${BOARD_REBOOT_LOCK_WAIT:-0}
WAIT_FILE=${BOARD_REBOOT_WAIT_FILE-${BOARD_RUN_DIR:-/run/board}/reboot-wait}

# The lock's holder from /proc/locks (whoever took it, by any tool).
holder() {
	[ -n "$LOCK" ] && [ -e "$LOCK" ] || return 0
	_ino=$(ls -i "$LOCK" 2>/dev/null | awk '{print $1}')
	[ -n "$_ino" ] || return 0
	_pid=$(awk -v ino="$_ino" '$2 != "->" && $6 ~ (":" ino "$") { print $5 }' /proc/locks 2>/dev/null |
		while read -r _p; do [ "$_p" = "$$" ] || { echo "$_p"; break; }; done)
	[ -n "$_pid" ] || return 0
	_cmd=$( (tr '\0' ' ' < "/proc/$_pid/cmdline") 2>/dev/null | cut -c1-120)
	if [ -z "$_cmd" ]; then
		# The usual holder (`exec 9>> lock; flock 9`) took the lock through a
		# flock process that has exited (its pid gone, or showing no command:
		# a zombie, or reused): the lock stays with the process sharing its
		# fd. Name that one (not this script or its subshells).
		_fd=$(fd_holder)
		[ -z "$_fd" ] || _pid=$_fd
		_cmd=$( (tr '\0' ' ' < "/proc/$_pid/cmdline") 2>/dev/null | cut -c1-120)
	fi
	# (A pid from another pid namespace has no /proc entry here.)
	_cmd=${_cmd% }
	echo "pid $_pid${_cmd:+ ($_cmd)}"
}
# Whether pid $1 can't be the holder: this script or a descendant (its
# subshells, at any depth: dash forks more of them than bash, and their
# children), or gone while we looked (our own short-lived helpers, whose
# pids can sort before the holder's).
not_holder() {
	_a=$1
	while [ "$_a" -gt 1 ] 2>/dev/null; do
		[ "$_a" = "$$" ] && return 0
		_a=$(awk '/^PPid:/ { print $2 }' "/proc/$_a/status" 2>/dev/null)
		[ -n "$_a" ] || return 0
	done
	return 1
}
# The first process with the lock file open, leaving out this script, its
# subshells and their children.
fd_holder() {
	# One ls and one awk for every fd on the board: a readlink per fd took
	# minutes on a busy machine.
	ls -l /proc/[0-9]*/fd/ 2>/dev/null | awk -v lock="$LOCK" '
		/^\/proc\/[0-9]+\/fd\/?:$/ { split($0, part, "/"); pid = part[3]; next }
		pid != "" && $NF == lock && $(NF - 1) == "->" { print pid }' | uniq |
		while read -r _p; do
			not_holder "$_p" && continue
			echo "$_p"
			break
		done
}
say() {
	echo "reboot-locked: $*" >&2
	logger -t board-reboot "$*" 2>/dev/null || true
}

case ${1:-} in
--holder)
	holder
	exit 0
	;;
'')
	sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' >&2
	exit 2
	;;
esac

if [ -n "$LOCK" ] && command -v flock >/dev/null 2>&1 && exec 9>> "$LOCK" && ! flock -n 9; then
	_by=$(holder)
	if [ -e "$LOCK.reboot-ok" ]; then
		rm -f "$LOCK.reboot-ok"
		say "restart asked for by the holder of ${LOCK##*/}, ${_by:-gone}: $*"
	else
		say "waiting for ${LOCK##*/} held by ${_by:-an unknown process} before the restart: $*"
		if [ -n "$WAIT_FILE" ]; then
			mkdir -p "${WAIT_FILE%/*}" 2>/dev/null
			echo "waiting for ${LOCK##*/} held by ${_by:-an unknown process} before the restart" > "$WAIT_FILE.$$" 2>/dev/null &&
				mv -f "$WAIT_FILE.$$" "$WAIT_FILE" 2>/dev/null
			trap 'rm -f "$WAIT_FILE"' EXIT
		fi
		if [ "$WAIT" -gt 0 ] 2>/dev/null; then
			if ! flock -w "$WAIT" 9; then
				if [ "${BOARD_REBOOT_LOCK_OVERRIDE:-0}" = 1 ]; then
					say "overriding ${LOCK##*/}, still held after ${WAIT}s by $(holder): this restart recovers the board"
				else
					say "${LOCK##*/} still held after ${WAIT}s by $(holder); not restarting"
					exit 3
				fi
			fi
		else
			flock 9
		fi
		[ -z "$WAIT_FILE" ] || rm -f "$WAIT_FILE"
	fi
fi
"$@" || exit
# Accepted: keep the lock (fd 9) until the shutdown stops this process.
exec sleep "${BOARD_REBOOT_LOCK_HOLD:-600}"
