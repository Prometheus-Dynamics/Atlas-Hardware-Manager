#!/bin/sh
# Apply the device default hostname (raze-{serial8}) as the transient hostname,
# only when the static hostname is unset or a stock default. An OS or user
# choice in /etc/hostname always wins, and nothing is written to /etc.
# Settings: hostname.env (BOARD_HOSTNAME_POLICY, BOARD_HOSTNAME_PATTERN, BOARD_HOSTNAME_STOCK).
set -eu

BOARD_LIB_DIR=${BOARD_LIB_DIR:-/usr/lib/board}
# shellcheck source=lib.sh
. "$BOARD_LIB_DIR/lib.sh"

BOARD_STATIC_HOSTNAME_FILE=${BOARD_STATIC_HOSTNAME_FILE:-/etc/hostname}

board_load_env hostname.env

case "${BOARD_HOSTNAME_POLICY:-if-stock}" in
never)
	exit 0
	;;
if-stock) ;;
*)
	board_log "unknown BOARD_HOSTNAME_POLICY '${BOARD_HOSTNAME_POLICY}', leaving the hostname alone"
	exit 0
	;;
esac

static=$(board_first_line "$BOARD_STATIC_HOSTNAME_FILE" | tr -d '[:space:]')
if [ -n "$static" ]; then
	stock=0
	for name in ${BOARD_HOSTNAME_STOCK:-}; do
		if [ "$static" = "$name" ]; then
			stock=1
			break
		fi
	done
	if [ "$stock" = 0 ]; then
		exit 0
	fi
fi

serial8=$(board_serial8)
serial=$(board_serial)
[ -n "$serial" ] || serial=$serial8
if [ -z "$serial8" ]; then
	board_log "no board serial or machine id; leaving the hostname alone"
	exit 0
fi

pattern=${BOARD_HOSTNAME_PATTERN:-}
[ -n "$pattern" ] || pattern='raze-{serial8}'
name=$(printf '%s' "$pattern" |
	sed -e "s/{serial8}/$serial8/g" -e "s/{serial}/$serial/g" |
	tr 'A-Z' 'a-z' | tr -c 'a-z0-9-' '-' | cut -c1-63)
name=${name%-}
if [ -z "$name" ]; then
	exit 0
fi

current=$(board_hostname)
if [ "$current" = "$name" ]; then
	exit 0
fi
if printf '%s' "$name" > "$BOARD_HOSTNAME_PROC"; then
	board_log "hostname set to $name (static hostname: ${static:-unset})"
else
	board_log "could not set the hostname to $name"
fi
