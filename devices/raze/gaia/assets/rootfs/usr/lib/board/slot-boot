# shellcheck shell=sh
# slot-boot: which slots' boot files are on the boot FAT (sourced by slots).
#
# The FAT holds the boot files of the resident slots only: the running,
# default, previous and trial slots (and the default's again at the FAT's root,
# root_copy). Every installed slot's boot files are kept on /data:
#
#   /data/slots/<id>.boot          sha256sum lines: "<sha256>  <path>" for each
#                                  file of the slot's FAT dir (slot.json and the
#                                  slot's cmdline.txt included)
#   /data/slots/bootfiles/<sha256> the files themselves, stored by content, so
#                                  slots sharing a kernel, dtbs or overlays
#                                  keep one copy
#
# A slot's dir goes onto the FAT (boot_stage) before default.txt or trial.txt
# names it, and other slots' dirs come off (boot_evict) only after the
# pointers that named them are written. With power lost at any point, the
# FAT has either the old pointers and their dirs, or the new ones and a
# checked dir. slot-init's own fallback (trial.txt -> the previous slot)
# copies nothing: the previous slot is resident. A slot whose dir is on the
# FAT but not on /data (installed before this, or by a Gaia image) is copied
# to /data first (boot_migrate), never removed without it.
#
# The interface, used by slots:
#   boot_put <id> <dir>   keep <dir> (the slot's FAT dir as built) on /data
#   boot_stage <id> [--replace]
#                         its dir on the FAT, checked (refuses when it
#                         doesn't fit); --replace: over the one there
#   boot_evict [<id>..]   dirs of non-resident slots (and the given ids are
#                         kept too) off the FAT; half-written ones and those
#                         of slots no longer installed too
#   boot_drop <id>        its files off /data (a removed slot)
#   boot_migrate          FAT dirs with no copy on /data get one
# It needs from slots: $IMAGES, $BOOT and mount_boot, boot_sync, $SYNC,
# installed, running, valid_id, refuse, die and the pointers ($DEFAULT,
# $PREVIOUS, $TRIAL).

BOOT_STORE=$IMAGES/bootfiles

boot_manifest() { printf '%s/%s.boot\n' "$IMAGES" "$1"; }
boot_kept() { [ -r "$(boot_manifest "$1")" ]; }

# boot_put <id> <dir>
boot_put() {
	mkdir -p "$BOOT_STORE"
	_bm=$(boot_manifest "$1")
	(cd "$2" && find . -type f | sed 's|^\./||' | sort | while IFS= read -r _bf; do
		sha256sum "$_bf"
	done) > "$_bm.tmp" || die "can't read the slot's boot files"
	while read -r _bsha _bf; do
		[ -e "$BOOT_STORE/$_bsha" ] && continue
		cp "$2/$_bf" "$BOOT_STORE/.$_bsha.tmp" || die "can't keep the slot's boot files on /data"
		mv -f "$BOOT_STORE/.$_bsha.tmp" "$BOOT_STORE/$_bsha"
	done < "$_bm.tmp"
	$SYNC
	mv -f "$_bm.tmp" "$_bm"
	$SYNC
}

# The slots whose dirs stay on the FAT.
boot_resident() {
	for _br in "$(running)" "$DEFAULT" "$PREVIOUS" "$TRIAL"; do
		[ -z "$_br" ] || echo "$_br"
	done
}

# boot_stage <id> [--replace]
boot_stage() {
	mount_boot
	[ ! -d "$BOOT/slots/$1" ] || [ "${2:-}" = --replace ] || return 0
	boot_kept "$1" || refuse "slot $1 has no boot files"
	_bm=$(boot_manifest "$1")
	_need_kb=1024
	while read -r _bsha _bf; do
		[ -r "$BOOT_STORE/$_bsha" ] || refuse "slot $1's boot file $_bf is missing on /data"
		_need_kb=$((_need_kb + ($(board_file_size "$BOOT_STORE/$_bsha") + 1023) / 1024))
	done < "$_bm"
	_fat_kb=${SLOTS_BOOT_FREE_KB:-$(df -kP "$BOOT" 2>/dev/null | awk 'NR == 2 { print $4 }')}
	[ "${_fat_kb:-0}" -ge "$_need_kb" ] || refuse "no room on the boot partition for slot $1's boot files: they need $((_need_kb / 1024)) MiB, it has $((${_fat_kb:-0} / 1024)) MiB free"
	_bn=$BOOT/slots/.$1.new
	rm -rf "$_bn"
	mkdir -p "$_bn"
	while read -r _bsha _bf; do
		case $_bf in */*) mkdir -p "$_bn/${_bf%/*}" ;; esac
		cp "$BOOT_STORE/$_bsha" "$_bn/$_bf" || die "can't write slot $1's boot files"
	done < "$_bm"
	boot_sync
	(cd "$_bn" && sha256sum -c "$_bm" > /dev/null 2>&1) || { rm -rf "$_bn"; die "slot $1's boot files didn't read back as written"; }
	rm -rf "$BOOT/slots/$1"
	mv "$_bn" "$BOOT/slots/$1" || die "can't put slot $1's boot files in place"
	boot_sync
}

# boot_migrate: a FAT dir of an installed slot with no copy on /data.
boot_migrate() {
	mount_boot
	[ -d "$BOOT/slots" ] || return 0
	for _bd in "$BOOT/slots"/*; do
		[ -d "$_bd" ] || continue
		_bi=${_bd##*/}
		valid_id "$_bi" && installed "$_bi" || continue
		boot_kept "$_bi" || boot_put "$_bi" "$_bd"
	done
}

# boot_evict [<id>..]
boot_evict() {
	mount_boot
	[ -d "$BOOT/slots" ] || return 0
	boot_migrate
	_bkeep=" $(boot_resident | tr '\n' ' ') $* "
	_bgone=0
	for _bd in "$BOOT/slots"/* "$BOOT/slots"/.*.new; do
		[ -d "$_bd" ] || continue
		_bi=${_bd##*/}
		case $_bkeep in *" $_bi "*) continue ;; esac
		# An installed slot is only taken off with its copy on /data.
		if valid_id "$_bi" && installed "$_bi" && ! boot_kept "$_bi"; then continue; fi
		rm -rf "$_bd"
		_bgone=$((_bgone + 1))
	done
	[ "$_bgone" = 0 ] || boot_sync
}

# boot_drop <id>, then the files no slot lists any more.
boot_drop() {
	rm -f "$(boot_manifest "$1")"
	[ -d "$BOOT_STORE" ] || return 0
	_bkeep=$(cat "$IMAGES"/*.boot 2>/dev/null | awk '{ print $1 }' | sort -u)
	for _bf in "$BOOT_STORE"/*; do
		[ -e "$_bf" ] || continue
		printf '%s\n' "$_bkeep" | grep -qx "${_bf##*/}" || rm -f "$_bf"
	done
	rm -f "$BOOT_STORE"/.*.tmp 2>/dev/null || true
}
