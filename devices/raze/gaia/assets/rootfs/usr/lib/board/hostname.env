# Defaults for board-hostname.service. Override any of these in
# /etc/board/hostname.env.
#
# The device hostname is only a default. It is applied as the transient
# (kernel) hostname, never written to /etc/hostname, and only when the static
# hostname is unset or one of BOARD_HOSTNAME_STOCK. An OS that wants the device
# name over its own default adds that name to the list, for example:
#   BOARD_HOSTNAME_STOCK="$BOARD_HOSTNAME_STOCK photonvision"

# if-stock: apply when the static hostname is unset or stock. never: do nothing.
BOARD_HOSTNAME_POLICY=if-stock
# {serial8}: last 8 hex digits of the board serial; {serial}: all of it.
BOARD_HOSTNAME_PATTERN=raze-{serial8}
BOARD_HOSTNAME_STOCK="localhost localhost.localdomain buildroot (none)"
