#!/bin/sh
# One HTTP/1.0 exchange on stdin/stdout, started per connection by
# board-http.socket (Accept=yes). Unauthenticated:
#   GET|HEAD /.well-known/pd-device  -> 200, the identity JSON
#   GET|HEAD /status                 -> 200, `status --json` (read-only: the
#                                       drift part is root's kept result)
#   GET|HEAD /events?since=<t>&limit=<n>
#                                    -> 200, the event log (lib.sh
#                                       board_events_json): events with
#                                       t >= since (default 0), the newest
#                                       limit (default 200, at most 2000);
#   GET|HEAD /events?after_seq=<n>&limit=<n>
#                                    -> 200, the oldest limit events whose
#                                       seq is above n, in seq order (to
#                                       catch up whatever the clock did);
#                                       both forms give the newest seq;
#                                       400 unless the values are whole
#                                       numbers
#   POST /actions/<id>               -> 202 when <id> is in BOARD_ACTIONS: drops
#                                       /run/board/requests/<id>, which a
#                                       root path unit acts on; 404 otherwise
#   other methods on those paths     -> 405
#   anything else                    -> 404
set -u

BOARD_LIB_DIR=${BOARD_LIB_DIR:-/usr/lib/board}
# shellcheck source=lib.sh
. "$BOARD_LIB_DIR/lib.sh"

CR=$(printf '\r')

respond() {
	# respond <status line> <content type> <body> [extra header line]
	_len=$(printf '%s' "$3" | wc -c | tr -d ' ')
	printf 'HTTP/1.0 %s\r\n' "$1"
	printf 'Content-Type: %s\r\n' "$2"
	printf 'Content-Length: %s\r\n' "$_len"
	printf 'Cache-Control: no-store\r\n'
	printf 'Access-Control-Allow-Origin: *\r\n'
	if [ -n "${4:-}" ]; then
		printf '%s\r\n' "$4"
	fi
	printf 'Connection: close\r\n\r\n'
	if [ "$method" != HEAD ]; then
		printf '%s' "$3"
	fi
}

method=''
line=''
IFS= read -r line || [ -n "$line" ] || exit 0
line=${line%"$CR"}
method=${line%% *}
rest=${line#* }
target=${rest%% *}
path=${target%%\?*}

# Read the request headers before answering: closing a socket with unread
# input makes the kernel send a reset, and the client can lose the response.
n=0
while [ "$n" -lt 100 ] && IFS= read -r header; do
	header=${header%"$CR"}
	[ -n "$header" ] || break
	n=$((n + 1))
done

board_load_env identity.env

query=''
case "$target" in
*\?*) query=${target#*\?} ;;
esac

# The read-only paths answer GET and HEAD only.
read_only() {
	case "$method" in
	GET | HEAD) return 0 ;;
	esac
	respond '405 Method Not Allowed' 'text/plain' "method not allowed
" 'Allow: GET, HEAD'
	return 1
}

# Sets since, after_seq and limit from the query. Only those keys count, and
# only as plain decimal numbers; nothing from the query is ever evaluated.
parse_events_query() {
	since=0
	after_seq=''
	limit=200
	set -f
	_ifs=$IFS
	IFS='&'
	# shellcheck disable=SC2086
	set -- $query
	IFS=$_ifs
	set +f
	for kv in "$@"; do
		k=${kv%%=*}
		v=${kv#*=}
		[ "$k" != "$kv" ] || v=''
		case "$k" in
		since | limit | after_seq) ;;
		*) continue ;;
		esac
		case "$v" in
		'' | *[!0-9]*) return 1 ;;
		esac
		[ "${#v}" -le 12 ] || return 1
		case "$k" in
		since) since=$v ;;
		after_seq) after_seq=$v ;;
		*) limit=$v ;;
		esac
	done
	[ "$limit" -le 2000 ] || limit=2000
}

case "$path" in
/status)
	read_only || exit 0
	if [ -x "$BOARD_LIB_DIR/status" ] && body=$("$BOARD_LIB_DIR/status" --json) && [ -n "$body" ]; then
		respond '200 OK' 'application/json' "$body
"
	else
		respond '503 Service Unavailable' 'text/plain' "status unavailable
"
	fi
	exit 0
	;;
/events)
	read_only || exit 0
	if ! parse_events_query; then
		respond '400 Bad Request' 'text/plain' "since, after_seq and limit must be whole numbers
"
		exit 0
	fi
	respond '200 OK' 'application/json' "$(board_events_json "$since" "$limit" "$after_seq")
"
	exit 0
	;;
/actions/*)
	action=${path#/actions/}
	case "$action" in
	'' | *[!a-z0-9-]*) action='' ;;
	esac
	if [ -z "$action" ] || ! board_action_offered "$action"; then
		respond '404 Not Found' 'text/plain' "no such action
"
	elif [ "$method" != POST ]; then
		respond '405 Method Not Allowed' 'text/plain' "method not allowed
" 'Allow: POST'
	elif : > "$BOARD_RUN_DIR/requests/$action" 2>/dev/null; then
		respond '202 Accepted' 'text/plain' "ok
"
	else
		respond '503 Service Unavailable' 'text/plain' "actions unavailable
"
	fi
	exit 0
	;;
esac

if [ "$path" != /.well-known/pd-device ]; then
	respond '404 Not Found' 'text/plain' "not found
"
	exit 0
fi

case "$method" in
GET | HEAD) ;;
*)
	respond '405 Method Not Allowed' 'text/plain' "method not allowed
" 'Allow: GET, HEAD'
	exit 0
	;;
esac

if body=$(board_identity_json) && [ -n "$body" ]; then
	respond '200 OK' 'application/json' "$body
"
else
	respond '500 Internal Server Error' 'text/plain' "identity unavailable
"
fi
