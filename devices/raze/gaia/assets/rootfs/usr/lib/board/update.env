# Defaults for board-update (/usr/lib/board/update). Override any of
# these in /etc/board/update.env.

# A trial boot is judged once its critical units are active and have stayed
# so for UPDATE_CONFIRM_SETTLE seconds, or after UPDATE_CONFIRM_DELAY seconds
# at the most (then whatever state they are in is judged).
UPDATE_CONFIRM_DELAY=30
UPDATE_CONFIRM_SETTLE=5

# The confirm deadline, in seconds after a boot starts: a boot that hasn't
# confirmed by then stalled while the board was up, and its slot fails (a
# trial goes back to the default; see board-update-deadline.service). A power cut is
# never a failure. It is 10 x UPDATE_CONFIRM_DELAY, so a slow but healthy boot
# (eMMC, first mounts, the network) is judged well before it, and it outlasts
# UPDATE_LINK_DELAY (120 s): a trial whose link stays down goes back by itself
# first.
UPDATE_CONFIRM_DEADLINE=300

# 1: when the health check fails on a trial boot, restart into the previous
# version right away. 0: stay on the trial until something else resets it.
UPDATE_REBOOT_ON_FAIL=1

# The health check: an executable that exits 0 when the new version is good.
# Empty uses /etc/board/update-health, then /usr/lib/board/update-health;
# with neither, a trial boot that reaches multi-user.target is good.
UPDATE_HEALTH=

# Units whose failure makes a booted slot unfit, checked before the health
# hook on a trial boot and after every boot by `update check-link`.
UPDATE_CRITICAL_UNITS="board-identity.service board-usb-gadget.service board-http.service"

# check-link: seconds after boot before checking, how many bad boots in a row
# before going back to the previous good slot, and 0 to only record them.
UPDATE_LINK_DELAY=120
UPDATE_LINK_MAX_BAD=2
UPDATE_LINK_FALLBACK=1

# Slots boards: how many slots housekeeping keeps when an update is confirmed
# (the running and previous ones count, pinned ones don't and never go; 0:
# never remove any). `slots keep <n>` sets it on the board (/data wins).
SLOTS_KEEP=3
