# Defaults for board-update (/usr/lib/board/update). Override any of
# these in /etc/board/update.env.

# Seconds the trial boot waits before running the health check, so the
# application has time to start.
UPDATE_CONFIRM_DELAY=30

# 1: when the health check fails on a trial boot, restart into the previous
# version right away. 0: stay on the trial until something else resets it.
UPDATE_REBOOT_ON_FAIL=1

# The health check: an executable that exits 0 when the new version is good.
# Empty uses /etc/board/update-health, then /usr/lib/board/update-health;
# with neither, a trial boot that reaches multi-user.target is good.
UPDATE_HEALTH=

# Units whose failure makes a booted slot unfit, checked before the health
# hook on a trial boot and after every boot by `update check-link`.
UPDATE_CRITICAL_UNITS="board-identity.service board-usb-gadget.service board-http.socket"

# check-link: seconds after boot before checking, how many bad boots in a row
# before going back to the previous good slot, and 0 to only record them.
UPDATE_LINK_DELAY=120
UPDATE_LINK_MAX_BAD=2
UPDATE_LINK_FALLBACK=1
