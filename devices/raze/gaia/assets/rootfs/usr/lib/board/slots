#!/bin/sh
# board-slots: the update writer on a board with dynamic slots (slot images
# as EROFS files on /data, docs/slots.md). `update` hands over to it when the
# board has /data/board/slots/state.json; the commands `update` has keep
# their meaning, and slots adds its own:
#
#   slots status | list           JSON: the update state, every slot, free space
#   slots stage <bundle.tar|-> [--sha256 <hex>] [--pin]
#                                 install a slot bundle (never over the
#                                 running or default slot)
#   slots stage-url <url> --sha256 <hex> --size <bytes> [--pin]
#   slots check <bundle.tar>      JSON: whether `stage` would install it (the
#                                 same checks, nothing written to /data or
#                                 the boot FAT); exit status as stage's
#   slots apply [<id>]            boot it once (trial.txt, "0 tryboot");
#                                 default: the slot just staged
#   slots boot-once <id>          the same, for any installed slot
#   slots confirm                 after a boot: keep a healthy trial as the
#                                 default; note a failed one
#   slots check-link              a trial whose management link stays down
#                                 goes back to the default
#   slots set-default <id>        a slot that has booted well before
#   slots rollback [--no-reboot]  the previous slot becomes the default
#   slots remove <id>             not the running, default or a pinned slot
#   slots pin|unpin <id>
#   slots cancel                  stop a running install
#   slots push <layer.tar|-> [--reboot|--no-restart]
#                                 replace one layer of the running (layered)
#                                 slot: kept for the next boot, laid over
#                                 /usr and /opt now, the layer's units
#                                 restarted (docs/slots.md, layered slots)
#   slots push --revert <name>    put back the layer the last push replaced
#
# Exit status as `update`: 0 done, 3 refused with nothing changed (another
# command running, the device lock held, no room, a slot that can't be
# touched), anything else failed. The firmware's choice is two one-line
# files on the boot FAT (default.txt, trial.txt: os_prefix=slots/<id>/); the
# rest is in /data/board/slots/: state.env (DEFAULT, PREVIOUS, TRIAL, STAGED
# and the update's STATE), state.json (generated from it, for the
# initramfs), <id>.meta per slot, booted (the initramfs's), fallbacks.
#
# Test hooks: SLOTS_DATA (/data), SLOTS_BOOT_MOUNT (a mounted FAT instead of
# mounting p1), SLOTS_BOOT_DEV (the device flushed after FAT writes with
# SLOTS_BOOT_MOUNT), SLOT_INIT, UPDATE_REBOOT, UPDATE_REBOOT_PLAIN, UPDATE_SYNC,
# SLOTS_RESERVE_KB, SLOTS_RUNNING, SLOTS_PARTUUID.
set -eu

BOARD_LIB_DIR=${BOARD_LIB_DIR:-/usr/lib/board}
# shellcheck source=lib.sh
. "$BOARD_LIB_DIR/lib.sh"
board_load_env update.env

DATA=${SLOTS_DATA:-/data}
IMAGES=$DATA/slots
# A layered slot's layers, shared by every slot that has them (by id).
LAYERS=$IMAGES/layers
STATE_DIR=$DATA/board/slots
INIT=${SLOT_INIT:-$BOARD_LIB_DIR/slot-init}
SYNC=${UPDATE_SYNC:-sync}
SYSTEMCTL=${UPDATE_SYSTEMCTL:-systemctl}
# Free space kept for logs, settings and PhotonVision's snapshots.
RESERVE_KB=${SLOTS_RESERVE_KB:-2097152}
STATUS_JSON=${BOARD_RUN_DIR}/update.json
DOWNLOAD_DIR=${UPDATE_DOWNLOAD_DIR:-$DATA/board/update}
REFUSED=3
BOOT='' BOOT_DEV=''
CHECKING=''
WORK_DIR='' STREAMED=''
# One exit handler: the install's work dir, a bundle that came on stdin (it
# can't resume, so it never stays on /data), the boot FAT if mounted here.
cleanup() {
	[ -z "$WORK_DIR" ] || rm -rf "$WORK_DIR"
	[ -z "$STREAMED" ] || rm -f "$STREAMED"
	if [ -n "$BOOT" ] && [ -z "${SLOTS_BOOT_MOUNT:-}" ]; then
		umount "$BOOT" 2>/dev/null || true
	fi
}
trap cleanup EXIT

refuse() {
	[ -z "$CHECKING" ] || check_answer "$REFUSED" "$*"
	board_log "$*"
	exit "$REFUSED"
}
die() {
	[ -z "$CHECKING" ] || check_answer 1 "$*"
	board_log "$*"
	[ -n "${STATE:-}" ] && STATE=error ERROR="$*" && save_state 2>/dev/null
	exit 1
}

# --- state ------------------------------------------------------------------

DEFAULT='' PREVIOUS='' TRIAL='' STAGED='' STATE=idle ERROR='' PROGRESS=0 STARTED_BY=''
load_state() {
	[ -r "$STATE_DIR/state.env" ] && . "$STATE_DIR/state.env"
	# A first boot from the image: state.json alone (built by Gaia).
	if [ -z "$DEFAULT" ] && [ -r "$STATE_DIR/state.json" ]; then
		DEFAULT=$($INIT field "$STATE_DIR/state.json" default 2>/dev/null || true)
	fi
	return 0
}
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
save_state() {
	mkdir -p "$STATE_DIR"
	{
		echo "DEFAULT=$(q "$DEFAULT")"
		echo "PREVIOUS=$(q "$PREVIOUS")"
		echo "TRIAL=$(q "$TRIAL")"
		echo "STAGED=$(q "$STAGED")"
		echo "STATE=$(q "$STATE")"
		echo "ERROR=$(q "$ERROR")"
		echo "PROGRESS=$(q "$PROGRESS")"
		echo "STARTED_BY=$(q "$STARTED_BY")"
	} > "$STATE_DIR/state.env.tmp"
	mv -f "$STATE_DIR/state.env.tmp" "$STATE_DIR/state.env"
	js() { if [ -n "$1" ]; then board_json_str "$1"; else printf null; fi; }
	printf '{"schema":1,"default":%s,"previous":%s,"trial":%s}\n' \
		"$(js "$DEFAULT")" "$(js "$PREVIOUS")" "$(js "$TRIAL")" > "$STATE_DIR/state.json.tmp"
	$SYNC
	mv -f "$STATE_DIR/state.json.tmp" "$STATE_DIR/state.json"
	$SYNC
	write_status
}

# <id>.meta: PINNED, GOOD (yes, no, untried), INSTALLED, LAST_BOOT.
meta_get() { sed -n "s/^$2=//p" "$STATE_DIR/$1.meta" 2>/dev/null | head -n 1 | tr -d "'"; }
meta_set() {
	_m=$STATE_DIR/$1.meta
	{ grep -v "^$2=" "$_m" 2>/dev/null || true; echo "$2=$3"; } > "$_m.tmp"
	mv -f "$_m.tmp" "$_m"
}

running() {
	if [ -n "${SLOTS_RUNNING:-}" ]; then echo "$SLOTS_RUNNING"; return; fi
	cat "$STATE_DIR/booted" 2>/dev/null || true
}
# A slot is its manifest and its one image, or its manifest and its layers.
installed() { [ -r "$IMAGES/$1.json" ] && { [ -r "$IMAGES/$1.erofs" ] || layered "$IMAGES/$1.json" > /dev/null; }; }
# layered <slot.json>: whether it lists layers (its layer lines on stdout).
layered() { $INIT layers "$1" 2>/dev/null; }

# Layers no installed slot lists any more go (after a remove, or an install
# that replaced a slot's layers).
gc_layers() {
	[ -d "$LAYERS" ] || return 0
	# The slots' layers, and those a push --revert would put back.
	_keep=$(for _j in "$IMAGES"/*.json "$STATE_DIR"/*.prev.json; do [ -e "$_j" ] && layered "$_j" || true; done | awk '{ print $2 }')
	for _f in "$LAYERS"/*.erofs; do
		[ -e "$_f" ] || continue
		_gid=${_f##*/}
		_gid=${_gid%.erofs}
		printf '%s\n' "$_keep" | grep -qx "$_gid" || rm -f "$_f"
	done
	rm -f "$LAYERS"/.*.tmp 2>/dev/null || true
}
valid_id() {
	case "$1" in '' | .* | *[!a-z0-9._-]*) return 1 ;; esac
	[ "${#1}" -le 64 ]
}
mf() { $INIT field "$IMAGES/$1.json" "$2" 2>/dev/null || true; }

# --- the boot FAT -----------------------------------------------------------

# p1 of the disk /data is on (p2), mounted on $BOOT.
mount_boot() {
	[ -z "$BOOT" ] || return 0
	if [ -n "${SLOTS_BOOT_MOUNT:-}" ]; then
		BOOT=$SLOTS_BOOT_MOUNT BOOT_DEV=${SLOTS_BOOT_DEV:-}
		return 0
	fi
	_dev=$(findmnt -n -o SOURCE "$DATA" 2>/dev/null) || die "can't tell which device /data is on"
	_boot=${_dev%2}1
	BOOT=$BOARD_RUN_DIR/slots-boot
	mkdir -p "$BOOT"
	mount -t vfat "$_boot" "$BOOT" || { BOOT=''; die "can't mount the boot partition $_boot"; }
	BOOT_DEV=$_boot
}
# The FAT's writes on the media, not just sent to the device: sync writes
# them back, and the flush empties the eMMC's write-back cache, which vfat
# never asks for (ext4 does, at each commit). What the firmware reads at the
# next boot (a trial.txt, a slot's kernel) has to be there before a restart.
boot_sync() {
	$SYNC
	[ -z "$BOOT_DEV" ] || $INIT flush "$BOOT_DEV" > /dev/null || board_log "couldn't flush $BOOT_DEV's write cache"
}
# Done with the FAT before a restart: unmounted (its dirty flag cleared),
# flushed.
umount_boot() {
	[ -n "$BOOT" ] || return 0
	boot_sync
	if [ -z "${SLOTS_BOOT_MOUNT:-}" ]; then
		umount "$BOOT" || board_log "couldn't unmount the boot partition before restarting"
	fi
	BOOT=''
}
# write_line <file> <line>: a one-line file on the FAT, replaced in one rename.
write_line() {
	printf '%s\n' "$2" > "$BOOT/$1.new" || die "can't write $1 on the boot partition"
	boot_sync
	mv -f "$BOOT/$1.new" "$BOOT/$1" || die "can't write $1 on the boot partition"
	boot_sync
}
# The default slot's boot files at the FAT's root too: what the firmware
# boots when config.txt (or default.txt) can't be read.
root_copy() {
	_src=$BOOT/slots/$1
	[ -d "$_src" ] || return 0
	for _f in "$_src"/*; do
		_n=${_f##*/}
		[ -f "$_f" ] || continue
		cp "$_f" "$BOOT/.$_n.new" && mv -f "$BOOT/.$_n.new" "$BOOT/$_n"
	done
	if [ -d "$_src/overlays" ]; then
		rm -rf "$BOOT/.overlays.new"
		cp -r "$_src/overlays" "$BOOT/.overlays.new" && rm -rf "$BOOT/overlays" && mv "$BOOT/.overlays.new" "$BOOT/overlays"
	fi
	boot_sync
}

tryboot_reboot() {
	if [ -n "${UPDATE_REBOOT:-}" ]; then eval "$UPDATE_REBOOT"; return; fi
	"$SYSTEMCTL" reboot --reboot-argument='0 tryboot'
}
plain_reboot() { eval "${UPDATE_REBOOT_PLAIN:-$SYSTEMCTL reboot}"; }

# --- status -----------------------------------------------------------------

slots_json() {
	_first=1
	printf '['
	for _man in "$IMAGES"/*.json; do
		[ -e "$_man" ] || continue
		_id=${_man##*/}
		_id=${_id%.json}
		valid_id "$_id" || continue
		_img=$IMAGES/$_id.erofs
		# A layered slot: its size is its layers', and it's intact when each
		# layer file is there at its size.
		_layers='' _lsize=0 _lok=true
		if [ ! -e "$_img" ]; then
			_lines=$(layered "$_man") || continue
			while read -r _ln _lid _lsz _lsha _lroot; do
				_have=$(board_file_size "$LAYERS/$_lid.erofs" 2>/dev/null || echo)
				[ "$_have" = "$_lsz" ] || _lok=false
				_lsize=$((_lsize + _lsz))
				_layers="$_layers{\"name\":$(board_json_str "$_ln"),\"id\":\"$_lid\",\"size\":$_lsz},"
			done <<EOF
$_lines
EOF
		fi
		[ "$_first" = 1 ] || printf ','
		_first=0
		if [ -e "$_img" ]; then _size=$(board_file_size "$_img"); else _size=$_lsize; fi
		# The manifest's fields in one helper run, a line each. The sentinel
		# keeps $(...) from dropping trailing empty lines. A helper that can't
		# give them as lines (exit 1) leaves them to mf, one by one.
		if _fields=$($INIT fields "$IMAGES/$_id.json" image.size family version variant kernel verity.root_hash display_name 2>/dev/null && echo .); then
			_fields=${_fields%.}
			{
				IFS= read -r _want
				IFS= read -r _family
				IFS= read -r _version
				IFS= read -r _variant
				IFS= read -r _kernel
				IFS= read -r _root
				IFS= read -r _display
			} <<EOF
$_fields
EOF
		else
			_want=$(mf "$_id" image.size)
			_family=$(mf "$_id" family)
			_version=$(mf "$_id" version)
			_variant=$(mf "$_id" variant)
			_kernel=$(mf "$_id" kernel)
			_root=$(mf "$_id" verity.root_hash)
			_display=$(mf "$_id" display_name)
		fi
		# Damaged when the file isn't the size it was built at.
		_intact=true
		if [ -e "$_img" ]; then
			[ -z "$_want" ] || [ "$_want" = "$_size" ] || _intact=false
		else
			_intact=$_lok
			_root=layered
		fi
		_flags=''
		[ "$_id" = "$(running)" ] && _flags="$_flags\"running\","
		[ "$_id" = "$DEFAULT" ] && _flags="$_flags\"default\","
		[ "$_id" = "$PREVIOUS" ] && _flags="$_flags\"previous\","
		[ "$_id" = "$TRIAL" ] && _flags="$_flags\"trial\","
		[ "$_id" = "$STAGED" ] && _flags="$_flags\"staged\","
		printf '{"id":%s,"family":%s,"version":%s,"variant":%s,"kernel":%s,"size":%s,"verity":%s,"intact":%s,"flags":[%s],"pinned":%s,"good":%s,"installed":%s,"last_boot":%s,"display_name":%s,"layers":%s}' \
			"$(board_json_str "$_id")" "$(board_json_str "$_family")" "$(board_json_str "$_version")" \
			"$(board_json_str "$_variant")" "$(board_json_str "$_kernel")" "$_size" \
			"$([ -n "$_root" ] && echo true || echo false)" "$_intact" "${_flags%,}" \
			"$([ "$(meta_get "$_id" PINNED)" = yes ] && echo true || echo false)" \
			"$(board_json_str "$(meta_get "$_id" GOOD)")" "$(board_json_str "$(meta_get "$_id" INSTALLED)")" \
			"$(board_json_str "$(meta_get "$_id" LAST_BOOT)")" \
				"$(if [ -n "$_display" ]; then board_json_str "$_display"; else printf null; fi)" \
			"$(if [ -n "$_layers" ]; then printf '[%s]' "${_layers%,}"; else printf null; fi)"
	done
	printf ']'
}
free_kb() { df -kP "$DATA" 2>/dev/null | awk 'NR == 2 { print $4 }'; }
write_status() {
	mkdir -p "$BOARD_RUN_DIR"
	_run=$(running)
	_free=$(free_kb)
	printf '{"state":%s,"layout":"slots","slot_active":%s,"slot_staged":%s,"slot_default":%s,"slot_previous":%s,"slot_trial":%s,"version_active":%s,"version_staged":%s,"progress":%s,"error":%s,"version_previous":%s,"started_by":%s,"phase":null,"free_bytes":%s,"reserve_bytes":%s,"slots":%s}\n' \
		"$(board_json_str "$STATE")" "$(board_json_str "$_run")" "$(board_json_str "$STAGED")" "$(board_json_str "$DEFAULT")" \
		"$(board_json_str "$PREVIOUS")" "$(board_json_str "$TRIAL")" "$(board_json_str "$([ -n "$_run" ] && mf "$_run" version)")" \
		"$(board_json_str "$([ -n "$STAGED" ] && mf "$STAGED" version)")" "${PROGRESS:-0}" "$(board_json_str "$ERROR")" \
		"$(board_json_str "$([ -n "$PREVIOUS" ] && mf "$PREVIOUS" version)")" "$(board_json_str "$STARTED_BY")" \
		"$((${_free:-0} * 1024))" "$((RESERVE_KB * 1024))" "$(slots_json)" > "$STATUS_JSON.tmp.$$"
	chmod 0644 "$STATUS_JSON.tmp.$$" 2>/dev/null || true
	# The boot it describes, as `update status` checks before answering from it.
	cat "${UPDATE_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}" > "$STATUS_JSON.boot" 2>/dev/null || true
	mv -f "$STATUS_JSON.tmp.$$" "$STATUS_JSON"
}

# --- install ----------------------------------------------------------------

# bundle_layers <dir>: a slot.json without layers of its own, next to the
# build's layers/layers.json (Gaia), takes its layers from it.
bundle_layers() {
	[ -r "$1/layers/layers.json" ] || return 0
	layered "$1/slot.json" > /dev/null && return 0
	$INIT merge-layers "$1/slot.json" "$1/layers/layers.json" > "$1/slot.json.new" ||
		die "the bundle's layers/layers.json doesn't make a bootable slot (each layer needs its verity)"
	mv -f "$1/slot.json.new" "$1/slot.json"
}

# install_bundle <tar> <pin yes|no>: unpack into /data/slots/.install.<pid>,
# check everything against slot.json, then put each part in place by rename.
install_bundle() {
	_tar=$1
	_work=$IMAGES/.install.$$
	rm -rf "$IMAGES"/.install.* 2>/dev/null || true
	mkdir -p "$_work"
	WORK_DIR=$_work
	_need=$(( $(board_file_size "$_tar") / 1024 + RESERVE_KB ))
	[ "$(free_kb)" -ge "$_need" ] || refuse "no room for this slot: it needs $((_need / 1024)) MiB with the reserve, /data has $(( $(free_kb) / 1024 )) MiB free; remove a slot first"
	STATE=staging PROGRESS=100 ERROR=''
	save_state
	tar -xf "$_tar" -C "$_work" || die "the bundle doesn't unpack"
	# Unpacked: a streamed bundle's tar goes now, not after the install.
	[ -z "$STREAMED" ] || { rm -f "$STREAMED"; STREAMED=''; }
	[ -r "$_work/slot.json" ] && [ -d "$_work/boot" ] || die "not a slot bundle (slot.json, rootfs.erofs or layers/, boot/)"
	_id=$($INIT field "$_work/slot.json" id) || die "slot.json has no id"
	valid_id "$_id" || die "slot.json: \`$_id\` isn't a slot id"
	[ "$_id" != "$(running)" ] || refuse "$_id is the running slot"
	[ "$_id" != "$DEFAULT" ] || refuse "$_id is the default slot"
	# A layered slot: each layer the board already has is kept as it is;
	# the others come from the bundle's layers/<id>.erofs (or the build's
	# own name for it, layers/<name>.erofs), checked here. A bundle whose
	# slot.json lists no layers but carries the build's layers/layers.json
	# gets them from it.
	bundle_layers "$_work"
	_new_layers=''
	if _lines=$(layered "$_work/slot.json"); then
		_root='' _sha=layered
		while read -r _ln _lid _lsz _lsha _lroot; do
			_root="$_root${_root:+,}$_lroot"
			if [ "$(board_file_size "$LAYERS/$_lid.erofs" 2>/dev/null)" = "$_lsz" ]; then
				continue
			fi
			[ -r "$_work/layers/$_lid.erofs" ] || [ ! -r "$_work/layers/$_ln.erofs" ] || mv -f "$_work/layers/$_ln.erofs" "$_work/layers/$_lid.erofs"
			[ -r "$_work/layers/$_lid.erofs" ] || die "layer $_ln ($_lid) is neither in the bundle nor on the board"
			[ "$(board_file_size "$_work/layers/$_lid.erofs")" = "$_lsz" ] || die "layer $_ln isn't the size slot.json says"
			[ "$(sha256sum "$_work/layers/$_lid.erofs" | cut -d' ' -f1)" = "$_lsha" ] || die "layer $_ln doesn't match slot.json's sha256"
			_new_layers="$_new_layers $_lid"
		done <<EOF
$_lines
EOF
		PROGRESS=600 && write_status
	else
		[ -r "$_work/rootfs.erofs" ] || die "not a slot bundle (slot.json, rootfs.erofs or layers/, boot/)"
		_root=$($INIT field "$_work/slot.json" verity.root_hash) || die "slot.json has no verity root hash"
		_size=$($INIT field "$_work/slot.json" image.size) || die "slot.json has no image size"
		_sha=$($INIT field "$_work/slot.json" image.sha256) || die "slot.json has no image sha256"
		[ "$(board_file_size "$_work/rootfs.erofs")" = "$_size" ] || die "rootfs.erofs isn't the size slot.json says"
		PROGRESS=300 && write_status
		[ "$(sha256sum "$_work/rootfs.erofs" | cut -d' ' -f1)" = "$_sha" ] || die "rootfs.erofs doesn't match slot.json's sha256"
		PROGRESS=600 && write_status
	fi
	$INIT boot-files "$_work/slot.json" > "$_work/boot.sha256" || die "slot.json's boot files"
	(cd "$_work/boot" && sha256sum -c ../boot.sha256 > /dev/null 2>&1) || die "a boot file doesn't match slot.json"
	# An initramfs the kernel can't unpack never gets to /init (r54: xz with
	# a 64 MiB dictionary): refuse it here, not on the trial.
	if [ -f "$_work/boot/initramfs" ]; then
		_why=$($INIT check-initramfs "$_work/boot/initramfs" 2>&1) || refuse "the bundle's initramfs won't boot: ${_why#slot-init: }"
	fi
	# The firmware reads overlays from os_prefix only when overlays/README
	# exists; without it the slot gets the root overlays (the default slot's).
	# Bundles from before slots.toml shipped one get it here.
	if [ -d "$_work/boot/overlays" ] && [ ! -e "$_work/boot/overlays/README" ]; then
		printf 'Overlays for this slot. The firmware reads them from os_prefix only when this file exists.\n' > "$_work/boot/overlays/README"
	fi
	# The boot side: slots/<id>/ on the FAT, its cmdline naming the slot.
	mount_boot
	_dev=${SLOTS_PARTUUID:-$(findmnt -n -o PARTUUID "$DATA" 2>/dev/null || true)}
	_base=$(tr '\n' ' ' < "$_work/boot/cmdline.txt" 2>/dev/null | sed 's/ *$//')
	rm -rf "$BOOT/slots/.$_id.new"
	mkdir -p "$BOOT/slots"
	cp -r "$_work/boot" "$BOOT/slots/.$_id.new" || die "can't write the slot's boot files"
	cp "$_work/slot.json" "$BOOT/slots/.$_id.new/slot.json"
	printf '%s atlas.slot=%s atlas.roothash=%s atlas.data=PARTUUID=%s panic=5\n' \
		"$_base" "$_id" "$_root" "$_dev" > "$BOOT/slots/.$_id.new/cmdline.txt"
	boot_sync
	rm -rf "$BOOT/slots/$_id"
	mv "$BOOT/slots/.$_id.new" "$BOOT/slots/$_id" || die "can't put the slot's boot files in place"
	boot_sync
	PROGRESS=900 && write_status
	# The data side: the image (or the new layers) and the manifest, each
	# by rename, the manifest last.
	mv -f "$_work/slot.json" "$IMAGES/.$_id.json.tmp"
	if [ "$_sha" = layered ]; then
		mkdir -p "$LAYERS"
		for _lid in $_new_layers; do
			mv -f "$_work/layers/$_lid.erofs" "$LAYERS/.$_lid.erofs.tmp"
		done
		$SYNC
		for _lid in $_new_layers; do
			mv -f "$LAYERS/.$_lid.erofs.tmp" "$LAYERS/$_lid.erofs"
		done
		# Replacing a one-image slot of the same id: its image goes.
		rm -f "$IMAGES/$_id.erofs"
	else
		mv -f "$_work/rootfs.erofs" "$IMAGES/.$_id.erofs.tmp"
		$SYNC
		mv -f "$IMAGES/.$_id.erofs.tmp" "$IMAGES/$_id.erofs"
	fi
	mv -f "$IMAGES/.$_id.json.tmp" "$IMAGES/$_id.json"
	$SYNC
	# Layers a replaced slot had and nothing has now.
	gc_layers
	rm -f "$STATE_DIR/$_id.meta"
	meta_set "$_id" PINNED "$2"
	meta_set "$_id" GOOD untried
	meta_set "$_id" INSTALLED "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	STAGED=$_id STATE=staged PROGRESS=1000 STARTED_BY=${BOARD_EVENT_SOURCE:-local}
	save_state
	board_event update.staged "installed slot $_id ($(mf "$_id" family) $(mf "$_id" version))" "slot=$_id" "sha256=$_sha"
}

cmd_stage() {
	_file='' _want='' _pin=no
	while [ $# -gt 0 ]; do
		case "$1" in
		--sha256) _want=${2:-}; shift 2 ;;
		--pin) _pin=yes; shift ;;
		-) _file=-; shift ;;
		-*) die "unknown option '$1'" ;;
		*) _file=$1; shift ;;
		esac
	done
	[ -n "$_file" ] || die "usage: slots stage <bundle.tar|-> [--sha256 <hex>] [--pin]"
	if [ "$_file" = - ]; then
		mkdir -p "$DOWNLOAD_DIR"
		_file=$DOWNLOAD_DIR/stdin.slot.tar
		STREAMED=$_file
		cat > "$_file"
	fi
	[ -r "$_file" ] || die "no bundle at $_file"
	[ -z "$_want" ] || [ "$(sha256sum "$_file" | cut -d' ' -f1)" = "$_want" ] || refuse "the bundle doesn't match --sha256; nothing changed"
	board_event update.stage "installing a slot from $(basename "$_file")"
	install_bundle "$_file" "$_pin"
}

# --- check ------------------------------------------------------------------

# check_answer <status> <message>: `slots check`'s refusal or failure, as
# JSON on stdout, and that exit status.
check_answer() {
	printf '{"ok":false,"refused":%s,"error":%s}\n' \
		"$([ "$1" = "$REFUSED" ] && echo true || echo false)" "$(board_json_str "$2")"
	exit "$1"
}

# A bundle's member <name>'s size, from the listing (-tv: size is field 3).
member_size() { awk -v n="$2" '$NF == n || $NF == "./" n { print $3; exit }' "$1"; }

# slots check <bundle.tar>: every check install_bundle makes, reading the
# bundle where it is: slot.json and boot/ unpacked to a temporary dir (a few
# MiB, tmpfs), rootfs.erofs hashed straight out of the tar. Nothing on /data
# or the boot FAT changes, no state, no event.
cmd_check() {
	CHECKING=1
	_tar=${1:-}
	[ -n "$_tar" ] || die "usage: slots check <bundle.tar>"
	[ -r "$_tar" ] || die "no bundle at $_tar"
	_work=$(mktemp -d "${TMPDIR:-/tmp}/slots-check.XXXXXX") || die "no temporary dir"
	WORK_DIR=$_work
	tar -tvf "$_tar" > "$_work/.list" 2>/dev/null || die "the bundle doesn't unpack"
	_pre=''
	grep -q ' \./slot\.json$' "$_work/.list" && _pre=./
	# slot.json and boot/'s files by name (busybox tar may lack --exclude).
	awk '$1 !~ /^d/ { n = $NF; sub(/^\.\//, "", n); if (n == "slot.json" || n == "layers/layers.json" || n ~ /^boot\//) print $NF }' "$_work/.list" > "$_work/.want"
	set --
	while IFS= read -r _n; do set -- "$@" "$_n"; done < "$_work/.want"
	[ $# -gt 0 ] || die "not a slot bundle (slot.json, rootfs.erofs, boot/)"
	tar -xf "$_tar" -C "$_work" "$@" 2>/dev/null || die "the bundle doesn't unpack"
	[ -r "$_work/slot.json" ] && [ -d "$_work/boot" ] || die "not a slot bundle (slot.json, rootfs.erofs or layers/, boot/)"
	_id=$($INIT field "$_work/slot.json" id) || die "slot.json has no id"
	valid_id "$_id" || die "slot.json: \`$_id\` isn't a slot id"
	[ "$_id" != "$(running)" ] || refuse "$_id is the running slot"
	[ "$_id" != "$DEFAULT" ] || refuse "$_id is the default slot"
	_reuse=0
	bundle_layers "$_work"
	if _lines=$(layered "$_work/slot.json"); then
		# Each layer the board has is reused; the others must be in the bundle.
		_size=0
		while read -r _ln _lid _lsz _lsha _lroot; do
			_size=$((_size + _lsz))
			if [ "$(board_file_size "$LAYERS/$_lid.erofs" 2>/dev/null)" = "$_lsz" ]; then
				_reuse=$((_reuse + 1))
				continue
			fi
			_member=layers/$_lid.erofs
			[ -n "$(member_size "$_work/.list" "$_member")" ] || _member=layers/$_ln.erofs
			[ -n "$(member_size "$_work/.list" "$_member")" ] || die "layer $_ln ($_lid) is neither in the bundle nor on the board"
			[ "$(member_size "$_work/.list" "$_member")" = "$_lsz" ] || die "layer $_ln isn't the size slot.json says"
			[ "$(tar -xOf "$_tar" "${_pre}$_member" | sha256sum | cut -d' ' -f1)" = "$_lsha" ] || die "layer $_ln doesn't match slot.json's sha256"
		done <<EOF
$_lines
EOF
	else
		[ -n "$(member_size "$_work/.list" rootfs.erofs)" ] || die "not a slot bundle (slot.json, rootfs.erofs or layers/, boot/)"
		$INIT field "$_work/slot.json" verity.root_hash > /dev/null || die "slot.json has no verity root hash"
		_size=$($INIT field "$_work/slot.json" image.size) || die "slot.json has no image size"
		_sha=$($INIT field "$_work/slot.json" image.sha256) || die "slot.json has no image sha256"
		[ "$(member_size "$_work/.list" rootfs.erofs)" = "$_size" ] || die "rootfs.erofs isn't the size slot.json says"
		[ "$(tar -xOf "$_tar" "${_pre}rootfs.erofs" | sha256sum | cut -d' ' -f1)" = "$_sha" ] || die "rootfs.erofs doesn't match slot.json's sha256"
	fi
	$INIT boot-files "$_work/slot.json" > "$_work/.boot.sha256" || die "slot.json's boot files"
	(cd "$_work/boot" && sha256sum -c ../.boot.sha256 > /dev/null 2>&1) || die "a boot file doesn't match slot.json"
	if [ -f "$_work/boot/initramfs" ]; then
		_why=$($INIT check-initramfs "$_work/boot/initramfs" 2>&1) || refuse "the bundle's initramfs won't boot: ${_why#slot-init: }"
	fi
	# Room last, as install_bundle: the tar's size plus the reserve.
	_need=$(( $(board_file_size "$_tar") / 1024 + RESERVE_KB ))
	_free=$(free_kb)
	[ "$_free" -ge "$_need" ] || refuse "no room for this slot: it needs $((_need / 1024)) MiB with the reserve, /data has $((_free / 1024)) MiB free; remove a slot first"
	printf '{"ok":true,"id":%s,"family":%s,"version":%s,"variant":%s,"image_size":%s,"need_bytes":%s,"free_bytes":%s,"replaces":%s,"layers_reused":%s}\n' \
		"$(board_json_str "$_id")" "$(board_json_str "$($INIT field "$_work/slot.json" family || true)")" \
		"$(board_json_str "$($INIT field "$_work/slot.json" version || true)")" \
		"$(board_json_str "$($INIT field "$_work/slot.json" variant || true)")" \
		"$_size" "$((_need * 1024))" "$((_free * 1024))" \
		"$(installed "$_id" && echo true || echo false)" "$_reuse"
}

cmd_stage_url() {
	_url='' _want='' _size='' _pin=no
	while [ $# -gt 0 ]; do
		case "$1" in
		--sha256) _want=${2:-}; shift 2 ;;
		--size) _size=${2:-}; shift 2 ;;
		--pin) _pin=yes; shift ;;
		-*) die "unknown option '$1'" ;;
		*) _url=$1; shift ;;
		esac
	done
	[ -n "$_url" ] && [ -n "$_want" ] || die "usage: slots stage-url <url> --sha256 <hex> --size <bytes> [--pin]"
	mkdir -p "$DOWNLOAD_DIR"
	_file=$DOWNLOAD_DIR/$_want.slot.tar
	STATE=staging PROGRESS=0 ERROR=''
	save_state
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL --retry 3 --connect-timeout 30 -C - -o "$_file" "$_url" || die "the download failed"
	else
		wget -q -c -O "$_file" "$_url" || die "the download failed"
	fi
	[ -z "$_size" ] || [ "$(board_file_size "$_file")" = "$_size" ] || die "the download isn't --size bytes"
	[ "$(sha256sum "$_file" | cut -d' ' -f1)" = "$_want" ] || { rm -f "$_file"; die "the download doesn't match --sha256"; }
	install_bundle "$_file" "$_pin"
	rm -f "$_file"
}

# --- booting ----------------------------------------------------------------

cmd_boot_once() {
	_id=${1:-$STAGED}
	[ -n "$_id" ] || refuse "nothing is staged"
	installed "$_id" || refuse "no slot $_id"
	[ "$_id" != "$(running)" ] || refuse "$_id is the running slot"
	mount_boot
	[ -d "$BOOT/slots/$_id" ] || refuse "slot $_id has no boot files"
	write_line trial.txt "os_prefix=slots/$_id/"
	# A new trial: confirm may try it once more if the restart loses its flag.
	meta_set "$_id" RETRIED no
	TRIAL=$_id STATE=rebooting
	save_state
	board_event update.apply "restarting into slot $_id ($(mf "$_id" version)) on trial" "slot=$_id"
	umount_boot
	tryboot_reboot
}

# After every boot (board-update-confirm): a healthy trial becomes the
# default; a trial that didn't come up is noted.
cmd_confirm() {
	_run=$(running)
	[ -n "$_run" ] || refuse "the initramfs didn't say which slot is running"
	if [ -n "$TRIAL" ] && [ "$_run" = "$TRIAL" ]; then
		if [ -x /etc/board/update-health ] && ! /etc/board/update-health; then
			meta_set "$_run" GOOD no
			ERROR="slot $_run failed its health check"
			board_event update.trial-failed "$ERROR" "slot=$_run"
			save_state
			plain_reboot
			return
		fi
		mount_boot
		root_copy "$_run"
		write_line default.txt "os_prefix=slots/$_run/"
		[ "$DEFAULT" = "$_run" ] || PREVIOUS=$DEFAULT
		DEFAULT=$_run TRIAL='' STAGED='' STATE=confirmed ERROR=''
		board_event update.confirmed "kept slot $_run ($(mf "$_run" version))" "slot=$_run"
	elif [ -n "$TRIAL" ]; then
		_retry=''
		meta_set "$TRIAL" GOOD no
		# The initramfs writes trial-init once it has /data on a trial, and
		# trial-started once it has started the slot.
		if [ "$(cat "$STATE_DIR/trial-started" 2>/dev/null)" = "$TRIAL" ]; then
			ERROR="slot $TRIAL started but its system didn't confirm the boot; back on $_run"
		elif [ "$(cat "$STATE_DIR/trial-init" 2>/dev/null)" = "$TRIAL" ]; then
			ERROR="slot $TRIAL didn't start (its initramfs stopped; the reason is in slot-init.log on the boot partition); back on $_run"
		else
			# This boot's tryboot flag: 1 is the firmware doing the trial but
			# starting another slot. 0 can't tell a restart that lost the
			# flag from a trial kernel that stopped before /init (the boot
			# after either is a normal one); either way it is tried once
			# more, which costs at most one more failed boot.
			case $(board_tryboot) in
			1)
				_tried=yes
				ERROR="slot $TRIAL didn't reach its initramfs's /init: the firmware did the trial boot but started $_run (it read another trial.txt, or couldn't load the slot's files); back on $_run"
				;;
			*)
				_tried=unknown
				ERROR="slot $TRIAL didn't reach its initramfs's /init (its kernel stopped before it, or the restart lost the tryboot flag); back on $_run"
				[ "$(meta_get "$TRIAL" RETRIED)" = yes ] || ! installed "$TRIAL" || _retry=$TRIAL
				;;
			esac
		fi
		# A boot that began at power-on: the board lost power on the way (a
		# bench brown-out loses the tryboot flag), not necessarily the slot.
		_reset=$(board_reset_cause)
		[ "$_reset" != power-on ] || ERROR="$ERROR; this boot began at power-on (the board lost power), so the trial may never have run: try it again"
		if [ -n "$_retry" ]; then
			meta_set "$_retry" RETRIED yes
			ERROR=''
			board_event update.retry "slot $_retry didn't reach its initramfs's /init (its kernel stopped before it, or the restart lost the tryboot flag); restarting into it once more" "slot=$_retry" "reset=${_reset:-unknown}"
		else
			board_event update.rolled-back "$ERROR" "slot=$TRIAL" "reset=${_reset:-unknown}" "tryboot=${_tried:-yes}"
			TRIAL='' STATE=rolled-back
		fi
	fi
	[ -n "$DEFAULT" ] || DEFAULT=$_run
	meta_set "$_run" GOOD yes
	meta_set "$_run" LAST_BOOT "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	echo 0 > "$STATE_DIR/fallbacks"
	rm -f "$STATE_DIR/trial-started" "$STATE_DIR/trial-init"
	save_state
	if [ -n "${_retry:-}" ]; then
		mount_boot
		write_line trial.txt "os_prefix=slots/$_retry/"
		STATE=rebooting
		save_state
		umount_boot
		tryboot_reboot
	fi
}

cmd_check_link() {
	_run=$(running)
	[ -n "$TRIAL" ] && [ "$_run" = "$TRIAL" ] || return 0
	[ "${LINK_OK:-1}" = 1 ] && return 0
	meta_set "$_run" GOOD no
	ERROR="slot $_run came up without its management link (${LINK_REASON:-}); back to $DEFAULT"
	board_event update.link-bad "$ERROR" "slot=$_run"
	TRIAL='' STATE=rolled-back
	save_state
	plain_reboot
}

cmd_set_default() {
	_id=${1:-}
	installed "$_id" || refuse "no slot $_id"
	[ "$(meta_get "$_id" GOOD)" = yes ] || refuse "slot $_id hasn't booted well here yet: boot it once first"
	mount_boot
	write_line default.txt "os_prefix=slots/$_id/"
	root_copy "$_id"
	[ "$DEFAULT" = "$_id" ] || PREVIOUS=$DEFAULT
	DEFAULT=$_id
	save_state
	board_event update.default "slot $_id is the default from the next boot" "slot=$_id"
}

cmd_rollback() {
	[ -n "$PREVIOUS" ] && installed "$PREVIOUS" || refuse "there is no previous slot to go back to"
	_back=$PREVIOUS
	_from=$DEFAULT
	mount_boot
	write_line default.txt "os_prefix=slots/$_back/"
	root_copy "$_back"
	DEFAULT=$_back PREVIOUS=$_from STATE=rebooting
	save_state
	board_event update.rollback "going back to slot $_back" "slot=$_back"
	umount_boot
	[ "${1:-}" = --no-reboot ] || plain_reboot
}

# --- slots ------------------------------------------------------------------

cmd_remove() {
	_id=${1:-}
	valid_id "$_id" || refuse "\`$_id\` isn't a slot id"
	installed "$_id" || [ -d "${SLOTS_BOOT_MOUNT:-/nonexistent}/slots/$_id" ] || refuse "no slot $_id"
	[ "$_id" != "$(running)" ] || refuse "$_id is the running slot"
	[ "$_id" != "$DEFAULT" ] || refuse "$_id is the default slot"
	[ "$_id" != "$TRIAL" ] || refuse "$_id is about to be tried"
	[ "$(meta_get "$_id" PINNED)" != yes ] || refuse "$_id is pinned; unpin it first"
	mount_boot
	rm -rf "$BOOT/slots/$_id"
	$SYNC
	rm -f "$IMAGES/$_id.erofs" "$IMAGES/$_id.json" "$STATE_DIR/$_id.meta"
	gc_layers
	$SYNC
	[ "$PREVIOUS" != "$_id" ] || PREVIOUS=''
	[ "$STAGED" != "$_id" ] || STAGED=''
	save_state
	board_event slot.removed "removed slot $_id" "slot=$_id"
}

cmd_pin() {
	installed "$2" || refuse "no slot $2"
	meta_set "$2" PINNED "$1"
	write_status
}

cmd_cancel() {
	if [ "$STATE" = staging ]; then
		rm -rf "$IMAGES"/.install.* "$IMAGES"/.*.tmp 2>/dev/null || true
		STATE=cancelled ERROR=''
		save_state
		echo cancelled
		return
	fi
	if [ -n "$STAGED" ] && [ "$STAGED" != "$(running)" ] && [ "$STAGED" != "$DEFAULT" ] &&
		[ "$(meta_get "$STAGED" GOOD)" = untried ]; then
		_id=$STAGED
		cmd_remove "$_id"
		STATE=cancelled
		save_state
		echo cancelled
		return
	fi
	echo idle
}

# --- push: one layer of the running slot --------------------------------------

# Test hooks: SLOTS_MOUNT, SLOTS_UMOUNT (mount and umount), SLOTS_MOUNTINFO
# (/proc/self/mountinfo), SLOTS_LIVE_ROOT (where the live dirs are, /).
MOUNT=${SLOTS_MOUNT:-mount}
UMOUNT=${SLOTS_UMOUNT:-umount}
LIVE=$BOARD_RUN_DIR/layers
LIVE_ROOT=${SLOTS_LIVE_ROOT:-}
# The dirs a pushed layer is laid over while the board runs. Its files
# elsewhere (/etc) take effect at the next boot.
LIVE_DIRS=${SLOTS_LIVE_DIRS:-usr opt}

# json_list <words...>: a JSON array of strings.
json_list() {
	_out=''
	for _w in "$@"; do _out="$_out${_out:+,}$(board_json_str "$_w")"; done
	printf '[%s]' "$_out"
}

# The running slot's manifest becomes <new slot.json>: the layer in the
# store, the cmdline's root hashes, the manifest by rename (the old one kept
# as <id>.prev.json for push --revert).
push_persist() {
	_run=$1 _man=$2
	_roots=$(layered "$_man" | awk '{ printf "%s%s", (NR > 1 ? "," : ""), $5 }')
	[ -n "$_roots" ] || die "the new manifest lists no layers"
	mount_boot
	_cmd=$BOOT/slots/$_run/cmdline.txt
	[ -r "$_cmd" ] || die "slot $_run has no cmdline.txt on the boot partition"
	sed "s/atlas\.roothash=[^ ]*/atlas.roothash=$_roots/" "$_cmd" > "$_cmd.new" || die "can't write $_run's cmdline.txt"
	grep -q "atlas.roothash=$_roots" "$_cmd.new" || die "$_run's cmdline.txt has no atlas.roothash"
	boot_sync
	mv -f "$_cmd.new" "$_cmd" || die "can't write $_run's cmdline.txt"
	if [ "$_run" = "$DEFAULT" ] && [ -f "$BOOT/cmdline.txt" ]; then
		cp "$_cmd" "$BOOT/.cmdline.txt.new" && mv -f "$BOOT/.cmdline.txt.new" "$BOOT/cmdline.txt"
	fi
	boot_sync
	cp "$IMAGES/$_run.json" "$STATE_DIR/$_run.prev.json.tmp" && mv -f "$STATE_DIR/$_run.prev.json.tmp" "$STATE_DIR/$_run.prev.json"
	cp "$_man" "$IMAGES/.$_run.json.tmp" && mv -f "$IMAGES/.$_run.json.tmp" "$IMAGES/$_run.json"
	$SYNC
}

# push_live <slot> <name> <id> <root hash>: the layer now, over LIVE_DIRS,
# its units restarted. Sets LIVE_DONE, LIVE_LATER, RESTARTED.
push_live() {
	_run=$1 _name=$2 _lid=$3 _root=$4
	LIVE_DONE='' LIVE_LATER='' RESTARTED=''
	_short=$(printf '%s' "$_lid" | cut -c1-12)
	_dm=$($INIT open "$LAYERS/$_lid.erofs" "$IMAGES/$_run.json" "$_root" "push-$_name-$_short" 2>/dev/null) ||
		die "dm-verity refused the pushed layer (it's kept for the next boot)"
	_mnt=$LIVE/$_name-$_short
	mkdir -p "$_mnt"
	$MOUNT -t erofs -o ro "$_dm" "$_mnt" || die "can't mount the pushed layer ($_dm)"
	# The root as it booted, without what earlier pushes laid over it.
	_orig=$LIVE/root
	if [ ! -e "$LIVE/.root-bound" ]; then
		mkdir -p "$_orig"
		$MOUNT --bind "$LIVE_ROOT/" "$_orig" || die "can't bind the booted root"
		: > "$LIVE/.root-bound"
	fi
	for _d in $LIVE_DIRS; do
		[ -d "$_mnt/$_d" ] || continue
		_at=$LIVE_ROOT/$_d
		# Something else mounted under it would be hidden: leave it to the
		# next boot.
		if awk -v p="$_at/" 'index($5, p) == 1 { found = 1 } END { exit !found }' "${SLOTS_MOUNTINFO:-/proc/self/mountinfo}"; then
			LIVE_LATER="$LIVE_LATER /$_d"
			continue
		fi
		if grep -qx "$_d" "$LIVE/.dirs" 2>/dev/null; then
			$UMOUNT -l "$_at" 2>/dev/null || true
		fi
		$MOUNT -t overlay overlay -o "ro,lowerdir=$_mnt/$_d:$_orig/$_d" "$_at" || die "can't lay the layer over /$_d"
		grep -qx "$_d" "$LIVE/.dirs" 2>/dev/null || echo "$_d" >> "$LIVE/.dirs"
		LIVE_DONE="$LIVE_DONE /$_d"
	done
	for _e in "$_mnt"/*; do
		[ -e "$_e" ] || continue
		_d=${_e##*/}
		case " $LIVE_DIRS " in *" $_d "*) ;; *) LIVE_LATER="$LIVE_LATER /$_d" ;; esac
	done
	# The layer's units: reloaded, and the running ones restarted.
	$SYSTEMCTL daemon-reload 2>/dev/null || true
	for _u in "$_mnt"/usr/lib/systemd/system/*.service "$_mnt"/etc/systemd/system/*.service; do
		[ -e "$_u" ] || continue
		_u=${_u##*/}
		case $_u in *@.service) continue ;; esac
		if $SYSTEMCTL is-active -q "$_u" 2>/dev/null; then
			$SYSTEMCTL restart "$_u" 2>/dev/null || board_log "restarting $_u failed"
			RESTARTED="$RESTARTED $_u"
		fi
	done
}

cmd_push() {
	_file='' _mode=live _revert=''
	while [ $# -gt 0 ]; do
		case "$1" in
		--reboot) _mode=reboot; shift ;;
		--no-restart) _mode=keep; shift ;;
		--revert) _revert=${2:-}; shift 2 || die "usage: slots push --revert <layer name>" ;;
		-) _file=-; shift ;;
		-*) die "unknown option '$1'" ;;
		*) _file=$1; shift ;;
		esac
	done
	_run=$(running)
	[ -n "$_run" ] || refuse "the initramfs didn't say which slot is running"
	[ -r "$IMAGES/$_run.json" ] && layered "$IMAGES/$_run.json" > /dev/null ||
		refuse "the running slot $_run isn't layered; push needs a layered slot"
	_work=$(mktemp -d "$IMAGES/.push.XXXXXX") || die "no work dir on /data"
	WORK_DIR=$_work
	if [ -n "$_revert" ]; then
		[ -r "$STATE_DIR/$_run.prev.json" ] || refuse "no push to revert on $_run"
		_name=$_revert
		_lid=$(layered "$STATE_DIR/$_run.prev.json" | awk -v n="$_name" '$1 == n { print $2 }')
		[ -n "$_lid" ] || refuse "the slot before the last push has no layer $_name"
		[ -r "$LAYERS/$_lid.erofs" ] || die "layer $_name ($_lid) is no longer on the board"
		cp "$STATE_DIR/$_run.prev.json" "$_work/slot.json"
	else
		[ -n "$_file" ] || die "usage: slots push <layer.tar|-> [--reboot|--no-restart]"
		if [ "$_file" = - ]; then
			tar -xf - -C "$_work" || die "the layer doesn't unpack"
		else
			[ -r "$_file" ] || die "no layer at $_file"
			tar -xf "$_file" -C "$_work" || die "the layer doesn't unpack"
		fi
		[ -r "$_work/layer.json" ] || die "not a layer push (layer.json, <id>.erofs)"
		$INIT set-layer "$IMAGES/$_run.json" "$_work/layer.json" > "$_work/slot.json" || die "the layer doesn't fit slot $_run"
		_name=$($INIT field "$_work/layer.json" name) || die "layer.json has no name"
		_lid=$($INIT field "$_work/layer.json" id) || die "layer.json has no id"
		_lsz=$($INIT field "$_work/layer.json" size) || die "layer.json has no size"
		_lsha=$($INIT field "$_work/layer.json" sha256) || die "layer.json has no sha256"
		if [ "$(board_file_size "$LAYERS/$_lid.erofs" 2>/dev/null)" != "$_lsz" ]; then
			[ -r "$_work/$_lid.erofs" ] || die "the push has no $_lid.erofs and the board doesn't have it"
			[ "$(board_file_size "$_work/$_lid.erofs")" = "$_lsz" ] || die "the layer isn't the size layer.json says"
			[ "$(sha256sum "$_work/$_lid.erofs" | cut -d' ' -f1)" = "$_lsha" ] || die "the layer doesn't match layer.json's sha256"
			mkdir -p "$LAYERS"
			mv -f "$_work/$_lid.erofs" "$LAYERS/.$_lid.erofs.tmp"
			$SYNC
			mv -f "$LAYERS/.$_lid.erofs.tmp" "$LAYERS/$_lid.erofs"
		fi
	fi
	_old=$(layered "$IMAGES/$_run.json" | awk -v n="$_name" '$1 == n { print $2 }')
	_root=$(layered "$_work/slot.json" | awk -v n="$_name" '$1 == n { print $5 }')
	if [ "$_old" = "$_lid" ]; then
		printf '{"ok":true,"slot":%s,"layer":%s,"id":"%s","changed":false}\n' "$(board_json_str "$_run")" "$(board_json_str "$_name")" "$_lid"
		return 0
	fi
	push_persist "$_run" "$_work/slot.json"
	gc_layers
	board_event slot.layer-pushed "slot $_run: layer $_name is now $(printf '%s' "$_lid" | cut -c1-12)$([ -z "$_revert" ] || echo ' (reverted)')" \
		"slot=$_run" "layer=$_name" "id=$_lid" "previous=$_old" "mode=$_mode"
	LIVE_DONE='' LIVE_LATER='' RESTARTED=''
	case $_mode in
	reboot)
		plain_reboot
		;;
	live)
		push_live "$_run" "$_name" "$_lid" "$_root"
		;;
	esac
	# shellcheck disable=SC2086
	printf '{"ok":true,"slot":%s,"layer":%s,"id":"%s","previous":"%s","changed":true,"mode":"%s","live":%s,"next_boot":%s,"restarted":%s}\n' \
		"$(board_json_str "$_run")" "$(board_json_str "$_name")" "$_lid" "$_old" "$_mode" \
		"$(json_list $LIVE_DONE)" "$(json_list $LIVE_LATER)" "$(json_list $RESTARTED)"
}

# --- main -------------------------------------------------------------------

mkdir -p "$BOARD_RUN_DIR" "$STATE_DIR" "$IMAGES"
case "${1:-}" in
stage | stage-url | apply | boot-once | rollback | remove | set-default | push) board_refuse_if_locked "update ${1}" ;;
esac
# A check changes nothing: no lock, so it never waits behind an install.
if [ "${1:-}" = check ]; then
	shift
	load_state
	cmd_check "$@"
	exit 0
fi
exec 9> "$BOARD_RUN_DIR/update.lock"
if command -v flock >/dev/null 2>&1; then
	waited=0
	until flock -n 9; do
		[ "${1:-}" != status ] && [ "${1:-}" != list ] || { cat "$STATUS_JSON" 2>/dev/null && exit 0; }
		[ "$waited" -lt "${UPDATE_LOCK_WAIT:-60}" ] || refuse "another update command is still running; nothing changed"
		sleep 1
		waited=$((waited + 1))
	done
fi
load_state

cmd=${1:-}
[ $# -eq 0 ] || shift
case "$cmd" in
status | list)
	# An install that died (power loss, a kill) under the lock: an error.
	if [ "$STATE" = staging ]; then
		STATE=error PROGRESS=0 ERROR="the install was interrupted; install it again"
		save_state
	fi
	write_status
	cat "$STATUS_JSON"
	;;
stage) cmd_stage "$@" ;;
stage-url) cmd_stage_url "$@" ;;
apply | boot-once) cmd_boot_once "$@" ;;
confirm) cmd_confirm ;;
check-link) cmd_check_link ;;
set-default) cmd_set_default "$@" ;;
rollback) cmd_rollback "$@" ;;
remove) cmd_remove "$@" ;;
pin) cmd_pin yes "${1:-}" ;;
unpin) cmd_pin no "${1:-}" ;;
cancel) cmd_cancel ;;
push) cmd_push "$@" ;;
*)
	sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//' >&2
	exit 2
	;;
esac
