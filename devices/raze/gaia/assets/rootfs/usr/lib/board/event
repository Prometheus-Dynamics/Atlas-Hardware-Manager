#!/bin/sh
# The board's event log (lib.sh board_event) from the command line.
#
#   event <kind> <message> [key=value ...]   append an event
#   event --json [--since <unix s>] [--limit <n>]
#                                            print events as JSON, oldest first
#
# The source is $BOARD_EVENT_SOURCE (atlas, orion), else local: Atlas sets it
# on its SSH commands and board-agent on what it runs, so a command typed on
# the board counts as local. Appending never fails.
set -u

BOARD_LIB_DIR=${BOARD_LIB_DIR:-/usr/lib/board}
# shellcheck source=lib.sh
. "$BOARD_LIB_DIR/lib.sh"

usage() {
	sed -n '4,6p' "$0" | sed 's/^# \{0,1\}//' >&2
	exit 2
}

number() {
	case "$1" in
	'' | *[!0-9]*) usage ;;
	esac
	[ "${#1}" -le 12 ] || usage
}

case "${1:-}" in
--json)
	shift
	since=0
	limit=200
	while [ $# -gt 0 ]; do
		case "$1" in
		--since) since=${2:-}; number "$since"; shift 2 ;;
		--limit) limit=${2:-}; number "$limit"; shift 2 ;;
		*) usage ;;
		esac
	done
	[ "$limit" -le "$BOARD_EVENT_MAX" ] || limit=$BOARD_EVENT_MAX
	board_events_json "$since" "$limit"
	;;
'' | -*) usage ;;
*)
	[ $# -ge 2 ] || usage
	board_event "$@"
	;;
esac
exit 0
