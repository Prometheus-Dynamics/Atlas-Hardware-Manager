#!/bin/sh
# board-update: A/B updates with the Pi bootloader's tryboot (docs/ota.md).
#
#   update status              JSON on stdout (also /run/board/update.json)
#   update stage <image> --sha256 <hex>
#                              verify, copy the image's slot A into the
#                              inactive slot, fix its cmdline
#   update stage - --sha256 <hex> [--format xz|zst|gz|raw]
#                              the same from stdin (checked at the end)
#   update stage-url <url> --sha256 <hex> --size <bytes> [--format ...]
#                              download to /data/board/update/ (resumed when
#                              interrupted), check size and SHA-256, stage
#   update apply               boot the staged slot once on trial ("0 tryboot")
#   update confirm             on the trial boot, once healthy: keep it
#   update cancel              stop a running stage, or forget a staged update
#   update rollback [--no-reboot]
#                              boot the previous confirmed slot again
#   update check-link          after boot: fall back to the previous slot when
#                              the board's management services stay down
#
# States (STATE in board-update.env, "state" in the JSON): idle, staging,
# staged, rebooting (apply's or rollback's restart was accepted), trying (the
# trial boot), confirmed, rolled-back, cancelled, error. Exit status: 0 done,
# 3 refused with nothing changed (wrong state, another command still running
# after UPDATE_LOCK_WAIT seconds, a read-only p1), anything else failed
# (recorded as `error` once staging began; a failed write to p1 is in
# update.json). `status` answers from update.json without the lock.
# While the state is trying, "phase" in the JSON says how far the trial's
# judgement is: null before `confirm` starts it (the new image is still
# coming up), "checking" while its checks run, "failed" once they failed
# (restarting into the old version). Kept for this boot only
# ($BOARD_RUN_DIR/update.phase); null in every other state.
#
# Layout (MBR on the eMMC): p1 holds autoboot.txt only; boot A/B are p2/p3
# (FAT), root A/B are p5/p6. autoboot.txt's [all] boot_partition is the
# default; its [tryboot] section is what `reboot "0 tryboot"` boots once.
# If the trial never confirms, the next reset boots the default again.
#
# The input is the same whole-disk image that is flashed over USB (.img,
# .img.xz, .img.zst or .img.gz, A/B layout). board-image-slots copies its boot
# slot A (p2) and root slot A (p5) out of the decompressed stream into this
# board's inactive slot in one pass; p1, the other slot and /data in the
# image are skipped. A file is checked against --sha256 (of the file as
# given) before anything is written; stdin is checked when it ends, and a
# mismatch leaves the slot unstaged. The new root's board-package.env must
# name this model, and its os-release gives the version.
#
# The OS may add hooks in /etc/board/update.d/: pre-stage, post-stage,
# pre-reboot, post-boot (plus update-health). A failing pre- hook stops that
# step; post- hooks are logged only. They get BOARD_UPDATE_SLOT,
# BOARD_UPDATE_VERSION and BOARD_UPDATE_IMAGE.
#
# State lives on p1 (shared by both slots) in board-update.env. Settings:
# update.env.
set -eu

BOARD_LIB_DIR=${BOARD_LIB_DIR:-/usr/lib/board}
# shellcheck source=lib.sh
. "$BOARD_LIB_DIR/lib.sh"
board_load_env board-package.env
board_load_env update.env

# Partition numbers of the two slots: "<boot> <root>".
SLOT_A=${UPDATE_SLOT_A:-2 5}
SLOT_B=${UPDATE_SLOT_B:-3 6}
AUTOBOOT_PART=${UPDATE_AUTOBOOT_PART:-1}
# Test hooks: where partitions live and how a FAT partition is mounted.
PART_PREFIX=${UPDATE_PART_PREFIX:-}
MOUNT=${UPDATE_MOUNT:-mount}
UMOUNT=${UPDATE_UMOUNT:-umount}
MOUNT_RO=${UPDATE_MOUNT_RO:-mount -o ro}
SYSTEMCTL=${UPDATE_SYSTEMCTL:-systemctl}
SLOTS=${UPDATE_SLOTS_TOOL:-board-image-slots}
# Flushes writes to the eMMC; tests stub it, since a whole-system sync can
# take minutes on a busy build machine.
SYNC=${UPDATE_SYNC:-sync}
CMDLINE_ROOT=${UPDATE_CMDLINE_ROOT:-}
WORK=${BOARD_RUN_DIR}/update
STATUS_JSON=${BOARD_RUN_DIR}/update.json
PHASE_FILE=${BOARD_RUN_DIR}/update.phase
# The running stage's PID (stage, stage-url), for `cancel`.
PID_FILE=${BOARD_RUN_DIR}/update.pid
# Where stage-url keeps its download: persistent (/run is RAM), so an
# interrupted download resumes.
DOWNLOAD_DIR=${UPDATE_DOWNLOAD_DIR:-$BOARD_DATA_DIR/update}
# curl or wget; empty takes whichever the image has.
DOWNLOADER=${UPDATE_DOWNLOADER:-}
# Seconds between progress updates of update.json while downloading or
# copying.
POLL=${UPDATE_POLL:-1}
# Where the stage's progress starts, per mille: stage-url's download takes
# 0-500 and its stage 500-1000.
STAGE_FROM=0
PUMP=''

die() {
	board_log "$*"
	stop_pump
	# Inside with_autoboot, p1 is already mounted: record the failure there.
	if [ -n "${AB:-}" ] && [ -d "$AB" ]; then
		STATE=error
		ERROR="$*"
		save_state 2>/dev/null || true
		board_event update.failed "$*" "slot=${SLOT_STAGED:-}"
		$SYNC
		$UMOUNT "$AB" >/dev/null 2>&1 || true
	fi
	exit 1
}

# Refuses a command without touching the recorded state (inside
# with_autoboot: its status is the command's). Exit status 3 always means
# "refused, nothing changed" (also when another command holds the lock), so
# a caller such as board-agent can tell a refusal from a failed stage.
REFUSED=3
refuse() {
	board_log "$*"
	return "$REFUSED"
}

# Records a failure outside with_autoboot (stage-url's download), then exits.
fail() {
	FAILURE="$*"
	board_log "$FAILURE"
	with_autoboot _record_failure || true
	exit 1
}
_record_failure() {
	load_state
	STATE=error ERROR=$FAILURE
	save_state
	board_event update.failed "$FAILURE"
}

# The disk's partition prefix, e.g. /dev/mmcblk0p or /dev/sda.
root_disk() {
	if [ -n "$PART_PREFIX" ]; then
		echo "$PART_PREFIX"
		return
	fi
	root=$(board_root_device)
	case "$root" in
	*[0-9]p[0-9]*) echo "${root%p[0-9]*}p" ;;
	*) echo "${root%%[0-9]*}" ;;
	esac
}

part() { echo "$(root_disk)$1"; }

# The root partition number the system booted from.
active_root() {
	if [ -n "$CMDLINE_ROOT" ]; then
		echo "$CMDLINE_ROOT"
		return
	fi
	src=$(board_root_device)
	echo "${src##*[!0-9]}"
}

slot_of_root() {
	a_root=$(echo "$SLOT_A" | cut -d' ' -f2)
	b_root=$(echo "$SLOT_B" | cut -d' ' -f2)
	case "$(active_root)" in
	"$a_root") echo A ;;
	"$b_root") echo B ;;
	*) echo unknown ;;
	esac
}

other() { [ "$1" = A ] && echo B || echo A; }
slot_boot() { if [ "$1" = A ]; then echo "$SLOT_A" | cut -d' ' -f1; else echo "$SLOT_B" | cut -d' ' -f1; fi; }
slot_root() { if [ "$1" = A ]; then echo "$SLOT_A" | cut -d' ' -f2; else echo "$SLOT_B" | cut -d' ' -f2; fi; }

# Mounts partition $1 at a fresh directory and prints it.
mount_part() {
	dir="$WORK/mnt-$1"
	mkdir -p "$dir"
	$MOUNT "$(part "$1")" "$dir" >/dev/null || return 1
	echo "$dir"
}

# Mounts partition $1 read-only (a slot's new root) and prints where.
mount_part_ro() {
	dir="$WORK/mnt-$1"
	mkdir -p "$dir"
	$MOUNT_RO "$(part "$1")" "$dir" >/dev/null
	echo "$dir"
}

with_autoboot() {
	# with_autoboot <function>: runs it with $AB pointing at mounted p1.
	# p1 that can't be mounted, or mounts read-only (it shares the
	# superblock of a read-only mount elsewhere), stops the command first.
	mkdir -p "$WORK"
	if ! AB=$(mount_part "$AUTOBOOT_PART"); then
		AB=''
		board_log "couldn't mount the boot partition (p$AUTOBOOT_PART); nothing changed"
		exit 1
	fi
	# (In a subshell: a failed redirection of a special built-in such as `:`
	# ends the whole shell.)
	if [ "$1" != _status ] && ! (: > "$AB/.board-update.probe") 2>/dev/null; then
		$UMOUNT "$AB" >/dev/null 2>&1 || true
		AB=''
		ERROR="the boot partition (p$AUTOBOOT_PART) is read-only$(ro_note); nothing changed"
		board_log "$ERROR"
		write_status_json 2>/dev/null || true
		exit "$REFUSED"
	fi
	rm -f "$AB/.board-update.probe"
	cp "$AB/autoboot.txt" "$WORK/autoboot.before" 2>/dev/null || rm -f "$WORK/autoboot.before"
	rc=0
	"$1" || rc=$?
	$SYNC
	$UMOUNT "$AB" >/dev/null 2>&1 || true
	AB=''
	return "$rc"
}

load_state() {
	STATE=idle SLOT_STAGED= VERSION_ACTIVE= VERSION_STAGED= ERROR= PROGRESS=0
	PREVIOUS_SLOT= PREVIOUS_VERSION= BAD_BOOTS=0 SWITCH_BOOT= SWITCH_COUNT= SHA256_STAGED= STARTED_BY=
	if [ -r "$AB/board-update.env" ]; then
		# shellcheck disable=SC1091
		. "$AB/board-update.env"
	fi
	# Before the first update, the running image says what it is.
	[ -n "$VERSION_ACTIVE" ] || VERSION_ACTIVE=$(board_os_field VERSION_ID)
}

# A write to p1 that didn't happen ends the command (status 1): nothing it
# would do or print after it is true. p1 can't take the error, so it goes to
# update.json; the state on p1 is what it was.
write_failed() {
	ERROR="couldn't write $1 on the boot partition (p$AUTOBOOT_PART)$(ro_note)"
	# A switch writes autoboot.txt before the state: put it back, so the
	# board boots what the state on p1 says.
	if [ -n "${AB:-}" ] && [ -r "$WORK/autoboot.before" ] && ! cmp -s "$WORK/autoboot.before" "$AB/autoboot.txt"; then
		if cp "$WORK/autoboot.before" "$AB/autoboot.txt" 2>/dev/null; then
			ERROR="$ERROR; autoboot.txt is back as it was"
		else
			ERROR="$ERROR; autoboot.txt couldn't be put back"
		fi
	fi
	board_log "$ERROR"
	write_status_json 2>/dev/null || true
	stop_pump
	if [ -n "${AB:-}" ]; then
		$UMOUNT "$AB" >/dev/null 2>&1 || true
		AB=''
	fi
	exit 1
}

# ": it is mounted read-only at <dir>" when p1 is, else nothing.
ro_note() {
	dev=$(part "$AUTOBOOT_PART")
	where=$(awk -v d="$dev" '$1 == d && $4 ~ /^ro(,|$)/ { print $2; exit }' /proc/mounts 2>/dev/null) || where=''
	[ -n "$where" ] && printf ': it is mounted read-only at %s' "$where"
	return 0
}

save_state() {
	{
		printf 'STATE=%s\n' "$STATE"
		printf 'SLOT_STAGED=%s\n' "$SLOT_STAGED"
		printf 'VERSION_ACTIVE=%s\n' "$(quote "$VERSION_ACTIVE")"
		printf 'VERSION_STAGED=%s\n' "$(quote "$VERSION_STAGED")"
		printf 'ERROR=%s\n' "$(quote "$ERROR")"
		printf 'PROGRESS=%s\n' "$PROGRESS"
		printf 'PREVIOUS_SLOT=%s\n' "$PREVIOUS_SLOT"
		printf 'PREVIOUS_VERSION=%s\n' "$(quote "$PREVIOUS_VERSION")"
		printf 'BAD_BOOTS=%s\n' "${BAD_BOOTS:-0}"
		printf 'SWITCH_BOOT=%s\n' "$(quote "${SWITCH_BOOT:-}")"
		printf 'SWITCH_COUNT=%s\n' "${SWITCH_COUNT:-}"
		printf 'SHA256_STAGED=%s\n' "${SHA256_STAGED:-}"
		printf 'STARTED_BY=%s\n' "${STARTED_BY:-}"
	} > "$AB/board-update.env.tmp" || write_failed board-update.env
	mv "$AB/board-update.env.tmp" "$AB/board-update.env" || write_failed board-update.env
	write_status_json
}

quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# This boot's count and whether the boot before it shut down cleanly
# (boot-record's boot.json): "<count> <true|false|null>", empty when unknown.
boot_record() {
	sed -n 's/.*"count":\([0-9]*\),.*"previous_clean":\([a-z]*\),.*/\1 \2/p' "$BOARD_RUN_DIR/boot.json" 2>/dev/null | head -n 1
}

# The kernel's id of this boot; empty when unknown.
boot_id() {
	if [ -n "${UPDATE_BOOT_ID:-}" ]; then
		echo "$UPDATE_BOOT_ID"
		return
	fi
	cat /proc/sys/kernel/random/boot_id 2>/dev/null || true
}

# The state as reported. A switch (apply, rollback) records the boot it was
# made in (SWITCH_BOOT): `rebooting` seen in a later boot is the trial boot
# before `confirm` ran, so it reports `trying`; a rollback reports
# `rebooting` until the board has restarted, then `rolled-back`.
reported_state() {
	now=$(boot_id)
	case "$STATE" in
	rebooting)
		if [ -n "${SWITCH_BOOT:-}" ] && [ -n "$now" ] && [ "$SWITCH_BOOT" != "$now" ]; then
			echo trying
			return
		fi
		;;
	rolled-back)
		if [ -n "${SWITCH_BOOT:-}" ] && [ "$SWITCH_BOOT" = "$now" ]; then
			echo rebooting
			return
		fi
		;;
	esac
	echo "$STATE"
}

# set_phase <checking|failed>: the trial's phase, for this boot (see the top).
set_phase() {
	mkdir -p "$BOARD_RUN_DIR"
	printf '%s\n' "$1" > "$PHASE_FILE.tmp.$$" && mv -f "$PHASE_FILE.tmp.$$" "$PHASE_FILE"
}

write_status_json() {
	mkdir -p "$BOARD_RUN_DIR"
	_state=$(reported_state)
	_phase=''
	[ "$_state" != trying ] || _phase=$(head -n 1 "$PHASE_FILE" 2>/dev/null | tr -cd 'a-z')
	printf '{"state":%s,"slot_active":%s,"slot_staged":%s,"version_active":%s,"version_staged":%s,"progress":%s,"error":%s,"version_previous":%s,"started_by":%s,"phase":%s}\n' \
		"$(board_json_str "$_state")" "$(board_json_str "$(slot_of_root)")" "$(board_json_str "$SLOT_STAGED")" \
		"$(board_json_str "$VERSION_ACTIVE")" "$(board_json_str "$VERSION_STAGED")" "${PROGRESS:-0}" \
		"$(board_json_str "$ERROR")" "$(board_json_str "${PREVIOUS_SLOT:+$PREVIOUS_VERSION}")" \
		"$(board_json_str "${STARTED_BY:-}")" "$(board_json_str "$_phase")" > "$STATUS_JSON.tmp.$$"
	chmod 0644 "$STATUS_JSON.tmp.$$" 2>/dev/null || true
	# The boot it describes: `status` trusts update.json only in that boot.
	boot_id > "$STATUS_JSON.boot"
	mv "$STATUS_JSON.tmp.$$" "$STATUS_JSON"
}

# The stage's own progress (0-1000) as reported, after STAGE_FROM.
stage_progress() { echo $((STAGE_FROM + $1 * (1000 - STAGE_FROM) / 1000)); }

# Keeps update.json's progress current while board-image-slots copies (it
# writes its own 0-1000 to $WORK/progress). Runs in the background; the copy
# maps to 100-950 of the stage.
pump_progress() {
	while sleep "$POLL"; do
		pm=$(cat "$WORK/progress" 2>/dev/null || true)
		case "$pm" in
		'' | *[!0-9]*) continue ;;
		esac
		PROGRESS=$(stage_progress $((100 + pm * 85 / 100)))
		write_status_json
	done
}

stop_pump() {
	[ -n "${PUMP:-}" ] || return 0
	kill "$PUMP" 2>/dev/null || true
	wait "$PUMP" 2>/dev/null || true
	PUMP=''
}

# autoboot.txt for "<default boot> [<tryboot boot>]".
write_autoboot() {
	{
		echo "[all]"
		echo "tryboot_a_b=1"
		echo "boot_partition=$1"
		if [ -n "${2:-}" ]; then
			echo "[tryboot]"
			echo "boot_partition=$2"
		fi
	} > "$AB/autoboot.txt.tmp" || write_failed autoboot.txt
	mv "$AB/autoboot.txt.tmp" "$AB/autoboot.txt" || write_failed autoboot.txt
}

default_boot() { sed -n '/^\[all\]/,/^\[/{s/^boot_partition=\([0-9]*\).*/\1/p}' "$AB/autoboot.txt" | head -n 1; }

cmd_status() {
	with_autoboot _status
}
_status() {
	load_state
	if [ -z "$VERSION_ACTIVE" ]; then
		VERSION_ACTIVE=$(board_os_field VERSION_ID)
	fi
	# Holding the lock, nothing else is staging: a `staging` state is left
	# over from a stage that was interrupted (power loss, a killed process).
	if [ "$STATE" = staging ] && [ "$HAVE_FLOCK" = 1 ]; then
		STATE=error PROGRESS=0
		ERROR="the update was interrupted while staging; stage it again"
		save_state
	fi
	write_status_json
	cat "$STATUS_JSON"
}

# Restarts once into the [tryboot] slot. systemd 258 dropped the positional
# argument (`systemctl reboot "0 tryboot"`); --reboot-argument works on every
# systemd that matters. Returns non-zero when the restart wasn't accepted.
tryboot_reboot() {
	if [ -n "${UPDATE_REBOOT:-}" ]; then
		eval "$UPDATE_REBOOT"
		return
	fi
	if command -v "$SYSTEMCTL" >/dev/null 2>&1; then
		"$SYSTEMCTL" reboot --reboot-argument='0 tryboot'
		return
	fi
	board_log "no systemctl: can't pass the tryboot flag to the bootloader"
	return 1
}

plain_reboot() {
	eval "${UPDATE_REBOOT_PLAIN:-$SYSTEMCTL reboot}"
}

# The package's own checks of a booted slot, before the OS's health hook.
# Prints the reason and returns 1 when the slot isn't fit to keep:
# - the running kernel has modules on this root (boot and root slot match);
# - the USB gadget, the board's management link, is bound (when enabled);
# - none of the critical units failed.
slot_sanity() {
	release=${UPDATE_UNAME_R:-$(uname -r)}
	if [ ! -d "${UPDATE_MODULES_ROOT:-}/lib/modules/$release" ] &&
		[ ! -d "${UPDATE_MODULES_ROOT:-}/usr/lib/modules/$release" ]; then
		echo "the kernel ($release) has no modules on this root slot: the boot and root slots don't belong together"
		return 1
	fi
	(
		board_load_env usb-gadget.env
		[ "${USB_GADGET_ENABLED:-1}" = 1 ] || exit 0
		for udc in "${UPDATE_GADGET_DIR:-/sys/kernel/config/usb_gadget}"/*/UDC; do
			[ -s "$udc" ] && exit 0
		done
		echo "the USB gadget (the board's management link) isn't up"
		exit 1
	) || return 1
	if command -v "$SYSTEMCTL" >/dev/null 2>&1; then
		for unit in ${UPDATE_CRITICAL_UNITS:-}; do
			if "$SYSTEMCTL" is-failed --quiet "$unit" 2>/dev/null; then
				echo "$unit failed"
				return 1
			fi
		done
	fi
	return 0
}

# The kernel release in a boot slot's kernel image (raw or gzip Image),
# from config.txt's kernel= or the Pi 5's default names. Empty if unknown.
kernel_release() {
	kfile=$(sed -n 's/^[[:space:]]*kernel=[[:space:]]*//p' "$1/config.txt" 2>/dev/null | tail -n 1)
	for name in $kfile kernel_2712.img kernel8.img; do
		[ -r "$1/$name" ] || continue
		case "$(od -An -tx1 -N2 "$1/$name" | tr -d ' \n')" in
		1f8b) gzip -dc < "$1/$name" ;;
		*) cat "$1/$name" ;;
		esac 2>/dev/null | LC_ALL=C tr '\000' '\n' |
			LC_ALL=C sed -n 's/.*Linux version \([^ ]*\).*/\1/p' | head -n 1
		# (NULs to lines, not `tr -c '[:print:]'`: busybox tr has no
		# classes. tests/update.sh runs this with busybox's tools.)
		return
	done
}

# run_hook <name>: the OS's hook, if any. Prints nothing; returns its status.
run_hook() {
	hook=$BOARD_ETC_DIR/update.d/$1
	[ -x "$hook" ] || return 0
	board_log "running the $1 hook"
	BOARD_UPDATE_SLOT=${SLOT_STAGED:-} BOARD_UPDATE_VERSION=${VERSION_STAGED:-} \
		BOARD_UPDATE_IMAGE=${IMAGE:-} "$hook"
}

# The image's compression, from --format or its first bytes.
image_format() {
	if [ -n "$FORMAT" ]; then
		echo "$FORMAT"
		return
	fi
	case "$(od -An -tx1 -N6 "$IMAGE" | tr -d ' \n')" in
	fd377a585a00) echo xz ;;
	28b52ffd*) echo zst ;;
	1f8b*) echo gz ;;
	*) echo raw ;;
	esac
}

decompressor() {
	case "$1" in
	xz) if command -v xz >/dev/null 2>&1; then echo "xz -dc"; else echo xzcat; fi ;;
	zst) echo "zstd -dc" ;;
	gz) echo "gzip -dc" ;;
	raw) echo cat ;;
	*) die "unknown image format '$1' (xz, zst, gz or raw)" ;;
	esac
}

# board-image-slots's own reason, else a generic one.
slots_error() {
	reason=$(sed -n 's/^board-image-slots: //p' "$WORK/slots.err" 2>/dev/null | tail -n 1)
	echo "${reason:-copying the image into slot $1 failed}"
}

# Reads a key from an os-release style file.
field() { sed -n "s/^$1=//p" "$2" 2>/dev/null | head -n 1 | tr -d "\"'"; }

# Checks and lower-cases $SHA256.
check_sha256() {
	case "$SHA256" in
	*[!0-9a-fA-F]* | '') die "give the image's SHA-256 with --sha256" ;;
	esac
	[ ${#SHA256} -eq 64 ] || die "--sha256 must be 64 hex digits"
	SHA256=$(echo "$SHA256" | tr 'A-F' 'a-f')
}

# The stage commands record their PID for `cancel` while they hold the lock.
begin_stage() {
	echo "$$" > "$PID_FILE"
	trap 'stop_pump; rm -f "$PID_FILE"' EXIT
}

cmd_stage() {
	IMAGE='' SHA256='' FORMAT=''
	while [ $# -gt 0 ]; do
		case "$1" in
		--sha256) SHA256=${2:-}; shift 2 ;;
		--format) FORMAT=${2:-}; shift 2 ;;
		-*) [ "$1" = - ] || die "unknown option '$1'"; IMAGE=-; shift ;;
		*) IMAGE=$1; shift ;;
		esac
	done
	[ -n "$IMAGE" ] || die "usage: update stage <image|-> --sha256 <hex>"
	[ "$IMAGE" = - ] || [ -r "$IMAGE" ] || die "no image at '$IMAGE'"
	check_sha256
	[ "$IMAGE" != - ] || FORMAT=${FORMAT:-xz}
	mkdir -p "$WORK"
	begin_stage
	with_autoboot _stage
}
_stage() {
	load_state
	case "$STATE" in
	trying | rebooting) refuse "the last update is still on trial; reboot or confirm it first" || return ;;
	esac
	active=$(slot_of_root)
	[ "$active" != unknown ] || die "this system is not on an A/B layout (root partition $(active_root))"
	target=$(other "$active")
	boot=$(slot_boot "$target")
	root=$(slot_root "$target")
	unzip=$(decompressor "$(image_format)")

	STATE=staging SLOT_STAGED=$target VERSION_STAGED='' ERROR='' SWITCH_BOOT='' SHA256_STAGED=''
	STARTED_BY=$(board_event_source)
	PROGRESS=$(stage_progress 0)
	# The target slot is about to be overwritten: it is no longer a slot to
	# go back to.
	if [ "$PREVIOUS_SLOT" = "$target" ]; then
		PREVIOUS_SLOT='' PREVIOUS_VERSION=''
	fi
	save_state
	board_event update.stage "staging an update into slot $target" "slot=$target" "sha256=$SHA256"

	# A file is checked before anything is written (stage-url checked its
	# download already).
	if [ "$IMAGE" != - ]; then
		if [ "${VERIFIED:-0}" != 1 ]; then
			[ "$(sha256sum < "$IMAGE" | cut -d' ' -f1)" = "$SHA256" ] ||
				die "the image failed its SHA-256 check (damaged or incomplete copy)"
		fi
		PROGRESS=$(stage_progress 100)
		save_state
	fi
	run_hook pre-stage || die "the pre-stage hook stopped the update"

	rm -f "$WORK/progress" "$WORK/sum"
	# Without the lock's descriptor: a sleep it leaves behind must not hold
	# the lock after the stage.
	pump_progress 9>&- &
	PUMP=$!
	if [ "$IMAGE" = - ]; then
		rm -f "$WORK/hash.fifo"
		mkfifo "$WORK/hash.fifo"
		sha256sum < "$WORK/hash.fifo" > "$WORK/sum" &
		hasher=$!
		tee "$WORK/hash.fifo" | $unzip | "$SLOTS" --drain --progress "$WORK/progress" \
			--boot-out "$(part "$boot")" --root-out "$(part "$root")" > "$WORK/slots.env" 2> "$WORK/slots.err" ||
			die "$(slots_error "$target")"
		wait "$hasher" || true
		rm -f "$WORK/hash.fifo"
		[ "$(cut -d' ' -f1 "$WORK/sum")" = "$SHA256" ] ||
			die "the image failed its SHA-256 check; slot $target was written but is not used"
	else
		$unzip < "$IMAGE" | "$SLOTS" --progress "$WORK/progress" \
			--boot-out "$(part "$boot")" --root-out "$(part "$root")" > "$WORK/slots.env" 2> "$WORK/slots.err" ||
			die "$(slots_error "$target")"
	fi
	stop_pump
	PROGRESS=$(stage_progress 950)
	save_state

	# The new root says what it is.
	newroot=$(mount_part_ro "$root")
	modules=$(ls "$newroot/lib/modules" "$newroot/usr/lib/modules" 2>/dev/null | sort -u | tr '\n' ' ')
	model=$(field BOARD_DEVICE_MODEL "$newroot/usr/lib/board/board-package.env")
	version=$(field IMAGE_VERSION "$newroot/etc/os-release")
	[ -n "$version" ] || version=$(field VERSION_ID "$newroot/etc/os-release")
	[ -n "$version" ] || version=$(field VERSION_ID "$newroot/usr/lib/os-release")
	[ -n "$version" ] || version=$(field VERSION "$newroot/etc/os-release")
	$UMOUNT "$newroot" >/dev/null 2>&1 || true
	if [ -n "$model" ] && [ -n "${BOARD_DEVICE_MODEL:-}" ] && [ "$model" != "$BOARD_DEVICE_MODEL" ]; then
		die "the image is for a '$model', this is a '$BOARD_DEVICE_MODEL'"
	fi
	[ -n "$model" ] || board_log "the image carries no device package; it can't be updated in place again"
	VERSION_STAGED=${version:-unknown}

	# One boot image serves both slots: point this copy at its own root. Its
	# kernel must be the one the new root has modules for.
	mnt=$(mount_part "$boot")
	kernel=$(kernel_release "$mnt")
	if [ -n "$kernel" ] && [ -n "$modules" ]; then
		case " $modules " in
		*" $kernel "*) ;;
		*)
			$UMOUNT "$mnt" >/dev/null 2>&1 || true
			die "the image's kernel ($kernel) doesn't match the modules on its root ($modules); it would boot without drivers"
			;;
		esac
	else
		board_log "couldn't compare the kernel (${kernel:-unknown}) with the root's modules (${modules:-none})"
	fi
	if [ -f "$mnt/cmdline.txt" ]; then
		sed -i "s#root=[^ ]*#root=$(part "$root")#" "$mnt/cmdline.txt"
	fi
	# What the slot's boot files are, so `status` can tell when they drift.
	board_boot_hashes "$mnt" > "$AB/board-boot.$target.sha256.tmp" &&
		mv -f "$AB/board-boot.$target.sha256.tmp" "$AB/board-boot.$target.sha256"
	rm -f "$BOARD_DATA_DIR/drift/boot.$target.sha256" 2>/dev/null || true
	$SYNC
	$UMOUNT "$mnt" >/dev/null 2>&1 || true

	STATE=staged PROGRESS=1000 SHA256_STAGED=$SHA256
	save_state
	run_hook post-stage || board_log "the post-stage hook failed"
	board_log "staged $VERSION_STAGED in slot $target"
	board_event update.staged "staged $VERSION_STAGED in slot $target" "version=$VERSION_STAGED" "slot=$target"
}

# A file's size in bytes, 0 when it doesn't exist (ls works everywhere and
# doesn't read the file).
size_of() {
	n=$(ls -ln "$1" 2>/dev/null | awk '{ print $5 }')
	echo "${n:-0}"
}

# curl or wget, whichever is installed (UPDATE_DOWNLOADER picks one).
downloader() {
	if [ -n "$DOWNLOADER" ]; then
		command -v "$DOWNLOADER" >/dev/null 2>&1 || return 1
		echo "$DOWNLOADER"
	elif command -v curl >/dev/null 2>&1; then
		echo curl
	elif command -v wget >/dev/null 2>&1; then
		echo wget
	else
		return 1
	fi
}

# fetch <tool> <url> <file>: downloads, continuing a partial file.
fetch() {
	case "$1" in
	curl) curl -fsSL --retry 3 --connect-timeout 30 -C - -o "$3" "$2" ;;
	wget) wget -q -c -O "$3" "$2" ;;
	*) return 1 ;;
	esac
}

# Runs fetch in the background, publishing the download's share (0-500)
# of the progress, and returns its status.
fetch_with_progress() {
	fetch "$TOOL" "$URL" "$PART" &
	dl=$!
	while kill -0 "$dl" 2>/dev/null; do
		got=$(size_of "$PART")
		PROGRESS=$((got * 500 / SIZE))
		[ "$PROGRESS" -le 500 ] || PROGRESS=500
		write_status_json
		sleep "$POLL"
	done
	wait "$dl"
}

# A download that ended without error and isn't larger than the image.
download_fits() {
	fetch_with_progress && [ "$(size_of "$PART")" -le "$SIZE" ]
}

fail_download() {
	got=$(size_of "$PART")
	if [ "$got" -gt "$SIZE" ]; then
		rm -f "$PART"
		fail "the download has $got bytes, the image $SIZE"
	fi
	fail "downloading $URL failed"
}

cmd_stage_url() {
	URL='' SHA256='' SIZE='' FORMAT=''
	while [ $# -gt 0 ]; do
		case "$1" in
		--sha256) SHA256=${2:-}; shift 2 ;;
		--size) SIZE=${2:-}; shift 2 ;;
		--format) FORMAT=${2:-}; shift 2 ;;
		-*) die "unknown option '$1'" ;;
		*) URL=$1; shift ;;
		esac
	done
	[ -n "$URL" ] || die "usage: update stage-url <url> --sha256 <hex> --size <bytes>"
	check_sha256
	case "$SIZE" in
	'' | *[!0-9]* | 0) die "give the image's size in bytes with --size" ;;
	esac
	mkdir -p "$WORK"
	begin_stage
	ALREADY=0
	with_autoboot _stage_url_begin
	if [ "$ALREADY" = 1 ]; then
		board_log "$VERSION_STAGED (this image) is already staged"
		return 0
	fi

	mkdir -p "$DOWNLOAD_DIR" || fail "can't create $DOWNLOAD_DIR"
	FILE=$DOWNLOAD_DIR/$SHA256.img
	PART=$FILE.part
	# Downloads of other images only take space.
	for old in "$DOWNLOAD_DIR"/*; do
		case "$old" in
		"$FILE" | "$PART" | "$DOWNLOAD_DIR/*") ;;
		*) rm -f "$old" ;;
		esac
	done
	if [ -f "$FILE" ]; then
		mv "$FILE" "$PART"
	fi
	[ "$(size_of "$PART")" -le "$SIZE" ] || rm -f "$PART"
	if [ "$(size_of "$PART")" -lt "$SIZE" ]; then
		TOOL=$(downloader) || fail "neither curl nor wget is installed: can't download the image"
		board_log "downloading $URL with $TOOL"
		resumed=0
		[ ! -s "$PART" ] || resumed=1
		if ! download_fits; then
			# A server that can't resume (an error, or the whole file
			# appended to the part): start over once.
			if [ "$resumed" = 1 ]; then
				board_log "the download didn't continue; starting it again"
				rm -f "$PART"
				download_fits || fail_download
			else
				fail_download
			fi
		fi
	fi
	got=$(size_of "$PART")
	if [ "$got" -ne "$SIZE" ]; then
		[ "$got" -lt "$SIZE" ] || rm -f "$PART"
		fail "the download has $got bytes, the image $SIZE"
	fi
	PROGRESS=500
	write_status_json
	if [ "$(sha256sum < "$PART" | cut -d' ' -f1)" != "$SHA256" ]; then
		rm -f "$PART"
		fail "the downloaded image failed its SHA-256 check (damaged in transit, or a different file)"
	fi
	mv "$PART" "$FILE"

	IMAGE=$FILE STAGE_FROM=500 VERIFIED=1
	with_autoboot _stage
	rm -f "$FILE"
}
_stage_url_begin() {
	load_state
	case "$STATE" in
	trying | rebooting) refuse "the last update is still on trial; reboot or confirm it first" || return ;;
	esac
	if [ "$STATE" = staged ] && [ "$SHA256_STAGED" = "$SHA256" ]; then
		ALREADY=1
		write_status_json
		return 0
	fi
	STATE=staging SLOT_STAGED='' VERSION_STAGED='' ERROR='' PROGRESS=0 SWITCH_BOOT='' SHA256_STAGED=''
	STARTED_BY=$(board_event_source)
	save_state
	board_event update.download "downloading an update" "url=$URL" "size=$SIZE" "sha256=$SHA256"
}

cmd_apply() {
	with_autoboot _apply
	board_log "rebooting into the staged slot on trial"
	$SYNC
	if ! tryboot_reboot; then
		# Nothing restarted: undo the trial so the state tells the truth.
		with_autoboot _apply_failed
		exit 1
	fi
}
_apply_failed() {
	load_state
	write_autoboot "$(slot_boot "$(slot_of_root)")"
	STATE=staged SWITCH_BOOT='' ERROR="the restart into the new version didn't happen; it is still staged"
	save_state
	board_log "$ERROR"
	board_event update.apply-failed "$ERROR"
}
_apply() {
	load_state
	[ "$STATE" = staged ] || refuse "nothing is staged (state: $STATE)" || return
	# A refusal keeps the update staged, to apply later.
	if ! run_hook pre-reboot; then
		ERROR="the pre-reboot hook stopped the restart; the update is still staged"
		save_state
		refuse "$ERROR" || return
	fi
	active=$(slot_of_root)
	write_autoboot "$(slot_boot "$active")" "$(slot_boot "$SLOT_STAGED")"
	# Recorded before the restart, which may not leave time afterwards; if
	# the restart isn't accepted, _apply_failed puts it back to staged.
	STATE=rebooting SWITCH_BOOT=$(boot_id) ERROR=''
	# The boot the trial follows: the next one, unless the restart is cut
	# short (see _confirm).
	SWITCH_COUNT=$(boot_record | cut -d' ' -f1)
	save_state
	board_event update.apply "restarting into $VERSION_STAGED on trial" "version=$VERSION_STAGED" "slot=$SLOT_STAGED"
}

cmd_confirm() {
	with_autoboot _confirm
}
_confirm() {
	load_state
	case "$STATE" in
	trying) ;;
	rebooting)
		# Still the boot that asked for the restart: nothing to judge yet.
		if [ -n "$SWITCH_BOOT" ] && [ "$SWITCH_BOOT" = "$(boot_id)" ]; then
			write_status_json
			return 0
		fi
		;;
	*)
		write_status_json
		return 0
		;;
	esac
	STATE=trying SWITCH_BOOT=''
	# The trial's outcome belongs to whoever started the update.
	BOARD_EVENT_SOURCE=${BOARD_EVENT_SOURCE:-$STARTED_BY}
	active=$(slot_of_root)
	if [ "$active" != "$SLOT_STAGED" ] && [ -n "${SWITCH_COUNT:-}" ] &&
		[ "$(boot_record)" = "$((SWITCH_COUNT + 1)) false" ]; then
		# The very next boot, still on the old slot, after a boot that didn't
		# shut down cleanly: the reset came during the shutdown, before the
		# restart into the trial (the firmware boots the default then). The
		# trial never ran: still staged, to apply again.
		STATE=staged SWITCH_COUNT=''
		ERROR="the restart into $VERSION_STAGED was cut short (the board reset before it finished shutting down), so its trial never started; it is still staged: apply it again"
		write_autoboot "$(slot_boot "$active")"
		save_state
		board_log "$ERROR"
		board_event update.apply-interrupted "$ERROR" "version=$VERSION_STAGED" "slot=$SLOT_STAGED"
		return 0
	fi
	SWITCH_COUNT=''
	if [ "$active" != "$SLOT_STAGED" ]; then
		# The trial boot didn't stick; the bootloader went back by itself.
		STATE=rolled-back ERROR=${ERROR:-"the new version didn't start; back on $VERSION_ACTIVE"}
		write_autoboot "$(slot_boot "$active")"
		save_state
		board_event update.rolled-back "$ERROR" "version=$VERSION_ACTIVE" "slot=$active"
		return 0
	fi
	# The trial's checks start now (the new image is up to this unit).
	set_phase checking
	save_state
	run_hook post-boot || board_log "the post-boot hook failed"
	# Give the services a moment to come up before judging them.
	sleep "${UPDATE_CONFIRM_DELAY:-0}"
	if ! reason=$(slot_sanity); then
		fail_trial "$reason"
		return 1
	fi
	health=${UPDATE_HEALTH:-}
	if [ -z "$health" ]; then
		for candidate in "$BOARD_ETC_DIR/update-health" "$BOARD_LIB_DIR/update-health"; do
			[ -x "$candidate" ] && health=$candidate && break
		done
	fi
	if [ -n "$health" ] && ! "$health"; then
		fail_trial "the health check failed"
		return 1
	fi
	write_autoboot "$(slot_boot "$active")"
	PREVIOUS_SLOT=$(other "$active") PREVIOUS_VERSION=$VERSION_ACTIVE BAD_BOOTS=0
	STATE=confirmed VERSION_ACTIVE=$VERSION_STAGED ERROR=''
	save_state
	board_log "confirmed $VERSION_ACTIVE in slot $active"
	board_event update.confirmed "kept $VERSION_ACTIVE in slot $active" "version=$VERSION_ACTIVE" "slot=$active"
}

# Leaves the trial unconfirmed: the next reset returns to the old slot.
fail_trial() {
	ERROR="$1 on $VERSION_STAGED"
	set_phase failed
	save_state
	board_event update.trial-failed "$ERROR" "reason=$1" "version=$VERSION_STAGED"
	if [ "${UPDATE_REBOOT_ON_FAIL:-1}" = 1 ]; then
		board_log "$ERROR; restarting into $VERSION_ACTIVE"
		$SYNC
		$UMOUNT "$AB" >/dev/null 2>&1 || true
		plain_reboot
	fi
}

# After every boot of a confirmed slot (board-update-link.service): when
# the package's checks fail on UPDATE_LINK_MAX_BAD boots in a row and the
# previous slot was good, go back to it. This recovers a board whose
# management link died without anyone needing USB boot.
cmd_check_link() {
	# The delay and the check ran before the lock (see the end of the file).
	if [ "$LINK_OK" = 1 ]; then
		with_autoboot _link_ok
	else
		REASON=$LINK_REASON
		with_autoboot _link_bad
	fi
}
_link_ok() {
	load_state
	[ "${BAD_BOOTS:-0}" = 0 ] && return 0
	BAD_BOOTS=0
	save_state
}
_link_bad() {
	load_state
	case "$STATE" in
	trying | rebooting) return 0 ;;
	esac
	BAD_BOOTS=$((${BAD_BOOTS:-0} + 1))
	board_log "$REASON (bad boot $BAD_BOOTS of ${UPDATE_LINK_MAX_BAD:-2})"
	board_event update.link-bad "$REASON" "bad_boots=$BAD_BOOTS" "max=${UPDATE_LINK_MAX_BAD:-2}"
	active=$(slot_of_root)
	if [ "$BAD_BOOTS" -lt "${UPDATE_LINK_MAX_BAD:-2}" ] || [ -z "$PREVIOUS_SLOT" ] ||
		[ "$PREVIOUS_SLOT" = "$active" ] || [ "${UPDATE_LINK_FALLBACK:-1}" != 1 ]; then
		save_state
		return 0
	fi
	write_autoboot "$(slot_boot "$PREVIOUS_SLOT")"
	ERROR="$REASON on $VERSION_ACTIVE after $BAD_BOOTS boots; went back to ${PREVIOUS_VERSION:-the previous version}"
	STATE=rolled-back VERSION_STAGED=$VERSION_ACTIVE VERSION_ACTIVE=$PREVIOUS_VERSION
	SLOT_STAGED=$active PREVIOUS_SLOT='' PREVIOUS_VERSION='' BAD_BOOTS=0 SWITCH_BOOT=''
	save_state
	board_log "$ERROR"
	board_event update.link-fallback "$ERROR" "version=$VERSION_ACTIVE" "from_slot=$active"
	$SYNC
	$UMOUNT "$AB" >/dev/null 2>&1 || true
	plain_reboot
}

# The PIDs of process $1 and all its descendants, from /proc.
process_tree() {
	cat /proc/[0-9]*/stat 2>/dev/null |
		sed -n 's/^\([0-9][0-9]*\) (.*) [A-Za-z] \([0-9][0-9]*\) .*/\1 \2/p' |
		awk -v root="$1" '
			{ parent[$1] = $2 }
			END {
				keep[root] = 1
				for (changed = 1; changed; ) {
					changed = 0
					for (p in parent)
						if (!(p in keep) && (parent[p] in keep)) { keep[p] = 1; changed = 1 }
				}
				for (p in keep) print p
			}'
}

alive() {
	for p in "$@"; do
		kill -0 "$p" 2>/dev/null && return 0
	done
	return 1
}

# With the lock held by another command: stops it when it is a stage (its
# PID is in update.pid). Freezes the process tree first so nothing new
# starts, then ends it; the lock is free once every process holding it is
# gone. Exits when there's no stage to stop.
stop_stage() {
	pid=$(cat "$PID_FILE" 2>/dev/null || true)
	case "$pid" in
	'' | *[!0-9]*) pid='' ;;
	esac
	if [ -z "$pid" ] || ! tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q ' stage'; then
		board_log "another update command is running (not a stage; nothing to cancel)"
		exit "$REFUSED"
	fi
	board_log "stopping the stage (process $pid)"
	kill -STOP "$pid" 2>/dev/null || true
	tree=$(process_tree "$pid")
	# shellcheck disable=SC2086
	kill -STOP $tree 2>/dev/null || true
	tree=$(process_tree "$pid")
	# shellcheck disable=SC2086
	kill -TERM $tree 2>/dev/null || true
	# shellcheck disable=SC2086
	kill -CONT $tree 2>/dev/null || true
	tries=0
	# shellcheck disable=SC2086
	while alive $tree && [ "$tries" -lt 50 ]; do
		sleep 0.2 2>/dev/null || sleep 1
		tries=$((tries + 1))
	done
	# shellcheck disable=SC2086
	kill -KILL $tree 2>/dev/null || true
	rm -f "$PID_FILE"
	# The stage may have left partitions mounted.
	for mnt in "$WORK"/mnt-*; do
		[ -e "$mnt" ] || [ -L "$mnt" ] || continue
		$UMOUNT "$mnt" >/dev/null 2>&1 || true
	done
	rm -f "$WORK/hash.fifo"
	STOPPED=1
}

# Cancel: a stage that was running (stopped above), an interrupted one, or a
# staged update. The inactive slot keeps what was written, unused. Prints
# `cancelled`, or `idle` when there was nothing to cancel.
cmd_cancel() {
	with_autoboot _cancel
}
_cancel() {
	load_state
	case "$(reported_state)" in
	staging | staged) ;;
	trying | rebooting) refuse "the update is past staging (state: $(reported_state)); it can't be cancelled" || return ;;
	*)
		if [ "${STOPPED:-0}" != 1 ]; then
			write_status_json
			echo idle
			return 0
		fi
		;;
	esac
	active=$(slot_of_root)
	[ "$active" = unknown ] || write_autoboot "$(slot_boot "$active")"
	board_log "cancelled ${VERSION_STAGED:-the update}"
	board_event update.cancelled "cancelled ${VERSION_STAGED:-the update}" "version=${VERSION_STAGED:-}" "stopped=${STOPPED:-0}"
	STATE=cancelled SLOT_STAGED='' VERSION_STAGED='' ERROR='' PROGRESS=0 SWITCH_BOOT='' SHA256_STAGED=''
	save_state
	echo cancelled
}

# Rollback: make the previous confirmed slot the default again and restart
# into it. It stays the previous slot's partner: a second rollback goes
# forward again.
cmd_rollback() {
	reboot=1
	case "${1:-}" in
	--no-reboot) reboot=0 ;;
	'') ;;
	*) die "usage: update rollback [--no-reboot]" ;;
	esac
	with_autoboot _rollback
	[ "$reboot" = 1 ] || return 0
	$SYNC
	if ! plain_reboot; then
		with_autoboot _rollback_undo
		exit 1
	fi
}
_rollback() {
	load_state
	case "$(reported_state)" in
	staging) refuse "an update is staging; cancel it first (update cancel)" || return ;;
	trying | rebooting) refuse "the board is restarting or on a trial boot (state: $(reported_state))" || return ;;
	esac
	active=$(slot_of_root)
	if [ -z "$PREVIOUS_SLOT" ] || [ "$PREVIOUS_SLOT" = "$active" ] || [ "$active" = unknown ]; then
		refuse "there is no previous confirmed slot to go back to" || return
	fi
	cp "$AB/board-update.env" "$AB/board-update.env.undo"
	write_autoboot "$(slot_boot "$PREVIOUS_SLOT")"
	board_log "going back to ${PREVIOUS_VERSION:-the previous version} in slot $PREVIOUS_SLOT"
	board_event update.rollback "going back to ${PREVIOUS_VERSION:-the previous version} in slot $PREVIOUS_SLOT" \
		"version=${PREVIOUS_VERSION:-}" "slot=$PREVIOUS_SLOT" "from=$VERSION_ACTIVE"
	left=$VERSION_ACTIVE
	STATE=rolled-back VERSION_ACTIVE=$PREVIOUS_VERSION PREVIOUS_VERSION=$left
	PREVIOUS_SLOT=$active SLOT_STAGED='' VERSION_STAGED='' SHA256_STAGED=''
	ERROR='' PROGRESS=0 BAD_BOOTS=0 SWITCH_BOOT=$(boot_id)
	save_state
}
_rollback_undo() {
	write_autoboot "$(slot_boot "$(slot_of_root)")"
	mv "$AB/board-update.env.undo" "$AB/board-update.env"
	load_state
	ERROR="the restart into the previous version didn't happen"
	save_state
	board_log "$ERROR"
	board_event update.rollback-failed "$ERROR"
}

# One writer at a time: a state of `staging` seen under the lock is left over
# from an interrupted stage and may be redone. `cancel` stops a running stage
# to take the lock.
mkdir -p "$BOARD_RUN_DIR"
HAVE_FLOCK=0
command -v flock >/dev/null 2>&1 && HAVE_FLOCK=1
# How long a command that changes something waits for another to finish
# (seconds): at boot, confirm, check-link and board-agent's first calls start
# together.
LOCK_WAIT=${UPDATE_LOCK_WAIT:-60}

# status answers from update.json, which every command keeps current, without
# the lock or p1, so it never holds up a command that changes something. It
# reads p1 (under the lock) only when update.json is from another boot or
# missing, or says a stage runs (a stage left over from a power loss becomes
# an error there).
if [ "${1:-}" = status ] && [ -r "$STATUS_JSON" ] &&
	[ "$(cat "$STATUS_JSON.boot" 2>/dev/null)" = "$(boot_id)" ] &&
	! grep -q '"state":"staging"' "$STATUS_JSON"; then
	cat "$STATUS_JSON"
	exit 0
fi

# check-link waits for the services before taking the lock, so nothing waits
# on it meanwhile.
if [ "${1:-}" = check-link ]; then
	sleep "${UPDATE_LINK_DELAY:-0}"
	LINK_OK=1
	LINK_REASON=$(slot_sanity) || LINK_OK=0
fi

# take_lock <seconds>: the lock, waiting at most that long (busybox flock
# has no -w).
take_lock() {
	waited=0
	until flock -n 9; do
		[ "$waited" -lt "$1" ] || return 1
		sleep 1
		waited=$((waited + 1))
	done
}

exec 9> "$BOARD_RUN_DIR/update.lock"
if [ "$HAVE_FLOCK" = 1 ] && ! flock -n 9; then
	case "${1:-}" in
	status)
		# Busy: a stage keeps update.json's progress current.
		if [ -r "$STATUS_JSON" ]; then
			cat "$STATUS_JSON"
			exit 0
		fi
		take_lock "$LOCK_WAIT" || {
			board_log "another update command is running"
			exit "$REFUSED"
		}
		;;
	cancel)
		stop_stage
		if ! take_lock 30; then
			board_log "the stage didn't stop"
			exit 1
		fi
		;;
	*)
		if ! take_lock "$LOCK_WAIT"; then
			board_log "another update command is still running after ${LOCK_WAIT} s; nothing changed"
			exit "$REFUSED"
		fi
		;;
	esac
fi

case "${1:-}" in
status) cmd_status ;;
stage) shift; cmd_stage "$@" ;;
stage-url) shift; cmd_stage_url "$@" ;;
apply) cmd_apply ;;
confirm) cmd_confirm ;;
cancel) cmd_cancel ;;
rollback) shift; cmd_rollback "$@" ;;
check-link) cmd_check_link ;;
*)
	sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' >&2
	exit 2
	;;
esac
