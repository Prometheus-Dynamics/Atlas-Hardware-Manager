#!/bin/sh
# Orion's settings for this board, in one place (board-orion-env.service, at
# boot, before orion-node and lemnos-orion; board-security.path again when
# the security switch changes).
#
# /run/board/orion.env: ORION_NODE_ID=<id>, read by both units (drop-ins),
# so lemnosd's devices are registered on the node they run on. The id is the
# OS's own ORION_NODE_ID from /etc/default/orion-node.env when it sets one
# (orion-node reads that file too, so the two agree), else raze-<serial8>:
# the name Atlas shows.
#
# /run/board/orion-node.env: orion-node's access, from the security switch
# (security.env), read by orion-node only:
#   off (FRC's default)  listen on 0.0.0.0:9200, peer auth optional, status
#                        and live streams open to read without enrollment,
#                        and operators enrolled on their hello, no key
#                        needed, for everything Atlas does: updates, slots,
#                        reboot, locate, the clock, the board's devices
#                        (Lemnos: set, restore, release, power, calibration,
#                        the ring's looks and brightness) and the USB route;
#                        from the USB cable's network (usb-boot too) and the
#                        robot network (ORION_NODE_ROBOT_NETS, FRC's
#                        10.TE.AM.x by default)
#   on                   peer auth required, nothing open, no auto-enroll
# The OS's own ORION_NODE_PEER_ADDR wins; the rest follow the switch.
#
# --restart (board-security.service): restarts orion-node when its access
# changed. Settings: ORION_NODE_ENV (the OS's file), ORION_NODE_PORT,
# ORION_NODE_ROBOT_NETS (networks given updates without a key while the
# switch is off, space-separated; empty for none).
set -u

BOARD_LIB_DIR=${BOARD_LIB_DIR:-/usr/lib/board}
# shellcheck source=lib.sh
. "$BOARD_LIB_DIR/lib.sh"

ORION_NODE_ENV=${ORION_NODE_ENV:-/etc/default/orion-node.env}
ORION_NODE_PORT=${ORION_NODE_PORT:-9200}
ORION_NODE_ROBOT_NETS=${ORION_NODE_ROBOT_NETS-10.0.0.0/8}
# What an operator is enrolled for by network while the switch is off.
ROBOT_ACTIONS=update*,slot.*,reboot,locate,clock.set,set,restore,release,power.*,calibration.*,looks.*,light.*,usb-route.set
USB_ACTIONS=$ROBOT_ACTIONS,usb-boot

# The last <name>= the OS's env file assigns, without quotes.
os_value() {
	[ -r "$ORION_NODE_ENV" ] || return 0
	sed -n "s/^[[:space:]]*\\(export[[:space:]]\\{1,\\}\\)\\{0,1\\}$1=//p" "$ORION_NODE_ENV" |
		tail -n 1 | sed "s/^[\"']//; s/[\"'][[:space:]]*\$//; s/[[:space:]]*\$//"
}

mkdir -p "$BOARD_RUN_DIR"

# orion-node's access, from the switch.
access=$BOARD_RUN_DIR/orion-node.env
before=$(cat "$access" 2>/dev/null || true)
{
	echo '# From /usr/lib/board/orion-env and the security switch (security.env).'
	[ -n "$(os_value ORION_NODE_PEER_ADDR)" ] || echo "ORION_NODE_PEER_ADDR=0.0.0.0:$ORION_NODE_PORT"
	if board_security_on; then
		echo 'ORION_NODE_PEER_AUTH=required'
		echo 'ORION_NODE_OPERATOR_OPEN_READ='
		echo 'ORION_NODE_OPERATOR_AUTO_ENROLL='
	else
		echo 'ORION_NODE_PEER_AUTH=optional'
		echo 'ORION_NODE_OPERATOR_OPEN_READ=status,streams'
		board_load_env usb-gadget.env
		rules=''
		if board_gadget_address 2>/dev/null && [ -n "${BOARD_GADGET_CIDR:-}" ] &&
			board_ip4_var "${BOARD_GADGET_CIDR%/*}"; then
			# The network, not the board's own address in it.
			bits=${BOARD_GADGET_CIDR#*/}
			size=$((1 << (32 - bits)))
			n=$((BOARD_IP4 / size * size))
			net=$((n >> 24 & 255)).$((n >> 16 & 255)).$((n >> 8 & 255)).$((n & 255))
			rules="$net/$bits=$USB_ACTIONS"
		fi
		for robot in $ORION_NODE_ROBOT_NETS; do
			case "$robot" in
			*[!0-9./]* | */*/* | [!0-9]*) board_log "ORION_NODE_ROBOT_NETS: \`$robot' isn't a network; left out" ;;
			*/*) rules="$rules${rules:+;}$robot=$ROBOT_ACTIONS" ;;
			*) board_log "ORION_NODE_ROBOT_NETS: \`$robot' needs a /prefix; left out" ;;
			esac
		done
		echo "ORION_NODE_OPERATOR_AUTO_ENROLL=$rules"
	fi
} > "$access.$$" && mv -f "$access.$$" "$access"
if [ "${1:-}" = --restart ] && [ "$(cat "$access")" != "$before" ]; then
	board_log "security switch changed orion-node's access; restarting it"
	systemctl try-restart orion-node.service || board_log "orion-node didn't restart"
fi

os_id=$(os_value ORION_NODE_ID)

if [ -n "$os_id" ]; then
	id=$os_id
else
	serial8=$(board_serial8)
	if [ -z "$serial8" ]; then
		board_log "no board serial or machine id; orion-node keeps its own id"
		exit 0
	fi
	id=raze-$serial8
fi

tmp=$BOARD_RUN_DIR/.orion.env.$$
printf 'ORION_NODE_ID=%s\n' "$id" > "$tmp" && mv -f "$tmp" "$BOARD_RUN_DIR/orion.env"
