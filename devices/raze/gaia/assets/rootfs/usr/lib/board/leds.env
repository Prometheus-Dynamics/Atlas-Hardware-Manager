# Generated by devices/tools/gen-raze.py from devices/raze/manifest.json; do not edit.
# Change the manifest and run the tool (CI runs it with --check).
#
# LED ring defaults for raze-leds and the selftest. Each value yields to the
# environment; OS and user overrides go in raze-leds.env (in /etc/board or
# /data/board), which raze-leds reads after this file.
#
# SK6812-EC20: grb24 on the wire. The driver reads
# 4 bytes per LED in rgbw order and drops W.
# Logical LED i is driver slot (OFFSET + DIRECTION * i) mod COUNT.
RAZE_LEDS_DEVICE=${RAZE_LEDS_DEVICE:-/dev/leds0}
RAZE_LEDS_COUNT=${RAZE_LEDS_COUNT:-16}
RAZE_LEDS_ORDER=${RAZE_LEDS_ORDER:-rgbw}
RAZE_LEDS_OFFSET=${RAZE_LEDS_OFFSET:-5}
RAZE_LEDS_DIRECTION=${RAZE_LEDS_DIRECTION:-1}
