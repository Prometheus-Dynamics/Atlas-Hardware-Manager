# Generated by devices/tools/gen-raze.py from devices/raze/manifest.json; do not edit.
# Change the manifest and run the tool (CI runs it with --check).
#
# LED ring defaults for board-leds and the selftest. Each value yields to the
# environment; OS and user overrides go in board-leds.env (in /etc/board or
# /data/board), which board-leds reads after this file.
#
# SK6812-EC20: grb24 on the wire. The driver reads
# 4 bytes per LED in rgbw order and drops W.
# Logical LED i is driver slot (OFFSET + DIRECTION * i) mod COUNT.
BOARD_LEDS_DEVICE=${BOARD_LEDS_DEVICE:-/dev/leds0}
BOARD_LEDS_COUNT=${BOARD_LEDS_COUNT:-16}
BOARD_LEDS_ORDER=${BOARD_LEDS_ORDER:-rgbw}
BOARD_LEDS_OFFSET=${BOARD_LEDS_OFFSET:-5}
BOARD_LEDS_DIRECTION=${BOARD_LEDS_DIRECTION:-1}
BOARD_LEDS_PIO_DEV=${BOARD_LEDS_PIO_DEV:-ws2812_pio@d}
