#!/bin/sh
# Device identity (contract 1).
#
#   identity            print the identity JSON
#   identity --write    also write $BOARD_RUN_DIR/identity.json, and what
#                       identity-http serves from: identity.part (the
#                       fixed fields, lib.sh board_identity_fixed_json) and
#                       gadget-cidr (the USB link's network)
#   identity --dnssd    also write the mDNS advertisement: a resolved
#                       service, $BOARD_DNSSD_DIR/pd-device.dnssd, and the same
#                       as an avahi service file, $BOARD_AVAHI_DIR/pd-device.service
#
# board-identity.service runs `identity --write --dnssd` at boot, and
# board-identity-refresh.service `identity --write` whenever update.json,
# usb-route.state or camera-streams.json change (board-identity-refresh.path;
# its timer catches a change the path unit missed while the service ran).
# systemd-resolved reads /run/systemd/dnssd when it starts (the service runs
# before it; a later change reloads it). With avahi.toml,
# etc-avahi-services.mount binds $BOARD_AVAHI_DIR over /etc/avahi/services
# (the root is read-only; avahi reads services only from there and follows
# changes), before avahi-daemon starts. The HTTP endpoint adds the live
# fields (hostname, time, actions) to identity.part per request.
set -eu

BOARD_LIB_DIR=${BOARD_LIB_DIR:-/usr/lib/board}
# shellcheck source=lib.sh
. "$BOARD_LIB_DIR/lib.sh"

BOARD_AVAHI_DIR=${BOARD_AVAHI_DIR:-/run/board/avahi-services}
BOARD_DNSSD_DIR=${BOARD_DNSSD_DIR:-/run/systemd/dnssd}
BOARD_HTTP_PORT=5899
BOARD_HTTP_PATH=/.well-known/pd-device

write=0
dnssd=0
quiet=0
for arg in "$@"; do
	case "$arg" in
	--write) write=1 ;;
	--dnssd) dnssd=1 ;;
	--quiet) quiet=1 ;;
	*)
		board_log "unknown argument: $arg"
		exit 2
		;;
	esac
done

# Atomic replace, so readers never see a partial file.
write_file() {
	_dir=${1%/*}
	mkdir -p "$_dir"
	_tmp="$1.tmp.$$"
	cat > "$_tmp"
	chmod 0644 "$_tmp"
	mv -f "$_tmp" "$1"
}

# TXT values: letters, digits and ._:+- only (no XML to escape).
txt_value() {
	printf '%s' "$1" | tr -c 'A-Za-z0-9._:+-' '_' | cut -c1-200
}

# Whether a file the fixed fields come from changed since the stamp, taken
# before they were read.
inputs_newer() {
	for _f in update.json usb-route.state camera-streams.json; do
		[ "$BOARD_RUN_DIR/$_f" -nt "$BOARD_RUN_DIR/identity.stamp" ] && return 0
	done
	return 1
}

if [ "$write" = 1 ]; then
	mkdir -p "$BOARD_RUN_DIR"
	board_load_env usb-gadget.env
	if board_gadget_address 2>/dev/null && [ -n "${BOARD_GADGET_CIDR:-}" ]; then
		printf '%s\n' "$BOARD_GADGET_CIDR" | write_file "$BOARD_RUN_DIR/gadget-cidr"
	fi
	# Again (a few times at most) when an input changed while this ran.
	n=0
	while :; do
		: > "$BOARD_RUN_DIR/identity.stamp"
		part=$(board_identity_fixed_json)
		printf '%s\n' "$part" | write_file "$BOARD_RUN_DIR/identity.part"
		n=$((n + 1))
		[ "$n" -lt 3 ] && inputs_newer || break
	done
	json=$(printf '{%s' "$part"; board_identity_live_json; printf '}')
	printf '%s\n' "$json" | write_file "$BOARD_RUN_DIR/identity.json"
else
	json=$(board_identity_json)
fi

if [ "$dnssd" = 1 ]; then
	board_load_env board-package.env
	board_load_env identity.env
	target="$BOARD_AVAHI_DIR/pd-device.service"
	dnssd_file="$BOARD_DNSSD_DIR/pd-device.dnssd"
	dnssd_was=$(cat "$dnssd_file" 2>/dev/null || :)
	# The directory always exists: it is the bind mount's source (avahi.toml).
	mkdir -p "$BOARD_AVAHI_DIR"
	if [ "${BOARD_MDNS:-1}" = 1 ]; then
		os_ver=$(board_os_version)
		txts="contract=1
model=$(txt_value "${BOARD_DEVICE_MODEL:-}")
rev=$(txt_value "$(board_rev)")
serial=$(txt_value "$(board_serial)")
os=$(txt_value "$(board_os_field ID)")
os_ver=$(txt_value "$os_ver")
path=$BOARD_HTTP_PATH"
		{
			printf '# Generated at boot by board-identity.service; edits are lost. Turn the\n'
			printf '# advertisement off with BOARD_MDNS=0 in /etc/board/identity.env.\n'
			printf '[Service]\n'
			printf 'Name=%%H\n'
			printf 'Type=_pd-device._tcp\n'
			printf 'Port=%s\n' "$BOARD_HTTP_PORT"
			printf 'TxtText=%s\n' "$(printf '%s' "$txts" | tr '\n' ' ')"
		} | write_file "$dnssd_file"
		{
			printf '<?xml version="1.0" standalone="no"?>\n'
			printf '<!DOCTYPE service-group SYSTEM "avahi-service.dtd">\n'
			printf '<!-- Generated at boot by board-identity.service; edits are lost. Turn the\n'
			printf '     advertisement off with BOARD_MDNS=0 in /etc/board/identity.env. -->\n'
			printf '<service-group>\n'
			printf '  <name replace-wildcards="yes">%%h</name>\n'
			printf '  <service>\n'
			printf '    <type>_pd-device._tcp</type>\n'
			printf '    <port>%s</port>\n' "$BOARD_HTTP_PORT"
			printf '%s\n' "$txts" | while read -r txt; do
				printf '    <txt-record>%s</txt-record>\n' "$txt"
			done
			printf '  </service>\n'
			printf '</service-group>\n'
		} | write_file "$target"
	else
		rm -f "$target" "$dnssd_file"
	fi
	# resolved rereads its services on reload; before it starts (boot) it
	# reads them when it does.
	if [ "$(cat "$dnssd_file" 2>/dev/null || :)" != "$dnssd_was" ] &&
		systemctl -q is-active systemd-resolved.service 2>/dev/null; then
		systemctl reload systemd-resolved.service 2>/dev/null ||
			board_log "couldn't reload systemd-resolved for the mDNS advertisement"
	fi
fi

if [ "$quiet" = 0 ]; then
	printf '%s\n' "$json"
fi
