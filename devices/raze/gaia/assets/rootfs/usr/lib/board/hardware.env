# Generated by devices/tools/gen-raze.py from devices/raze/manifest.json; do not edit.
# Change the manifest and run the tool (CI runs it with --check).
#
# Hardware facts for /usr/lib/board/selftest and hw.sh. HW_I2C_DEVICES is
# id:bus:address:part per device (bus: its number on the 7.2.9 image, a hint).
# HW_I2C_BUSES is bus:selector, the Lemnos i2c: selector that finds a bus
# whatever its number; HW_I2C_PIO_BUSES is bus:lemnos-bus for the buses lemnosd
# runs on RP1 PIO, which have no kernel adapter. HW_I2C_IDS is id:register:b|w:value[:register.bit], the
# chip id as i2cget reads it (w: an SMBus word, so byte-swapped) and the power
# control bit to set first. HW_LEMNOS_* are device ids in board.toml.
HW_MODEL=raze
HW_LEDS_DEVICE=/dev/leds0
HW_LEDS_COUNT=16
HW_LEDS_PART=SK6812-EC20
HW_LEDS_WIRE=grb24
HW_FAN_COOLING_TYPE=pwm-fan
HW_FAN_HWMON=pwmfan
HW_FAN_LEVELS='179 212 245 255 255'
HW_FAN_TRIPS_C='50 60 67.5 75'
HW_CAMERA_PART=OV9782
HW_CAMERA_SENSOR=ov9782
HW_CAMERA_DRIVER=ov9282
HW_CAMERA_ADDRESS=0x60
HW_CAMERA_RECEIVER=rp1-cfe
HW_I2C_DEVICES='imu-accel:4:0x18:BMI088 imu-gyro:4:0x68:BMI088 magnetometer:1:0x10:BMM150 power-monitor:1:0x40:INA238'
HW_I2C_BUSES='1:of=/axi/pcie@1000120000/rp1/i2c@74000'
HW_I2C_PIO_BUSES='4:pio-i2c:sda=8,scl=7'
HW_I2C_IDS='imu-accel:0x00:b:0x1e imu-gyro:0x00:b:0x0f magnetometer:0x40:b:0x32:0x4b.0 power-monitor:0xfe:w:0x4954'
HW_LEMNOS_DEVICES='imu-accel:imu imu-gyro:imu magnetometer:magnetometer power-monitor:power'
HW_LEMNOS_RING=status-ring
HW_LEMNOS_FAN=fan
HW_LEMNOS_THERMAL=cpu-thermal
HW_WATCHDOG_DEVICE=/dev/watchdog0
HW_WATCHDOG_RUNTIME_SEC=15
