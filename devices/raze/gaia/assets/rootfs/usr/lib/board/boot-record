#!/bin/sh
# The boot record (board-boot.service):
#
#   boot-record             at boot: count it, write /run/board/boot.json and
#                           log a `boot` event
#   boot-record --shutdown  at a clean shutdown (the unit's ExecStop): log a
#                           `shutdown` event
#   boot-record --power <stage>
#                           log a `power` event: the board supply as lemnosd's
#                           `power` device (INA238) reads it now
#                           (board-power-log.service, at the start of a
#                           shutdown), to see whether it sags as things stop
#
# A boot whose previous boot ended without a `shutdown` event (power cut,
# watchdog reset, kernel panic) has "previous_clean": false; with no earlier
# events at all it is null. The kernel's own last words count too: when the
# previous boot's console (pstore, moved to /data/board/pstore/<this boot>/ by
# board-pstore.service, which runs first) ends with the kernel restarting or
# powering off, that boot finished its shutdown, whatever the event log says,
# and "previous_reboot" is the restart's command ("0 tryboot", "" for a plain
# restart; null when the console doesn't say). boot.json:
#   {"id":..,"count":<n>,"slot":"A|B|unknown","kernel":..,
#    "previous_clean":true|false|null,"previous_reboot":<string|null>,
#    "pstore_saved":true|false,"previous_journal":<string|null>,"at":<unix s>}
# pstore_saved: pstore had something of the previous boot (warm restarts
# always leave its console; none means RAM was lost, a power-level reset).
# previous_journal: the previous boot's last journal lines (3, " | "
# between), to see where a boot that didn't shut down cleanly stopped.
# throttled: the firmware's flags early in this boot ("0x50005"; null without
# vcgencmd); the power event at shutdown start carries them again, with
# undervoltage=yes|no.
# The count is kept in /data/board/boot-count (/run/board without /data).
# Test hooks: BOARD_BOOT_ID, BOARD_UNAME_R, UPDATE_CMDLINE_ROOT.
set -u

BOARD_LIB_DIR=${BOARD_LIB_DIR:-/usr/lib/board}
# shellcheck source=lib.sh
. "$BOARD_LIB_DIR/lib.sh"

# The firmware's throttling flags (`vcgencmd get_throttled`): "0x50005", empty
# without vcgencmd. Bit 0 is undervoltage now, bit 16 undervoltage since the
# firmware started: a bench supply that sags shows here, not as a software
# fault. BOARD_VCGENCMD (tests).
throttled() {
	_vc=${BOARD_VCGENCMD:-vcgencmd}
	command -v "$_vc" >/dev/null 2>&1 || return 0
	"$_vc" get_throttled 2>/dev/null | sed -n 's/^throttled=\(0x[0-9a-fA-F]*\)$/\1/p' | head -n 1
}
# "yes" when the flags say undervoltage now or since the firmware started.
undervoltage() {
	case "$1" in
	0x*) [ $(($1 & 0x10001)) -ne 0 ] && echo yes || echo no ;;
	*) echo unknown ;;
	esac
}

case "${1:-}" in
--shutdown)
	up=$(cut -d. -f1 /proc/uptime 2>/dev/null) || up=''
	board_event shutdown "shutting down cleanly" "uptime_s=$up"
	# On the disk before the restart: an appended line still in the page
	# cache is a hole of NULs on the next boot (raze:0708c973, r27), which
	# reads as a shutdown that never happened. BOARD_SYNC (tests).
	sync=${BOARD_SYNC:-sync}
	$sync "$(board_events_file)" 2>/dev/null || $sync
	exit 0
	;;
--power)
	# "power <t>us <status> bus_voltage=12.01V current=1.52A power=18.3W .."
	ctl=${BOARD_LEMNOS_CTL:-lemnos-ctl}
	line=''
	if command -v "$ctl" >/dev/null 2>&1; then
		if command -v timeout >/dev/null 2>&1; then
			line=$(timeout 3 "$ctl" --client board-boot read power 2>/dev/null | head -n 1)
		else
			line=$("$ctl" --client board-boot read power 2>/dev/null | head -n 1)
		fi
	fi
	set -- "${2:-now}"
	stage=$1
	# The readings as event data, name=value with the unit.
	data=$(printf '%s\n' "$line" | tr ' ' '\n' | grep -E '^[a-z_]+=[-0-9.]' | head -n 8)
	flags=$(throttled)
	low=$(undervoltage "$flags")
	note=''
	[ "$low" != yes ] || note=' (UNDERVOLTAGE this boot)'
	if [ -z "$data" ]; then
		board_event power "board supply at $stage: no reading (lemnosd or its power device isn't there)$note" "stage=$stage" \
			"throttled=${flags:-unknown}" "undervoltage=$low"
	else
		# shellcheck disable=SC2086 # one argument per reading
		board_event power "board supply at $stage: $(printf '%s' "$data" | tr '\n' ' ')$note" "stage=$stage" $data \
			"throttled=${flags:-unknown}" "undervoltage=$low"
	fi
	sync=${BOARD_SYNC:-sync}
	$sync "$(board_events_file)" 2>/dev/null || $sync
	exit 0
	;;
'') ;;
*)
	sed -n '4,7p' "$0" | sed 's/^# \{0,1\}//' >&2
	exit 2
	;;
esac

mkdir -p "$BOARD_RUN_DIR"
id=$(board_boot_id)
# Once per boot: a restarted unit doesn't count again.
if [ -n "$id" ] && grep -q "\"id\":\"$id\"" "$BOARD_RUN_DIR/boot.json" 2>/dev/null; then
	exit 0
fi

# The last event of an earlier boot says how that boot ended (the `power`
# reading board-power-log takes as the shutdown starts may come after the
# `shutdown` event, so it doesn't count).
last=$(cat "$BOARD_RUN_DIR/events.jsonl" "$BOARD_DATA_DIR/events.jsonl" 2>/dev/null |
	awk -v id="\"boot_id\":\"$id\"" '/^\{"t":[0-9]+,"boot_id":.*\}$/ && index($0, id) == 0 && index($0, "\"kind\":\"power\"") == 0 { last = $0 } END { print last }')
case "$last" in
'') clean=null ;;
*'"kind":"shutdown"'*) clean=true ;;
*) clean=false ;;
esac

# The previous boot's console, as pstore kept it: its last restart or
# power-off line.
reboot=null
console=$BOARD_DATA_DIR/pstore/${id:-unknown}/console-ramoops-0
if [ -r "$console" ]; then
	line=$(grep -a -E 'reboot: (Restarting system|Power down)' "$console" 2>/dev/null | tail -n 1)
	case "$line" in
	*"Restarting system with command '"*)
		command=${line#*with command \'}
		command=${command%\'*}
		reboot=$(board_json_str "$command")
		;;
	*"Restarting system"*) reboot='""' ;;
	*"Power down"*) reboot='"power-off"' ;;
	esac
	# The kernel got to the end of the shutdown: not a reset mid-way.
	[ "$reboot" = null ] || [ "$clean" != false ] || clean=true
fi

# Whether pstore had anything of the previous boot, and how its journal ended.
pstore_saved=false
[ -n "$id" ] && [ -d "$BOARD_DATA_DIR/pstore/$id" ] && pstore_saved=true
journal=null
jctl=${BOARD_JOURNALCTL:-journalctl}
if command -v "$jctl" >/dev/null 2>&1; then
	tail3=$("$jctl" -b -1 -n 3 -o short-monotonic --no-pager -q 2>/dev/null |
		awk 'NR > 1 { printf " | " } { printf "%s", $0 }')
	[ -z "$tail3" ] || journal=$(board_json_str "$(printf '%s' "$tail3" | cut -c1-600)")
fi

count_file=$BOARD_DATA_DIR/boot-count
mkdir -p "$BOARD_DATA_DIR" 2>/dev/null && [ -w "$BOARD_DATA_DIR" ] || count_file=$BOARD_RUN_DIR/boot-count
count=$(cat "$count_file" 2>/dev/null | tr -cd '0-9')
count=$((${count:-0} + 1))
printf '%s\n' "$count" > "$count_file.tmp.$$" && mv -f "$count_file.tmp.$$" "$count_file"

slot=$(board_active_slot)
kernel=${BOARD_UNAME_R:-$(uname -r)}
flags=$(throttled)
printf '{"id":%s,"count":%s,"slot":%s,"kernel":%s,"previous_clean":%s,"previous_reboot":%s,"pstore_saved":%s,"previous_journal":%s,"throttled":%s,"at":%s}\n' \
	"$(board_json_str "$id")" "$count" "$(board_json_str "$slot")" "$(board_json_str "$kernel")" \
	"$clean" "$reboot" "$pstore_saved" "$journal" "$(board_json_str "$flags")" "$(date +%s)" > "$BOARD_RUN_DIR/boot.json.tmp.$$"
chmod 0644 "$BOARD_RUN_DIR/boot.json.tmp.$$"
mv -f "$BOARD_RUN_DIR/boot.json.tmp.$$" "$BOARD_RUN_DIR/boot.json"

message="boot $count, slot $slot, kernel $kernel"
[ "$clean" != false ] || message="$message; the previous boot didn't shut down cleanly"
if [ "$reboot" = null ]; then
	board_event boot "$message" "count=$count" "slot=$slot" "kernel=$kernel" "previous_clean=$clean"
else
	board_event boot "$message" "count=$count" "slot=$slot" "kernel=$kernel" "previous_clean=$clean" \
		"previous_reboot=$(printf '%s' "$reboot" | tr -d '"')"
fi
exit 0
