# Netconsole: the kernel's log sent live over UDP to a host, for a capture
# across a reboot (board-netconsole.service; dev use: it sends in the clear).
# Override in /etc/board/netconsole.env or /data/board/netconsole.env.
#   BOARD_NETCONSOLE   the module's netconsole= value, empty (the default)
#                      for off: [+][r][src-port]@[src-ip]/[dev],[port]@<ip>/[mac]
#                      e.g. "@/usb0,6666@10.55.0.1/" (no mac: broadcast);
#                      receive with `nc -u -l 6666` (or socat)
#   BOARD_NETCONSOLE_LEVEL
#                      the console log level while it runs (8: everything)
BOARD_NETCONSOLE=
BOARD_NETCONSOLE_LEVEL=8
