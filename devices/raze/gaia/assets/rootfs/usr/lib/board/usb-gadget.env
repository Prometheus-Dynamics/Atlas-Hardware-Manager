# Defaults for board-usb-gadget.service. Override any of these in
# /etc/board/usb-gadget.env.

# 0 leaves the USB controller alone.
USB_GADGET_ENABLED=1
USB_GADGET_NAME=g1

# Generic Linux composite gadget id; there is no assigned VID/PID.
USB_GADGET_VID=0x1d6b
USB_GADGET_PID=0x0104
USB_GADGET_MANUFACTURER="Prometheus Dynamics"
USB_GADGET_PRODUCT="Raze"
# AUTO: the board serial (device tree serial-number), else the first 16 hex
# digits of /etc/machine-id. Atlas maps a USB device to its board, and
# computes its gadget address, from this string; keep it the board serial.
USB_GADGET_SERIAL=AUTO

# Functions. ECM goes in configuration 1 (Linux, macOS), RNDIS in
# configuration 2 with Microsoft OS descriptors (Windows). NCM replaces ECM in
# configuration 1 when USB_GADGET_ECM=0 and USB_GADGET_NCM=1. ACM adds a serial
# port to both configurations.
USB_GADGET_ECM=1
USB_GADGET_RNDIS=1
USB_GADGET_NCM=0
USB_GADGET_ACM=1
USB_GADGET_OS_DESC=1

# AUTO: derived from the board serial with the locally administered bit set
# (see manifest.json identity.mac_rule). Set explicit addresses to override.
USB_GADGET_DEV_ADDR=AUTO
USB_GADGET_HOST_ADDR=AUTO

# Seconds to wait for the USB device controller to appear.
USB_GADGET_UDC_WAIT_SEC=30
# Empty: the first controller in /sys/class/udc.
USB_GADGET_UDC=

# bridge: put the gadget network interfaces in USB_GADGET_BRIDGE with
# USB_GADGET_ADDRESS, and serve DHCP on it. Only gadget interfaces are ever
# added; Ethernet is never bridged. none: leave the interfaces to the OS.
USB_GADGET_NET=bridge
USB_GADGET_BRIDGE=usbbr0
# AUTO: a subnet of its own per board, derived from the USB serial (scheme
# serial-hash-v1, manifest.json capabilities.gadget-net.addressing), so
# several boards can share one computer: the first 4 bytes of sha256 of the
# serial's last 8 hex digits pick one /USB_GADGET_ADDR_PREFIX subnet of
# USB_GADGET_ADDR_BASE outside USB_GADGET_ADDR_EXCLUDE, and the board takes
# its first address. Without a hex serial: 172.31.250.1/24.
# An address with a prefix (for example 172.31.250.1/24, the address before
# per-board subnets) pins it; Atlas then finds the board by mDNS, or at
# 172.31.250.1 when it is the only one plugged in.
USB_GADGET_ADDRESS=AUTO
# The scheme's parameters. Atlas computes addresses from manifest.json, so
# changing these makes boards unreachable over the gadget link except by mDNS.
USB_GADGET_ADDR_BASE=172.31.0.0/16
USB_GADGET_ADDR_PREFIX=29
USB_GADGET_ADDR_EXCLUDE=172.31.250.0/24
# DHCP on the USB link only (dnsmasq, DNS disabled, no default route offered).
USB_GADGET_DHCP=1
# AUTO: the addresses after the board's, at most 19, inside its subnet (with
# the default /29, .2 to .6), with a 1h lease. Otherwise a dnsmasq dhcp-range.
USB_GADGET_DHCP_RANGE=AUTO
