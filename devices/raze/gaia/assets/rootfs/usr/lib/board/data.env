# /data on first boot (data-setup). Override in /etc/board/data.env.
#   BOARD_DATA_PART   the data partition's number on the root's disk
#   BOARD_DATA_LABEL  the ext4 label a new filesystem gets
#   BOARD_DATA_GROW   1: grow the partition (and its extended one) to the
#                     end of the disk; 0: leave the table alone
BOARD_DATA_PART=7
BOARD_DATA_LABEL=data
BOARD_DATA_GROW=1
