#!/bin/sh
# Raze LED ring: 16 SK6812-EC20 LEDs (24-bit GRB) on /dev/leds0 (ws2812-pio-rp1).
#
#   raze-leds on | off                 light the ring in its colour, or not
#   raze-leds set <0|1>                same, for PhotonVision ({v} = 0 or 1)
#   raze-leds dim <0-100>              brightness in percent (default 100)
#   raze-leds color <r> <g> <b> [<w>]  colour, 0-255 each; w is ignored by this ring
#   raze-leds status <ok|warn|error|busy|off>   green, amber, red, blue, off
#   raze-leds blink [<hz>]             blink the current colour (default 2 Hz)
#   raze-leds locate [<seconds>]       the locate look, then back (10 s)
#   raze-leds pixel <index|all> <r> <g> <b> [<w>]
#                                      light one LED (or all) once; the saved
#                                      state stays as it is
#   raze-leds refresh                  show the saved state again
#   raze-leds show                     print the current state
#
# With lemnosd (the default when /usr/bin/lemnos-ctl exists) this is a thin
# wrapper over `lemnos-ctl --client raze-leds led ...`: lemnosd owns the ring
# and arbitrates it between its clients (system states such as an update and
# locate above status, status above colours), fades changes (250 ms, from
# /etc/lemnos/board.toml) and shows `status` with the board's status effect
# (breathe). `color`, `on`, `dim` send a colour intent, `status` a status
# intent, `blink` the colour with lemnosd's blink effect, `locate` lemnosd's
# locate effect, `pixel` a one-off frame; `off` drops raze-leds' intents, so
# other clients' looks show again. RAZE_LEDS_CLIENT names the client.
#
# With the sysfs backend (BOARD_HW_BACKEND=sysfs, or no lemnos-ctl) it writes
# one frame of 16 x 4 bytes per change to /dev/leds0 itself; the ring keeps it
# until the next. The driver reads 4 bytes (R, G, B, W) per LED and drops W on
# the wire, so white is `color 255 255 255`. A blink is a background loop, and
# RAZE_LEDS_FOREGROUND=1 runs it in the foreground (board-locate.service does;
# with lemnosd it waits out the locate instead).
#
# State lives in /run/board/leds.state, so commands combine: `color` then
# `dim` keeps the colour. Any command but show and refresh stops a blink.
# Defaults come from leds.env, generated from the package manifest. Override
# them in /etc/board/raze-leds.env (or /data/board/raze-leds.env); the sysfs
# backend uses:
#   RAZE_LEDS_ORDER      the driver's 4-byte layout, rgbw. If colours come out
#                        swapped on a board revision, reorder the four letters
#                        (e.g. grbw); a 3-letter order misaligns the buffer.
#   RAZE_LEDS_OFFSET     the driver slot of LED index 0 (5, as in HeliOS)
#   RAZE_LEDS_DIRECTION  1, or -1 when indexes run the other way round
#   RAZE_LEDS_COUNT, RAZE_LEDS_DEVICE
# LED index i is driver slot (OFFSET + DIRECTION * i) mod COUNT (lemnosd takes
# the same from board.toml). Hardware access goes through hw.sh.
set -eu

BOARD_LIB_DIR=${BOARD_LIB_DIR:-/usr/lib/board}
# shellcheck source=lib.sh
. "$BOARD_LIB_DIR/lib.sh"
case "${BOARD_HW_BACKEND:-}" in
*/*) . "$BOARD_HW_BACKEND" ;;
# shellcheck source=hw.sh
*) . "$BOARD_LIB_DIR/hw.sh" ;;
esac
board_load_env raze-leds.env
HW_LEMNOS_CLIENT=${RAZE_LEDS_CLIENT:-raze-leds}

STATE_DIR=${BOARD_RUN_DIR:-/run/board}
STATE=$STATE_DIR/leds.state
BLINK_PID=$STATE_DIR/leds.blink.pid

usage() {
	sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//' >&2
	exit 2
}

byte() {
	# byte <0-255>: clamp and validate
	case "$1" in
	'' | *[!0-9]*) echo "raze-leds: not a number: $1" >&2; exit 2 ;;
	esac
	if [ "$1" -gt 255 ]; then echo 255; else echo "$1"; fi
}

load_state() {
	ON=0 R=255 G=255 B=255 W=0 BRIGHT=100 STATUS='' BLINK=0 SHOWN=''
	if [ -r "$STATE" ]; then
		# shellcheck disable=SC1090
		. "$STATE"
	fi
}

save_state() {
	mkdir -p "$STATE_DIR"
	printf 'ON=%s R=%s G=%s B=%s W=%s BRIGHT=%s STATUS=%s BLINK=%s SHOWN=%s\n' \
		"$ON" "$R" "$G" "$B" "$W" "$BRIGHT" "$STATUS" "$BLINK" "$SHOWN" > "$STATE.tmp"
	mv "$STATE.tmp" "$STATE"
}

scaled() {
	# scaled <value> <percent>
	echo $(($1 * $2 / 100))
}

# ---------------------------------------------------------------------------
# lemnosd.

ctl_led() {
	if ! lemnos-ctl --client "$HW_LEMNOS_CLIENT" led "$@" --device "$HW_LEMNOS_RING" >/dev/null; then
		echo "raze-leds: lemnos-ctl led $1 failed (is lemnosd.service running?)" >&2
		exit 1
	fi
}

# The saved state as a lemnosd intent. A status intent sits in a layer above
# colours, so switching between the two drops the old one first.
render_lemnosd() {
	if [ "$ON" != 1 ]; then
		ctl_led off
		SHOWN=''
		return
	fi
	kind=color
	[ -z "$STATUS" ] || kind=status
	[ -z "$SHOWN" ] || [ "$SHOWN" = "$kind" ] || ctl_led off
	SHOWN=$kind
	set -- --brightness "$(awk -v b="$BRIGHT" 'BEGIN { printf "%.2f", b / 100 }')"
	if [ "$BLINK" != 0 ]; then
		set -- "$@" --blink --period "$(awk -v hz="$BLINK" 'BEGIN { if (hz <= 0) hz = 2; printf "%d", 1000 / hz }')"
	fi
	if [ "$kind" = status ]; then
		ctl_led status "$STATUS" "$@"
	else
		ctl_led color "$(printf '%02x%02x%02x' "$R" "$G" "$B")" "$@"
	fi
}

# ---------------------------------------------------------------------------
# sysfs: frames and a blink loop of our own.

# frame <r> <g> <b> <w>: one colour on every LED, already scaled.
frame() {
	hw_leds_fill "$1,$2,$3,$4" || exit 1
}

render_sysfs() {
	if [ "$ON" = 1 ]; then
		frame "$(scaled "$R" "$BRIGHT")" "$(scaled "$G" "$BRIGHT")" "$(scaled "$B" "$BRIGHT")" "$(scaled "$W" "$BRIGHT")"
	else
		frame 0 0 0 0
	fi
}

stop_blink() {
	if [ -r "$BLINK_PID" ]; then
		kill "$(cat "$BLINK_PID")" 2>/dev/null || true
		rm -f "$BLINK_PID"
	fi
}

blink_loop() {
	# blink_loop <half period, seconds> <until epoch or 0>
	trap 'exit 0' TERM INT
	while :; do
		ON=1 render_sysfs
		sleep "$1"
		ON=0 render_sysfs
		sleep "$1"
		if [ "$2" -gt 0 ] && [ "$(date +%s)" -ge "$2" ]; then
			break
		fi
	done
}

start_blink() {
	# start_blink <hz> <seconds or 0 for until the next command>
	half=$(awk -v hz="$1" 'BEGIN { if (hz <= 0) hz = 2; printf "%.3f", 0.5 / hz }')
	until=0
	if [ "$2" -gt 0 ]; then until=$(($(date +%s) + $2)); fi
	# Under a service (RAZE_LEDS_FOREGROUND=1) the blink is the service.
	if [ "${RAZE_LEDS_FOREGROUND:-0}" = 1 ]; then
		blink_loop "$half" "$until"
		load_state
		render_sysfs
		return 0
	fi
	(
		blink_loop "$half" "$until"
		# A timed blink (locate) puts the saved state back when it ends.
		load_state
		render_sysfs
		rm -f "$BLINK_PID"
	) </dev/null >/dev/null 2>&1 &
	echo $! > "$BLINK_PID"
}

render() {
	if [ "$HW_BACKEND" = lemnosd ]; then
		render_lemnosd
	else
		render_sysfs
	fi
}

# ---------------------------------------------------------------------------

[ $# -ge 1 ] || usage
cmd=$1
shift
load_state
case "$cmd" in
show | refresh) ;;
*)
	[ "$HW_BACKEND" = lemnosd ] || stop_blink
	case "$cmd" in locate | pixel) ;; *) BLINK=0 ;; esac
	;;
esac

case "$cmd" in
on) ON=1 ;;
off) ON=0 ;;
set)
	[ $# -eq 1 ] || usage
	case "$1" in 0) ON=0 ;; 1) ON=1 ;; *) usage ;; esac
	;;
dim)
	[ $# -eq 1 ] || usage
	BRIGHT=$(byte "$1")
	[ "$BRIGHT" -le 100 ] || BRIGHT=100
	;;
color | colour)
	[ $# -ge 3 ] || usage
	R=$(byte "$1") G=$(byte "$2") B=$(byte "$3") W=$(byte "${4:-0}")
	ON=1 STATUS=''
	;;
status)
	[ $# -eq 1 ] || usage
	case "$1" in
	ok) R=0 G=255 B=0 W=0 ON=1 ;;
	warn) R=255 G=160 B=0 W=0 ON=1 ;;
	error) R=255 G=0 B=0 W=0 ON=1 ;;
	busy) R=0 G=80 B=255 W=0 ON=1 ;;
	off) ON=0 ;;
	*) usage ;;
	esac
	# lemnosd shows the status in the board's colours and status effect.
	STATUS=$1
	[ "$1" != off ] || STATUS=''
	;;
blink)
	hz=${1:-2}
	case "$hz" in '' | *[!0-9.]*) usage ;; esac
	if [ "$HW_BACKEND" = lemnosd ]; then
		BLINK=$hz ON=1
		save_state
		render_lemnosd
		save_state
	else
		save_state
		start_blink "$hz" 0
	fi
	exit 0
	;;
locate)
	seconds=${1:-10}
	case "$seconds" in '' | *[!0-9]*) usage ;; esac
	if [ "$HW_BACKEND" = lemnosd ]; then
		# lemnosd's locate look, above every other intent, timed by lemnosd.
		ctl_led locate --seconds "$seconds"
		[ "${RAZE_LEDS_FOREGROUND:-0}" != 1 ] || sleep "$seconds"
		exit 0
	fi
	save_state
	# Bright cyan, whatever the saved colour and brightness are.
	(R=0 G=255 B=255 W=0 BRIGHT=100 && start_blink 3 "$seconds")
	exit 0
	;;
pixel)
	[ $# -ge 4 ] || usage
	px=$(byte "$2"),$(byte "$3"),$(byte "$4"),$(byte "${5:-0}")
	if [ "$1" = all ]; then
		hw_leds_fill "$px" || exit 1
		exit 0
	fi
	case "$1" in '' | *[!0-9]*) usage ;; esac
	if [ "$1" -ge "$(hw_leds_count)" ]; then
		echo "raze-leds: LED $1 is outside 0..$(($(hw_leds_count) - 1))" >&2
		exit 2
	fi
	# Index i is the (i+1)th argument; the ones before it are off.
	n=$1
	set --
	while [ "$#" -lt "$n" ]; do set -- "$@" 0,0,0,0; done
	hw_leds_write_frame "$@" "$px" || exit 1
	exit 0
	;;
refresh)
	# A running sysfs blink redraws by itself.
	[ "$HW_BACKEND" = lemnosd ] || [ ! -r "$BLINK_PID" ] || exit 0
	render
	[ "$HW_BACKEND" != lemnosd ] || save_state
	exit 0
	;;
show)
	if [ "$HW_BACKEND" = lemnosd ]; then
		blinking=no
		[ "$BLINK" = 0 ] || blinking=yes
	else
		blinking=$([ -r "$BLINK_PID" ] && echo yes || echo no)
	fi
	printf 'on=%s color=%s,%s,%s,%s brightness=%s%% blinking=%s\n' "$ON" "$R" "$G" "$B" "$W" "$BRIGHT" "$blinking"
	exit 0
	;;
*) usage ;;
esac

save_state
render
# lemnosd: remember which kind of intent is shown.
[ "$HW_BACKEND" != lemnosd ] || save_state
