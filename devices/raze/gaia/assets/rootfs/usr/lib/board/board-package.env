# Device package identity, read by the board scripts. Do not edit on a
# device: it describes the package the image was built from.
#
# BOARD_PACKAGE_VERSION is the release being worked toward, -dev while
# unreleased, the same as Atlas's; a build reports
# <year>.<major>.<minor>-dev.<count>+<commit> (board_package_version in lib.sh)
# from the two below, the commit count and commit of Atlas it came from.
#
# The OS sets them: write BOARD_PACKAGE_COMMIT=<commit> and BOARD_PACKAGE_COUNT=<count> (for Gaia,
# ${source.<id>.commit} and ${source.<id>.commit_count}) to
# /etc/board/board-package.env, which is read after this file.
BOARD_DEVICE_MODEL=raze
BOARD_PACKAGE_VERSION=2026.1.0-dev
BOARD_PACKAGE_COUNT=
BOARD_PACKAGE_COMMIT=
# Board revision reported until a real rev source exists (manifest.json "rev_source").
BOARD_DEVICE_REV_DEFAULT=gen1
# The board's config.txt fragment (the boot family checks the overlays it loads).
BOARD_DEVICE_CONFIG=raze-device.txt
