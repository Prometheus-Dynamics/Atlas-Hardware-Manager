# Device package identity, read by the board scripts. Do not edit on a
# device: it describes the package the image was built from.
#
# BOARD_PACKAGE_COMMIT is filled in by devices/tools/sync-device.sh when the
# package is vendored into an OS repo. When the layer is imported straight from
# git, the OS sets it: write BOARD_PACKAGE_COMMIT=<commit> (for Gaia,
# ${source.<id>.commit}) to /etc/board/board-package.env, which is read
# after this file.
BOARD_DEVICE_MODEL=raze
BOARD_PACKAGE_VERSION=1.0.7
BOARD_PACKAGE_COMMIT=
# Board revision reported until a real rev source exists (manifest.json "rev_source").
BOARD_DEVICE_REV_DEFAULT=gen1
