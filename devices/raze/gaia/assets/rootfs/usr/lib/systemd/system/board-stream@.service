[Unit]
Description=Board push channel viewer
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/bin/board-stream
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Read-only: it reads /data/board/events.jsonl and /run/board/update.json,
# and for the hardware topic lemnosd's readings (its socket is 0770, group
# lemnos; reads need no write policy). It runs while its viewer is connected
# (no RuntimeMaxSec) and ends when a write to it fails (a keepalive every
# 10 s); its lemnosd subscriptions end with it.
DynamicUser=yes
SupplementaryGroups=lemnos
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=16M
TasksMax=4
