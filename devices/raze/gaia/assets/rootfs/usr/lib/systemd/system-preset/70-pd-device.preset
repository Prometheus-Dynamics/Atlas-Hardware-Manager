# Device package units, enabled by default when the image is built
# (Buildroot runs `systemctl preset-all`). An OS turns one off with a preset
# file that sorts earlier, e.g. /usr/lib/systemd/system-preset/50-os.preset:
#   disable pd-device-http.socket
enable pd-device-hostname.service
enable pd-device-identity.service
enable pd-device-http.socket
enable pd-device-usb-gadget.service
enable pd-device-usb-gadget-dhcp.service
enable raze-leds-reprobe.service
enable pd-device-locate.path
enable pd-device-ssh-keys.service
enable serial-getty@.service ttyGS0 ttyGS1
enable pd-device-update-confirm.service
enable pd-device-update-link.service
