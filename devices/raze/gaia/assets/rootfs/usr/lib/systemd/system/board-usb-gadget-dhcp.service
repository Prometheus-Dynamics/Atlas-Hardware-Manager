[Unit]
Description=DHCP server for the USB gadget link
Documentation=file:/usr/lib/board/usb-gadget.env
Requires=board-usb-gadget.service
After=board-usb-gadget.service
# Restarts for as long as it fails (no start limit): the board has no one
# to restart it by hand.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/lib/board/usb-gadget-dhcp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
