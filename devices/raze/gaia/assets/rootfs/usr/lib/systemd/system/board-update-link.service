[Unit]
Description=Go back to the previous slot when the management link stays down
Documentation=file:/usr/lib/board/update
After=multi-user.target board-update-confirm.service
ConditionPathExists=/usr/lib/board/update

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/board/update check-link

[Install]
WantedBy=multi-user.target
