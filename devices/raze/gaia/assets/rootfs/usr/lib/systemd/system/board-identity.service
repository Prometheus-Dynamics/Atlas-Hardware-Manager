[Unit]
Description=Device identity (/run/board/identity.json) and mDNS advertisement
Documentation=file:/usr/lib/board/identity.env
# Early: the identity and the mDNS service files (/run/systemd/dnssd for
# resolved; avahi's bound into /etc/avahi/services by etc-avahi-services.mount
# with avahi.toml) are there before anything reads them.
DefaultDependencies=no
After=local-fs.target board-hostname.service
Before=sysinit.target shutdown.target systemd-resolved.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/board/identity --write --dnssd --quiet

[Install]
WantedBy=sysinit.target
