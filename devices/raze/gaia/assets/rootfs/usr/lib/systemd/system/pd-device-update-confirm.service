[Unit]
Description=Keep an A/B update once its trial boot is healthy
Documentation=file:/usr/lib/pd-device/update
After=multi-user.target
ConditionPathExists=/usr/lib/pd-device/update

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/pd-device/update confirm

[Install]
WantedBy=multi-user.target
