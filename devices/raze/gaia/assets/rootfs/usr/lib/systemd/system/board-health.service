[Unit]
Description=Keep the board's failed units for the identity endpoint (/run/board/failed.json)
Documentation=file:/usr/lib/board/status

[Service]
Type=oneshot
# Root: the identity endpoint's sandboxed user can't ask systemd itself, so
# GET /status reads this kept list while it is fresh (status, 120 s).
ExecStart=/usr/lib/board/status --refresh-failed --quiet
Nice=10
