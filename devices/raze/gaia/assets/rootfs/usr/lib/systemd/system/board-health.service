[Unit]
Description=Keep the board's failed units and hardware for the identity endpoint (/run/board/failed.json, hardware.json)
Documentation=file:/usr/lib/board/status

[Service]
Type=oneshot
# Root: the identity endpoint's sandboxed user can't ask systemd or lemnosd
# itself, so GET /status reads these kept results while they are fresh.
ExecStart=/usr/lib/board/status --refresh-failed --refresh-hardware --quiet
Nice=10
