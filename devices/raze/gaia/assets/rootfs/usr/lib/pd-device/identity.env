# Defaults for pd-device-identity.service. Override any of these in
# /etc/pd-device/identity.env.

# Write /run/systemd/dnssd/pd-device.dnssd so systemd-resolved advertises
# _pd-device._tcp over mDNS. 0 turns the advertisement off.
PD_MDNS=1

# Actions offered over the identity endpoint, space separated. Today:
#   locate   blink the LED ring so someone can find the board (raze-leds)
# A request only touches /run/pd-device/requests/<action>; a fixed root unit
# (pd-device-<action>.path/.service) does the work, so the unauthenticated
# endpoint itself stays unprivileged. Empty offers none.
PD_ACTIONS=locate
