# Defaults for pd-device-hostname.service. Override any of these in
# /etc/pd-device/hostname.env.
#
# The device hostname is only a default. It is applied as the transient
# (kernel) hostname, never written to /etc/hostname, and only when the static
# hostname is unset or one of PD_HOSTNAME_STOCK. An OS that wants the device
# name over its own default adds that name to the list, for example:
#   PD_HOSTNAME_STOCK="$PD_HOSTNAME_STOCK photonvision"

# if-stock: apply when the static hostname is unset or stock. never: do nothing.
PD_HOSTNAME_POLICY=if-stock
# {serial8}: last 8 hex digits of the board serial; {serial}: all of it.
PD_HOSTNAME_PATTERN=raze-{serial8}
PD_HOSTNAME_STOCK="localhost localhost.localdomain buildroot (none)"
