# Defaults for pd-device-update (/usr/lib/pd-device/update). Override any of
# these in /etc/pd-device/update.env.

# Seconds the trial boot waits before running the health check, so the
# application has time to start.
UPDATE_CONFIRM_DELAY=30

# 1: when the health check fails on a trial boot, restart into the previous
# version right away. 0: stay on the trial until something else resets it.
UPDATE_REBOOT_ON_FAIL=1

# The health check: an executable that exits 0 when the new version is good.
# Empty uses /etc/pd-device/update-health, then /usr/lib/pd-device/update-health;
# with neither, a trial boot that reaches multi-user.target is good.
UPDATE_HEALTH=
