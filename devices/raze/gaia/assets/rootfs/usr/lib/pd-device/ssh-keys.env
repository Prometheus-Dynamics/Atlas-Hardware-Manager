# Defaults for pd-device-ssh-keys.service. Override any of these in
# /etc/pd-device/ssh-keys.env.

# 0 ignores keys on the boot partition.
SSH_KEYS_ENABLED=1
# Relative to the boot partition's root.
SSH_KEYS_SOURCE=pd-device/authorized_keys
# Whose authorized_keys get them.
SSH_KEYS_HOME=/root
# Empty: partition 1 of the root filesystem's disk.
SSH_KEYS_BOOT_PARTITION=
