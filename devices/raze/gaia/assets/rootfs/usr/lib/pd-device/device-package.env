# Device package identity, read by the pd-device scripts. Do not edit on a
# device: it describes the package the image was built from.
#
# PD_DEVICE_PACKAGE_COMMIT is filled in by devices/tools/sync-device.sh when the
# package is vendored into an OS repo, and stays empty when the layer is used
# straight from an Atlas checkout.
PD_DEVICE_MODEL=raze
PD_DEVICE_PACKAGE_VERSION=1.0.3
PD_DEVICE_PACKAGE_COMMIT=
# Board revision reported until a real rev source exists (manifest.json "rev_source").
PD_DEVICE_REV_DEFAULT=gen1
