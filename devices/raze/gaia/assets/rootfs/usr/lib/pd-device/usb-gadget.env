# Defaults for pd-device-usb-gadget.service. Override any of these in
# /etc/pd-device/usb-gadget.env.

# 0 leaves the USB controller alone.
USB_GADGET_ENABLED=1
USB_GADGET_NAME=g1

# Generic Linux composite gadget id; there is no assigned VID/PID.
USB_GADGET_VID=0x1d6b
USB_GADGET_PID=0x0104
USB_GADGET_MANUFACTURER="Prometheus Dynamics"
USB_GADGET_PRODUCT="Raze"
# AUTO: the board serial (device tree serial-number).
USB_GADGET_SERIAL=AUTO

# Functions. ECM goes in configuration 1 (Linux, macOS), RNDIS in
# configuration 2 with Microsoft OS descriptors (Windows). NCM replaces ECM in
# configuration 1 when USB_GADGET_ECM=0 and USB_GADGET_NCM=1. ACM adds a serial
# port to both configurations.
USB_GADGET_ECM=1
USB_GADGET_RNDIS=1
USB_GADGET_NCM=0
USB_GADGET_ACM=1
USB_GADGET_OS_DESC=1

# AUTO: derived from the board serial with the locally administered bit set
# (see manifest.json identity.mac_rule). Set explicit addresses to override.
USB_GADGET_DEV_ADDR=AUTO
USB_GADGET_HOST_ADDR=AUTO

# Seconds to wait for the USB device controller to appear.
USB_GADGET_UDC_WAIT_SEC=30
# Empty: the first controller in /sys/class/udc.
USB_GADGET_UDC=

# bridge: put the gadget network interfaces in USB_GADGET_BRIDGE with
# USB_GADGET_ADDRESS, and serve DHCP on it. Only gadget interfaces are ever
# added; Ethernet is never bridged. none: leave the interfaces to the OS.
USB_GADGET_NET=bridge
USB_GADGET_BRIDGE=usbbr0
USB_GADGET_ADDRESS=172.31.250.1/24
# DHCP on the USB link only (dnsmasq, DNS disabled, no default route offered).
USB_GADGET_DHCP=1
USB_GADGET_DHCP_RANGE=172.31.250.2,172.31.250.20,255.255.255.0,1h
