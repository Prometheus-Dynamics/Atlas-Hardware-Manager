#!/bin/sh
# Configure the USB device controller as a composite gadget: network (ECM or
# NCM for Linux/macOS, RNDIS for Windows) plus an ACM serial port.
#
# The gadget network is USB only. Its interfaces go into a bridge of their own
# (usbbr0) with a static address and a DHCP server for the host on the other
# end of the cable. Ethernet (end0/end1/eth*) is never added to it.
#
# MAC addresses derive from the board serial with the locally administered bit
# set (lib.sh pd_mac_base), else from /etc/machine-id; never a fixed constant.
# Settings: usb-gadget.env.
set -eu

PD_LIB_DIR=${PD_LIB_DIR:-/usr/lib/pd-device}
# shellcheck source=lib.sh
. "$PD_LIB_DIR/lib.sh"

pd_load_env usb-gadget.env

if [ "${USB_GADGET_ENABLED:-1}" != 1 ]; then
	pd_log "disabled (USB_GADGET_ENABLED=${USB_GADGET_ENABLED:-})"
	exit 0
fi

CONFIGFS=${PD_CONFIGFS:-/sys/kernel/config}
UDC_CLASS=${PD_UDC_CLASS:-/sys/class/udc}
G="$CONFIGFS/usb_gadget/${USB_GADGET_NAME:-g1}"

serial=${USB_GADGET_SERIAL:-AUTO}
if [ "$serial" = AUTO ] || [ -z "$serial" ]; then
	serial=$(pd_serial)
	[ -n "$serial" ] || serial=$(pd_machine_id | cut -c1-16)
fi

dev_addr=${USB_GADGET_DEV_ADDR:-AUTO}
host_addr=${USB_GADGET_HOST_ADDR:-AUTO}
if [ "$dev_addr" = AUTO ] || [ -z "$dev_addr" ] || [ "$host_addr" = AUTO ] || [ -z "$host_addr" ]; then
	if base=$(pd_mac_base); then
		dev_addr=$base
		host_addr=$(pd_mac_variant "$base" 0x01)
	else
		pd_log "no board serial or machine id: the kernel will pick random MAC addresses"
		dev_addr=''
		host_addr=''
	fi
fi

# One stable address pair per function, so a host that sees several functions
# never gets duplicate MACs.
mac_for() {
	# mac_for <mac> <mask>
	if [ -n "$1" ]; then
		pd_mac_variant "$1" "$2"
	fi
}

set_addrs() {
	# set_addrs <function dir> <mask>
	if [ -n "$dev_addr" ]; then
		mac_for "$dev_addr" "$2" > "$1/dev_addr"
		mac_for "$host_addr" "$2" > "$1/host_addr"
	fi
}

modprobe dwc2 2>/dev/null || true
modprobe libcomposite 2>/dev/null || true

if ! mountpoint -q "$CONFIGFS" 2>/dev/null; then
	mount -t configfs configfs "$CONFIGFS" 2>/dev/null || true
fi
if [ ! -d "$CONFIGFS/usb_gadget" ]; then
	pd_log "$CONFIGFS/usb_gadget is missing (configfs or libcomposite not available)"
	exit 1
fi

udc=${USB_GADGET_UDC:-}
if [ -z "$udc" ]; then
	waited=0
	limit=${USB_GADGET_UDC_WAIT_SEC:-30}
	while :; do
		udc=$(ls "$UDC_CLASS" 2>/dev/null | head -n 1)
		[ -z "$udc" ] || break
		if [ "$waited" -ge "$limit" ]; then
			pd_log "no USB device controller after ${limit}s (is dtoverlay=dwc2,dr_mode=peripheral set?)"
			exit 1
		fi
		sleep 1
		waited=$((waited + 1))
	done
fi

# Remove a previous gadget, in the order configfs requires.
teardown() {
	[ -d "$G" ] || return 0
	echo '' > "$G/UDC" 2>/dev/null || true
	rm -f "$G/os_desc/c.2" 2>/dev/null || true
	for cfg in "$G"/configs/*; do
		[ -d "$cfg" ] || continue
		for link in "$cfg"/*; do
			if [ -L "$link" ]; then
				rm -f "$link"
			fi
		done
		rmdir "$cfg/strings/0x409" 2>/dev/null || true
		rmdir "$cfg" 2>/dev/null || true
	done
	for func in "$G"/functions/*; do
		[ -d "$func" ] || continue
		rmdir "$func/os_desc/interface.rndis" 2>/dev/null || true
		rmdir "$func" 2>/dev/null || true
	done
	rmdir "$G/strings/0x409" 2>/dev/null || true
	rmdir "$G" 2>/dev/null || true
}
teardown

mkdir -p "$G"
echo "${USB_GADGET_VID:-0x1d6b}" > "$G/idVendor"
echo "${USB_GADGET_PID:-0x0104}" > "$G/idProduct"
echo 0x0100 > "$G/bcdDevice"
echo 0x0200 > "$G/bcdUSB"
# Composite device class (IAD), which Windows needs to bind RNDIS + ACM.
echo 0xEF > "$G/bDeviceClass"
echo 0x02 > "$G/bDeviceSubClass"
echo 0x01 > "$G/bDeviceProtocol"
echo high-speed > "$G/max_speed" 2>/dev/null || true

mkdir -p "$G/strings/0x409"
printf '%s' "$serial" > "$G/strings/0x409/serialnumber"
printf '%s' "${USB_GADGET_MANUFACTURER:-Prometheus Dynamics}" > "$G/strings/0x409/manufacturer"
printf '%s' "${USB_GADGET_PRODUCT:-Raze}" > "$G/strings/0x409/product"

C1="$G/configs/c.1"
C2="$G/configs/c.2"
mkdir -p "$C1/strings/0x409" "$C2/strings/0x409"
echo "${USB_GADGET_PRODUCT:-Raze} (ECM/NCM)" > "$C1/strings/0x409/configuration"
echo "${USB_GADGET_PRODUCT:-Raze} (RNDIS)" > "$C2/strings/0x409/configuration"
for cfg in "$C1" "$C2"; do
	echo 0x80 > "$cfg/bmAttributes"
	echo 250 > "$cfg/MaxPower"
done

net_functions=''

if [ "${USB_GADGET_ECM:-1}" = 1 ]; then
	mkdir -p "$G/functions/ecm.usb0"
	set_addrs "$G/functions/ecm.usb0" 0x00
	ln -s "$G/functions/ecm.usb0" "$C1/ecm.usb0"
	net_functions="$net_functions ecm.usb0"
elif [ "${USB_GADGET_NCM:-0}" = 1 ]; then
	mkdir -p "$G/functions/ncm.usb0"
	set_addrs "$G/functions/ncm.usb0" 0x20
	ln -s "$G/functions/ncm.usb0" "$C1/ncm.usb0"
	net_functions="$net_functions ncm.usb0"
fi

if [ "${USB_GADGET_RNDIS:-1}" = 1 ]; then
	mkdir -p "$G/functions/rndis.usb0"
	set_addrs "$G/functions/rndis.usb0" 0x10
	ln -s "$G/functions/rndis.usb0" "$C2/rndis.usb0"
	net_functions="$net_functions rndis.usb0"
	if [ "${USB_GADGET_OS_DESC:-1}" = 1 ]; then
		echo 1 > "$G/os_desc/use"
		echo MSFT100 > "$G/os_desc/qw_sign"
		echo 0x01 > "$G/os_desc/b_vendor_code"
		mkdir -p "$G/functions/rndis.usb0/os_desc/interface.rndis"
		echo RNDIS > "$G/functions/rndis.usb0/os_desc/interface.rndis/compatible_id"
		echo 5162001 > "$G/functions/rndis.usb0/os_desc/interface.rndis/sub_compatible_id"
		ln -s "$C2" "$G/os_desc/c.2"
	fi
fi

if [ "${USB_GADGET_ACM:-1}" = 1 ]; then
	mkdir -p "$G/functions/acm.usb0" "$G/functions/acm.usb1"
	ln -s "$G/functions/acm.usb0" "$C1/acm.usb0"
	ln -s "$G/functions/acm.usb1" "$C2/acm.usb1"
fi

echo "$udc" > "$G/UDC"
# The ACM ports exist now: start their consoles if the OS wants them.
if [ "${USB_GADGET_ACM:-1}" = 1 ] && command -v systemctl >/dev/null 2>&1; then
	systemctl --no-block start serial-getty@ttyGS0.service serial-getty@ttyGS1.service 2>/dev/null || true
fi
pd_log "gadget bound to $udc: ${USB_GADGET_VID:-0x1d6b}:${USB_GADGET_PID:-0x0104} serial=$serial functions:$net_functions acm=${USB_GADGET_ACM:-1} mac=${dev_addr:-random}"

if [ "${USB_GADGET_NET:-bridge}" != bridge ] || [ -z "$net_functions" ]; then
	exit 0
fi

bridge=${USB_GADGET_BRIDGE:-usbbr0}
if ! ip link show dev "$bridge" >/dev/null 2>&1; then
	ip link add "$bridge" type bridge
fi
if [ -n "$dev_addr" ]; then
	ip link set dev "$bridge" address "$dev_addr"
fi
for func in $net_functions; do
	# configfs reports the network interface each function created.
	ifname=$(cat "$G/functions/$func/ifname" 2>/dev/null) || ifname=''
	case "$ifname" in
	'' | *'%d'*)
		pd_log "no interface name for $func"
		continue
		;;
	end* | eth* | en* | wl*)
		# Never bridge anything that is not a gadget interface.
		pd_log "refusing to bridge $ifname"
		continue
		;;
	esac
	ip link set dev "$ifname" master "$bridge"
	ip link set dev "$ifname" up
done
ip addr replace "${USB_GADGET_ADDRESS:-172.31.250.1/24}" dev "$bridge"
ip link set dev "$bridge" up

# mDNS on the USB link, so the host can find the device by name. Ethernet mDNS
# is the OS's network configuration (see devices/README.md).
if command -v resolvectl >/dev/null 2>&1; then
	resolvectl mdns "$bridge" yes 2>/dev/null || true
fi

mkdir -p "$PD_RUN_DIR"
cat > "$PD_RUN_DIR/usb-gadget-dnsmasq.conf" <<EOF
# Generated by pd-device-usb-gadget.service. DHCP for the USB link only.
port=0
interface=$bridge
bind-dynamic
dhcp-authoritative
dhcp-range=${USB_GADGET_DHCP_RANGE:-172.31.250.2,172.31.250.20,255.255.255.0,1h}
# No default route for the host.
dhcp-option=option:router
dhcp-leasefile=$PD_RUN_DIR/usb-gadget-dhcp.leases
EOF
