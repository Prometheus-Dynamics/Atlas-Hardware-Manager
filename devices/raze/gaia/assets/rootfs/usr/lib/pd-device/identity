#!/bin/sh
# Device identity (contract 1).
#
#   identity            print the identity JSON
#   identity --write    also write $PD_RUN_DIR/identity.json
#   identity --dnssd    also write the mDNS advertisement for systemd-resolved
#
# pd-device-identity.service runs `identity --write --dnssd` at boot, before
# systemd-resolved starts. The HTTP endpoint builds the document per request.
set -eu

PD_LIB_DIR=${PD_LIB_DIR:-/usr/lib/pd-device}
# shellcheck source=lib.sh
. "$PD_LIB_DIR/lib.sh"

PD_DNSSD_DIR=${PD_DNSSD_DIR:-/run/systemd/dnssd}
PD_HTTP_PORT=5899
PD_HTTP_PATH=/.well-known/pd-device

write=0
dnssd=0
quiet=0
for arg in "$@"; do
	case "$arg" in
	--write) write=1 ;;
	--dnssd) dnssd=1 ;;
	--quiet) quiet=1 ;;
	*)
		pd_log "unknown argument: $arg"
		exit 2
		;;
	esac
done

# Atomic replace, so readers never see a partial file.
write_file() {
	_dir=${1%/*}
	mkdir -p "$_dir"
	_tmp="$1.tmp.$$"
	cat > "$_tmp"
	chmod 0644 "$_tmp"
	mv -f "$_tmp" "$1"
}

# TXT values: no quotes, backslashes or '%' (resolved expands specifiers).
txt_value() {
	printf '%s' "$1" | tr -c 'A-Za-z0-9._:+-' '_' | cut -c1-200
}

json=$(pd_identity_json)

if [ "$write" = 1 ]; then
	printf '%s\n' "$json" | write_file "$PD_RUN_DIR/identity.json"
fi

if [ "$dnssd" = 1 ]; then
	pd_load_env device-package.env
	pd_load_env identity.env
	target="$PD_DNSSD_DIR/pd-device.dnssd"
	if [ "${PD_MDNS:-1}" = 1 ]; then
		os_ver=$(pd_os_field VERSION_ID)
		[ -n "$os_ver" ] || os_ver=$(pd_os_field VERSION)
		{
			printf '# Generated at boot by pd-device-identity.service; edits are lost.\n'
			printf '# Turn the advertisement off with PD_MDNS=0 in /etc/pd-device/identity.env.\n'
			printf '[Service]\n'
			printf 'Name=%%H\n'
			printf 'Type=_pd-device._tcp\n'
			printf 'Port=%s\n' "$PD_HTTP_PORT"
			printf 'TxtText="contract=1" "model=%s" "rev=%s" "serial=%s" "os=%s" "os_ver=%s" "path=%s"\n' \
				"$(txt_value "${PD_DEVICE_MODEL:-}")" \
				"$(txt_value "$(pd_rev)")" \
				"$(txt_value "$(pd_serial)")" \
				"$(txt_value "$(pd_os_field ID)")" \
				"$(txt_value "$os_ver")" \
				"$PD_HTTP_PATH"
		} | write_file "$target"
	else
		rm -f "$target"
	fi
fi

if [ "$quiet" = 0 ]; then
	printf '%s\n' "$json"
fi
