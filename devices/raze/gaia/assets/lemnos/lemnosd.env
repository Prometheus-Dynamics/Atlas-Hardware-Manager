# /etc/default/lemnosd.env: settings for lemnosd.service on a Raze.
#
# The Raze package's copy of Lemnos's packaging/systemd/lemnosd.env.example
# (Gaia item `lemnosd-env`, redeclared by gaia/lemnos.toml). Plain KEY=value
# lines (systemd EnvironmentFile syntax); they override the unit's
# Environment= defaults. Restart after editing: `systemctl restart lemnosd`.
# An OS replaces the file by redeclaring `lemnosd-env` in a layer imported
# after the device layer.

# The board definition, generated from the package manifest.
#LEMNOSD_BOARD=/etc/lemnos/board.toml

# The socket clients connect to (lemnos-ctl --socket).
#LEMNOSD_SOCKET=/run/lemnos/lemnosd.sock

# The package's update writer (/usr/lib/board/update) keeps its status here
# and the image copy's progress in /run/board/update/progress; lemnosd shows
# both on the status ring (updating, booting, update-failed).
LEMNOSD_UPDATE_STATUS=/run/board/update.json

# Show the booting spinner for this long after start, or until a client sets
# a status (0: off).
#LEMNOSD_BOOTING_MS=30000
