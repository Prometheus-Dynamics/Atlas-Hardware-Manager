config BR2_PACKAGE_BOARD_AGENT
	bool "board-agent"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_HOST_RUSTC
	help
	  The board's Orion device agent: connects to orion-node's local
	  IPC, claims the node actions update, update.cancel,
	  update.rollback, reboot and locate, runs them with the device
	  package's writer (/usr/lib/board/update), and publishes the
	  writer's state as the update.* status keys. Without orion-node
	  it waits; nothing on the board depends on it.

	  Source: crates/board-agent in the Atlas repository this device
	  package belongs to (built from that checkout, see
	  board-agent.mk).
