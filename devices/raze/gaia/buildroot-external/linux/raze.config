# Raze kernel fragment, applied on top of bcm2712_defconfig, after any
# fragments the OS lists in BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES (external.mk
# appends it last), so these decisions can't be overridden by an OS layer.
#
# 0. Page size: 4 KiB, what every Raze image has actually run. Buildroot sets
#    the kernel's page size from BR2_ARM64_PAGE_SIZE_* (kernel.toml) after all
#    fragments, so that option is the real switch; this line only states it.
#    bcm2712_defconfig's 16K (and the "-v8-16k" in the kernel's name) never
#    reached a Buildroot image. 16K is faster on the Pi 5 but breaks prebuilt
#    arm64 libraries linked for 4K pages, so it needs a hardware test (the
#    OS's native libraries, e.g. PhotonVision's JNI) before switching both
#    lines. external.mk fails the build if the result disagrees.
CONFIG_ARM64_4K_PAGES=y
# CONFIG_ARM64_16K_PAGES is not set
# CONFIG_ARM64_64K_PAGES is not set
#
# 1. The root filesystem may be EROFS (read-only, compressed), mounted by the
#    kernel itself, without an initramfs: built in, with LZMA and ZSTD.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_ZSTD=y

# 2. Only what a Raze uses. Kept on purpose: the USB gadget's bridge
#    (BRIDGE), CAN, USB webcams (USB_VIDEO_CLASS) and USB Ethernet adapters,
#    IIO and hwmon (the IMU, magnetometer and power monitor), overlayfs,
#    sound (DRM_VC4, the display and GPU driver, depends on SND && SND_SOC),
#    vfat/exfat/ext4/squashfs, and Pi staging drivers.
#
# No radio hardware: Wi-Fi and Bluetooth are disabled by overlay anyway.
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_IEEE802154 is not set
# CONFIG_6LOWPAN is not set
# CONFIG_ATM is not set
# Media: cameras only (the OV9782 through rp1-cfe and PiSP, and USB cameras).
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
# CONFIG_DVB_CORE is not set
# CONFIG_RC_CORE is not set
# CONFIG_USB_GSPCA is not set
# Input devices a camera board never has.
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# Storage: no RAID or network block devices.
# CONFIG_BLK_DEV_MD is not set
# CONFIG_BLK_DEV_DRBD is not set
# CONFIG_BLK_DEV_NBD is not set
# Filesystems nothing here mounts.
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# Camera sensors other than the OV9782 (VIDEO_OV9282, set by the ov9782
# extension).
# CONFIG_VIDEO_AD5398 is not set
# CONFIG_VIDEO_ADV7180 is not set
# CONFIG_VIDEO_AK7375 is not set
# CONFIG_VIDEO_ARDUCAM_64MP is not set
# CONFIG_VIDEO_ARDUCAM_PIVARIETY is not set
# CONFIG_VIDEO_BU64754 is not set
# CONFIG_VIDEO_CS53L32A is not set
# CONFIG_VIDEO_CX25840 is not set
# CONFIG_VIDEO_DW9807_VCM is not set
# CONFIG_VIDEO_I2C is not set
# CONFIG_VIDEO_IMX219 is not set
# CONFIG_VIDEO_IMX258 is not set
# CONFIG_VIDEO_IMX283 is not set
# CONFIG_VIDEO_IMX290 is not set
# CONFIG_VIDEO_IMX296 is not set
# CONFIG_VIDEO_IMX335 is not set
# CONFIG_VIDEO_IMX355 is not set
# CONFIG_VIDEO_IMX415 is not set
# CONFIG_VIDEO_IMX477 is not set
# CONFIG_VIDEO_IMX500 is not set
# CONFIG_VIDEO_IMX519 is not set
# CONFIG_VIDEO_IMX708 is not set
# CONFIG_VIDEO_IR_I2C is not set
# CONFIG_VIDEO_IRS1125 is not set
