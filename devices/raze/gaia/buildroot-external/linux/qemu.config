# Raze kernel for QEMU (-M virt): applied last, after raze.config and the
# trim, when BR2_RAZE_KERNEL_QEMU is on (external.mk). Never on in a board
# build: HeliOS's qemu layer sets it for the simulated board (Gaia's
# scripts/qemu-rpi-slots.sh). It only adds options (virtio, the generic PCI
# host, PL011/PL031/PL061, GICv3, the i6300esb watchdog the runner always
# attaches); LOCALVERSION, the page size and
# MODVERSIONS stay, so the release (and slot-init's kernel check) and the
# modules' vermagic are the board kernel's. raze.config turns VIRTIO_MENU
# off; this turns it back on.
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
CONFIG_ARM_GIC_V3=y
CONFIG_GPIO_PL061=y
CONFIG_KEYBOARD_GPIO=m
CONFIG_I6300ESB_WDT=y
