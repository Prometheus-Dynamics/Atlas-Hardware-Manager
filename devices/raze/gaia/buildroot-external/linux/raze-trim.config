# Raze kernel, install-size trim: applied after raze.config when
# BR2_RAZE_KERNEL_TRIM is on (the default; external.mk). Board-tested on r58:
# every Raze device, the camera stack, dm-verity, nft NAT and the USB gadget
# up, PhotonVision's pipeline timing unchanged, the slot started 0.13 s
# sooner. Built with -Os (r57) it died before pstore came up, so -O2 it
# stays. raze.config keeps gamepads; this turns them off with the rest of
# HID.
# CONFIG_JOYSTICK_XPAD is not set
#
# Install size (every boot partition and every slot carries the kernel,
#    and every slot's root carries its modules). Kept: what PhotonVision,
#    HeliOS and the Raze roadmap use (USB cameras through UVC, the USB
#    Ethernet adapters below, usb-storage, the gadget stack, I2C/SPI/GPIO/
#    PIO/PWM, hwmon, thermal, the watchdog, pstore, zram, IPv6, the bridge,
#    VLANs and nftables), vc4 and v3d (the GPU and the KMS overlay).
#    Measured on the board's own config (photon-image-modifier 783778d):
#    Image 17.92 -> 14.89 MB, kernel8.img (gzip) 8.04 -> 6.65 MB, modules
#    323 files / 15.8 MB -> 249 / 12.3 MB (-O2; -Os would have made
#    kernel8.img 5.60 MB, but that kernel didn't boot). NET_SCHED stays: a
#    Buildroot package turns it on.
#
# Kernel debugging and tracing a camera never uses (oopses still name
# functions: KALLSYMS stays).
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_KPROBES is not set
# CONFIG_SLUB_DEBUG is not set
# Security modules and auditing: systemd needs neither; AppArmor selects
# AUDIT.
# CONFIG_SECURITY_APPARMOR is not set
CONFIG_DEFAULT_SECURITY_DAC=y
# CONFIG_AUDIT is not set
# 32-bit programs and CPU features the Cortex-A76 doesn't have.
# CONFIG_COMPAT is not set
# CONFIG_ARM64_SVE is not set
# CONFIG_ARM64_SME is not set
# Android, NVMe (no M.2 on the carrier), the legacy RAM disk (the slot
# initramfs is a cpio), and io_uring (nothing here uses it).
# CONFIG_ANDROID_BINDER_IPC is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_CORE is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_IO_URING is not set
# Consoles: the serial console and the USB gadget's (ttyGS0); no virtual
# terminals on HDMI, and no 8250 UARTs (the CM5's are PL011).
# CONFIG_VT is not set
# CONFIG_SERIAL_8250 is not set
# Input: no HID (keyboards, mice, gamepads) on a robot camera.
# CONFIG_HID_SUPPORT is not set
# CONFIG_INPUT_JOYSTICK is not set
# Networking a camera doesn't do: Multipath TCP, containers' veth and macvlan.
# CONFIG_MPTCP is not set
# CONFIG_VETH is not set
# CONFIG_MACVLAN is not set
# CAN: no transceiver on gen1.
# CONFIG_CAN is not set
# USB serial adapters.
# CONFIG_USB_SERIAL is not set
# USB Ethernet: cdc_ether, cdc_ncm, r8152, ax88179_178a and asix stay.
# LAN78xx and SMSC95xx are the Pi 3/4 boards' own chips, built in.
# CONFIG_USB_LAN78XX is not set
# CONFIG_USB_NET_SMSC95XX is not set
# CONFIG_USB_NET_SMSC75XX is not set
# CONFIG_USB_CATC is not set
# CONFIG_USB_KAWETH is not set
# CONFIG_USB_PEGASUS is not set
# CONFIG_USB_RTL8150 is not set
# CONFIG_USB_NET_CDC_EEM is not set
# CONFIG_USB_NET_HUAWEI_CDC_NCM is not set
# CONFIG_USB_NET_CDC_MBIM is not set
# CONFIG_USB_NET_DM9601 is not set
# CONFIG_USB_NET_SR9700 is not set
# CONFIG_USB_NET_SR9800 is not set
# CONFIG_USB_NET_GL620A is not set
# CONFIG_USB_NET_NET1080 is not set
# CONFIG_USB_NET_PLUSB is not set
# CONFIG_USB_NET_MCS7830 is not set
# CONFIG_USB_NET_RNDIS_HOST is not set
# CONFIG_USB_NET_CDC_SUBSET is not set
# CONFIG_USB_NET_ZAURUS is not set
# CONFIG_USB_NET_CX82310_ETH is not set
# CONFIG_USB_NET_QMI_WWAN is not set
# CONFIG_USB_NET_INT51X1 is not set
# CONFIG_USB_IPHETH is not set
# CONFIG_USB_NET_AQC111 is not set
# Sound: the cores stay (DRM_VC4 depends on SND and SND_SOC); no USB audio
# or generic sound drivers.
# CONFIG_SND_USB is not set
# CONFIG_SND_DRIVERS is not set
# CONFIG_SND_SPI is not set
# Displays other than HDMI through vc4.
# CONFIG_DRM_RP1_DSI is not set
# Filesystems: ext4, vfat, erofs, tmpfs, squashfs and configfs stay.
# CONFIG_EXFAT_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_QUOTA is not set
# CONFIG_FS_ENCRYPTION is not set
# Swap goes to zram; no zswap.
# CONFIG_ZSWAP is not set
# Not built for size: the -Os kernel (kernel8.img 5.60 MB) didn't boot on
# the board (r57: dead before pstore and the console came up).
