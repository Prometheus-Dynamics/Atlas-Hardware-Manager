#!/bin/sh
# Bring-up LEDs (adapted from Gaia's examples/components/board-alive at 0fb5637, see component.toml).
#   /etc/board-alive.leds   the LEDs to drive, one name per line (names under /sys/class/leds). Required: a
#                           missing or empty file drives no LED (nothing is guessed).
#   /etc/board-alive.links  the links the user reaches the board by, one per line: an interface name (usb0), or
#                           `ether` (the Ethernet device). Required: a missing or empty file means no link counts.
# Beat (heartbeat trigger) while no named link has an IPv4 address; a 1 s blink (timer trigger) once one has.
# Looks every two seconds and depends on no DHCP client's hooks. The kernel keeps the trigger running after this
# script is stuck, so a hang shows as a reset cycle, not as a stopped beat.

listed() {
    # Prints the names in $1 (one per line, blank lines and # comments skipped); prints nothing when $1 is absent.
    [ -r "$1" ] || return 0
    sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//' "$1" | grep -v '^$'
}

show() {
    for led in $(listed /etc/board-alive.leds); do
        dir=/sys/class/leds/$led
        [ -w "$dir/trigger" ] || continue
        case "$1" in
            beat)
                echo heartbeat > "$dir/trigger" 2>/dev/null
                ;;
            leased)
                echo timer > "$dir/trigger" 2>/dev/null
                echo 1000 > "$dir/delay_on" 2>/dev/null
                echo 1000 > "$dir/delay_off" 2>/dev/null
                ;;
        esac
    done
}

# An IPv4 address with global scope on one of the named links. A name is an interface name, or `ether`: every
# Ethernet-type link (sysfs type 1) except usb0, the same set networkd's 10-bringup-ethernet.network matches
# (Type=ether, Name=!usb0). The Ethernet name is not fixed (eth0 or end0 by predictable naming), so `ether` is the
# only way a board's Ethernet is named here.
leased() {
    for name in $(listed /etc/board-alive.links); do
        if [ "$name" = ether ]; then
            for dev in /sys/class/net/*; do
                n=${dev##*/}
                [ "$n" = usb0 ] && continue
                [ "$(cat "$dev/type" 2>/dev/null)" = 1 ] || continue
                ip -4 -o addr show dev "$n" scope global 2>/dev/null | grep -q . && return 0
            done
        else
            ip -4 -o addr show dev "$name" scope global 2>/dev/null | grep -q . && return 0
        fi
    done
    return 1
}

state=
while :; do
    if leased; then now=leased; else now=beat; fi
    if [ "$now" != "$state" ]; then
        show "$now"
        state=$now
    fi
    sleep 2
done
