#!/bin/sh
# DEV ONLY (bring-up). usb0 at 10.55.0.1/24 for the OTG gadget network, with a
# DHCP server for the host (10.55.0.2). BusyBox init runs it as S41usb0.
case "$1" in
start)
	i=0
	while [ ! -e /sys/class/net/usb0 ] && [ "$i" -lt 30 ]; do
		sleep 1
		i=$((i + 1))
	done
	[ -e /sys/class/net/usb0 ] || { echo "usb0: no gadget interface" >&2; exit 1; }
	ip addr add 10.55.0.1/24 dev usb0 2>/dev/null
	ip link set usb0 up
	udhcpd /etc/udhcpd.usb0.conf
	;;
stop)
	kill "$(pidof udhcpd)" 2>/dev/null
	ip link set usb0 down 2>/dev/null
	;;
*)
	echo "usage: $0 {start|stop}" >&2
	exit 1
	;;
esac
