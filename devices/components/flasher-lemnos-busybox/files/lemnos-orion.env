# /etc/lemnos/lemnos-orion.env for the bcm2712 flasher: Lemnos's packaging/systemd/lemnos-orion.env.example
# (da86d0b3) with the lines a flasher sets. Read by S51lemnos-orion.
LEMNOS_ORION_USER=lemnos-orion
LEMNOS_ORION_GROUP=lemnos-orion
LEMNOS_ORION_GROUPS=lemnos,orion
# The USB link: the board file's gadget, and the default composition's first interface. Orion's
# links.usb names the same link (flasher-orion's orion.conf).
LEMNOS_ORION_LINKS=gadget=orion-link
# The first-flash streams: the board file's `flash` device takes image.img.xz and image.img, each after its
# <name>.json manifest (docs/slots.md, "First flash > Over Orion"). Atlas pushes to lemnos/flash/<name>.
LEMNOS_ORION_STREAMS=flash=image.img.xz+image.img
# The flash device's file directory: the manifest is a committed file here, kept until a push of the same name
# replaces it (Lemnos, "The manifest after a broken push"). In RAM: S39flasher-net makes it at each boot.
LEMNOS_ORION_FILES=flash=/run/lemnos-flash
