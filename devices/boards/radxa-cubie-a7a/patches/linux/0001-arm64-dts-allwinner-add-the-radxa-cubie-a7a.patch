From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] arm64: dts: allwinner: add the Radxa Cubie A7A (bench, untested)

Bench image device tree (candidate, UNTESTED). Makefile line after the A7S entry; the A7S entry is the DockSeed series' (fe0a8ed).
---
--- a/arch/arm64/boot/dts/allwinner/Makefile	2026-11-14 23:02:58.700170418 -0700
+++ b/arch/arm64/boot/dts/allwinner/Makefile	2026-11-14 23:02:58.770645338 -0700
@@ -1,3 +1,4 @@
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h700-anbernic-rg35xx-sp.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun60i-a733-cubie-a7s.dtb
+dtb-$(CONFIG_ARCH_SUNXI) += sun60i-a733-cubie-a7a.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun55i-a527-cubie-a5e.dtb

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+/*
+ * Radxa Cubie A7A: a kernel device tree for bench images. CANDIDATE, UNTESTED, NEVER BOOTED. Bench only.
+ * Base: the Cubie A7S board tree of the DockSeed A733 series (fe0a8ed, patches/a733-dts, a733-ramoops-a7s,
+ * a733-a7s-usbc not carried, a733-board LEDs not carried). Peripherals from Radxa's U-Boot tree 9da4b3e8
+ * (arch/arm/dts/sun60i-a733-radxa-a7a.dts), which is the A7A's only public board description. The A7Z has no
+ * public board description; its peripherals are the A7A's and are UNVERIFIED.
+ * Not written here: the PMIC (AXP318), LEDs, USB-C typec, UFS, and any VBUS regulator on the device port.
+ */
+
+/dts-v1/;
+
+#include "sun60i-a733.dtsi"
+
+/ {
+	model = "Radxa A7A";
+	compatible = "radxa,cubie-a7a", "allwinner,sun60i-a733";
+
+	aliases {
+		serial0 = &uart0;
+		mmc0 = &mmc0;
+		mmc2 = &mmc2;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	reserved-memory {
+		/* pstore records, kept in DRAM across a warm reset (values as in the A7S series ramoops patch) */
+		ramoops@60000000 {
+			compatible = "ramoops";
+			reg = <0x0 0x60000000 0x0 0x100000>;
+			console-size = <0x40000>;
+			record-size = <0x20000>;
+			ecc-size = <16>;
+		};
+	};
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_pb9_pb10_pins>;
+	status = "okay";
+};
+
+&mmc0 {
+	bus-width = <4>;
+	status = "okay";
+};
+
+&mmc2 {
+	bus-width = <8>;
+	cap-mmc-hw-reset;
+	mmc-ddr-1_8v;
+	mmc-hs200-1_8v;
+	non-removable;
+	status = "okay";
+};
+
+&usb_otg {
+	dr_mode = "peripheral";
+	status = "okay";
+};
+
+&gmac0 {
+	phy-mode = "rgmii-id";
+	phy-handle = <&ext_rgmii1_phy>;
+	tx-internal-delay-ps = <1200>;
+	rx-internal-delay-ps = <1000>;
+	status = "okay";
+};
+
+&mdio0 {
+	ext_rgmii1_phy: ethernet-phy@1 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <1>;
+		reset-gpios = <&pio 7 16 GPIO_ACTIVE_LOW>; /* PH16, from the A7A U-Boot dts */
+		reset-assert-us = <10000>;
+		reset-deassert-us = <150000>;
+	};
+};
