# Kernel config fragment for the AI-CAM's base OS (mainline 7.3.3, arch default config). Every line says
# why it is here (standing rule). Written from Gaia's board fragment (work tree, 2026-11-08); untested.

# Mainline's riscv defconfig cut down for the K230D's 128 MB: U-Boot loads the kernel at 2 MiB and the
# dtb at 34 MiB, so Image must stay under 32 MiB. Reason: the boot chain's load addresses.
# CONFIG_ARCH_ANDES is not set
# CONFIG_ARCH_ANLOGIC is not set
# CONFIG_ARCH_ESWIN is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SIFIVE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_SPACEMIT is not set
# CONFIG_SOC_STARFIVE is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_TENSTORRENT is not set
# CONFIG_ARCH_THEAD is not set
# CONFIG_ARCH_ULTRARISC is not set
# CONFIG_ARCH_VIRT is not set
# CONFIG_DRM is not set
# CONFIG_KVM is not set
# CONFIG_MODULES is not set
CONFIG_ARCH_CANAAN=y
CONFIG_COMMON_CLK_K230=y
CONFIG_RESET_K230=y
CONFIG_PINCTRL_K230=y
CONFIG_PHY_CANAAN_USB=y
# SD card (the boot and root partitions) and the USB-C port in device mode.
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_EXT4_FS=y
CONFIG_EROFS_FS=y
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_USB_GADGET=y
# The CMA area at 16 MiB, as on the Zero (its reason is there): the 128 MB board.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_SEL_MBYTES=y
CONFIG_CMA_SIZE_MBYTES=16

# Not carried from dev's AI-CAM fragment: CONFIG_USB_ETH and CONFIG_USB_ETH_RNDIS (dev's g_ether gadget;
# `next` gadgets are NCM, decision 5), and the DMABUF heaps (VGLite and Styx's ISP are not on `next`).
