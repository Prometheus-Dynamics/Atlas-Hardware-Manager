# Raze kernel install-size trim, applied after raze.config. Every line is "not set" and says why in
# its section. Reason for the whole file: the image's install size is a standing requirement (every
# slot carries the kernel and its modules), and each section below turns off what no Lemnos driver or
# Raze function uses. Dev measured the sizes on its board (Image 17.92 -> 14.89 MB). OPEN: the sections
# are dev's and were not re-checked line by line against every Lemnos driver on next.

# Install size (every boot partition and every slot carries the kernel,
#    and every slot's root carries its modules). Kept: what PhotonVision,
#    HeliOS and the Raze roadmap use (USB cameras through UVC, the USB
#    Ethernet adapters below, usb-storage, the gadget stack, I2C/SPI/GPIO/
#    PIO/PWM, hwmon, thermal, the watchdog, pstore, zram, IPv6, the bridge,
#    VLANs and nftables), vc4 and v3d (the GPU and the KMS overlay).
#    Measured on the board's own config (photon-image-modifier 783778d):
#    Image 17.92 -> 14.89 MB, kernel8.img (gzip) 8.04 -> 6.65 MB, modules
#    323 files / 15.8 MB -> 249 / 12.3 MB (-O2; -Os would have made
#    kernel8.img 5.60 MB, but that kernel didn't boot). NET_SCHED stays: a
#    Buildroot package turns it on.

# Kernel debugging and tracing a camera never uses (oopses still name
# functions: KALLSYMS stays).
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_KPROBES is not set
# The selectors of the two lines above (PR B25: each line did not take until its selector was off; checked with
# merge_config against the pinned Raze tree, 53679a5). Nothing here needs any of them.
# KGDB: the kernel debugger over a serial console. The Raze has no wired console (pstore is its log), and no product
#   runs kgdb. Its default KGDB_HONOUR_BLOCKLIST selects KPROBES; KGDB_KDB goes with it.
# CONFIG_KGDB is not set
# The latency tracer, a debug aid. It selects KALLSYMS_ALL.
# CONFIG_LATENCYTOP is not set
# OCFS2: a shared-disk cluster filesystem no Raze product mounts (slots are EROFS, data is ext4). It selects QUOTA,
#   which the trim turns off below.
# CONFIG_OCFS2_FS is not set
# CONFIG_SLUB_DEBUG is not set
# Security modules and auditing: systemd needs neither; AppArmor selects
# AUDIT.
# CONFIG_SECURITY_APPARMOR is not set
CONFIG_DEFAULT_SECURITY_DAC=y
# CONFIG_AUDIT is not set
# 32-bit programs and CPU features the Cortex-A76 doesn't have.
# CONFIG_COMPAT is not set
# CONFIG_ARM64_SVE is not set
# Android, NVMe (no M.2 on the carrier), the legacy RAM disk (the slot
# initramfs is a cpio), and io_uring (nothing here uses it).
# CONFIG_ANDROID_BINDER_IPC is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_IO_URING is not set
# Consoles: the serial console and the USB gadget's (ttyGS0); no virtual
# terminals on HDMI, and no 8250 UARTs (the CM5's are PL011).
# CONFIG_VT is not set
# CONFIG_SERIAL_8250 is not set
# Input: no HID (keyboards, mice, gamepads) on a robot camera.
# CONFIG_HID_SUPPORT is not set
# CONFIG_INPUT_JOYSTICK is not set
# Networking a camera doesn't do: Multipath TCP, containers' veth and macvlan.
# CONFIG_MPTCP is not set
# CONFIG_VETH is not set
# CONFIG_MACVLAN is not set
# CAN: no transceiver on gen1.
# CONFIG_CAN is not set
# USB serial adapters.
# CONFIG_USB_SERIAL is not set
# USB Ethernet: cdc_ether, cdc_ncm, r8152, ax88179_178a and asix stay.
# LAN78xx and SMSC95xx are the Pi 3/4 boards' own chips, built in.
# CONFIG_USB_LAN78XX is not set
# CONFIG_USB_NET_SMSC95XX is not set
# CONFIG_USB_NET_SMSC75XX is not set
# CONFIG_USB_CATC is not set
# CONFIG_USB_KAWETH is not set
# CONFIG_USB_PEGASUS is not set
# CONFIG_USB_RTL8150 is not set
# CONFIG_USB_NET_CDC_EEM is not set
# CONFIG_USB_NET_HUAWEI_CDC_NCM is not set
# CONFIG_USB_NET_CDC_MBIM is not set
# CONFIG_USB_NET_DM9601 is not set
# CONFIG_USB_NET_SR9700 is not set
# CONFIG_USB_NET_SR9800 is not set
# CONFIG_USB_NET_GL620A is not set
# CONFIG_USB_NET_NET1080 is not set
# CONFIG_USB_NET_PLUSB is not set
# CONFIG_USB_NET_MCS7830 is not set
# CONFIG_USB_NET_RNDIS_HOST is not set
# CONFIG_USB_NET_CDC_SUBSET is not set
# CONFIG_USB_NET_ZAURUS is not set
# CONFIG_USB_NET_CX82310_ETH is not set
# CONFIG_USB_NET_QMI_WWAN is not set
# CONFIG_USB_NET_INT51X1 is not set
# CONFIG_USB_IPHETH is not set
# CONFIG_USB_NET_AQC111 is not set
# Sound: the cores stay (DRM_VC4 depends on SND and SND_SOC); no USB audio
# or generic sound drivers.
# CONFIG_SND_USB is not set
# CONFIG_SND_DRIVERS is not set
# CONFIG_SND_SPI is not set
# Displays other than HDMI through vc4.
# CONFIG_DRM_RP1_DSI is not set
# Filesystems: ext4, vfat, erofs, tmpfs, squashfs and configfs stay (configfs: the gadget). overlayfs
# is off in raze.config (Lemnos refuses layered slots).
# CONFIG_EXFAT_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_QUOTA is not set
# CONFIG_FS_ENCRYPTION is not set
# Swap goes to zram; no zswap.
# CONFIG_ZSWAP is not set
# Not built for size: the -Os kernel (kernel8.img 5.60 MB) didn't boot on
# the board (r57: dead before pstore and the console came up).
# PR B25: not listed, because each is absent from this tree once its parent is off: ARM64_SME (ARM64_SVE is off),
# JOYSTICK_XPAD (no HID input), NVME_CORE (no NVMe block device).

# -- PR B29: the floor (dev's trimmed set) and what the Raze needs above it ----------------------------------
# Method: the resolved next config (cross toolchain, bcm2712_defconfig + the family fragment + raze.config +
# this file) against dev's trimmed .config (the size floor). Every option that is =y or =m on next and that
# dev does not have is turned off, unless the slot contract, lemnos.ko, a driver Lemnos owns on this board,
# the gadget, pstore or a deliberate line (B14, B16, raze.config) needs it. Lines are emitted only for symbols
# that are on in the resolved next config, and a line whose symbol came out absent (its parent is off) or is
# selected by something kept is dropped, so each line below takes (scripts/check-kernel-fragments.sh).
# Kept on above the floor, with the reason in the file that sets it: BLK_DEV_DM, DM_BUFIO, DM_VERITY (the slot
# chain, =y: the contract refuses =m); I2C_CHARDEV, I2C_DESIGNWARE_*, RP1_PIO, FIRMWARE_RP1, MBOX_RP1 (the stock
# routes of the flasher, which has no modules, and the RP1 PIO chain Lemnos's transports need); USB_CONFIGFS,
# USB_LIBCOMPOSITE, USB_F_FS, USB_F_NCM, USB_F_ACM, USB_U_ETHER, USB_U_SERIAL (the gadget: NCM, ACM, FunctionFS);
# HW_RANDOM_BCM2835 (the SoC's RNG, early entropy); BRIDGE_VLAN_FILTERING (B16: bridge and VLANs kept).
# Sound is NOT turned off: DRM_VC4 (the GPU that HeliOS needs) depends on SND and SND_SOC, and dev keeps sound.
# Dev-only options, each decided (dev has it, next did not): ECM, RNDIS, configfs serial (no ECM or RNDIS
# anywhere: the link is NCM); OVERLAY_FS (Lemnos refuses layered slots); NETPOLL and NETCONSOLE (no netconsole);
# EFIVAR_FS and DMI_SYSFS (the Raze boots by the Pi firmware, not EFI); SQUASHFS* (no product mounts a squashfs).
# The rest of dev's set the Raze does not use by the same rule is listed in docs/prs/B29.md.
# -- legacy VideoCore camera, codec and decoder stack (Lemnos owns the Raze camera; the Raze has no decoder)
# CONFIG_VIDEO_BCM2835 is not set
# CONFIG_VIDEO_BCM2835_UNICAM is not set
# CONFIG_VIDEO_BCM2835_UNICAM_LEGACY is not set
# CONFIG_VIDEO_CODEC_BCM2835 is not set
# CONFIG_VIDEO_ISP_BCM2835 is not set
# CONFIG_VIDEO_RPI_HEVC_DEC is not set
# CONFIG_BCM2835_VCHIQ_MMAL is not set
# CONFIG_BCM_VC_SM_CMA is not set
# CONFIG_VIDEO_RP1_CFE_DOWNSTREAM is not set
# CONFIG_VIDEO_MUX is not set
# -- Cirrus codec multi-function device (no such part on the board)
# CONFIG_MFD_ARIZONA_I2C is not set
# CONFIG_MFD_ARIZONA_SPI is not set
# -- I2C controllers and muxes other than the RP1 DesignWare pair (the Raze's buses are i2c1 and i2c10 on RP1)
# CONFIG_I2C_BCM2835 is not set
# CONFIG_I2C_BRCMSTB is not set
# CONFIG_I2C_GPIO is not set
# CONFIG_I2C_MUX is not set
# -- SPI controllers (the SoC map has no SPI controller for the Raze; the SPI core stays for lemnos.ko)
# CONFIG_SPI_BCM2835 is not set
# CONFIG_SPI_DESIGNWARE is not set
# CONFIG_SPI_SPIDEV is not set
# -- Ethernet PHYs and MDIO (the Raze's wired networks are USB adapters)
# CONFIG_REALTEK_PHY is not set
# CONFIG_PCS_XPCS is not set
# CONFIG_MDIO_BITBANG is not set
# -- sensors and IIO on the firmware and ADC paths the Raze does not use (Lemnos's own drivers serve its sensors)
# CONFIG_SENSORS_RASPBERRYPI_HWMON is not set
# CONFIG_SENSORS_RP1_ADC is not set
# CONFIG_SENSORS_SHT3x is not set
# CONFIG_SENSORS_SHT4x is not set
# CONFIG_IIO is not set
# -- input, Type-C, CEC, backlight, LED classes and the GPIO-memory device (no such device on the board; Lemnos drives the LED ring)
# CONFIG_INPUT_FF_MEMLESS is not set
# CONFIG_INPUT_GPIO_ROTARY_ENCODER is not set
# CONFIG_INPUT_JOYDEV is not set
# CONFIG_INPUT_UINPUT is not set
# CONFIG_KEYBOARD_GPIO is not set
# CONFIG_SERIO is not set
# CONFIG_SERIAL_RP1_PIO_UART is not set
# CONFIG_TYPEC is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_RASPBERRYPI_GPIOMEM is not set
# CONFIG_LEDS_CLASS_MULTICOLOR is not set
# CONFIG_NVMEM_RMEM is not set
# CONFIG_GPIO_WATCHDOG is not set
# CONFIG_PWM_PCA9685 is not set
# -- tunnels, virtual networks and diagnostics the Raze does not run (B16: its networking is bridge, VLAN and nftables)
# CONFIG_WIREGUARD is not set
# CONFIG_VXLAN is not set
# CONFIG_TUN is not set
# CONFIG_IPVLAN is not set
# CONFIG_DUMMY is not set
# CONFIG_TCP_CONG_BBR is not set
# CONFIG_INET_DIAG is not set
# CONFIG_BRIDGE_NETFILTER is not set
# -- USB gadget functions the link does not use: ECM and RNDIS are not used anywhere (the link is NCM); generic serial and WWAN are not Raze functions
# CONFIG_USB_SIERRA_NET is not set
# CONFIG_USB_WDM is not set
# -- crypto ciphers, modes and user API nobody on the board calls (slots are verity over SHA-256, built in; dm-crypt and dm-integrity are not used)
