# Raze kernel fragment (applied after the bcm2712 defconfig). Each group says why it is here.
# Dropped from dev's file, with no reason on next: the HEVC decoder and the media filter (no
# Lemnos driver uses them), joystick and gamepad drivers (no HID on a robot camera), netconsole
# (dev's bench capture; not carried), OVERLAY_FS (nothing on next uses it).

# 4 KiB pages: the page size dev measured on a Raze (HeliOS, KernelPageSize 4 kB), and the one
# Buildroot's config forces anyway.
CONFIG_ARM64_4K_PAGES=y

# EROFS, built in: a root slot is an EROFS image (the slot recipe), mounted read-only with dm-verity.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_ZSTD=y

# Pstore and ramoops: the crash log the board keeps across a reset (ramoops-pi5 in raze-device.txt),
# for the support bundle. PSTORE_PMSG keeps the userspace messages too.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# Timestamps in the console log that pstore keeps.
CONFIG_PRINTK_TIME=y

# Lockups must reset, not hang: a hung trial boot has to fall back. Soft and hard lockup detectors
# panic (the hardware watchdog then resets the board).
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y

# FunctionFS and its configfs hook: Orion's link is a FunctionFS function (one interface, two bulk
# endpoints) in the board's one gadget configuration built by Lemnos's usb-gadget driver.
CONFIG_USB_F_FS=m
CONFIG_USB_CONFIGFS_F_FS=y

# The camera receiver and ISP are Lemnos's (rp1-csi2 and pisp drivers, owned through lemnos.ko): the
# stock rp1-cfe and pispbe modules would claim the same devices, so they are off.
# CONFIG_VIDEO_RP1_CFE is not set
# CONFIG_VIDEO_RASPBERRYPI_PISP_BE is not set
