# Raze kernel fragment, applied after the bcm2712 defconfig (and before raze-trim.config). Each group
# says why it is here. The defconfig states are from arch/arm64/configs/bcm2712_defconfig at 53679a5.

# -- Page size ----------------------------------------------------------------------------------
# 4 KiB pages: the size dev measured on a Raze (HeliOS: KernelPageSize 4 kB). Buildroot forces it too.
CONFIG_ARM64_4K_PAGES=y
# The release suffix states what the kernel is, not a page size it does not have (PR B25). bcm2712_defconfig sets
# CONFIG_LOCALVERSION="-v8-16k", a label from a 16 KiB-page build; this kernel is 4 KiB pages (above), so the suffix
# is "-v8". LOCALVERSION_AUTO off keeps the release exactly this string (no git or scm suffix is added).
CONFIG_LOCALVERSION="-v8"
# CONFIG_LOCALVERSION_AUTO is not set

# -- The slot root and its verity ----------------------------------------------------------------
# EROFS, built in: a root slot is an EROFS image (the slot recipe), read-only, with dm-verity.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
# Loop devices, built in: the slot initramfs opens the slot image through a loop device.
CONFIG_BLK_DEV_LOOP=y
# Device-mapper core, its buffer layer and dm-verity are BUILT IN (=y, set in families/bcm2712/assets/linux.fragment,
# PR B16), not modules here. Reason: a slot's root is opened by lemnos-slot-init before any root filesystem with
# /lib/modules exists; Lemnos docs/slots.md (at 4a2d3b7d) loads these only from /lib/modules/<release> in the slot's
# initramfs, and Gaia's initramfs has no modules (no recipe puts them in, and the product has no initramfs input).
# So a module would never load. The old lines (dev's initramfs.toml: dm-mod, dm-bufio, dm-verity as modules) are gone.

# -- Crash log --------------------------------------------------------------------------------------
# pstore and ramoops: the crash log the board keeps across a reset (ramoops-pi5, raze-device.txt),
# read by the support bundle. PSTORE_PMSG keeps the userspace messages too.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# Timestamps in the console log that pstore keeps.
CONFIG_PRINTK_TIME=y

# -- Hangs reset the board -----------------------------------------------------------------------
# Lockup detectors panic, so a hang becomes a reset: the hardware watchdog (below) then restarts the
# board, and a hung trial boot falls back.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
# The BCM2835 hardware watchdog, built in: lemnosd feeds it (15 s by default, from the board file).
CONFIG_BCM2835_WDT=y

# -- Buses and pins Lemnos drives through its own drivers -----------------------------------------
# I2C character devices (/dev/i2c-N, the DesignWare platform driver for RP1) and RP1 PIO: built in
# by families/bcm2712/assets/linux.fragment (PR B14: the flasher has no modules).
# RP1 pinctrl/GPIO: the GPIO lines the port power switches and the fan's pin use.
CONFIG_PINCTRL_RP1=y
# RP1 hardware PWM (channel 3 of PWM1 is the fan): Lemnos's PWM driver writes it.
CONFIG_PWM_RP1=y
# RP1 PIO block: Lemnos's PIO transports (the PIO I2C bus, and the LED ring's transport once Q1 lands).
# Built in by the family fragment, not here (PR B14).

# -- USB gadget (Lemnos's one configuration) -----------------------------------------------------
# FunctionFS: Orion's link is a FunctionFS function (one interface, two bulk endpoints). Built in by the
# family fragment (CONFIG_USB_CONFIGFS_F_FS selects USB_F_FS; PR B14).
# NCM: the board's network function (replaces ECM and RNDIS on next).
CONFIG_USB_CONFIGFS_NCM=y
# ACM: the one serial console (a getty on ttyGS0).
CONFIG_USB_CONFIGFS_ACM=y

# -- Cameras: the sensor, receiver and ISP are Lemnos's, not the kernel's ------------------------
# The OV9782 kernel sensor driver: Lemnos's ov9782 driver serves the sensor.
# CONFIG_VIDEO_OV9282 is not set
# The stock CSI receiver and ISP modules: Lemnos's rp1-csi2 and pisp drivers own those devices.
# CONFIG_VIDEO_RP1_CFE is not set
# CONFIG_VIDEO_RASPBERRYPI_PISP_BE is not set
# The V4L2 and media core stays: Lemnos's v4l2 backend opens /dev/videoN and /dev/mediaN.
CONFIG_MEDIA_SUPPORT=m

# -- Off: taken over by Lemnos, or no board use on next ------------------------------------------
# The LED ring's kernel driver: Lemnos's PIO transport replaces it (Q1, pending). The ring is dark
# until then; the driver is not built.
# CONFIG_WS2812_PIO_RP1 is not set
# Kernel fan control: the fan is Lemnos's own PWM driver's (fan/1). With pwm-fan off, no kernel
# cooling device is tied to the fan.
# CONFIG_SENSORS_PWM_FAN is not set
# The PIO-based PWM: the fan is on the hardware PWM (PWM_RP1), so nothing uses this one.
# CONFIG_PWM_PIO_RP1 is not set
# The generic gadget serial function and the ECM/RNDIS networks: dev's gadget, replaced by NCM and
# ACM above.
# CONFIG_USB_CONFIGFS_SERIAL is not set
# CONFIG_USB_CONFIGFS_ECM is not set
# CONFIG_USB_CONFIGFS_ECM_SUBSET is not set
# CONFIG_USB_CONFIGFS_RNDIS is not set
# Netconsole (the kernel log over UDP): a bench capture dev used; nothing on next needs it.
# CONFIG_NETCONSOLE is not set
# Layered slots: Lemnos refuses layered manifests, so nothing mounts an overlay on the slot.
# CONFIG_OVERLAY_FS is not set

# PR B25: CONFIG_CPU_BIG_ENDIAN is not a symbol of this arm64 configuration (absent is unset), so no line is
# listed: the Lemnos requirement (unset) holds.
# -- For lemnos.ko (Lemnos docs/kernel-module.md, "For an image builder"): the symbols the module links ----
# Required by the module: each names what it links against. The defconfig selects most of them;
# they are set here so the requirement shows in this file. Checked against the kernel's Kconfig at 53679a5.
CONFIG_OF=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_COMMON_CLK=y
CONFIG_GPIOLIB=y
CONFIG_THERMAL=y
CONFIG_RESET_CONTROLLER=y
# Must be off: the module's BUILD_BUG_ON (lemnos_stream.c) refuses a big-endian kernel.
# The RP1 PIO driver the module's PIO part (lemnos_pio.c) links against: built in by the family
# fragment (PR B14), not m.

# -- For the slot initramfs (Lemnos docs/slots.md; dev's initramfs.toml) -------------------------------
# dm-verity needs the sha256 crypto algorithm for the root hash (the slot's verity table names sha256).
CONFIG_CRYPTO_SHA256=y
# The slot initramfs is a zstd-compressed cpio (cpio-zstd, dev's initramfs.toml): the kernel must decompress
# zstd to unpack it. Not checked at build: whether this kernel reads the zstd initramfs through DECOMPRESS_ZSTD.
CONFIG_DECOMPRESS_ZSTD=y

# -- For the gadget (Lemnos builds one configuration through configfs) ---------------------------------
# configfs: the gadget's tree lives under /sys/kernel/config (Lemnos's gadget step, service/lemnosd/src/gadget.rs).
CONFIG_CONFIGFS_FS=y
