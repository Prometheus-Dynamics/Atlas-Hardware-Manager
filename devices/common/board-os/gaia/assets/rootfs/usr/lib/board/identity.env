# Defaults for board-identity.service. Override any of these in
# /etc/board/identity.env.

# Advertise _pd-device._tcp over mDNS (resolved, or avahi with avahi.toml;
# identity --dnssd writes the service files at boot). 0 turns it off.
BOARD_MDNS=1

# Actions offered over the identity endpoint, space separated. Today:
#   locate   blink the LED ring so someone can find the board (board-leds)
# A request only touches /run/board/requests/<action>; a fixed root unit
# (board-<action>.path/.service) does the work, so the unauthenticated
# endpoint itself stays unprivileged. Empty offers none.
BOARD_ACTIONS=locate

# Actions offered only to the computer on the board's USB link (a request
# from the gadget network, BOARD_GADGET_CIDR), and listed in the identity only
# for it, while the security switch is off (security.env). They work when SSH
# has no key, Orion isn't up and the console is busy. Today:
#   reboot    restart (board-reboot.path/.service)
#   usb-boot  restart into USB boot to be flashed (board-usb-boot.*)
BOARD_USB_ACTIONS="reboot usb-boot"
