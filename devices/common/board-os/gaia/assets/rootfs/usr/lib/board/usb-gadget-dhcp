#!/bin/sh
# DHCP server for the USB gadget link (board-usb-gadget-dhcp.service).
#
# With systemd-networkd (USB_GADGET_DHCP_SERVER=AUTO when it is enabled, or
# networkd) its DHCPServer serves the bridge: this writes the bridge's
# .network (address, pool, lease time, usb-route's routes as options 121 and
# 249) to /run/systemd/network and reloads networkd when it changed, then
# exits. No process of its own: dnsmasq is ~1.9 MB of RAM, networkd runs anyway.
# Otherwise dnsmasq runs in the foreground with the configuration
# board-usb-gadget generated: DHCP on the gadget bridge only, DNS disabled.
# Extra dnsmasq settings: /etc/board/usb-gadget-dnsmasq.d/*.conf
#
#   usb-gadget-dhcp            serve (networkd: write the .network and exit)
#   usb-gadget-dhcp --refresh  the routes changed (usb-route): rewrite the
#                              .network, or have dnsmasq reread its options
set -eu

BOARD_LIB_DIR=${BOARD_LIB_DIR:-/usr/lib/board}
# shellcheck source=lib.sh
. "$BOARD_LIB_DIR/lib.sh"

board_load_env usb-gadget.env

NETWORKD_DIR=${BOARD_NETWORKD_DIR:-/run/systemd/network}
# Before 05-board-usb-gadget-bridge.network, which leaves the bridge unmanaged.
NETWORK=$NETWORKD_DIR/04-board-usb-gadget-bridge.network
OPTS=$BOARD_RUN_DIR/usb-gadget-dhcp-routes
BRIDGE=${USB_GADGET_BRIDGE:-usbbr0}

dhcp_on() {
	[ "${USB_GADGET_ENABLED:-1}" = 1 ] && [ "${USB_GADGET_NET:-bridge}" = bridge ] && [ "${USB_GADGET_DHCP:-1}" = 1 ]
}

server() {
	case "${USB_GADGET_DHCP_SERVER:-AUTO}" in
	networkd | dnsmasq) echo "$USB_GADGET_DHCP_SERVER" ;;
	*) if systemctl -q is-enabled systemd-networkd.service 2>/dev/null; then echo networkd; else echo dnsmasq; fi ;;
	esac
}

# Option 121 (and 249) bytes for "net/prefix,via,net/prefix,via,...", as
# networkd's C escapes: per route the prefix length, the network's
# significant octets, then the router.
routes_escaped() {
	_out=''
	_rest=$1
	while [ -n "$_rest" ]; do
		_net=${_rest%%,*}
		_rest=${_rest#*,}
		_via=${_rest%%,*}
		case "$_rest" in *,*) _rest=${_rest#*,} ;; *) _rest='' ;; esac
		_pre=${_net#*/}
		_n=$(board_ip4_int "${_net%/*}") || return 1
		_v=$(board_ip4_int "$_via") || return 1
		_out="$_out$(printf '\\x%02x' "$_pre")"
		_i=0
		while [ $((_i * 8)) -lt "$_pre" ]; do
			_out="$_out$(printf '\\x%02x' $(((_n >> (24 - _i * 8)) & 255)))"
			_i=$((_i + 1))
		done
		for _s in 24 16 8 0; do
			_out="$_out$(printf '\\x%02x' $(((_v >> _s) & 255)))"
		done
	done
	printf '%s\n' "$_out"
}

# Lease seconds from a dnsmasq lease time (2m, 1h, 120, infinite).
lease_sec() {
	case "$1" in
	*[!0-9smhd]* | '') echo 3600 ;;
	*s) echo "${1%s}" ;;
	*m) echo $((${1%m} * 60)) ;;
	*h) echo $((${1%h} * 3600)) ;;
	*d) echo $((${1%d} * 86400)) ;;
	*) echo "$1" ;;
	esac
}

# Tell a running networkd the .network changed. Only a running one, and
# without waiting: at boot networkd's start is queued behind network-pre,
# which waits for the gadget (this script), so a blocking reload queued
# behind that start deadlocked the boot (Raze #1, no D-Bus image). A
# networkd that hasn't started reads the file when it does.
# systemctl, not networkctl: no D-Bus needed (networkd is notify-reload).
networkd_reload() {
	systemctl -q is-active systemd-networkd.service 2>/dev/null &&
		systemctl --no-block reload systemd-networkd.service 2>/dev/null || true
}
write_network() {
	board_gadget_address
	_cidr=$BOARD_GADGET_CIDR
	_pre=${_cidr#*/}
	_a=$(board_ip4_int "${_cidr%/*}")
	_size=$((1 << (32 - _pre)))
	_base=$((_a - _a % _size))
	_range=${USB_GADGET_DHCP_RANGE:-AUTO}
	[ "$_range" != AUTO ] || _range=$(board_gadget_dhcp_range "$_cidr") || _range=''
	# start,end[,mask][,lease]: dnsmasq's form, which the env documents.
	_pool=''
	_lease=120
	_start=$(board_ip4_int "${_range%%,*}" 2>/dev/null) && {
		_end=$(printf '%s' "$_range" | cut -d, -f2)
		_end=$(board_ip4_int "$_end" 2>/dev/null) || _end=$_start
		_pool="PoolOffset=$((_start - _base))
PoolSize=$((_end - _start + 1))"
		case "$_range" in *,*,*) _lease=$(lease_sec "${_range##*,}") ;; esac
	}
	_routes=$(sed -n 's/^option:classless-static-route,//p' "$OPTS" 2>/dev/null | head -n 1)
	_send=''
	if [ -n "$_routes" ]; then
		_bytes=$(routes_escaped "$_routes") || _bytes=''
		[ -z "$_bytes" ] || _send="SendOption=121:string:$_bytes
SendOption=249:string:$_bytes"
	fi
	mkdir -p "$NETWORKD_DIR"
	cat >"$NETWORK.tmp" <<EOF
# Generated by usb-gadget-dhcp (board-usb-gadget.service, usb-route): the USB
# gadget bridge and its DHCP server. Settings: /etc/board/usb-gadget.env.
[Match]
Name=$BRIDGE

[Link]
RequiredForOnline=no

[Network]
Address=$_cidr
ConfigureWithoutCarrier=yes
# IPv6 link-local as before networkd managed it (mDNS over IPv6), no RAs.
LinkLocalAddressing=ipv6
IPv6AcceptRA=no
LLMNR=no
# resolved answers mDNS here (with avahi.toml its global switch keeps it off).
MulticastDNS=yes
KeepConfiguration=static
DHCPServer=yes

[DHCPServer]
${_pool:+$_pool
}DefaultLeaseTimeSec=$_lease
MaxLeaseTimeSec=$_lease
# No default route for the host: only routes to the board's own networks
# (usb-route), so the host keeps its internet. No DNS either.
EmitRouter=no
EmitDNS=no
EmitNTP=no
EmitSIP=no
EmitTimezone=no
PersistLeases=runtime
EOF
	[ -z "$_send" ] || printf '%s\n' "$_send" >>"$NETWORK.tmp"
	if cmp -s "$NETWORK.tmp" "$NETWORK" 2>/dev/null; then
		rm -f "$NETWORK.tmp"
		return 0
	fi
	mv -f "$NETWORK.tmp" "$NETWORK"
	networkd_reload
}

if ! dhcp_on; then
	rm -f "$NETWORK"
	[ "${1:-}" = --refresh ] || board_log "USB gadget DHCP is off"
	exit 0
fi

if [ "$(server)" = networkd ]; then
	write_network
	exit 0
fi
if [ -e "$NETWORK" ]; then
	# networkd managed the bridge: handing it back takes the bridge's address
	# with it (seen on a Raze), so put the address back for dnsmasq.
	rm -f "$NETWORK"
	networkd_reload
	board_gadget_address
	ip addr replace "$BOARD_GADGET_CIDR" dev "$BRIDGE" 2>/dev/null ||
		board_log "couldn't put $BOARD_GADGET_CIDR back on $BRIDGE"
fi

if [ "${1:-}" = --refresh ]; then
	# dnsmasq rereads its options file on SIGHUP.
	systemctl kill -s HUP board-usb-gadget-dhcp.service 2>/dev/null || true
	exit 0
fi

conf="$BOARD_RUN_DIR/usb-gadget-dnsmasq.conf"
if [ ! -r "$conf" ]; then
	board_log "$conf is missing; board-usb-gadget.service has not set up the link"
	exit 1
fi

if ! command -v dnsmasq >/dev/null 2>&1; then
	board_log "dnsmasq is not installed; the host must configure the USB link itself"
	exit 0
fi

# Leases live in /run: the root may be read-only, and a USB link's leases
# don't need to outlive a boot.
leases="$BOARD_RUN_DIR/usb-gadget-dnsmasq.leases"
extra="$BOARD_ETC_DIR/usb-gadget-dnsmasq.d"
if [ -d "$extra" ]; then
	exec dnsmasq --keep-in-foreground --pid-file= --dhcp-leasefile="$leases" \
		--conf-file="$conf" --conf-dir="$extra,*.conf"
fi
exec dnsmasq --keep-in-foreground --pid-file= --dhcp-leasefile="$leases" --conf-file="$conf"
