[Unit]
Description=Board machine id (stable across boots on a read-only root)
Documentation=file:/usr/lib/board/machine-id
DefaultDependencies=no
# After /data is mounted (a kept id), before the journal goes to disk and
# before anything that derives addresses from the id (networkd).
After=local-fs.target systemd-journald.service
Before=systemd-journal-flush.service network-pre.target sysinit.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/board/machine-id

[Install]
WantedBy=sysinit.target
