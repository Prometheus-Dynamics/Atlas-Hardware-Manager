[Unit]
Description=Fail a slot whose boot hasn't confirmed by the confirm deadline
Documentation=file:/usr/lib/board/slots
DefaultDependencies=no
After=local-fs.target
RequiresMountsFor=/data
ConditionPathExists=/data/board/slots/state.json

[Service]
# Waits UPDATE_CONFIRM_DEADLINE seconds after boot (update.env), then records
# a failure for the running slot if this boot hasn't confirmed. It exits when
# it has judged; a failed judging (the lock held too long) is tried again.
Type=exec
ExecStart=/usr/lib/board/slots deadline
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=sysinit.target
