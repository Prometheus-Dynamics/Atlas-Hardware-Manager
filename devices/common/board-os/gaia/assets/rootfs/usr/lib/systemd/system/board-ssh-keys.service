[Unit]
Description=Install SSH public keys left on the boot partition (opt-in access)
Documentation=file:/usr/lib/board/ssh-keys
DefaultDependencies=no
After=local-fs.target
Before=sshd.service ssh.service multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/board/ssh-keys

[Install]
WantedBy=multi-user.target
