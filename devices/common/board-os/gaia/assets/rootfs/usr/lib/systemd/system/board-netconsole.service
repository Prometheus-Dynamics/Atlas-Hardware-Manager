[Unit]
Description=Kernel log over the network (netconsole), when netconsole.env sets a target
Documentation=file:/usr/lib/board/netconsole.env
After=network-online.target board-usb-gadget.service
Wants=network-online.target
# Restarts for as long as it fails (no start limit): the board has no one
# to restart it by hand.
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/board/netconsole
# The interface may come up a little later (the gadget waits for a host).
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
