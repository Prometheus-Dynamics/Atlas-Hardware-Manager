[Unit]
Description=Keep the board's failed units for the identity endpoint (/run/board/failed.json)
Documentation=file:/usr/lib/board/status
# hardware.json is board-agent's (one lemnosd connection, written on change).
# Started by every failing service: a burst of them (at boot) must not hit
# systemd's start limit (5 in 10 s) and leave the failed units unkept.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Root: the identity endpoint's sandboxed user can't ask systemd itself, so
# GET /status reads the kept result while it is fresh (120 s). Started at
# once by any service failing (service.d/50-board-failed.conf) and by
# board-health.timer for units that recovered.
ExecStart=/usr/lib/board/status --refresh-failed --quiet
Nice=10
