[Unit]
Description=Keep an A/B update once its trial boot is healthy
Documentation=file:/usr/lib/board/update
After=multi-user.target
ConditionPathExists=/usr/lib/board/update

[Service]
# Started, not waited for: judging a trial holds the writer's lock (which
# anything else on the slots waits for), not "Startup finished".
Type=exec
ExecStart=/usr/lib/board/update confirm

[Install]
WantedBy=multi-user.target
