# The build image for Atlas's Linux .deb (scripts/deb-fast.sh): the distro
# the package installs on (BASE: debian:trixie, or ubuntu:22.04), its
# WebKitGTK and GTK development packages, the Rust toolchain
# rust-toolchain.toml pins and bun for the UI. Built once; the cargo
# registry and the build output live outside it (deb-fast.sh mounts them).
ARG BASE=debian:trixie
FROM ${BASE}
ARG RUST=1.99.0
ARG BUN=bun-v1.4.2
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends ca-certificates curl unzip git \
      build-essential pkg-config file xz-utils \
      libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libssl-dev \
 && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:/opt/bun/bin:$PATH
# The official installers (rustup, bun), pinned versions.
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal \
      --default-toolchain ${RUST} --component rustfmt,clippy \
 && rustup target add x86_64-unknown-linux-gnu
RUN curl -fsSL https://bun.sh/install | BUN_INSTALL=/opt/bun bash -s "${BUN}"
