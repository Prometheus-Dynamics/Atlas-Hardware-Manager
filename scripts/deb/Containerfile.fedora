# The build image for Atlas's Linux .rpm (scripts/deb-fast.sh with
# DEB_BASE=fedora:<n>): the Fedora the package installs on, its WebKitGTK and
# GTK development packages, rpm-build, the Rust toolchain rust-toolchain.toml
# pins and bun for the UI. Built once; the cargo registry and the build
# output live outside it (deb-fast.sh mounts them).
ARG BASE=fedora:44
FROM ${BASE}
ARG RUST=1.99.0
ARG BUN=bun-v1.4.2
RUN dnf install -y -q --setopt=install_weak_deps=False ca-certificates curl unzip git \
      gcc gcc-c++ make pkgconf-pkg-config file xz rpm-build \
      webkit2gtk4.1-devel gtk3-devel libappindicator-gtk3-devel librsvg2-devel openssl-devel \
 && dnf clean all
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:/opt/bun/bin:$PATH
# The official installers (rustup, bun), pinned versions.
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal \
      --default-toolchain ${RUST} --component rustfmt,clippy \
 && rustup target add x86_64-unknown-linux-gnu
RUN curl -fsSL https://bun.sh/install | BUN_INSTALL=/opt/bun bash -s "${BUN}"
