# Copy to a scratch dir (never commit the filled copy): board serial, link and paths.
CTL=<lemnos-ctl at the pinned Lemnos rev>
SOCS=<lemnos checkout>/socs
BOARD_A1=<the A1 bench board file the image was built with>
PAYLOAD=<out>/raze-base.payload
FIRMWARE=<out>/firmware
DATA=<out>/raze-base.data
SLOT=<slot id>
SERIAL=<board serial>
R2=<this dir>/r2
R2_HOST=root@<993 link-local address>%usb0
R2_KNOWN_HOSTS=<scratch>/board.known_hosts
state=<scratch>/run
TMPDIR=<scratch>/tmp
