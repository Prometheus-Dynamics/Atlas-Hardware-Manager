{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas Hardware Manager",
  "version": "2026.0.0",
  "identifier": "ca.prometheusdynamics.atlas-hardware-manager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Atlas Hardware Manager",
        "width": 1280,
        "height": 840,
        "minWidth": 1100,
        "minHeight": 720,
        "decorations": true,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Sozo Systems",
    "shortDescription": "Instrument-grade Atlas hardware configuration tool",
    "longDescription": "Atlas Hardware Manager provides a unified desktop workflow for configuring, updating, and monitoring Atlas CAN-connected devices across the fleet.",
    "copyright": "© 2025 Sozo Systems. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../tools/**/*"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/desktop-template.hbs",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "librsvg2-2",
          "iproute2",
          "usbutils",
          "util-linux",
          "xz-utils",
          "sudo",
          "coreutils"
        ],
        "files": {
          "/usr/share/applications/Atlas Hardware Manager.desktop": "linux/atlas-hardware-manager.desktop",
          "/usr/share/applications/atlas-hardware-manager.desktop": "linux/atlas-hardware-manager.desktop",
          "/usr/share/applications/ca.prometheusdynamics.atlas-hardware-manager.desktop": "linux/ca.prometheusdynamics.atlas-hardware-manager.desktop",
          "/usr/share/icons/hicolor/scalable/apps/atlas-hardware-manager.svg": "../static/logo.svg",
          "/usr/share/icons/hicolor/scalable/apps/ca.prometheusdynamics.atlas-hardware-manager.svg": "../static/logo.svg",
          "/usr/share/icons/hicolor/32x32/apps/ca.prometheusdynamics.atlas-hardware-manager.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/ca.prometheusdynamics.atlas-hardware-manager.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256@2/apps/ca.prometheusdynamics.atlas-hardware-manager.png": "icons/128x128@2x.png"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/desktop-template.hbs",
        "files": {
          "/usr/share/applications/Atlas Hardware Manager.desktop": "linux/atlas-hardware-manager.desktop",
          "/usr/share/applications/atlas-hardware-manager.desktop": "linux/atlas-hardware-manager.desktop",
          "/usr/share/applications/ca.prometheusdynamics.atlas-hardware-manager.desktop": "linux/ca.prometheusdynamics.atlas-hardware-manager.desktop",
          "/usr/share/icons/hicolor/scalable/apps/atlas-hardware-manager.svg": "../static/logo.svg",
          "/usr/share/icons/hicolor/scalable/apps/ca.prometheusdynamics.atlas-hardware-manager.svg": "../static/logo.svg",
          "/usr/share/icons/hicolor/32x32/apps/ca.prometheusdynamics.atlas-hardware-manager.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/ca.prometheusdynamics.atlas-hardware-manager.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256@2/apps/ca.prometheusdynamics.atlas-hardware-manager.png": "icons/128x128@2x.png"
        }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
